<%
  const m = movie;
  const sorts = [
    { key: 'latest', t: 'Latest' },
    { key: 'top',    t: 'Most liked' },
    { key: 'hot',    t: 'Most talked about' },
    { key: 'oldest', t: 'Oldest' }
  ];
  const cur = sorts.find((s) => s.key === sort) || sorts[0];
  const base = m.url + '/discussions';
  const sortUrl = (k) => base + (k === 'latest' ? '' : '?sort=' + k);
%>
<%- include('partials/head', { title: 'Discussions · ' + m.title + (m.year ? ' (' + m.year + ')' : '') }) %>
<%- include('partials/nav') %>

<style>
  /* ALL DISCUSSIONS OF ONE MOVIE: header -> compose -> count + sort -> list (infinite scroll) */
  .mdisc { padding-block: 20px 40px; }

  /* ---------- header ---------- */
  .mdisc-head { display: flex; align-items: center; gap: 14px; margin: 0 0 18px; min-width: 0; }
  .mdisc-poster { flex: none; width: 52px; aspect-ratio: 2/3; border-radius: 9px; overflow: hidden; display: grid; place-items: center; background: var(--surface-2); border: 1px solid color-mix(in srgb, var(--text) 12%, transparent); box-shadow: 0 14px 28px -16px rgba(0, 0, 0, .8); }
  .mdisc-poster img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .mdisc-id { flex: 1; min-width: 0; display: grid; gap: 3px; }
  .mdisc-id h1 { margin: 0; font-size: clamp(22px, 3.6vw, 32px); font-weight: 750; letter-spacing: -.03em; line-height: 1.1; }
  .mdisc-id p { margin: 0; font-size: 13.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mdisc-id p a { color: inherit; font-weight: 600; }
  .mdisc-id p a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .mdisc-head .btn { flex: none; display: inline-flex; align-items: center; gap: 6px; height: 36px; padding: 0 16px; border-radius: 999px; font-size: 13px; }

  /* ---------- compose bar ---------- */
  .mdisc-compose {
    display: flex; align-items: center; gap: 12px; margin: 0 0 18px; padding: 10px 10px 10px 12px; border-radius: 18px; min-width: 0; text-decoration: none; color: var(--text);
    background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 12%, transparent), transparent 55%), color-mix(in srgb, var(--text) 4%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--text) 11%, transparent); transition: border-color .25s, box-shadow .25s;
  }
  .mdisc-compose:hover { border-color: color-mix(in srgb, var(--accent) 55%, transparent); box-shadow: 0 14px 32px -20px color-mix(in srgb, var(--accent) 60%, #000); }
  .mdisc-compose .avatar { width: 36px; height: 36px; font-size: 15px; flex: none; }
  .mdisc-compose > span:nth-child(2) { flex: 1; min-width: 0; font-size: 13.5px; color: color-mix(in srgb, var(--text) 62%, transparent); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mdisc-compose-cta { flex: none; display: inline-flex; align-items: center; height: 36px; padding: 0 18px; border-radius: 999px; font: 600 13px/1 var(--font); color: #fff; background: var(--accent); }

  /* ---------- count + sort pill ---------- */
  .mdisc-bar { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 0 0 14px; }
  .mdisc-count { font-size: 13.5px; color: color-mix(in srgb, var(--text) 62%, transparent); }
  .mdisc-count b { color: var(--text); font-variant-numeric: tabular-nums; }

  .dd { position: relative; z-index: 40; }
  .dd-pill {
    list-style: none; display: inline-flex; align-items: center; gap: 9px; height: 38px; padding: 0 12px 0 14px; border-radius: 999px; cursor: pointer; user-select: none; -webkit-user-select: none; -webkit-tap-highlight-color: transparent;
    font: 600 13px/1 var(--font); color: var(--text); background: color-mix(in srgb, var(--text) 6%, transparent); border: 1px solid color-mix(in srgb, var(--text) 14%, transparent);
    transition: background .2s, border-color .2s, box-shadow .2s;
  }
  .dd-pill::-webkit-details-marker { display: none; }
  .dd-pill:hover { border-color: color-mix(in srgb, var(--accent) 55%, transparent); background: color-mix(in srgb, var(--accent) 10%, transparent); }
  .dd-pill > svg { width: 15px; height: 15px; flex: none; opacity: .75; }
  .dd-pill .chev { width: 14px; height: 14px; opacity: .7; transition: transform .25s ease; }
  .dd[open] .dd-pill { border-color: var(--accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 18%, transparent); }
  .dd[open] .chev { transform: rotate(180deg); }
  .dd-panel {
    position: absolute; top: calc(100% + 10px); right: 0; width: 210px; padding: 8px; border-radius: 18px; transform-origin: top right; animation: dd-pop .18s ease-out;
    background: color-mix(in srgb, var(--text) 5%, var(--surface)); border: 1px solid color-mix(in srgb, var(--text) 13%, transparent);
    box-shadow: 0 28px 60px -20px rgba(0, 0, 0, .85); -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px);
  }
  @keyframes dd-pop { from { opacity: 0; transform: translateY(-6px) scale(.97); } to { opacity: 1; transform: none; } }
  .dd-opt { display: flex; align-items: center; justify-content: space-between; gap: 8px; height: 40px; padding: 0 12px; border-radius: 12px; text-decoration: none; font: 500 13px/1 var(--font); white-space: nowrap; color: color-mix(in srgb, var(--text) 82%, transparent); transition: background .15s, color .15s; }
  .dd-opt svg { width: 14px; height: 14px; flex: none; opacity: 0; }
  .dd-opt:hover, .dd-opt:focus-visible { background: color-mix(in srgb, var(--accent) 16%, transparent); color: #fff; }
  .dd-opt.on { background: var(--accent); color: #fff; font-weight: 600; }
  .dd-opt.on svg { opacity: 1; }
  .dd :is(.dd-pill, .dd-opt):focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* ---------- list ---------- */
  .mdisc #feed { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 10px; align-items: start; }
  .mdisc #feed .pcard { margin: 0; padding: 12px 14px; border-radius: 14px; min-width: 0; content-visibility: auto; contain-intrinsic-size: auto 150px; }
  .mdisc #feed .pcard .pcard-eyebrow { display: none; }
  .mdisc #feed .pcard .pcard-title { margin: 0 0 4px; font-size: 14.5px; line-height: 1.3; }
  .mdisc #feed .pcard .pcard-text { margin: 0 0 8px; font-size: 13px; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .mdisc #feed .pcard .pcard-foot { margin: 0; padding-top: 8px; font-size: 12px; }
  .mdisc .loader { padding: 26px 0; }
  .mdisc .empty { padding: 36px 16px; text-align: center; }

  @media (max-width: 640px) {
    .mdisc { padding-block: 14px 28px; }
    .mdisc-head { gap: 12px; margin-bottom: 14px; }
    .mdisc-poster { width: 44px; }
    .mdisc-head .btn { width: 36px; padding: 0; justify-content: center; }
    .mdisc-head .btn span { display: none; }
    .mdisc-compose { margin-bottom: 14px; border-radius: 16px; }
    .mdisc #feed { grid-template-columns: minmax(0, 1fr); }
  }
  @media (prefers-reduced-motion: reduce) { .dd-panel { animation: none; } .dd-pill .chev { transition: none; } }
</style>

<main class="page">
  <div class="shell mdisc">

    <header class="mdisc-head">
      <a class="mdisc-poster" href="<%= m.url %>" aria-label="<%= m.title %>">
        <% if (m.poster) { %><img src="<%= m.poster %>" alt="" width="104" height="156" decoding="async"><% } else { %><%- include('partials/icon', { n: 'film' }) %><% } %>
      </a>
      <div class="mdisc-id">
        <h1>Discussions</h1>
        <p class="muted"><a href="<%= m.url %>"><%= m.title %></a><% if (m.year) { %> (<%= m.year %>)<% } %></p>
      </div>
      <a class="btn btn-ghost" href="<%= m.url %>"><%- include('partials/icon', { n: 'prev' }) %><span>Back to movie</span></a>
    </header>

    <a class="mdisc-compose" href="<%= me ? m.url + '?compose=1#discussions' : '/login?next=' + encodeURIComponent(m.url + '?compose=1') %>">
      <span class="avatar" style="--h:<%= me ? hue(me.username) : 260 %>"><%= me ? me.username.charAt(0).toUpperCase() : '?' %></span>
      <span><%= me ? 'Start a discussion about ' + m.title + '…' : 'Log in to start a discussion…' %></span>
      <span class="mdisc-compose-cta"><%= me ? 'Post' : 'Log in' %></span>
    </a>

    <% if (posts.length) { %>
      <div class="mdisc-bar">
        <span class="mdisc-count"><b><%= total %></b> discussion<%= total === 1 ? '' : 's' %></span>
        <details class="dd" data-dd>
          <summary class="dd-pill" aria-label="Sort discussions">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 4v16M7 20l-3-3M7 20l3-3M17 20V4M17 4l-3 3M17 4l3 3"/></svg>
            <span><%= cur.t %></span>
            <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </summary>
          <div class="dd-panel">
            <% sorts.forEach((s) => { %><a class="dd-opt<%= s.key === cur.key ? ' on' : '' %>" href="<%= sortUrl(s.key) %>"<%- s.key === cur.key ? ' aria-current="true"' : '' %>><span><%= s.t %></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></a><% }) %>
          </div>
        </details>
      </div>

      <div class="stack" id="feed" data-post-list><%- include('partials/postCards', { posts, showMovie: false }) %></div>
      <% if (hasMore) { %>
        <div class="loader" data-infinite="/api<%= m.url %>/discussions?sort=<%= cur.key %>" data-next="2" data-target="#feed" data-bare data-end="End of the discussion — for now."><span class="spinner"></span></div>
      <% } %>
    <% } else { %>
      <div class="empty">
        <%- include('partials/icon', { n: 'chat', cls: 'ic--xl' }) %>
        <p>No one has started a discussion on <b><%= m.title %></b> yet.</p>
      </div>
    <% } %>

  </div>
</main>

<script>
  /* sort dropdown: close on outside click or Esc */
  (function () {
    var dd = document.querySelector('[data-dd]');
    if (!dd) return;
    document.addEventListener('click', function (e) { if (dd.open && !dd.contains(e.target)) dd.open = false; });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && dd.open) { dd.open = false; dd.querySelector('summary').focus(); } });
  })();
</script>
<%- include('partials/foot') %>