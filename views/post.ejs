    <% if (backdrop) { %><img class="thread-hero-img" src="<%= backdrop %>" alt=""><% } else if (d.posterUrl) { %><img class="thread-hero-img thread-hero-img--poster" src="<%= d.posterUrl %>" alt=""><% } %>
    <div class="thread-hero-shade"></div>
    <div class="shell shell--narrow thread-hero-inner">
      <a class="movie-mini" href="<%= movieUrl %>">
        <% if (d.posterUrl) { %><img src="<%= d.posterUrl %>" alt=""><% } else { %><span class="movie-mini-none"><%- include('partials/icon', { n: 'film' }) %></span><% } %>
        <span>
          <small>Discussion on</small>
          <strong><%= post.movie_name %></strong>
          <em>
            <% if (d.rating) { %><span class="rate"><%- include('partials/icon', { n: 'star' }) %><%= d.rating %></span><% } %>
            <% if (post.release_date) { %><span><%= post.release_date %></span><% } %>
            <% if (post.runtime) { %><span><%= post.runtime %></span><% } %>
          </em>
        </span>
        <%- include('partials/icon', { n: 'next' }) %>
      </a>
    </div>
  </section>

  <div class="shell shell--narrow thread">

    <article class="thread-main" id="d-<%= post.id %>" data-post="<%= json(d) %>">
      <h1 class="thread-title"><%= post.title %></h1>

      <div class="thread-by">
        <a class="pcard-author" href="/users/<%= encodeURIComponent(post.username) %>">
          <span class="avatar" style="--h:<%= hue(post.username) %>"><%= post.username.charAt(0).toUpperCase() %></span>
          <span><strong><%= post.username %></strong></span>
        </a>
        <time class="muted" title="<%= fmtDate(post.created_at, true) %>"><%= fmtDate(post.created_at, true) %></time>
        <span class="stats">
          <span class="stat"><%= mins %> min read</span>
          <a class="stat" href="#comments"><%- include('partials/icon', { n: 'chat' }) %><%= comments.length %></a>
        </span>
      </div>

      <% if (genres.length) { %><div class="chips"><% genres.forEach((g) => { %><a class="chip" href="/discussions?genre=<%= encodeURIComponent(g) %>"><%= g %></a><% }) %></div><% } %>

      <p class="thread-content"><%= post.content %></p>

      <div class="thread-actions">
        <button type="button" class="btn btn-ghost like-big<%= d.liked ? ' on' : '' %>" data-like="<%= post.id %>" aria-pressed="<%= d.liked %>"><%- include('partials/icon', { n: 'heart' }) %> <span data-like-label><%= d.liked ? 'Liked' : 'Like' %></span></button>
        <button type="button" class="btn btn-ghost" data-share-post><%- include('partials/icon', { n: 'share' }) %> Share</button>
        <% if (mine) { %>
          <form action="/posts/<%= post.id %>/delete" method="POST" onsubmit="return confirm('Delete this discussion permanently?');">
            <button type="submit" class="btn btn-ghost btn-danger"><%- include('partials/icon', { n: 'trash' }) %> Delete</button>
          </form>
        <% } %>
      </div>

      <p class="likes-line">
        <% if (d.likes > 0) { %>
          <span class="likes-av" aria-hidden="true"><% likers.slice(0, 4).forEach((l) => { %><span class="avatar" style="--h:<%= hue(l.username) %>"><%= l.username.charAt(0).toUpperCase() %></span><% }) %></span>
          <a href="/posts/<%= post.id %>/likes">Liked by
            <strong><span data-like-count="<%= post.id %>"><%= d.likes %></span></strong> <%= d.likes === 1 ? 'person' : 'people' %></a>
          <span class="muted">· <%= likers.slice(0, 3).map((l) => l.username).join(', ') %><%= others > 0 || likers.length > 3 ? ' …' : '' %></span>
        <% } else { %><span class="muted">Be the first to like this · <span data-like-count="<%= post.id %>" hidden>0</span></span><% } %>
      </p>
    </article>

    <!-- Kravn Card — the collectible, shareable version of this discussion -->
    <section class="thread-card" aria-label="Kravn Card">
      <div class="section-head"><h2>Your KravN Card</h2><span class="muted small">Download it or share it anywhere</span></div>
      <div class="kcard-mount" data-kcard-mount data-post="<%= json(d) %>"></div>
    </section>

    <!-- Comments (YouTube style: anyone logged in can reply to any comment, the post author included) -->
    <section class="comments" id="comments">
      <div class="section-head"><h2><%= comments.length %> <%= comments.length === 1 ? 'Comment' : 'Comments' %></h2></div>

      <% if (me) { %>
      <form class="comment-form" action="/posts/<%= post.id %>/comments" method="POST">
        <span class="avatar" style="--h:<%= hue(me.username) %>"><%= me.username.charAt(0).toUpperCase() %></span>
        <div class="cf-field">
          <textarea name="content" rows="1" maxlength="2000" required placeholder="Add a comment…"></textarea>
          <div class="cf-actions">
            <button type="button" class="reply-cancel" data-cf-cancel>Cancel</button>
            <button type="submit" class="btn btn-primary btn-sm">Comment</button>
          </div>
        </div>
      </form>
      <% } else { %>
      <a class="compose-teaser" href="/login?next=<%= encodeURIComponent('/posts/' + post.id + '#comments') %>">
        <span class="avatar" style="--h:260">?</span><span>Log in or sign up to join this discussion</span><span class="btn btn-primary btn-sm">Log in</span>
      </a>
      <% } %>

      <% if (!comments.length) { %><p class="muted empty-line">No comments yet. Say something.</p><% } %>

      <div class="comment-list">
        <% commentThreads.forEach((c) => { %>
          <%- include('partials/commentItem', { c: c, isReply: false }) %>
        <% }) %>
      </div>

    </section>

    <% if (more.length) { %>
      <section class="more-talk">
        <div class="section-head"><h2>More on <%= post.movie_name %></h2><a class="more" href="<%= movieUrl %>#discussions">All discussions <%- include('partials/icon', { n: 'next' }) %></a></div>
        <div class="stack"><%- include('partials/postCards', { posts: more, showMovie: false }) %></div>
      </section>
    <% } %>

  </div>
</main>

<script>
  /* YouTube-style comments: Reply boxes and "N replies" are plain <details> elements.
     This only adds polish: auto-growing boxes, focus on open, close others, and open the replies
     when a link points at one. */
  (function () {
    var root = document.getElementById('comments');
    if (!root) return;

    function grow(ta) {
      if (!ta) return;
      ta.style.height = 'auto';
      ta.style.height = Math.min(ta.scrollHeight, 240) + 'px';
    }

    root.addEventListener('input', function (e) {
      if (e.target && e.target.tagName === 'TEXTAREA') grow(e.target);
    });

    root.addEventListener('toggle', function (e) {
      var d = e.target;
      if (!d || !d.classList || !d.classList.contains('reply-box') || !d.open) return;
      root.querySelectorAll('details.reply-box[open]').forEach(function (o) { if (o !== d) o.open = false; });
      var ta = d.querySelector('textarea');
      if (ta) { grow(ta); ta.focus(); var n = ta.value.length; ta.setSelectionRange(n, n); }
    }, true);

    root.addEventListener('click', function (e) {
      if (e.target.closest('[data-reply-cancel]')) {
        var box = e.target.closest('details');
        if (box) box.open = false;
        return;
      }
      if (e.target.closest('[data-cf-cancel]')) {
        var form = e.target.closest('form');
        if (form) {
          form.reset();
          var t = form.querySelector('textarea');
          if (t) t.style.height = '';
        }
        if (document.activeElement && document.activeElement.blur) document.activeElement.blur();
      }
    });

    function revealHash() {
      var id = (location.hash || '').slice(1);
      if (!id) return;
      var el;
      try { el = document.getElementById(decodeURIComponent(id)); } catch (err) { return; }
      if (!el || !root.contains(el)) return;
      var wrap = el.closest('details.replies');
      if (wrap) { wrap.open = true; el.scrollIntoView({ block: 'center' }); }
    }
    revealHash();
    window.addEventListener('hashchange', revealHash);
  })();
</script>
<%- include('partials/foot') %>