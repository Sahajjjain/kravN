  const d = cardData(post);
  const genres = genreList(post);
  const mine = !!me && me.id === post.user_id;
  const movieUrl = movie ? movie.url : movieLink(post);
  const backdrop = movie && movie.backdrop;
  const others = Math.max(0, d.likes - likers.length);
  const mins = Math.max(1, Math.round(String(post.content || '').trim().split(/\s+/).length / 200));

  // Group comments into YouTube-style threads: each top-level comment gets a flat list of all its
  // replies (replies to replies included, oldest first), built here from `comments` using parent_id.
  // (The route's own `threads` uses a `replies` property, so it is deliberately not used.)
  const toTime = (v) => { const t = new Date(v).getTime(); return isNaN(t) ? 0 : t; };
  const buildThreads = (all) => {
    const byId = new Map(all.map((x) => [String(x.id), x]));
    const rootOf = (x) => {
      let cur = x, guard = 0;
      while (cur.parent_id != null && byId.has(String(cur.parent_id)) && guard++ < 50) cur = byId.get(String(cur.parent_id));
      return cur;
    };
    const roots = new Map();
    all.forEach((x) => { if (rootOf(x) === x) roots.set(String(x.id), Object.assign({}, x, { flat: [] })); });
    all.forEach((x) => {
      const r = rootOf(x);
      if (r === x) return;
      const parent = byId.get(String(x.parent_id));
      const bucket = roots.get(String(r.id));
      if (!bucket) return;
      bucket.flat.push(Object.assign({}, x, { replyTo: parent && parent !== r ? parent.username : '' }));
    });
    const out = Array.from(roots.values());
    out.forEach((r) => r.flat.sort((a, b) => toTime(a.created_at) - toTime(b.created_at)));
    return out;
  };
  const commentThreads = buildThreads(comments);
