<% const qs = (o) => { const p = new URLSearchParams(Object.assign({ genre, sort }, o)); if (!p.get('genre')) p.delete('genre'); if (p.get('sort') === 'latest') p.delete('sort'); const s = p.toString(); return '/discussions' + (s ? '?' + s : ''); }; %>
<%- include('partials/head', { title: 'Latest discussions' }) %>
<%- include('partials/nav') %>
<style>
  /* =====================================================================
     SHARED: compact poster tiles + slim genre pills
     Used by the home page rail and the discussions grid.
     ===================================================================== */

  /* ---------- genre pills (home "Browse by genre" + discussions filter chips) ---------- */
  .kv-genres, .toolbar .chips--scroll {
    display: flex; flex-wrap: nowrap; gap: 8px; overflow-x: auto; scrollbar-width: none; overscroll-behavior-x: contain;
    scroll-snap-type: x proximity; padding: 2px 0 6px;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 16px, #000 calc(100% - 28px), transparent 100%);
            mask-image: linear-gradient(90deg, transparent 0, #000 16px, #000 calc(100% - 28px), transparent 100%);
  }
  .kv-genres::-webkit-scrollbar, .toolbar .chips--scroll::-webkit-scrollbar { display: none; }
  .kv-genre, .toolbar .chips--scroll .chip {
    flex: none; scroll-snap-align: start; display: inline-flex; align-items: center; height: 32px; padding: 0 14px; margin: 0;
    border-radius: 999px; font: 500 12.5px/1 var(--font); letter-spacing: .01em; color: color-mix(in srgb, var(--text) 82%, transparent);
    white-space: nowrap; background: color-mix(in srgb, var(--text) 5%, transparent);
    border: 1px solid color-mix(in srgb, var(--text) 10%, transparent); box-shadow: none;
    transition: color .2s, background .2s, border-color .2s, transform .2s;
  }
  .kv-genre:hover, .kv-genre:focus-visible,
  .toolbar .chips--scroll .chip:hover, .toolbar .chips--scroll .chip:focus-visible {
    color: #fff; border-color: color-mix(in srgb, var(--accent) 60%, transparent); background: color-mix(in srgb, var(--accent) 18%, transparent);
  }
  .toolbar .chips--scroll .chip.on { color: #fff; background: var(--accent); border-color: var(--accent); }
  .kv-genre:active, .toolbar .chips--scroll .chip:active { transform: scale(.96); }

  /* ---------- discussions grid ---------- */
  .pgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 14px; align-items: start; }

  /* ---------- the tile itself ---------- */
  :is(.rail-track--posts, .pgrid) .pcard {
    display: flex; flex-direction: column; gap: 0; padding: 0; height: auto; position: relative; overflow: hidden; min-width: 0; margin: 0;
    border-radius: 14px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--text) 7%, var(--surface)), var(--surface));
    border: 1px solid color-mix(in srgb, var(--text) 9%, transparent);
    transition: transform .25s ease, border-color .25s, box-shadow .25s;
  }
  :is(.rail-track--posts, .pgrid) .pcard:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--accent) 45%, transparent); box-shadow: 0 16px 36px -18px rgba(0, 0, 0, .7); }

  /* poster: the full 2:3 frame */
  :is(.rail-track--posts, .pgrid) .pcard .pcard-poster {
    position: relative; display: block; width: 100%; height: auto; aspect-ratio: 2/3; flex: none; margin: 0; border-radius: 0;
    background: color-mix(in srgb, var(--surface-2) 90%, #000); overflow: hidden;
  }
  :is(.rail-track--posts, .pgrid) .pcard .pcard-poster img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; transition: transform .5s ease; }
  :is(.rail-track--posts, .pgrid) .pcard:hover .pcard-poster img { transform: scale(1.04); }
  :is(.rail-track--posts, .pgrid) .pcard .pcard-poster::after { content: ''; position: absolute; inset: auto 0 0 0; height: 38%; background: linear-gradient(0deg, rgba(0,0,0,.55), transparent); pointer-events: none; }
  :is(.rail-track--posts, .pgrid) .pcard .pcard-poster-fallback { display: grid; place-items: center; width: 100%; height: 100%; color: var(--muted); }

  /* rating chip over the poster (inline display:none keeps it hidden on other pages; forced on in tiles) */
  :is(.rail-track--posts, .pgrid) .pcard .pcard-badge {
    display: inline-flex !important; position: absolute; z-index: 2; top: 8px; left: 8px; align-items: center; gap: 4px;
    padding: 3px 8px 3px 6px; border-radius: 999px; font: 700 11px/1 var(--font); color: #fff;
    background: rgba(10, 10, 14, .62); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, .14);
  }
  .pcard-badge svg { width: 11px; height: 11px; color: #f5c518; fill: currentColor; }

  /* text block */
  :is(.rail-track--posts, .pgrid) .pcard .pcard-body { padding: 10px 11px 11px; display: grid; gap: 5px; min-width: 0; }
  :is(.rail-track--posts, .pgrid) .pcard .pcard-eyebrow { margin: 0; display: block; }
  :is(.rail-track--posts, .pgrid) .pcard .pcard-eyebrow .rate,
  :is(.rail-track--posts, .pgrid) .pcard .pcard-eyebrow .muted { display: none; }
  :is(.rail-track--posts, .pgrid) .pcard .pcard-movie {
    display: block; font-size: 10.5px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase;
    color: var(--accent-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; position: relative; z-index: 2;
  }
  :is(.rail-track--posts, .pgrid) .pcard .pcard-title { margin: 0; font-size: 13.5px; font-weight: 650; line-height: 1.3; letter-spacing: -.005em; }
  :is(.rail-track--posts, .pgrid) .pcard .pcard-title a { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; color: inherit; }
  :is(.rail-track--posts, .pgrid) .pcard .pcard-text { display: none; }

  /* footer: author left, like + comment right */
  :is(.rail-track--posts, .pgrid) .pcard .pcard-foot { margin: 3px 0 0; padding: 8px 0 0; border-top: 1px solid color-mix(in srgb, var(--text) 8%, transparent); display: flex; align-items: center; justify-content: space-between; gap: 6px; flex-wrap: nowrap; }
  :is(.rail-track--posts, .pgrid) .pcard .pcard-author { display: inline-flex; align-items: center; gap: 6px; min-width: 0; font-size: 11.5px; color: color-mix(in srgb, var(--text) 70%, transparent); position: relative; z-index: 2; }
  :is(.rail-track--posts, .pgrid) .pcard .pcard-author span:last-child { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 62px; }
  :is(.rail-track--posts, .pgrid) .pcard .avatar--sm { width: 20px; height: 20px; font-size: 10px; flex: none; }
  :is(.rail-track--posts, .pgrid) .pcard time,
  :is(.rail-track--posts, .pgrid) .pcard [data-share-post] { display: none; }
  :is(.rail-track--posts, .pgrid) .pcard .pcard-actions { margin: 0; display: inline-flex; gap: 8px; position: relative; z-index: 2; }
  :is(.rail-track--posts, .pgrid) .pcard .act { display: inline-flex; align-items: center; gap: 3px; font-size: 11.5px; padding: 0; min-height: 0; background: none; border: 0; }
  :is(.rail-track--posts, .pgrid) .pcard .act svg { width: 13px; height: 13px; }

  /* ---------- home rail sizing ---------- */
  .rail-track--posts { gap: 14px; align-items: flex-start; padding-block: 4px 10px; }
  .rail-track--posts .pcard { flex: 0 0 auto; width: clamp(150px, 14vw, 184px); max-width: 184px; scroll-snap-align: start; }

  /* ---------- phones ---------- */
  @media (max-width: 640px) {
    .kv-genres, .toolbar .chips--scroll { margin-inline: -16px; padding-inline: 16px; scroll-padding-inline: 16px; gap: 7px; }
    .kv-genre, .toolbar .chips--scroll .chip { height: 30px; padding: 0 12px; font-size: 12px; }
    .pgrid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    :is(.rail-track--posts, .pgrid) .pcard { border-radius: 12px; }
    :is(.rail-track--posts, .pgrid) .pcard .pcard-body { padding: 8px 9px 9px; gap: 4px; }
    :is(.rail-track--posts, .pgrid) .pcard .pcard-title { font-size: 12.5px; }
    :is(.rail-track--posts, .pgrid) .pcard .pcard-movie { font-size: 9.5px; }
    :is(.rail-track--posts, .pgrid) .pcard .pcard-author span:last-child { max-width: 44px; }
    .rail-track--posts { gap: 10px; }
    .rail-track--posts .pcard { width: 132px; max-width: 132px; }
  }
  @media (min-width: 900px) { .pgrid { grid-template-columns: repeat(auto-fill, minmax(168px, 1fr)); } }
  @media (hover: none) { :is(.rail-track--posts, .pgrid) .pcard:hover { transform: none; } }
</style>

<style>
  /* =====================================================================
     DISCUSSIONS PAGE: compact head -> composer -> genre chips -> sort -> grid
     ===================================================================== */
  .page .shell--narrow.kv-disc { max-width: min(1100px, 100% - 32px); }

  /* ---------- header ---------- */
  .kv-disc .page-head { display: grid; gap: 6px; justify-items: start; margin: 0 0 14px; padding: 0; }
  .kv-disc .page-head h1 { margin: 0; font-size: clamp(24px, 3.4vw, 34px); font-weight: 700; letter-spacing: -.03em; line-height: 1.1; }
  .kv-disc .page-head .muted { margin: 0; max-width: 560px; font-size: 13.5px; line-height: 1.5; }

  /* ---------- composer teaser ---------- */
  .kv-disc .compose-teaser {
    display: flex; align-items: center; gap: 12px; margin: 0 0 16px; padding: 10px 10px 10px 12px; border-radius: 999px; min-width: 0;
    color: color-mix(in srgb, var(--text) 62%, transparent); text-decoration: none; font-size: 13.5px;
    background: color-mix(in srgb, var(--text) 4%, var(--surface)); border: 1px solid color-mix(in srgb, var(--text) 10%, transparent);
    transition: border-color .2s ease, background .2s ease;
  }
  .kv-disc .compose-teaser:hover { border-color: color-mix(in srgb, var(--accent) 50%, transparent); background: color-mix(in srgb, var(--text) 6%, var(--surface)); }
  .kv-disc .compose-teaser .avatar { width: 32px; height: 32px; font-size: 14px; flex: none; }
  .kv-disc .compose-teaser > span:nth-child(2) { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  /* hollow pill buttons */
  .kv-disc .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 7px; margin: 0; border-radius: 999px;
    font: 500 12.5px/1 var(--font); letter-spacing: .03em; color: #fff; white-space: nowrap; background: transparent; box-shadow: none;
    border: 1px solid color-mix(in srgb, var(--accent) 85%, #fff 10%);
    transition: transform .2s ease, background .2s ease, border-color .2s ease;
  }
  .kv-disc .btn:hover { background: var(--accent); border-color: var(--accent); transform: translateY(-1px); }
  .kv-disc .btn:active { transform: scale(.97); }
  .kv-disc .btn-sm { height: 32px; padding: 0 16px; flex: none; }
  .kv-disc .empty .btn { height: 40px; padding: 0 22px; }

  /* ---------- toolbar: genres on one swipeable row, sort below ---------- */
  .kv-disc .toolbar { display: grid; gap: 10px; margin: 0 0 16px; min-width: 0; }
  .kv-disc .toolbar .chips--scroll {
    margin: 0; padding: 2px 0 6px; cursor: grab; touch-action: pan-x; -webkit-overflow-scrolling: touch;
    -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 32px), transparent 100%);
            mask-image: linear-gradient(90deg, #000 calc(100% - 32px), transparent 100%);
  }
  .kv-disc .toolbar .chips--scroll.at-end { -webkit-mask-image: none; mask-image: none; }
  .kv-disc .toolbar .chips--scroll.is-drag { cursor: grabbing; user-select: none; -webkit-user-select: none; }
  .kv-disc .toolbar .chips--scroll .chip { cursor: pointer; text-decoration: none; }

  /* sort: segmented pill */
  .kv-disc .toolbar .seg {
    display: inline-flex; align-items: center; gap: 2px; justify-self: start; padding: 3px; margin: 0; border-radius: 999px;
    background: color-mix(in srgb, var(--text) 6%, transparent); border: 1px solid color-mix(in srgb, var(--text) 14%, transparent);
  }
  .kv-disc .toolbar .seg a {
    display: inline-flex; align-items: center; justify-content: center; height: 30px; padding: 0 16px; border-radius: 999px; margin: 0;
    font: 500 12.5px/1 var(--font); letter-spacing: .01em; white-space: nowrap; text-decoration: none; border: 0; background: transparent;
    color: color-mix(in srgb, var(--text) 66%, transparent); transition: background .2s ease, color .2s ease;
  }
  .kv-disc .toolbar .seg a:hover { color: var(--text); }
  .kv-disc .toolbar .seg a.on { background: var(--accent); color: #fff; }
  .kv-disc .toolbar .seg .sm { display: none; }

  .kv-disc .loader { padding: 22px 0; }
  .kv-disc .end { text-align: center; padding: 22px 0 8px; font-size: 13px; color: color-mix(in srgb, var(--text) 55%, transparent); }

  /* ---------- phone ---------- */
  @media (max-width: 640px) {
    .kv-disc .page-head { margin-bottom: 12px; gap: 4px; }
    .kv-disc .page-head .muted { font-size: 13px; }
    .kv-disc .compose-teaser { margin-bottom: 12px; padding: 8px 8px 8px 10px; gap: 10px; font-size: 13px; }
    .kv-disc .compose-teaser .avatar { width: 30px; height: 30px; font-size: 13px; }
    .kv-disc .toolbar { gap: 8px; margin-bottom: 14px; }
    .kv-disc .toolbar .chips--scroll { margin-inline: -16px; padding-inline: 16px; scroll-padding-inline: 16px; }
    .kv-disc .toolbar .seg { display: grid; grid-template-columns: repeat(3, 1fr); width: 100%; justify-self: stretch; }
    .kv-disc .toolbar .seg a { height: 34px; padding: 0 6px; font-size: 12.5px; }
    .kv-disc .toolbar .seg .lg { display: none; }
    .kv-disc .toolbar .seg .sm { display: inline; }
  }
</style>

<main class="page">
  <div class="shell shell--narrow kv-disc">
    <header class="page-head">
      <span class="eyebrow"><span class="dot"></span> Live from the community</span>
      <h1>Latest discussions</h1>
      <p class="muted">Theories, reviews and hot takes across every movie, newest first.</p>
    </header>

    <a class="compose-teaser" href="<%= me ? '/posts/new' : '/login?next=/posts/new' %>">
      <span class="avatar" style="--h:<%= me ? hue(me.username) : 260 %>"><%= me ? me.username.charAt(0).toUpperCase() : '?' %></span>
      <span><%= me ? 'Pick a movie and start a discussion…' : 'Log in to start a discussion…' %></span>
      <span class="btn btn-primary btn-sm"><%= me ? 'Post' : 'Log in' %></span>
    </a>

    <div class="toolbar">
      <div class="chips chips--scroll" data-filter-genres>
        <a class="chip<%= genre ? '' : ' on' %>" href="<%= qs({ genre: '' }) %>">All</a>
        <% genres.forEach((g) => { %><a class="chip<%= genre === g.name ? ' on' : '' %>" href="<%= qs({ genre: g.name }) %>"><%= g.name %></a><% }) %>
      </div>
      <div class="seg" role="group" aria-label="Sort">
        <a class="<%= sort === 'latest' ? 'on' : '' %>" href="<%= qs({ sort: 'latest' }) %>"<%- sort === 'latest' ? ' aria-current="true"' : '' %>>Latest</a>
        <a class="<%= sort === 'top' ? 'on' : '' %>" href="<%= qs({ sort: 'top' }) %>"<%- sort === 'top' ? ' aria-current="true"' : '' %>><span class="lg">Most liked</span><span class="sm">Liked</span></a>
        <a class="<%= sort === 'hot' ? 'on' : '' %>" href="<%= qs({ sort: 'hot' }) %>"<%- sort === 'hot' ? ' aria-current="true"' : '' %>><span class="lg">Most talked about</span><span class="sm">Hot</span></a>
      </div>
    </div>

    <% if (posts.length) { %>
      <div class="pgrid" id="feed" data-post-list><%- include('partials/postCards', { posts }) %></div>
      <% if (hasMore) { %>
        <div class="loader" data-infinite="/api/discussions?genre=<%= encodeURIComponent(genre) %>&sort=<%= sort %>" data-next="2" data-target="#feed" data-end="That's a wrap — you've seen every discussion."><span class="spinner"></span></div>
      <% } else { %><p class="end" data-egg="credits">That's a wrap — you've seen every discussion.</p><% } %>
    <% } else { %>
      <div class="empty"><p>No <%= genre || '' %> discussions yet.</p><a class="btn btn-primary" href="<%= me ? '/posts/new' : '/register' %>">Start the first one</a></div>
    <% } %>
  </div>
</main>

<script>
  /* genre chips: centre the selected chip on load, drag-to-scroll with mouse, drop the edge fade at the end */
  (function () {
    var row = document.querySelector('[data-filter-genres]');
    if (!row) return;
    function edge() { row.classList.toggle('at-end', row.scrollLeft + row.clientWidth >= row.scrollWidth - 4); }
    row.addEventListener('scroll', edge, { passive: true });
    window.addEventListener('resize', edge);

    var on = row.querySelector('.chip.on');
    if (on) row.scrollLeft = Math.max(0, on.offsetLeft - (row.clientWidth - on.offsetWidth) / 2);
    edge();

    var down = false, moved = false, startX = 0, startLeft = 0;
    row.addEventListener('mousedown', function (e) { down = true; moved = false; startX = e.pageX; startLeft = row.scrollLeft; });
    window.addEventListener('mousemove', function (e) {
      if (!down) return;
      var dx = e.pageX - startX;
      if (Math.abs(dx) > 4) { moved = true; row.classList.add('is-drag'); }
      if (moved) row.scrollLeft = startLeft - dx;
    });
    window.addEventListener('mouseup', function () { down = false; row.classList.remove('is-drag'); });
    row.addEventListener('click', function (e) {
      if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; }
    }, true);
    row.addEventListener('dragstart', function (e) { e.preventDefault(); });
  })();
</script>
<%- include('partials/foot') %>