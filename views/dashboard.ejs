<!DOCTYPE html>

<html>

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Dashboard - KravN</title>

  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/theme.js"></script>

  <style>
    /* =========================================================
       KRAVN COLLECTIBLE SWIPE DECK
       ========================================================= */

    .kravn-deck-section {
      margin: 0 0 var(--space-8, 2.5rem);
    }

    .kravn-deck-heading {
      text-align: center;
      margin: 0 0 1.25rem;
    }

    .kravn-deck-heading .kravn-deck-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: #c4b5fd;
    }

    .kravn-deck-heading .kravn-deck-eyebrow::before,
    .kravn-deck-heading .kravn-deck-eyebrow::after {
      content: '';
      width: 22px;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(139, 92, 246, 0.7));
    }

    .kravn-deck-heading .kravn-deck-eyebrow::after {
      background: linear-gradient(90deg, rgba(139, 92, 246, 0.7), transparent);
    }

    .kravn-deck-heading h3 {
      margin: 0.35rem 0 0;
      font-size: 1.35rem;
      font-weight: 800;
      letter-spacing: -0.4px;
      background: linear-gradient(135deg, #fff 30%, #c4b5fd 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      text-shadow: 0 0 30px rgba(139, 92, 246, 0.25);
    }

    .kravn-deck-stage {
      position: relative;
      width: 300px;
      max-width: 88vw;
      aspect-ratio: 9 / 16;
      margin: 0 auto;
      touch-action: pan-y;
    }

    .kravn-deck-card {
      position: absolute;
      inset: 0;
      border-radius: 22px;
      overflow: hidden;
      background: #050507;
      border: 2px solid rgba(139, 92, 246, 0.45);
      box-shadow: 0 30px 70px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(139, 92, 246, 0.06) inset;
      transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.35s ease;
      cursor: grab;
      will-change: transform;
      user-select: none;
    }

    .kravn-deck-card.dragging {
      transition: none;
      cursor: grabbing;
    }

    .kravn-deck-card-bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 20%;
      z-index: -3;
      pointer-events: none;
    }

    .kravn-deck-card-fallback {
      position: absolute;
      inset: 0;
      z-index: -3;
      background:
        radial-gradient(circle at 75% 25%, rgba(139, 92, 246, 0.3), transparent 45%),
        linear-gradient(150deg, #1c1428, #0a0810 55%, #030204);
    }

    .kravn-deck-card-overlay {
      position: absolute;
      inset: 0;
      z-index: -2;
      background: linear-gradient(
        to bottom,
        rgba(3,2,8,0.60) 0%,
        rgba(3,2,8,0.06) 22%,
        rgba(3,2,8,0.02) 34%,
        rgba(3,2,8,0.24) 50%,
        rgba(3,2,8,0.84) 76%,
        rgba(0,0,0,0.97) 100%
      );
    }

    .kravn-deck-card-content {
      position: absolute;
      inset: 0;
      box-sizing: border-box;
      padding: 20px 22px 24px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      z-index: 1;
      pointer-events: none;
    }

    .kravn-deck-logo {
      font-size: 18px;
      font-weight: 800;
      letter-spacing: -0.6px;
      color: #fff;
      text-shadow: 0 4px 14px rgba(0,0,0,0.7);
    }

    .kravn-deck-logo span { color: #c4b5fd; }

    .kravn-deck-movie {
      color: #c4b5fd;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1.4px;
      text-transform: uppercase;
      text-shadow: 0 2px 8px rgba(0,0,0,0.65);
      margin-bottom: 8px;
    }

    .kravn-deck-title {
      color: #fff;
      font-size: clamp(1.1rem, 4.6vw, 1.5rem);
      line-height: 1.2;
      font-weight: 800;
      letter-spacing: -0.6px;
      text-shadow: 0 3px 12px rgba(0,0,0,0.75);
      margin: 0 0 10px;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .kravn-deck-author {
      color: rgba(255,255,255,0.68);
      font-size: 11px;
    }

    .kravn-deck-controls {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 1.1rem;
      margin-top: 1.1rem;
    }

    .kravn-deck-arrow {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      border: 1px solid rgba(139, 92, 246, 0.3);
      background: rgba(139, 92, 246, 0.06);
      color: #c4b5fd;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 1rem;
      transition: border-color 0.18s ease, background 0.18s ease, transform 0.12s ease;
      user-select: none;
    }

    .kravn-deck-arrow:hover {
      border-color: rgba(139, 92, 246, 0.6);
      background: rgba(139, 92, 246, 0.14);
      transform: translateY(-1px);
    }

    .kravn-deck-counter {
      font-size: 0.78rem;
      color: var(--text-muted);
      font-variant-numeric: tabular-nums;
      min-width: 44px;
      text-align: center;
    }
  </style>

</head>

<body>

  <%- include('partials/navbar', { currentPage: 'dashboard' }) %>

  <div class="page">

    <!-- Dashboard Header -->
    <div class="profile-header"
         style="border-bottom: none; padding-bottom: 0; margin-bottom: var(--space-6);">

      <div class="avatar-placeholder lg">
        <%= username[0].toUpperCase() %>
      </div>

      <div>

        <h1 style="font-size: 1.6rem; margin-bottom: 0.25rem;">

          <%= username %>

          <span style="
            font-size: 0.9rem;
            color: var(--accent);
            font-family: 'Inter', sans-serif;
            font-weight: 400;
          ">
            · you
          </span>

        </h1>

        <p class="post-meta">
          Your KravN discussions
        </p>

        <p class="post-meta">
          <%= posts.length %> discussion<%= posts.length !== 1 ? 's' : '' %>
        </p>

      </div>

    </div>


    <!-- Divider -->
    <div class="sprocket-divider" style="margin-top: 0;">
      <div class="holes">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>


    <!-- KravN Collectible Swipe Deck -->
    <% if (posts.length > 0) { %>
      <div class="kravn-deck-section">

        <div class="kravn-deck-heading">
          <span class="kravn-deck-eyebrow">✦ Collectibles</span>
          <h3>Your Kravn Cards</h3>
        </div>

        <div class="kravn-deck-stage" id="kravn-deck-stage"></div>

        <div class="kravn-deck-controls">
          <div class="kravn-deck-arrow" id="kravn-deck-prev" title="Previous">‹</div>
          <span class="kravn-deck-counter" id="kravn-deck-counter">1 / <%= posts.length %></span>
          <div class="kravn-deck-arrow" id="kravn-deck-next" title="Next">›</div>
        </div>

      </div>
    <% } %>


    <!-- Empty State -->
    <% if (posts.length === 0) { %>

      <div class="empty-state">

        <p>You haven't posted anything yet.</p>

        <p>
          <a href="/posts/new">
            Start your first discussion →
          </a>
        </p>

      </div>

    <% } %>


    <!-- Discussions -->
    <div class="feed-grid">

      <% posts.forEach(post => { %>

        <div
          class="post-card"
          onclick="window.location.href='/posts/<%= post.id %>'"
        >

          <% if (post.poster_url && post.poster_url !== 'N/A') { %>

            <img
              class="post-poster"
              src="<%= post.poster_url %>"
              alt="<%= post.movie_name %>"
            >

          <% } else { %>

            <div class="post-poster-placeholder">
              🎬
            </div>

          <% } %>


          <div class="post-body">

            <div class="post-eyebrow">
              <span>
                <%= post.movie_name %>
              </span>
            </div>


            <h3>
              <a href="/posts/<%= post.id %>">
                <%= post.title %>
              </a>
            </h3>


            <p class="post-excerpt">
              <%= post.content %>
            </p>


            <p class="post-meta">

              <span class="like-count">
                <%= post.like_count %>
              </span>
              likes

              &nbsp;·&nbsp;

              <%= post.comment_count %>
              comments

              &nbsp;·&nbsp;

              <%= new Date(post.created_at).toLocaleString('en-IN', {
                dateStyle: 'medium',
                timeStyle: 'short',
                timeZone: 'Asia/Kolkata'
              }) %>

            </p>


            <span class="post-card-cta">
              View discussion →
            </span>

          </div>

        </div>

      <% }); %>

    </div>

  </div>

  <script>
    const KRAVN_DECK_POSTS = <%- JSON.stringify(posts.map(p => ({
      id: p.id,
      movieName: p.movie_name || '',
      title: p.title || '',
      posterUrl: (p.poster_url && p.poster_url !== 'N/A') ? p.poster_url : null
    }))) %>;
    const KRAVN_DECK_USERNAME = <%- JSON.stringify(username || '') %>;

    (function initKravnDeck() {
      const stage = document.getElementById('kravn-deck-stage');
      if (!stage || !KRAVN_DECK_POSTS.length) return;

      const prevBtn = document.getElementById('kravn-deck-prev');
      const nextBtn = document.getElementById('kravn-deck-next');
      const counter = document.getElementById('kravn-deck-counter');
      const total = KRAVN_DECK_POSTS.length;

      let current = 0;          // index of the front-most card
      let dragging = false;
      let startX = 0;
      let deltaX = 0;
      let isAnimatingOut = false; // guards against double-advance mid-fly-off

      const VISIBLE_STACK = Math.min(3, total); // how many cards peek behind the front card

      function escapeHtml(str) {
        return String(str || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;');
      }

      function cardHTML(post) {
        const posterBlock = post.posterUrl
          ? `<img class="kravn-deck-card-bg" src="${post.posterUrl}" alt="" onerror="this.remove()">`
          : `<div class="kravn-deck-card-fallback"></div>`;

        return `
          ${posterBlock}
          <div class="kravn-deck-card-overlay"></div>
          <div class="kravn-deck-card-content">
            <div class="kravn-deck-logo">Kravn<span>.</span></div>
            <div>
              <div class="kravn-deck-movie">${escapeHtml(post.movieName)}</div>
              <div class="kravn-deck-title">${escapeHtml(post.title)}</div>
              <div class="kravn-deck-author">@${escapeHtml(KRAVN_DECK_USERNAME)}</div>
            </div>
          </div>
        `;
      }

      function render() {
        stage.innerHTML = '';

        for (let i = VISIBLE_STACK - 1; i >= 0; i--) {
          const postIndex = (current + i) % total;
          const post = KRAVN_DECK_POSTS[postIndex];

          const card = document.createElement('div');
          card.className = 'kravn-deck-card';
          card.innerHTML = cardHTML(post);
          card.dataset.postId = post.id;

          const scale = 1 - i * 0.045;
          const yOffset = i * 12;
          card.style.transform = `translateY(${yOffset}px) scale(${scale})`;
          card.style.zIndex = String(VISIBLE_STACK - i);
          card.style.opacity = i === VISIBLE_STACK - 1 && VISIBLE_STACK > 1 ? '0.6' : '1';

          if (i === 0) {
            attachDrag(card);
          } else {
            card.style.cursor = 'default';
          }

          stage.appendChild(card);
        }

        counter.textContent = `${current + 1} / ${total}`;
      }

      function advance(direction) {
        current = (current + direction + total) % total;
        render();
      }

      function attachDrag(card) {
        card.addEventListener('pointerdown', onPointerDown);

        function onPointerDown(e) {
          if (isAnimatingOut) return;
          dragging = true;
          startX = e.clientX;
          deltaX = 0;
          card.classList.add('dragging');
          card.setPointerCapture(e.pointerId);

          card.addEventListener('pointermove', onPointerMove);
          card.addEventListener('pointerup', onPointerUp);
          card.addEventListener('pointercancel', onPointerUp);
        }

        function onPointerMove(e) {
          if (!dragging) return;
          deltaX = e.clientX - startX;
          const rotate = deltaX * 0.06;
          card.style.transform = `translateX(${deltaX}px) rotate(${rotate}deg)`;
          card.style.opacity = String(Math.max(1 - Math.abs(deltaX) / 400, 0.4));
        }

        function onPointerUp(e) {
          if (!dragging) return;
          dragging = false;
          card.classList.remove('dragging');
          card.removeEventListener('pointermove', onPointerMove);
          card.removeEventListener('pointerup', onPointerUp);
          card.removeEventListener('pointercancel', onPointerUp);

          const threshold = 90;

          if (Math.abs(deltaX) > threshold && !isAnimatingOut) {
            isAnimatingOut = true;
            const flyDirection = deltaX > 0 ? 1 : -1;
            card.style.transition = 'transform 0.35s ease, opacity 0.35s ease';
            card.style.transform = `translateX(${flyDirection * 500}px) rotate(${flyDirection * 30}deg)`;
            card.style.opacity = '0';

            setTimeout(() => {
              isAnimatingOut = false;
              advance(1); // always move forward in deck order, looping at the end
            }, 220);
          } else {
            // snap back
            card.style.transition = 'transform 0.3s cubic-bezier(0.22,1,0.36,1), opacity 0.3s ease';
            card.style.transform = 'translateY(0px) scale(1)';
            card.style.opacity = '1';
          }
        }
      }

      prevBtn.addEventListener('click', () => { if (!isAnimatingOut) advance(-1); });
      nextBtn.addEventListener('click', () => { if (!isAnimatingOut) advance(1); });

      render();
    })();
  </script>

</body>

</html>
