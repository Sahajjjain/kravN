<!DOCTYPE html>
<html lang="en" data-theme="dark">

<head>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>
    <%= post.title %> - KravN
  </title>

  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/theme.js"></script>


  <style>

    /* =========================================================
       KRAVN THEME — theme-aware: purple in dark mode, gold in
       light mode, matching the feed page exactly.
       ========================================================= */

    :root {
      --kravn-primary: #8b5cf6;
      --kravn-primary-rgb: 139, 92, 246;
      --kravn-primary-dark: #6d28d9;
      --kravn-primary-darker: #4c1d95;
      --kravn-primary-light: #c4b5fd;
      --kravn-heart-red: #ef4444;
    }

    html[data-theme="light"] {
      --kravn-primary: #d4a017;
      --kravn-primary-rgb: 212, 160, 23;
      --kravn-primary-dark: #a9790a;
      --kravn-primary-darker: #7a5807;
      --kravn-primary-light: #f0cf6f;
      --kravn-heart-red: #e0703a;
    }

    /* kept for the canvas export, which can't read CSS vars directly */
    .kravn-primary-glow { box-shadow: 0 8px 22px rgba(var(--kravn-primary-rgb), 0.35); }


    /* =========================================================
       BACKDROP — slightly larger poster
       ========================================================= */

    .detail-backdrop::before {
      background-size: 112% auto;
      background-position: center 22%;
    }


    /* =========================================================
       POST TEXT — premium typography
       ========================================================= */

    .detail-content {
      font-size: 0.95rem;
      line-height: 1.7;
      letter-spacing: 0.1px;
      color: rgba(255, 255, 255, 0.88);
      position: relative;
      padding-left: 1.1rem;
      border-left: 2px solid rgba(var(--kravn-primary-rgb), 0.35);
    }


    /* =========================================================
       ACTION ROW — LIKE / DELETE
       ========================================================= */

    .kravn-post-actions-row {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      flex-wrap: wrap;
      margin: 1.25rem 0 0.5rem;
    }

    .kravn-pill-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.6rem 1.25rem;
      border-radius: 999px;
      font-size: 0.88rem;
      font-weight: 700;
      cursor: pointer;
      border: 1px solid rgba(var(--kravn-primary-rgb), 0.35);
      background: rgba(var(--kravn-primary-rgb), 0.06);
      color: var(--kravn-primary-light);
      text-decoration: none;
      transition: border-color 0.18s ease, background 0.18s ease, transform 0.12s ease, box-shadow 0.18s ease;
    }

    .kravn-pill-btn .kravn-heart-icon {
      width: 16px;
      height: 16px;
      display: inline-block;
      transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .kravn-pill-btn:hover {
      border-color: rgba(var(--kravn-primary-rgb), 0.7);
      background: rgba(var(--kravn-primary-rgb), 0.14);
      box-shadow: 0 6px 20px rgba(var(--kravn-primary-rgb), 0.18);
      transform: translateY(-1px);
    }

    .kravn-pill-btn:hover .kravn-heart-icon {
      transform: scale(1.12);
    }

    .kravn-pill-btn.is-liked {
      background: linear-gradient(135deg, var(--kravn-primary), var(--kravn-primary-dark));
      border-color: transparent;
      color: #fff;
      box-shadow: 0 8px 22px rgba(var(--kravn-primary-rgb), 0.35);
    }

    .kravn-pill-btn.is-liked .kravn-heart-icon {
      transform: scale(1.08);
    }

    .kravn-pill-btn.danger {
      border-color: rgba(239, 68, 68, 0.3);
      background: rgba(239, 68, 68, 0.05);
      color: var(--danger);
    }

    .kravn-pill-btn.danger:hover {
      border-color: rgba(239, 68, 68, 0.6);
      background: rgba(239, 68, 68, 0.12);
      box-shadow: 0 6px 20px rgba(239, 68, 68, 0.15);
    }

    .kravn-post-actions-row form {
      margin: 0;
    }


    /* =========================================================
       SHARE — SUBTLE, CARD-FOCUSED
       ========================================================= */

    .kravn-share-section {
      margin: 1.5rem 0 2rem;
      display: flex;
      justify-content: center;
    }

    .kravn-share-heading {
      text-align: center;
      margin: 0 0 1.1rem;
    }

    .kravn-share-heading .kravn-share-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--kravn-primary-light);
    }

    .kravn-share-heading .kravn-share-eyebrow::before,
    .kravn-share-heading .kravn-share-eyebrow::after {
      content: '';
      width: 22px;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(var(--kravn-primary-rgb), 0.7));
    }

    .kravn-share-heading .kravn-share-eyebrow::after {
      background: linear-gradient(90deg, rgba(var(--kravn-primary-rgb), 0.7), transparent);
    }

    .kravn-share-heading h3 {
      margin: 0.35rem 0 0;
      font-size: 1.35rem;
      font-weight: 800;
      letter-spacing: -0.4px;
      background: linear-gradient(135deg, #fff 30%, var(--kravn-primary-light) 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      text-shadow: 0 0 30px rgba(var(--kravn-primary-rgb), 0.25);
    }

    .kravn-card-column {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
    }

    /* Share / download icon buttons — same treatment as the Kravn Cards
       tool buttons on the feed page. */
    .kravn-share-row {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .kravn-card-tool-btn {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: rgba(var(--kravn-primary-rgb), 0.1);
      border: 1px solid rgba(var(--kravn-primary-rgb), 0.35);
      backdrop-filter: blur(6px);
      color: var(--kravn-primary-light);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.95rem;
      cursor: pointer;
      transition: all 0.18s ease;
    }

    .kravn-card-tool-btn:hover {
      border-color: var(--kravn-primary);
      background: rgba(var(--kravn-primary-rgb), 0.22);
      color: #fff;
      transform: translateY(-1px);
    }

    .kravn-card-tool-btn:disabled {
      opacity: 0.55;
      cursor: wait;
      transform: none;
    }

    /* Toast — same shape/behavior as the feed page's Kravn Cards toast */
    .kravn-toast {
      position: fixed;
      bottom: 28px;
      left: 50%;
      transform: translateX(-50%) translateY(20px);
      background: #151515;
      border: 1px solid rgba(var(--kravn-primary-rgb), 0.35);
      color: #eee;
      font-family: var(--font-mono, monospace);
      font-size: 0.75rem;
      padding: 0.6rem 1rem;
      border-radius: 6px;
      opacity: 0;
      z-index: 1001;
      transition: all 0.25s ease;
      pointer-events: none;
      max-width: 88vw;
      text-align: center;
    }

    .kravn-toast.show {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }


    /* =========================================================
       POST CARD — printable-poster quality
       The poster sits INSET inside a matte frame (like a real
       printed card) instead of bleeding edge-to-edge. This also
       hides softness at the very border of the source image.
       ========================================================= */

    .kravn-card-wrapper {
      display: flex;
      justify-content: center;
    }

    .kravn-post-card {
      position: relative;
      width: 340px;
      aspect-ratio: 9 / 16;
      overflow: hidden;
      border-radius: 22px;
      background: #050507;
      border: 1px solid rgba(var(--kravn-primary-rgb), 0.35);
      box-shadow:
        0 30px 80px rgba(0, 0, 0, 0.55),
        0 0 0 1px rgba(var(--kravn-primary-rgb), 0.06) inset;
      isolation: isolate;
      padding: 10px;
      box-sizing: border-box;
    }

    .kravn-post-card-frame {
      position: absolute;
      inset: 10px;
      border-radius: 14px;
      overflow: hidden;
      isolation: isolate;
    }

    .kravn-post-card-bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 22%;
      z-index: -3;
    }

    .kravn-post-card-fallback {
      position: absolute;
      inset: 0;
      z-index: -3;
      background:
        radial-gradient(circle at 75% 25%, rgba(var(--kravn-primary-rgb), 0.3), transparent 40%),
        linear-gradient(145deg, #1a1425, #0a0810 60%, #020103);
    }

    .kravn-post-card-overlay {
      position: absolute;
      inset: 0;
      z-index: -2;
      background: linear-gradient(
        to bottom,
        rgba(3, 2, 8, 0.72) 0%,
        rgba(3, 2, 8, 0.12) 20%,
        rgba(3, 2, 8, 0.04) 36%,
        rgba(3, 2, 8, 0.28) 52%,
        rgba(3, 2, 8, 0.86) 76%,
        rgba(0, 0, 0, 0.97) 100%
      );
    }

    .kravn-post-card-vignette {
      position: absolute;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      background: radial-gradient(circle at center, transparent 35%, rgba(0, 0, 0, 0.35) 100%);
    }

    .kravn-post-card-content {
      position: absolute;
      inset: 0;
      box-sizing: border-box;
      padding: 24px 24px 26px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      z-index: 1;
    }

    .kravn-card-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 0.75rem;
    }

    .kravn-logo {
      font-size: 21px;
      line-height: 1;
      font-weight: 800;
      letter-spacing: -0.8px;
      color: #fff;
      text-shadow: 0 4px 16px rgba(0, 0, 0, 0.7);
    }

    .kravn-logo-dot {
      color: var(--kravn-primary-light);
    }

    .kravn-tagline {
      margin-top: 5px;
      color: rgba(255, 255, 255, 0.48);
      font-size: 7px;
      letter-spacing: 1.4px;
      text-transform: uppercase;
    }

    .kravn-card-badge {
      flex-shrink: 0;
      padding: 6px 10px;
      border-radius: 999px;
      border: 1px solid rgba(var(--kravn-primary-rgb), 0.6);
      background: rgba(5, 5, 9, 0.55);
      color: var(--kravn-primary-light);
      font-size: 6.5px;
      font-weight: 700;
      letter-spacing: 0.9px;
      white-space: nowrap;
    }

    .kravn-card-bottom {
      width: 100%;
    }

    .kravn-card-movie {
      margin-bottom: 10px;
      color: var(--kravn-primary-light);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.6px;
      text-transform: uppercase;
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.65);
    }

    .kravn-card-title {
      margin: 0 0 12px;
      color: #fff;
      font-size: clamp(1.35rem, 4.6vw, 2rem);
      line-height: 1.15;
      letter-spacing: -1px;
      font-weight: 800;
      text-shadow: 0 3px 14px rgba(0, 0, 0, 0.75);
      overflow-wrap: anywhere;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .kravn-card-author {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 14px;
      color: rgba(255, 255, 255, 0.68);
      font-size: 12px;
    }

    .kravn-card-author-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--kravn-primary);
      box-shadow: 0 0 10px rgba(var(--kravn-primary-rgb), 0.65);
    }

    .kravn-card-url {
      color: rgba(255, 255, 255, 0.35);
      font-size: 9.5px;
      letter-spacing: 0.2px;
    }


    /* =========================================================
       MOBILE
       ========================================================= */

    @media (max-width: 640px) {

      .kravn-post-card {
        width: 280px;
        border-radius: 18px;
        padding: 8px;
      }

      .kravn-post-card-frame {
        inset: 8px;
        border-radius: 11px;
      }

      .kravn-post-card-content {
        padding: 18px 18px;
      }

    }


    /* =========================================================
       COMMENTS — clear, unmissable, premium finish
       ========================================================= */

    .kravn-comments-section {
      margin-top: 1rem;
    }

    .kravn-comments-header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: 0.25rem;
      padding-bottom: 0.6rem;
      border-bottom: 1px solid rgba(var(--kravn-primary-rgb), 0.16);
    }

    .kravn-comments-header h2 {
      font-size: 1.2rem;
      margin: 0;
      letter-spacing: -0.2px;
    }

    .kravn-comments-count {
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--kravn-primary-light);
      background: rgba(var(--kravn-primary-rgb), 0.08);
      border: 1px solid rgba(var(--kravn-primary-rgb), 0.25);
      padding: 0.2rem 0.65rem;
      border-radius: 999px;
    }

    .comment-form {
      margin: 1rem 0 2rem;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .comment-form textarea {
      border-radius: 14px;
      border: 1px solid rgba(var(--kravn-primary-rgb), 0.22);
      background: rgba(255, 255, 255, 0.02);
      padding: 0.85rem 1rem;
      resize: vertical;
      min-height: 90px;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .comment-form textarea:focus {
      outline: none;
      border-color: var(--kravn-primary);
      box-shadow: 0 0 0 3px rgba(var(--kravn-primary-rgb), 0.16);
    }

    .comment-form button {
      align-self: flex-end;
      padding: 0.6rem 1.4rem;
      border-radius: 999px;
      border: none;
      font-weight: 700;
      color: #fff;
      cursor: pointer;
      background: linear-gradient(135deg, var(--kravn-primary), var(--kravn-primary-dark));
      box-shadow: 0 6px 18px rgba(var(--kravn-primary-rgb), 0.35);
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .comment-form button:hover {
      transform: translateY(-1px);
      box-shadow: 0 8px 22px rgba(var(--kravn-primary-rgb), 0.45);
    }

    .kravn-comment-list {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }

    .comment {
      display: flex;
      gap: 0.85rem;
      padding: 1rem 1.1rem;
      border-radius: 16px;
      border: 1px solid rgba(var(--kravn-primary-rgb), 0.14);
      background: rgba(255, 255, 255, 0.02);
      transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
    }

    .comment:hover {
      border-color: rgba(var(--kravn-primary-rgb), 0.32);
      background: rgba(var(--kravn-primary-rgb), 0.045);
      transform: translateY(-1px);
    }

    .kravn-comment-avatar {
      flex-shrink: 0;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 0.9rem;
      color: #fff;
      background: linear-gradient(135deg, var(--kravn-primary), var(--kravn-primary-darker));
      box-shadow: 0 0 0 3px rgba(var(--kravn-primary-rgb), 0.1);
    }

    .kravn-comment-body {
      flex: 1;
      min-width: 0;
    }

    .kravn-comment-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .comment-author a {
      font-weight: 700;
      color: #fff;
      text-decoration: none;
    }

    .comment-author a:hover {
      color: var(--kravn-primary-light);
    }

    .kravn-comment-actions {
      display: flex;
      gap: 0.4rem;
      flex-shrink: 0;
    }

    .kravn-comment-action-link,
    .kravn-comment-action-btn {
      font-size: 0.75rem;
      font-weight: 600;
      padding: 0.25rem 0.6rem;
      border-radius: 999px;
      border: 1px solid transparent;
      background: transparent;
      cursor: pointer;
      text-decoration: none;
      transition: background 0.15s ease, border-color 0.15s ease;
    }

    .kravn-comment-action-link {
      color: var(--kravn-primary-light);
    }

    .kravn-comment-action-link:hover {
      background: rgba(var(--kravn-primary-rgb), 0.12);
      border-color: rgba(var(--kravn-primary-rgb), 0.3);
    }

    .kravn-comment-action-btn {
      color: var(--danger);
    }

    .kravn-comment-action-btn:hover {
      background: rgba(239, 68, 68, 0.1);
      border-color: rgba(239, 68, 68, 0.3);
    }

    .comment-text {
      margin: 0.4rem 0 0;
      line-height: 1.6;
      color: rgba(255, 255, 255, 0.85);
      word-break: break-word;
    }

    .kravn-no-comments {
      text-align: center;
      padding: 2rem 1rem;
      border-radius: 16px;
      border: 1px dashed rgba(var(--kravn-primary-rgb), 0.25);
      color: var(--text-muted);
    }

  </style>

</head>


<body>

  <%- include('partials/navbar', { currentPage: 'postDetail' }) %>


  <!-- MOVIE HEADER -->

  <div class="detail-backdrop">

    <% if (post.poster_url && post.poster_url !== 'N/A') { %>
      <style>
        .detail-backdrop::before { background-image: url('<%= post.poster_url %>'); }
      </style>
    <% } %>

    <div class="detail-backdrop-inner">
      <div class="detail-header">

        <% if (post.poster_url && post.poster_url !== 'N/A') { %>
          <img class="detail-poster" src="<%= post.poster_url %>" alt="<%= post.movie_name %>">
        <% } else { %>
          <div class="post-poster-placeholder" style="width:160px;height:240px;font-size:2.4rem;border-radius:var(--radius-lg);">🎬</div>
        <% } %>

        <div class="detail-title-block">

          <div class="post-eyebrow">
            <span><%= post.movie_name %></span>
            <% if (post.imdb_rating && post.imdb_rating !== 'N/A') { %>
              <span class="post-rating">· IMDb <%= post.imdb_rating %></span>
            <% } %>
          </div>

          <h1><%= post.title %></h1>

          <p class="post-meta">
            Posted by
            <a href="/users/<%= post.username %>"><%= post.username %></a>
            ·
            <%= new Date(post.created_at).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Kolkata' }) %>
          </p>

        </div>
      </div>
    </div>
  </div>


  <!-- MAIN CONTENT -->

  <div class="page">

    <p class="detail-content"><%= post.content %></p>


    <!-- LIKE + DELETE ROW (edit removed — route needs a fix on the server before it can come back) -->

    <div class="kravn-post-actions-row">

      <form action="/posts/<%= post.id %>/like" method="POST">
        <button class="kravn-pill-btn<%= typeof userHasLiked !== 'undefined' && userHasLiked ? ' is-liked' : '' %>" type="submit">
          <svg class="kravn-heart-icon" viewBox="0 0 24 24" fill="<%= typeof userHasLiked !== 'undefined' && userHasLiked ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2">
            <path d="M12 21s-6.5-4.35-9.5-8.5C.5 9 2 5 5.5 5c2 0 3.5 1.2 4.5 2.7C11 6.2 12.5 5 14.5 5 18 5 19.5 9 17.5 12.5 14.5 16.65 12 21 12 21z"/>
          </svg>
          Like (<%= likeCount %>)
        </button>
      </form>

      <% if (post.user_id === currentUserId) { %>
        <form action="/posts/<%= post.id %>/delete" method="POST" onsubmit="return confirm('Delete this discussion permanently?');">
          <button type="submit" class="kravn-pill-btn danger">Delete</button>
        </form>
      <% } %>

    </div>

    <% if (likeCount > 0) { %>
      <p class="post-meta" style="margin: 0.5rem 0 1.5rem;">
        <a href="/posts/<%= post.id %>/likes">
          ♥ <%= likeCount %> <%= likeCount === 1 ? 'person' : 'people' %> liked this
        </a>
      </p>
    <% } %>


    <!-- SHARE — subtle, sitting right under the card -->

    <div class="kravn-share-heading">
      <span class="kravn-share-eyebrow">✦ Collectible</span>
      <h3>Your Kravn Card</h3>
    </div>

    <section class="kravn-share-section">
      <div class="kravn-card-column">

        <div class="kravn-card-wrapper">
          <div id="kravn-post-card" class="kravn-post-card">

            <div class="kravn-post-card-frame">
              <% if (post.poster_url && post.poster_url !== 'N/A') { %>
                <img class="kravn-post-card-bg" src="<%= post.poster_url %>" alt="">
              <% } else { %>
                <div class="kravn-post-card-fallback"></div>
              <% } %>

              <div class="kravn-post-card-overlay"></div>
              <div class="kravn-post-card-vignette"></div>
            </div>

            <div class="kravn-post-card-content">

              <div class="kravn-card-header">
                <div>
                  <div class="kravn-logo">Krav<span class="kravn-logo-dot">N.</span></div>
                  <div class="kravn-tagline">Discuss. Discover. Connect.</div>
                </div>
                <div class="kravn-card-badge">Kravn Discussion</div>
              </div>

              <div class="kravn-card-bottom">
                <div class="kravn-card-movie"><%= post.movie_name %></div>
                <h2 class="kravn-card-title"><%= post.title %></h2>
                <div class="kravn-card-author">
                  <span class="kravn-card-author-dot"></span>
                  @<%= post.username %>
                </div>
                <div class="kravn-card-url">kravn.onrender.com/posts/<%= post.id %></div>
              </div>

            </div>
          </div>
        </div>

        <!-- Share row — same icon-button treatment as the Kravn Cards on the feed page -->
        <div class="kravn-share-row">
          <div class="kravn-card-tool-btn" id="download-card-btn" title="Download postcard">⬇</div>
          <div class="kravn-card-tool-btn" id="share-card-btn" title="Share">↗</div>
        </div>

      </div>
    </section>


    <div class="sprocket-divider">
      <div class="holes"><span></span><span></span><span></span></div>
    </div>


    <!-- COMMENTS -->

    <div class="kravn-comments-section">

      <div class="kravn-comments-header">
        <h2>Comments</h2>
        <span class="kravn-comments-count">
          <%= comments.length %> <%= comments.length === 1 ? 'comment' : 'comments' %>
        </span>
      </div>

      <form class="comment-form" action="/posts/<%= post.id %>/comments" method="POST">
        <textarea name="content" placeholder="Add a comment..." required></textarea>
        <button type="submit">Comment</button>
      </form>

      <% if (comments.length === 0) { %>
        <p class="kravn-no-comments">No comments yet. Be the first to say something.</p>
      <% } %>

      <div class="kravn-comment-list">
        <% comments.forEach(comment => { %>
          <div class="comment">
            <div class="kravn-comment-avatar"><%= comment.username.charAt(0).toUpperCase() %></div>

            <div class="kravn-comment-body">
              <div class="kravn-comment-top">
                <div class="comment-author">
                  <a href="/users/<%= comment.username %>"><%= comment.username %></a>
                </div>

                <% if (comment.user_id === currentUserId) { %>
                  <div class="kravn-comment-actions">
                    <a href="/comments/<%= comment.id %>/edit" class="kravn-comment-action-link">Edit</a>
                    <form action="/comments/<%= comment.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Delete this comment?');">
                      <button type="submit" class="kravn-comment-action-btn">Delete</button>
                    </form>
                  </div>
                <% } %>
              </div>

              <p class="comment-text"><%= comment.content %></p>
            </div>
          </div>
        <% }); %>
      </div>

    </div>

  </div>

  <div class="kravn-toast" id="kravn-toast"></div>


  <!-- SHARING JAVASCRIPT -->

  <script>

    const KRAVN_POST = {
      id: <%- JSON.stringify(post.id) %>,
      movieName: <%- JSON.stringify(post.movie_name || '') %>,
      title: <%- JSON.stringify(post.title || '') %>,
      username: <%- JSON.stringify(post.username || '') %>,
      posterUrl: <%- JSON.stringify(post.poster_url && post.poster_url !== 'N/A' ? post.poster_url : null) %>
    };

    const KRAVN_POST_URL = 'https://kravn.onrender.com/posts/' + KRAVN_POST.id;

    const SCALE = 3;
    const CARD_WIDTH = Math.round(1080 * SCALE);
    const CARD_HEIGHT = Math.round(1920 * SCALE);
    const S = n => n * SCALE;

    function themeColor(name, fallback) {
      const v = getComputedStyle(document.documentElement).getPropertyValue(name);
      return v && v.trim() ? v.trim() : fallback;
    }

    function currentThemeColors() {
      return {
        light: themeColor('--kravn-primary-light', '#c4b5fd'),
        rgb: themeColor('--kravn-primary-rgb', '139, 92, 246')
      };
    }

    function purpleRgba(alpha) {
      const { rgb } = currentThemeColors();
      return 'rgba(' + rgb + ', ' + alpha + ')';
    }

    function cleanCardText(value) {
      return String(value || '').replace(/<[^>]*>/g, '').replace(/[\r\n\t]+/g, ' ').replace(/\s+/g, ' ').trim();
    }

    // Many poster URLs (e.g. TMDB) are served at multiple resolutions via a
    // "/w<number>/" size segment in the path. Force a larger one for the
    // canvas render so a 1080x1920@3x card isn't upscaling a tiny source
    // image — this is the main fix for the "blurry, not 4k" postcard.
    function getHiResPosterUrl(url) {
      if (!url) return url;
      return url.replace(/\/t\/p\/w\d{2,4}\//, '/t/p/w1280/');
    }

    function loadCardImage(url) {
      return new Promise((resolve, reject) => {
        if (!url) { reject(new Error('No image')); return; }
        const image = new Image();
        image.crossOrigin = 'anonymous';
        image.onload = () => resolve(image);
        image.onerror = () => reject(new Error('Image failed to load'));
        image.src = url;
      });
    }

    function roundedRect(ctx, x, y, width, height, radius) {
      ctx.beginPath();
      ctx.moveTo(x + radius, y);
      ctx.arcTo(x + width, y, x + width, y + height, radius);
      ctx.arcTo(x + width, y + height, x, y + height, radius);
      ctx.arcTo(x, y + height, x, y, radius);
      ctx.arcTo(x, y, x + width, y, radius);
      ctx.closePath();
    }

    function drawFallback(ctx) {
      const gradient = ctx.createLinearGradient(0, 0, CARD_WIDTH, CARD_HEIGHT);
      gradient.addColorStop(0, '#1a1425');
      gradient.addColorStop(0.55, '#0a0810');
      gradient.addColorStop(1, '#020103');
      ctx.fillStyle = gradient;
      ctx.fillRect(0, 0, CARD_WIDTH, CARD_HEIGHT);

      const glow = ctx.createRadialGradient(S(800), S(500), 0, S(800), S(500), S(700));
      glow.addColorStop(0, purpleRgba(0.28));
      glow.addColorStop(1, purpleRgba(0));
      ctx.fillStyle = glow;
      ctx.fillRect(0, 0, CARD_WIDTH, CARD_HEIGHT);
    }

    // Cover-fit poster fill (drawn full-canvas; the caller clips it to the
    // inset matte frame so the effective visible poster is slightly smaller
    // than the whole card — this reduces the upscale factor and reads more
    // like a printed, framed poster instead of an edge-to-edge stretch).
    function drawPoster(ctx, image) {
      const imageRatio = image.width / image.height;
      const canvasRatio = CARD_WIDTH / CARD_HEIGHT;
      let width, height, x, y;

      if (imageRatio > canvasRatio) {
        height = CARD_HEIGHT;
        width = height * imageRatio;
        x = (CARD_WIDTH - width) / 2;
        y = 0;
      } else {
        width = CARD_WIDTH;
        height = width / imageRatio;
        x = 0;
        // bias slightly upward, matching object-position: center 22% on the CSS preview
        y = -(height - CARD_HEIGHT) * 0.22;
      }

      ctx.drawImage(image, x, y, width, height);
    }

    function drawCardFades(ctx) {
      const topFade = ctx.createLinearGradient(0, 0, 0, CARD_HEIGHT * 0.24);
      topFade.addColorStop(0, 'rgba(3,2,8,0.68)');
      topFade.addColorStop(1, 'rgba(3,2,8,0)');
      ctx.fillStyle = topFade;
      ctx.fillRect(0, 0, CARD_WIDTH, CARD_HEIGHT * 0.24);

      const bottomStart = CARD_HEIGHT * 0.5;
      const bottomFade = ctx.createLinearGradient(0, bottomStart, 0, CARD_HEIGHT);
      bottomFade.addColorStop(0, 'rgba(3,2,8,0)');
      bottomFade.addColorStop(0.35, 'rgba(3,2,8,0.55)');
      bottomFade.addColorStop(1, 'rgba(3,2,8,0.97)');
      ctx.fillStyle = bottomFade;
      ctx.fillRect(0, bottomStart, CARD_WIDTH, CARD_HEIGHT - bottomStart);

      const vignette = ctx.createRadialGradient(
        CARD_WIDTH / 2, CARD_HEIGHT / 2, CARD_HEIGHT * 0.35,
        CARD_WIDTH / 2, CARD_HEIGHT / 2, CARD_HEIGHT * 0.75
      );
      vignette.addColorStop(0, 'rgba(0,0,0,0)');
      vignette.addColorStop(1, 'rgba(0,0,0,0.32)');
      ctx.fillStyle = vignette;
      ctx.fillRect(0, 0, CARD_WIDTH, CARD_HEIGHT);
    }

    function wrapCardText(ctx, text, maxWidth, maxLines) {
      const words = text.split(' ');
      const lines = [];
      let current = '';

      for (let i = 0; i < words.length; i++) {
        const test = current ? current + ' ' + words[i] : words[i];
        if (ctx.measureText(test).width > maxWidth && current) {
          lines.push(current);
          current = words[i];
          if (lines.length === maxLines) {
            let last = lines[lines.length - 1];
            while (ctx.measureText(last + '…').width > maxWidth && last.length > 0) {
              last = last.slice(0, -1).trim();
            }
            lines[lines.length - 1] = last + '…';
            return lines;
          }
        } else {
          current = test;
        }
      }
      if (current) lines.push(current);
      return lines;
    }

    async function createPostCard() {
      const canvas = document.createElement('canvas');
      canvas.width = CARD_WIDTH;
      canvas.height = CARD_HEIGHT;

      const ctx = canvas.getContext('2d');
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = 'high';

      const { light: PURPLE_LIGHT } = currentThemeColors();

      // Matte frame — background color shows as a thin border, poster is
      // drawn clipped inside a rounded inset rect (mirrors the CSS preview).
      ctx.fillStyle = '#050507';
      ctx.fillRect(0, 0, CARD_WIDTH, CARD_HEIGHT);

      const FRAME = S(10);
      ctx.save();
      roundedRect(ctx, FRAME, FRAME, CARD_WIDTH - FRAME * 2, CARD_HEIGHT - FRAME * 2, S(14));
      ctx.clip();

      try {
        const image = await loadCardImage(getHiResPosterUrl(KRAVN_POST.posterUrl));
        drawPoster(ctx, image);
      } catch (error) {
        console.warn('Using fallback background', error);
        drawFallback(ctx);
      }

      drawCardFades(ctx);
      ctx.restore();

      // Themed border, matching the on-page card's CSS border (thicker + rounder for the export)
      ctx.save();
      ctx.strokeStyle = purpleRgba(0.55);
      ctx.lineWidth = S(3);
      ctx.lineJoin = 'round';
      roundedRect(ctx, S(1.5), S(1.5), CARD_WIDTH - S(3), CARD_HEIGHT - S(3), S(26));
      ctx.stroke();
      ctx.restore();

      const left = S(56);
      const contentWidth = CARD_WIDTH - S(112);

      // ---- Header: logo + tagline, badge (top-right) ----
      ctx.save();
      ctx.textAlign = 'left';
      ctx.textBaseline = 'top';
      ctx.font = `800 ${S(54)}px Arial, sans-serif`;
      ctx.fillStyle = '#ffffff';
      ctx.shadowColor = 'rgba(0,0,0,0.7)';
      ctx.shadowBlur = S(8);
      ctx.fillText('Krav', left, S(48));
      const logoWidth = ctx.measureText('Krav').width;
      ctx.fillStyle = PURPLE_LIGHT;
      ctx.fillText('N.', left + logoWidth, S(48));
      ctx.restore();

      ctx.save();
      ctx.font = `600 ${S(13)}px Arial, sans-serif`;
      ctx.fillStyle = 'rgba(255,255,255,0.48)';
      ctx.textAlign = 'left';
      ctx.textBaseline = 'top';
      ctx.fillText('DISCUSS. DISCOVER. CONNECT.', left, S(96));
      ctx.restore();

      const badgeText = 'KRAVN DISCUSSION';
      ctx.save();
      ctx.font = `700 ${S(17)}px Arial, sans-serif`;
      const badgeTextWidth = ctx.measureText(badgeText).width;
      const badgePaddingX = S(22);
      const badgeHeight = S(50);
      const badgeWidth = badgeTextWidth + badgePaddingX * 2;
      const badgeX = CARD_WIDTH - left - badgeWidth;
      const badgeY = S(38);

      roundedRect(ctx, badgeX, badgeY, badgeWidth, badgeHeight, badgeHeight / 2);
      ctx.fillStyle = 'rgba(5,5,9,0.55)';
      ctx.fill();
      ctx.strokeStyle = purpleRgba(0.6);
      ctx.lineWidth = S(1.5);
      ctx.stroke();

      ctx.fillStyle = PURPLE_LIGHT;
      ctx.textAlign = 'left';
      ctx.textBaseline = 'middle';
      ctx.fillText(badgeText, badgeX + badgePaddingX, badgeY + badgeHeight / 2 + S(1));
      ctx.restore();

      // ---- Footer text block, reserved so a 3-line title can never overlap ----
      const panelBottomPadding = S(56);
      const movieBlockHeight = S(58);   // was S(50) — extra room fixes the movie-name/title overlap
      const movieTitleGap = S(28);       // NEW — explicit breathing room before the title starts
      const titleLineHeight = S(76);
      const maxTitleLines = 3;
      const usernameGap = S(28);
      const usernameBlockHeight = S(42);
      const urlGap = S(8);
      const urlBlockHeight = S(30);

      ctx.font = `800 ${S(66)}px Arial, sans-serif`;
      const titleLines = wrapCardText(ctx, cleanCardText(KRAVN_POST.title), contentWidth, maxTitleLines);

      const totalBlockHeight =
        movieBlockHeight +
        movieTitleGap +
        titleLines.length * titleLineHeight +
        usernameGap +
        usernameBlockHeight +
        urlGap +
        urlBlockHeight;

      let y = CARD_HEIGHT - panelBottomPadding - totalBlockHeight;

      ctx.save();
      ctx.font = `700 ${S(30)}px Arial, sans-serif`;
      ctx.fillStyle = PURPLE_LIGHT;
      ctx.textAlign = 'left';
      ctx.textBaseline = 'top';
      ctx.fillText(cleanCardText(KRAVN_POST.movieName).toUpperCase(), left, y, contentWidth);
      ctx.restore();

      y += movieBlockHeight + movieTitleGap;

      ctx.save();
      ctx.font = `800 ${S(66)}px Arial, sans-serif`;
      ctx.fillStyle = '#ffffff';
      ctx.shadowColor = 'rgba(0,0,0,0.8)';
      ctx.shadowBlur = S(9);
      titleLines.forEach((line, index) => {
        ctx.fillText(line, left, y + index * titleLineHeight);
      });
      ctx.restore();

      y += titleLines.length * titleLineHeight + usernameGap;

      ctx.save();
      ctx.font = `500 ${S(25)}px Arial, sans-serif`;
      ctx.fillStyle = 'rgba(255,255,255,0.68)';
      ctx.fillText('@' + cleanCardText(KRAVN_POST.username), left, y);
      ctx.restore();

      y += usernameBlockHeight + urlGap;

      ctx.save();
      ctx.font = `500 ${S(18)}px Arial, sans-serif`;
      ctx.fillStyle = 'rgba(255,255,255,0.35)';
      ctx.fillText('kravn.onrender.com/posts/' + KRAVN_POST.id, left, y);
      ctx.restore();

      return canvas;
    }

    function canvasToBlob(canvas) {
      return new Promise(resolve => { canvas.toBlob(blob => resolve(blob), 'image/png'); });
    }

    const kravnToastEl = document.getElementById('kravn-toast');
    function toast(msg) {
      if (!kravnToastEl) return;
      kravnToastEl.textContent = msg;
      kravnToastEl.classList.add('show');
      clearTimeout(kravnToastEl._t);
      kravnToastEl._t = setTimeout(() => kravnToastEl.classList.remove('show'), 2400);
    }

    async function downloadPostCard() {
      const button = document.getElementById('download-card-btn');
      button.style.pointerEvents = 'none';
      button.style.opacity = '0.55';

      try {
        await (document.fonts && document.fonts.ready);
        const canvas = await createPostCard();
        const blob = await canvasToBlob(canvas);
        if (!blob) throw new Error('Could not create PNG');

        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = 'kravn-post-' + KRAVN_POST.id + '.png';
        document.body.appendChild(link);
        link.click();
        link.remove();
        URL.revokeObjectURL(url);

        toast('Postcard downloaded');
      } catch (error) {
        console.error('Postcard download failed:', error);
        toast('Could not create the postcard');
      } finally {
        button.style.pointerEvents = '';
        button.style.opacity = '';
      }
    }

    // Same share behavior as the Kravn Cards on the feed page: try the
    // native share sheet with the rendered card image attached, otherwise
    // fall back to downloading the image and copying the link.
    async function sharePostCard() {
      const button = document.getElementById('share-card-btn');
      button.style.pointerEvents = 'none';
      button.style.opacity = '0.55';

      const shareText = KRAVN_POST.title + ' — on Kravn';

      try {
        await (document.fonts && document.fonts.ready);
        const canvas = await createPostCard();
        const blob = await canvasToBlob(canvas);
        if (!blob) throw new Error('render failed');
        const file = new File([blob], 'kravn-' + KRAVN_POST.id + '.png', { type: 'image/png' });

        if (navigator.canShare && navigator.canShare({ files: [file] })) {
          await navigator.share({ files: [file], title: KRAVN_POST.title, text: shareText, url: KRAVN_POST_URL });
          return;
        }

        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = 'kravn-' + KRAVN_POST.id + '.png';
        link.click();
        URL.revokeObjectURL(url);
        if (navigator.clipboard) await navigator.clipboard.writeText(KRAVN_POST_URL);
        toast('Card image saved · link copied');
      } catch (error) {
        if (error && error.name === 'AbortError') return;
        console.error('Share failed:', error);
        if (navigator.share) {
          navigator.share({ title: KRAVN_POST.title, text: shareText, url: KRAVN_POST_URL }).catch(() => {});
        } else if (navigator.clipboard) {
          navigator.clipboard.writeText(KRAVN_POST_URL).then(() => toast('Link copied')).catch(() => toast(KRAVN_POST_URL));
        } else {
          toast(KRAVN_POST_URL);
        }
      } finally {
        button.style.pointerEvents = '';
        button.style.opacity = '';
      }
    }

    document.getElementById('download-card-btn').addEventListener('click', downloadPostCard);
    document.getElementById('share-card-btn').addEventListener('click', sharePostCard);

  </script>

</body>

</html>
