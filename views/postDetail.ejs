<!DOCTYPE html>
<html lang="en" data-theme="dark">

<head>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>
    <%= post.title %> - KravN
  </title>

  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/theme.js"></script>


  <style>

    /* =========================================================
       KRAVN THEME — theme-aware: purple in dark mode, gold in
       light mode, matching the feed page exactly.
       ========================================================= */

    :root {
      --kravn-primary: #8b5cf6;
      --kravn-primary-rgb: 139, 92, 246;
      --kravn-primary-dark: #6d28d9;
      --kravn-primary-darker: #4c1d95;
      --kravn-primary-light: #c4b5fd;
      --kravn-heart-red: #ef4444;
      --kravn-heart-red-rgb: 239, 68, 68;
    }

    html[data-theme="light"] {
      --kravn-primary: #d4a017;
      --kravn-primary-rgb: 212, 160, 23;
      --kravn-primary-dark: #a9790a;
      --kravn-primary-darker: #7a5807;
      --kravn-primary-light: #f0cf6f;
      --kravn-heart-red: #e0703a;
      --kravn-heart-red-rgb: 224, 112, 58;
    }

    * { box-sizing: border-box; }


    /* =========================================================
       PAGE SHELL
       ========================================================= */

    .kravn-detail-shell {
      max-width: 1180px;
      margin: 0 auto;
      padding: 0.5rem 1.25rem 4rem;
    }

    .kravn-detail-grid {
      display: grid;
      grid-template-columns: 1fr;
      grid-template-areas:
        "top"
        "card"
        "comments";
      gap: 1.75rem;
    }

    .kd-top      { grid-area: top; }
    .kd-card     { grid-area: card; }
    .kd-comments { grid-area: comments; }

    @media (min-width: 980px) {
      .kravn-detail-grid {
        grid-template-columns: minmax(0, 1fr) 300px;
        grid-template-areas:
          "top      card"
          "comments card";
        column-gap: 2.75rem;
        row-gap: 2.25rem;
        align-items: start;
      }
      .kd-card { position: sticky; top: 1.5rem; }
    }


    /* =========================================================
       BACKDROP / HEADER
       ========================================================= */

    .detail-backdrop::before {
      background-size: 112% auto;
      background-position: center 22%;
    }

    /* Taller backdrop on larger screens only — mobile keeps the
       original proportions. */
    @media (min-width: 641px) {
      .detail-backdrop { min-height: 420px; }
      .detail-backdrop::before { background-size: 100% auto; }
    }

    .kravn-movie-eyebrow {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      flex-wrap: wrap;
      font-size: 0.82rem;
      color: rgba(255,255,255,0.55);
    }

    .kravn-movie-eyebrow .movie-name {
      color: var(--kravn-primary-light);
      font-weight: 700;
    }

    .kravn-movie-eyebrow .imdb-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      font-size: 0.7rem;
      font-weight: 800;
      color: #0a0a0a;
      background: #f5c518;
      padding: 0.15rem 0.5rem;
      border-radius: 4px;
      letter-spacing: 0.02em;
    }

    .kravn-detail-title {
      margin: 0.4rem 0 0.65rem;
      font-size: clamp(1.6rem, 3.6vw, 2.5rem);
      font-weight: 800;
      letter-spacing: -0.7px;
      line-height: 1.14;
    }

    /* Genre — directly under the title, quiet and structural */
    .kravn-genre-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      margin: 0 0 0.85rem;
    }

    .kravn-genre-tag {
      display: inline-flex;
      align-items: center;
      font-family: var(--font-mono, monospace);
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 0.32rem 0.7rem;
      border-radius: 20px;
      border: 1px solid rgba(var(--kravn-primary-rgb), 0.3);
      background: rgba(var(--kravn-primary-rgb), 0.06);
      color: var(--kravn-primary-light);
      text-decoration: none;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .kravn-genre-tag:hover {
      border-color: rgba(var(--kravn-primary-rgb), 0.6);
      background: rgba(var(--kravn-primary-rgb), 0.14);
      color: #fff;
      transform: translateY(-1px);
    }

    /* Byline — small, quiet, single line, no avatar circle */
    .kravn-byline {
      font-size: 0.78rem;
      line-height: 1.4;
      color: rgba(255,255,255,0.4);
      margin: 0;
    }

    /* Kill the default bottom spacing the shared header/backdrop
       partial adds after the byline, so the like row sits right
       under the poster with no dead strip in between. The real
       offender is .detail-backdrop's own bottom padding
       (var(--space-8) = 32px) defined in style.css — override it
       here since this page needs a tighter finish than the rest
       of the site. */
    .detail-backdrop { padding-bottom: 4px !important; }
    .detail-title-block,
    .detail-header { margin-bottom: 0 !important; padding-bottom: 0 !important; }
    .detail-backdrop-inner { padding-bottom: 0 !important; }

    .kravn-byline .byline-label {
      text-transform: uppercase;
      letter-spacing: 0.04em;
      font-size: 0.68rem;
      color: rgba(255,255,255,0.32);
    }

    .kravn-byline a {
      color: rgba(255,255,255,0.68);
      font-weight: 600;
      text-decoration: none;
    }
    .kravn-byline a:hover { color: var(--kravn-primary-light); }

    .kravn-byline-dot {
      color: rgba(255,255,255,0.22);
      margin: 0 0.3rem;
    }


    /* =========================================================
       LIKE ROW — sits directly above the discussion body, tight
       to the title block, no boxy border/padding around it.
       ========================================================= */

    .kravn-like-row {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      margin: 0 0 0.75rem;
    }

    .kravn-like-row form { margin: 0; line-height: 0; }

    .kravn-like-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: none;
      background: none;
      cursor: pointer;
      padding: 0.2rem;
      color: rgba(255,255,255,0.55);
      transition: transform 0.12s ease;
    }
    .kravn-like-btn:hover { transform: scale(1.08); }
    .kravn-like-btn:active { transform: scale(0.9); }

    .kravn-like-btn .kravn-heart-icon {
      width: 24px;
      height: 24px;
      display: block;
      stroke: currentColor;
      fill: none;
      transition: transform 0.32s cubic-bezier(0.34, 1.56, 0.64, 1), stroke 0.18s ease, fill 0.18s ease;
    }

    /* Only the heart itself turns red + fills when liked — nothing
       else in the row changes color. */
    .kravn-like-btn.is-liked .kravn-heart-icon {
      stroke: var(--kravn-heart-red);
      fill: var(--kravn-heart-red);
      transform: scale(1.08);
      filter: drop-shadow(0 0 8px rgba(var(--kravn-heart-red-rgb), 0.5));
    }

    .kravn-likes-text {
      font-size: 0.85rem;
      color: rgba(255,255,255,0.45);
      text-decoration: none;
    }
    a.kravn-likes-text:hover { color: var(--kravn-primary-light); }
    .kravn-likes-text strong {
      color: rgba(255,255,255,0.85);
      font-weight: 700;
    }
    a.kravn-likes-text:hover strong { color: inherit; }


    /* =========================================================
       POST BODY
       ========================================================= */

    .detail-content {
      font-size: 1.02rem;
      line-height: 1.75;
      letter-spacing: 0.1px;
      color: rgba(255, 255, 255, 0.88);
      padding-left: 1.1rem;
      border-left: 2px solid rgba(var(--kravn-primary-rgb), 0.32);
      margin: 0 0 1.1rem;
    }


    /* =========================================================
       DELETE POST — a single quiet red icon, right-aligned under
       the post body, always visible, confirms before deleting.
       ========================================================= */

    .kravn-post-footer-row {
      display: flex;
      justify-content: flex-end;
      padding-top: 0.6rem;
      margin-bottom: 0.5rem;
      border-top: 1px solid rgba(255,255,255,0.06);
    }
    .kravn-post-footer-row form { margin: 0; }

    .kravn-delete-post-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      border: 1px solid rgba(var(--kravn-heart-red-rgb), 0.3);
      background: rgba(var(--kravn-heart-red-rgb), 0.07);
      color: var(--kravn-heart-red);
      font-size: 0.78rem;
      font-weight: 700;
      padding: 0.45rem 0.85rem;
      border-radius: 999px;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .kravn-delete-post-btn:hover {
      background: rgba(var(--kravn-heart-red-rgb), 0.16);
      border-color: rgba(var(--kravn-heart-red-rgb), 0.55);
    }
    .kravn-delete-post-btn svg { width: 15px; height: 15px; flex-shrink: 0; }


    /* =========================================================
       SHARE CARD SECTION
       ========================================================= */

    .kd-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.1rem;
      padding: 1.5rem 1.25rem 1.75rem;
      border-radius: 24px;
      border: 1px solid rgba(var(--kravn-primary-rgb), 0.16);
      background:
        radial-gradient(circle at 50% 0%, rgba(var(--kravn-primary-rgb), 0.09), transparent 60%),
        rgba(255,255,255,0.015);
    }

    .kravn-share-heading { text-align: center; margin: 0; }

    .kravn-share-heading .kravn-share-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--kravn-primary-light);
    }

    .kravn-share-heading .kravn-share-eyebrow::before,
    .kravn-share-heading .kravn-share-eyebrow::after {
      content: '';
      width: 16px;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(var(--kravn-primary-rgb), 0.7));
    }
    .kravn-share-heading .kravn-share-eyebrow::after {
      background: linear-gradient(90deg, rgba(var(--kravn-primary-rgb), 0.7), transparent);
    }

    .kravn-share-heading h3 {
      margin: 0.35rem 0 0;
      font-size: 1.1rem;
      font-weight: 800;
      letter-spacing: -0.3px;
      background: linear-gradient(135deg, #fff 30%, var(--kravn-primary-light) 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .kravn-card-wrapper { display: flex; justify-content: center; width: 100%; }

    .kravn-post-card {
      position: relative;
      width: 250px;
      max-width: 100%;
      aspect-ratio: 9 / 16;
      overflow: hidden;
      border-radius: 20px;
      background: #050507;
      border: 1px solid rgba(var(--kravn-primary-rgb), 0.35);
      box-shadow:
        0 24px 60px rgba(0, 0, 0, 0.5),
        0 0 0 1px rgba(var(--kravn-primary-rgb), 0.06) inset;
      isolation: isolate;
      padding: 9px;
      transition: transform 0.25s ease;
    }
    .kravn-post-card:hover { transform: translateY(-3px); }

    .kravn-post-card-frame { position: absolute; inset: 9px; border-radius: 13px; overflow: hidden; isolation: isolate; }
    .kravn-post-card-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 22%; z-index: -3; }
    .kravn-post-card-fallback {
      position: absolute; inset: 0; z-index: -3;
      background: radial-gradient(circle at 75% 25%, rgba(var(--kravn-primary-rgb), 0.3), transparent 40%), linear-gradient(145deg, #1a1425, #0a0810 60%, #020103);
    }
    .kravn-post-card-overlay {
      position: absolute; inset: 0; z-index: -2;
      background: linear-gradient(to bottom, rgba(3,2,8,0.72) 0%, rgba(3,2,8,0.12) 20%, rgba(3,2,8,0.04) 36%, rgba(3,2,8,0.28) 52%, rgba(3,2,8,0.86) 76%, rgba(0,0,0,0.97) 100%);
    }
    .kravn-post-card-vignette {
      position: absolute; inset: 0; z-index: -1; pointer-events: none;
      background: radial-gradient(circle at center, transparent 35%, rgba(0,0,0,0.35) 100%);
    }
    .kravn-post-card-content {
      position: absolute; inset: 0; padding: 18px 18px 20px;
      display: flex; flex-direction: column; justify-content: space-between; z-index: 1;
    }
    .kravn-card-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.75rem; }
    .kravn-logo { font-size: 16px; line-height: 1; font-weight: 800; letter-spacing: -0.6px; color: #fff; text-shadow: 0 4px 16px rgba(0,0,0,0.7); }
    .kravn-logo-dot { color: var(--kravn-primary-light); }
    .kravn-tagline { margin-top: 4px; color: rgba(255,255,255,0.48); font-size: 6px; letter-spacing: 1.2px; text-transform: uppercase; }
    .kravn-card-badge {
      flex-shrink: 0; padding: 4px 8px; border-radius: 999px;
      border: 1px solid rgba(var(--kravn-primary-rgb), 0.6); background: rgba(5,5,9,0.55);
      color: var(--kravn-primary-light); font-size: 5.5px; font-weight: 700; letter-spacing: 0.7px; white-space: nowrap;
    }
    .kravn-card-bottom { width: 100%; }
    .kravn-card-movie { margin-bottom: 7px; color: var(--kravn-primary-light); font-size: 9px; font-weight: 700; letter-spacing: 1.3px; text-transform: uppercase; text-shadow: 0 2px 10px rgba(0,0,0,0.65); }
    .kravn-card-title {
      margin: 0 0 9px; color: #fff; font-size: clamp(0.98rem, 4vw, 1.4rem); line-height: 1.15; letter-spacing: -0.7px; font-weight: 800;
      text-shadow: 0 3px 14px rgba(0,0,0,0.75); overflow-wrap: anywhere;
      display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
    }
    .kravn-card-author { display: flex; align-items: center; gap: 6px; margin-bottom: 10px; color: rgba(255,255,255,0.68); font-size: 10px; }
    .kravn-card-author-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--kravn-primary); box-shadow: 0 0 10px rgba(var(--kravn-primary-rgb), 0.65); }
    .kravn-card-url { color: rgba(255,255,255,0.35); font-size: 7.5px; letter-spacing: 0.2px; }

    .kravn-share-row { display: flex; align-items: center; gap: 8px; }

    .kravn-card-tool-btn {
      width: 40px; height: 40px; border-radius: 50%;
      background: rgba(var(--kravn-primary-rgb), 0.1);
      border: 1px solid rgba(var(--kravn-primary-rgb), 0.35);
      backdrop-filter: blur(6px);
      color: var(--kravn-primary-light);
      display: flex; align-items: center; justify-content: center;
      font-size: 0.95rem; cursor: pointer;
      transition: all 0.18s ease;
    }
    .kravn-card-tool-btn:hover { border-color: var(--kravn-primary); background: rgba(var(--kravn-primary-rgb), 0.22); color: #fff; transform: translateY(-1px); }
    .kravn-card-tool-btn:disabled { opacity: 0.55; cursor: wait; transform: none; }

    .kravn-toast {
      position: fixed; bottom: 28px; left: 50%; transform: translateX(-50%) translateY(20px);
      background: #151515; border: 1px solid rgba(var(--kravn-primary-rgb), 0.35); color: #eee;
      font-family: var(--font-mono, monospace); font-size: 0.75rem; padding: 0.6rem 1rem; border-radius: 6px;
      opacity: 0; z-index: 1001; transition: all 0.25s ease; pointer-events: none; max-width: 88vw; text-align: center;
    }
    .kravn-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }


    /* =========================================================
       COMMENTS — quiet dividers, generous whitespace, owner
       actions permanently visible (edit pencil + red trash).
       ========================================================= */

    .kravn-comments-section { margin-top: 0; }

    .kravn-comments-header {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      margin-bottom: 1.4rem;
    }

    .kravn-comments-header svg { width: 19px; height: 19px; color: var(--kravn-primary-light); flex-shrink: 0; }

    .kravn-comments-header h2 {
      font-size: 1.15rem;
      margin: 0;
      letter-spacing: -0.2px;
      font-weight: 800;
    }

    .kravn-comments-count {
      font-size: 0.85rem;
      color: var(--text-muted, #888);
      font-weight: 600;
    }

    .comment-form {
      display: flex;
      margin: 0 0 2.2rem;
      align-items: flex-start;
    }

    .comment-form-body { flex: 1; min-width: 0; }

    .comment-form textarea {
      width: 100%;
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 14px;
      background: rgba(255,255,255,0.02);
      padding: 0.7rem 0.9rem;
      resize: none;
      min-height: 42px;
      font-size: 0.92rem;
      color: rgba(255,255,255,0.92);
      transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
      font-family: inherit;
    }

    .comment-form textarea:focus {
      outline: none;
      border-color: rgba(var(--kravn-primary-rgb), 0.6);
      background: rgba(var(--kravn-primary-rgb), 0.04);
      box-shadow: 0 0 0 3px rgba(var(--kravn-primary-rgb), 0.12);
    }

    .comment-form-actions {
      display: flex;
      justify-content: flex-end;
      margin-top: 0.6rem;
    }

    .comment-form button {
      padding: 0.5rem 1.3rem;
      border-radius: 999px;
      border: none;
      font-weight: 700;
      font-size: 0.84rem;
      color: #fff;
      cursor: pointer;
      background: linear-gradient(135deg, var(--kravn-primary), var(--kravn-primary-dark));
      box-shadow: 0 6px 18px rgba(var(--kravn-primary-rgb), 0.3);
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .comment-form button:hover { transform: translateY(-1px); box-shadow: 0 8px 22px rgba(var(--kravn-primary-rgb), 0.4); }

    .kravn-comment-list { display: flex; flex-direction: column; }

    .comment {
      position: relative;
      display: flex;
      gap: 0.9rem;
      padding: 1rem 0;
      border-bottom: 1px solid rgba(255,255,255,0.045);
    }
    .comment:last-child { border-bottom: none; }

    .kravn-comment-avatar {
      flex-shrink: 0;
      width: 36px; height: 36px;
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-weight: 800; font-size: 0.82rem; color: #fff;
      background: linear-gradient(135deg, var(--kravn-primary), var(--kravn-primary-darker));
    }

    .kravn-comment-body { flex: 1; min-width: 0; padding-right: 8.5rem; }

    .kravn-comment-top {
      display: flex;
      align-items: baseline;
      gap: 0.55rem;
      flex-wrap: wrap;
    }

    .comment-author a {
      font-weight: 700;
      font-size: 0.87rem;
      color: rgba(255,255,255,0.92);
      text-decoration: none;
    }
    .comment-author a:hover { color: var(--kravn-primary-light); }

    .kravn-comment-time {
      font-size: 0.72rem;
      color: var(--text-muted, #888);
    }

    .comment-text {
      margin: 0.3rem 0 0;
      line-height: 1.55;
      font-size: 0.91rem;
      color: rgba(255, 255, 255, 0.85);
      word-break: break-word;
    }

    /* Owner actions — labeled pills (icon + text), always visible,
       tucked top-right of the comment. No ambiguity about which
       one deletes. */
    .kravn-comment-owner-actions {
      position: absolute;
      top: 1rem;
      right: 0;
      display: flex;
      gap: 0.4rem;
    }

    .kravn-comment-owner-actions form { margin: 0; }

    .kravn-icon-action-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      height: 28px;
      padding: 0 0.6rem;
      border-radius: 999px;
      border: 1px solid transparent;
      background: transparent;
      cursor: pointer;
      text-decoration: none;
      font-size: 0.72rem;
      font-weight: 700;
      white-space: nowrap;
      transition: all 0.15s ease;
    }
    .kravn-icon-action-btn svg {
      width: 13px; height: 13px;
      stroke: currentColor;
      fill: none;
      flex-shrink: 0;
      display: block;
    }

    .kravn-icon-action-btn.edit {
      color: var(--kravn-primary-light);
      background: rgba(var(--kravn-primary-rgb), 0.12);
      border-color: rgba(var(--kravn-primary-rgb), 0.35);
    }
    .kravn-icon-action-btn.edit:hover {
      color: #fff;
      background: rgba(var(--kravn-primary-rgb), 0.22);
      border-color: rgba(var(--kravn-primary-rgb), 0.55);
    }

    .kravn-icon-action-btn.delete {
      color: #ffffff;
      background: var(--kravn-heart-red);
      border-color: var(--kravn-heart-red);
    }
    .kravn-icon-action-btn.delete:hover {
      background: #dc2626;
      border-color: #dc2626;
      transform: translateY(-1px);
    }

    .kravn-no-comments {
      text-align: center;
      padding: 2.5rem 1rem;
      border-radius: 18px;
      border: 1px dashed rgba(var(--kravn-primary-rgb), 0.25);
      color: var(--text-muted);
    }

    .kravn-section-rule {
      border: none;
      height: 1px;
      margin: 0 0 1.6rem;
      background: linear-gradient(90deg, rgba(var(--kravn-primary-rgb), 0.28), transparent 70%);
    }


    /* =========================================================
       MOBILE
       ========================================================= */

    @media (max-width: 640px) {
      .kravn-post-card { width: 230px; border-radius: 18px; padding: 8px; }
      .kravn-post-card-frame { inset: 8px; border-radius: 11px; }
      .kravn-post-card-content { padding: 15px; }
      .kd-card { padding: 1.35rem 1rem 1.5rem; border-radius: 20px; }
      .kravn-comment-body { padding-right: 0.25rem; }
      .kravn-comment-owner-actions { position: static; margin-top: 0.6rem; }
      .comment { flex-wrap: wrap; }
    }

  </style>

</head>


<body>

  <%- include('partials/navbar', { currentPage: 'postDetail' }) %>


  <!-- MOVIE HEADER -->

  <div class="detail-backdrop">

    <% if (post.poster_url && post.poster_url !== 'N/A') { %>
      <style>
        .detail-backdrop::before { background-image: url('<%= post.poster_url %>'); }
      </style>
    <% } %>

    <div class="detail-backdrop-inner">
      <div class="detail-header">

        <% if (post.poster_url && post.poster_url !== 'N/A') { %>
          <img class="detail-poster" src="<%= post.poster_url %>" alt="<%= post.movie_name %>">
        <% } else { %>
          <div class="post-poster-placeholder" style="width:160px;height:240px;font-size:2.4rem;border-radius:var(--radius-lg);">🎬</div>
        <% } %>

        <div class="detail-title-block">

          <div class="kravn-movie-eyebrow">
            <span class="movie-name"><%= post.movie_name %></span>
            <% if (post.imdb_rating && post.imdb_rating !== 'N/A') { %>
              <span class="imdb-chip">★ <%= post.imdb_rating %></span>
            <% } %>
          </div>

          <h1 class="kravn-detail-title"><%= post.title %></h1>

          <% if (post.genre) { %>
            <div class="kravn-genre-row">
              <% post.genre.split(',').map(g => g.trim()).filter(Boolean).forEach(g => { %>
                <a class="kravn-genre-tag" href="/feed?genre=<%= encodeURIComponent(g) %>"><%= g %></a>
              <% }); %>
            </div>
          <% } %>

          <div class="kravn-byline">
            <span class="byline-label">Posted by</span>
            <a href="/users/<%= post.username %>"><%= post.username %></a>
            <span class="kravn-byline-dot">·</span>
            <%= new Date(post.created_at).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Kolkata' }) %>
          </div>

        </div>
      </div>
    </div>
  </div>


  <!-- MAIN CONTENT -->

  <div class="kravn-detail-shell">
    <div class="kravn-detail-grid">

      <!-- TOP: like row + discussion body -->
      <div class="kd-top">

        <div class="kravn-like-row">
          <form action="/posts/<%= post.id %>/like" method="POST">
            <button class="kravn-like-btn<%= typeof userHasLiked !== 'undefined' && userHasLiked ? ' is-liked' : '' %>" type="submit" aria-label="Like this discussion">
              <svg class="kravn-heart-icon" viewBox="0 0 24 24" stroke-width="2">
                <path d="M12 21s-6.5-4.35-9.5-8.5C.5 9 2 5 5.5 5c2 0 3.5 1.2 4.5 2.7C11 6.2 12.5 5 14.5 5 18 5 19.5 9 17.5 12.5 14.5 16.65 12 21 12 21z"/>
              </svg>
            </button>
          </form>

          <% if (likeCount > 0) { %>
            <a class="kravn-likes-text" href="/posts/<%= post.id %>/likes">
              Liked by <strong><%= likeCount %></strong> <%= likeCount === 1 ? 'person' : 'people' %>
            </a>
          <% } else { %>
            <span class="kravn-likes-text">Be the first to like this</span>
          <% } %>
        </div>

        <p class="detail-content"><%= post.content %></p>

        <% if (post.user_id === currentUserId) { %>
          <div class="kravn-post-footer-row">
            <form action="/posts/<%= post.id %>/delete" method="POST" onsubmit="return confirm('Delete this discussion permanently?');">
              <button type="submit" class="kravn-delete-post-btn" title="Delete discussion" aria-label="Delete discussion">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="3 6 5 6 21 6"></polyline>
                  <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                </svg>
                Delete discussion
              </button>
            </form>
          </div>
        <% } %>

      </div>


      <!-- SHARE CARD -->
      <div class="kd-card">

        <div class="kravn-share-heading">
          <span class="kravn-share-eyebrow">✦ Collectible</span>
          <h3>Your Kravn Card</h3>
        </div>

        <div class="kravn-card-wrapper">
          <div id="kravn-post-card" class="kravn-post-card">

            <div class="kravn-post-card-frame">
              <% if (post.poster_url && post.poster_url !== 'N/A') { %>
                <img class="kravn-post-card-bg" src="<%= post.poster_url %>" alt="">
              <% } else { %>
                <div class="kravn-post-card-fallback"></div>
              <% } %>

              <div class="kravn-post-card-overlay"></div>
              <div class="kravn-post-card-vignette"></div>
            </div>

            <div class="kravn-post-card-content">

              <div class="kravn-card-header">
                <div>
                  <div class="kravn-logo">Krav<span class="kravn-logo-dot">N.</span></div>
                  <div class="kravn-tagline">Discuss. Discover. Connect.</div>
                </div>
                <div class="kravn-card-badge">Kravn Discussion</div>
              </div>

              <div class="kravn-card-bottom">
                <div class="kravn-card-movie"><%= post.movie_name %></div>
                <h2 class="kravn-card-title"><%= post.title %></h2>
                <div class="kravn-card-author">
                  <span class="kravn-card-author-dot"></span>
                  @<%= post.username %>
                </div>
                <div class="kravn-card-url">kravn.onrender.com/posts/<%= post.id %></div>
              </div>

            </div>
          </div>
        </div>

        <div class="kravn-share-row">
          <div class="kravn-card-tool-btn" id="download-card-btn" title="Download postcard">⬇</div>
          <div class="kravn-card-tool-btn" id="share-card-btn" title="Share">↗</div>
        </div>

      </div>


      <!-- COMMENTS (always last in document order) -->
      <div class="kd-comments">

        <hr class="kravn-section-rule">

        <div class="kravn-comments-section">

          <div class="kravn-comments-header">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
            <h2>Comments</h2>
            <span class="kravn-comments-count"><%= comments.length %></span>
          </div>

          <form class="comment-form" action="/posts/<%= post.id %>/comments" method="POST">
            <div class="comment-form-body">
              <textarea name="content" placeholder="Add a comment..." required rows="1" onfocus="this.rows=2;" onblur="if(!this.value){this.rows=1;}"></textarea>
              <div class="comment-form-actions">
                <button type="submit">Comment</button>
              </div>
            </div>
          </form>

          <% if (comments.length === 0) { %>
            <p class="kravn-no-comments">No comments yet. Be the first to say something.</p>
          <% } %>

          <div class="kravn-comment-list">
            <% comments.forEach(comment => { %>
              <div class="comment">
                <div class="kravn-comment-avatar"><%= comment.username.charAt(0).toUpperCase() %></div>

                <div class="kravn-comment-body">
                  <div class="kravn-comment-top">
                    <div class="comment-author">
                      <a href="/users/<%= comment.username %>"><%= comment.username %></a>
                    </div>
                    <span class="kravn-comment-time">
                      <%= new Date(comment.created_at || Date.now()).toLocaleString('en-IN', { dateStyle: 'medium', timeZone: 'Asia/Kolkata' }) %>
                    </span>
                  </div>

                  <p class="comment-text"><%= comment.content %></p>
                </div>

                <% if (comment.user_id === currentUserId) { %>
                  <div class="kravn-comment-owner-actions">
                    <a href="/comments/<%= comment.id %>/edit" class="kravn-icon-action-btn edit" title="Edit comment" aria-label="Edit comment">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4z"></path>
                      </svg>
                      Edit
                    </a>
                    <form action="/comments/<%= comment.id %>/delete" method="POST" onsubmit="return confirm('Delete this comment?');">
                      <button type="submit" class="kravn-icon-action-btn delete" title="Delete comment" aria-label="Delete comment">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="3 6 5 6 21 6"></polyline>
                          <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        </svg>
                        Delete
                      </button>
                    </form>
                  </div>
                <% } %>
              </div>
            <% }); %>
          </div>

        </div>

      </div>

    </div>
  </div>

  <div class="kravn-toast" id="kravn-toast"></div>


  <!-- SHARING JAVASCRIPT -->

  <script>

    const KRAVN_POST = {
      id: <%- JSON.stringify(post.id) %>,
      movieName: <%- JSON.stringify(post.movie_name || '') %>,
      title: <%- JSON.stringify(post.title || '') %>,
      username: <%- JSON.stringify(post.username || '') %>,
      posterUrl: <%- JSON.stringify(post.poster_url && post.poster_url !== 'N/A' ? post.poster_url : null) %>
    };

    const KRAVN_POST_URL = 'https://kravn.onrender.com/posts/' + KRAVN_POST.id;

    const SCALE = 3;
    const CARD_WIDTH = Math.round(1080 * SCALE);
    const CARD_HEIGHT = Math.round(1920 * SCALE);
    const S = n => n * SCALE;

    function themeColor(name, fallback) {
      const v = getComputedStyle(document.documentElement).getPropertyValue(name);
      return v && v.trim() ? v.trim() : fallback;
    }

    function currentThemeColors() {
      return {
        light: themeColor('--kravn-primary-light', '#c4b5fd'),
        rgb: themeColor('--kravn-primary-rgb', '139, 92, 246')
      };
    }

    function purpleRgba(alpha) {
      const { rgb } = currentThemeColors();
      return 'rgba(' + rgb + ', ' + alpha + ')';
    }

    function cleanCardText(value) {
      return String(value || '').replace(/<[^>]*>/g, '').replace(/[\r\n\t]+/g, ' ').replace(/\s+/g, ' ').trim();
    }

    function getHiResPosterUrl(url) {
      if (!url) return url;
      return url.replace(/\/t\/p\/w\d{2,4}\//, '/t/p/w1280/');
    }

    function loadCardImage(url) {
      return new Promise((resolve, reject) => {
        if (!url) { reject(new Error('No image')); return; }
        const image = new Image();
        image.crossOrigin = 'anonymous';
        image.onload = () => resolve(image);
        image.onerror = () => reject(new Error('Image failed to load'));
        image.src = url;
      });
    }

    function roundedRect(ctx, x, y, width, height, radius) {
      ctx.beginPath();
      ctx.moveTo(x + radius, y);
      ctx.arcTo(x + width, y, x + width, y + height, radius);
      ctx.arcTo(x + width, y + height, x, y + height, radius);
      ctx.arcTo(x, y + height, x, y, radius);
      ctx.arcTo(x, y, x + width, y, radius);
      ctx.closePath();
    }

    function drawFallback(ctx) {
      const gradient = ctx.createLinearGradient(0, 0, CARD_WIDTH, CARD_HEIGHT);
      gradient.addColorStop(0, '#1a1425');
      gradient.addColorStop(0.55, '#0a0810');
      gradient.addColorStop(1, '#020103');
      ctx.fillStyle = gradient;
      ctx.fillRect(0, 0, CARD_WIDTH, CARD_HEIGHT);

      const glow = ctx.createRadialGradient(S(800), S(500), 0, S(800), S(500), S(700));
      glow.addColorStop(0, purpleRgba(0.28));
      glow.addColorStop(1, purpleRgba(0));
      ctx.fillStyle = glow;
      ctx.fillRect(0, 0, CARD_WIDTH, CARD_HEIGHT);
    }

    function drawPoster(ctx, image) {
      const imageRatio = image.width / image.height;
      const canvasRatio = CARD_WIDTH / CARD_HEIGHT;
      let width, height, x, y;

      if (imageRatio > canvasRatio) {
        height = CARD_HEIGHT;
        width = height * imageRatio;
        x = (CARD_WIDTH - width) / 2;
        y = 0;
      } else {
        width = CARD_WIDTH;
        height = width / imageRatio;
        x = 0;
        y = -(height - CARD_HEIGHT) * 0.22;
      }

      ctx.drawImage(image, x, y, width, height);
    }

    function drawCardFades(ctx) {
      const topFade = ctx.createLinearGradient(0, 0, 0, CARD_HEIGHT * 0.24);
      topFade.addColorStop(0, 'rgba(3,2,8,0.68)');
      topFade.addColorStop(1, 'rgba(3,2,8,0)');
      ctx.fillStyle = topFade;
      ctx.fillRect(0, 0, CARD_WIDTH, CARD_HEIGHT * 0.24);

      const bottomStart = CARD_HEIGHT * 0.5;
      const bottomFade = ctx.createLinearGradient(0, bottomStart, 0, CARD_HEIGHT);
      bottomFade.addColorStop(0, 'rgba(3,2,8,0)');
      bottomFade.addColorStop(0.35, 'rgba(3,2,8,0.55)');
      bottomFade.addColorStop(1, 'rgba(3,2,8,0.97)');
      ctx.fillStyle = bottomFade;
      ctx.fillRect(0, bottomStart, CARD_WIDTH, CARD_HEIGHT - bottomStart);

      const vignette = ctx.createRadialGradient(
        CARD_WIDTH / 2, CARD_HEIGHT / 2, CARD_HEIGHT * 0.35,
        CARD_WIDTH / 2, CARD_HEIGHT / 2, CARD_HEIGHT * 0.75
      );
      vignette.addColorStop(0, 'rgba(0,0,0,0)');
      vignette.addColorStop(1, 'rgba(0,0,0,0.32)');
      ctx.fillStyle = vignette;
      ctx.fillRect(0, 0, CARD_WIDTH, CARD_HEIGHT);
    }

    function wrapCardText(ctx, text, maxWidth, maxLines) {
      const words = text.split(' ');
      const lines = [];
      let current = '';

      for (let i = 0; i < words.length; i++) {
        const test = current ? current + ' ' + words[i] : words[i];
        if (ctx.measureText(test).width > maxWidth && current) {
          lines.push(current);
          current = words[i];
          if (lines.length === maxLines) {
            let last = lines[lines.length - 1];
            while (ctx.measureText(last + '…').width > maxWidth && last.length > 0) {
              last = last.slice(0, -1).trim();
            }
            lines[lines.length - 1] = last + '…';
            return lines;
          }
        } else {
          current = test;
        }
      }
      if (current) lines.push(current);
      return lines;
    }

    async function createPostCard() {
      const canvas = document.createElement('canvas');
      canvas.width = CARD_WIDTH;
      canvas.height = CARD_HEIGHT;

      const ctx = canvas.getContext('2d');
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = 'high';

      const { light: PURPLE_LIGHT } = currentThemeColors();

      ctx.fillStyle = '#050507';
      ctx.fillRect(0, 0, CARD_WIDTH, CARD_HEIGHT);

      const FRAME = S(10);
      ctx.save();
      roundedRect(ctx, FRAME, FRAME, CARD_WIDTH - FRAME * 2, CARD_HEIGHT - FRAME * 2, S(14));
      ctx.clip();

      try {
        const image = await loadCardImage(getHiResPosterUrl(KRAVN_POST.posterUrl));
        drawPoster(ctx, image);
      } catch (error) {
        console.warn('Using fallback background', error);
        drawFallback(ctx);
      }

      drawCardFades(ctx);
      ctx.restore();

      ctx.save();
      ctx.strokeStyle = purpleRgba(0.55);
      ctx.lineWidth = S(3);
      ctx.lineJoin = 'round';
      roundedRect(ctx, S(1.5), S(1.5), CARD_WIDTH - S(3), CARD_HEIGHT - S(3), S(26));
      ctx.stroke();
      ctx.restore();

      const left = S(56);
      const contentWidth = CARD_WIDTH - S(112);

      ctx.save();
      ctx.textAlign = 'left';
      ctx.textBaseline = 'top';
      ctx.font = `800 ${S(54)}px Arial, sans-serif`;
      ctx.fillStyle = '#ffffff';
      ctx.shadowColor = 'rgba(0,0,0,0.7)';
      ctx.shadowBlur = S(8);
      ctx.fillText('Krav', left, S(48));
      const logoWidth = ctx.measureText('Krav').width;
      ctx.fillStyle = PURPLE_LIGHT;
      ctx.fillText('N.', left + logoWidth, S(48));
      ctx.restore();

      ctx.save();
      ctx.font = `600 ${S(13)}px Arial, sans-serif`;
      ctx.fillStyle = 'rgba(255,255,255,0.48)';
      ctx.textAlign = 'left';
      ctx.textBaseline = 'top';
      ctx.fillText('DISCUSS. DISCOVER. CONNECT.', left, S(96));
      ctx.restore();

      const badgeText = 'KRAVN DISCUSSION';
      ctx.save();
      ctx.font = `700 ${S(17)}px Arial, sans-serif`;
      const badgeTextWidth = ctx.measureText(badgeText).width;
      const badgePaddingX = S(22);
      const badgeHeight = S(50);
      const badgeWidth = badgeTextWidth + badgePaddingX * 2;
      const badgeX = CARD_WIDTH - left - badgeWidth;
      const badgeY = S(38);

      roundedRect(ctx, badgeX, badgeY, badgeWidth, badgeHeight, badgeHeight / 2);
      ctx.fillStyle = 'rgba(5,5,9,0.55)';
      ctx.fill();
      ctx.strokeStyle = purpleRgba(0.6);
      ctx.lineWidth = S(1.5);
      ctx.stroke();

      ctx.fillStyle = PURPLE_LIGHT;
      ctx.textAlign = 'left';
      ctx.textBaseline = 'middle';
      ctx.fillText(badgeText, badgeX + badgePaddingX, badgeY + badgeHeight / 2 + S(1));
      ctx.restore();

      const panelBottomPadding = S(56);
      const movieBlockHeight = S(58);
      const movieTitleGap = S(28);
      const titleLineHeight = S(76);
      const maxTitleLines = 3;
      const usernameGap = S(28);
      const usernameBlockHeight = S(42);
      const urlGap = S(8);
      const urlBlockHeight = S(30);

      ctx.font = `800 ${S(66)}px Arial, sans-serif`;
      const titleLines = wrapCardText(ctx, cleanCardText(KRAVN_POST.title), contentWidth, maxTitleLines);

      const totalBlockHeight =
        movieBlockHeight +
        movieTitleGap +
        titleLines.length * titleLineHeight +
        usernameGap +
        usernameBlockHeight +
        urlGap +
        urlBlockHeight;

      let y = CARD_HEIGHT - panelBottomPadding - totalBlockHeight;

      ctx.save();
      ctx.font = `700 ${S(30)}px Arial, sans-serif`;
      ctx.fillStyle = PURPLE_LIGHT;
      ctx.textAlign = 'left';
      ctx.textBaseline = 'top';
      ctx.fillText(cleanCardText(KRAVN_POST.movieName).toUpperCase(), left, y, contentWidth);
      ctx.restore();

      y += movieBlockHeight + movieTitleGap;

      ctx.save();
      ctx.font = `800 ${S(66)}px Arial, sans-serif`;
      ctx.fillStyle = '#ffffff';
      ctx.shadowColor = 'rgba(0,0,0,0.8)';
      ctx.shadowBlur = S(9);
      titleLines.forEach((line, index) => {
        ctx.fillText(line, left, y + index * titleLineHeight);
      });
      ctx.restore();

      y += titleLines.length * titleLineHeight + usernameGap;

      ctx.save();
      ctx.font = `500 ${S(25)}px Arial, sans-serif`;
      ctx.fillStyle = 'rgba(255,255,255,0.68)';
      ctx.fillText('@' + cleanCardText(KRAVN_POST.username), left, y);
      ctx.restore();

      y += usernameBlockHeight + urlGap;

      ctx.save();
      ctx.font = `500 ${S(18)}px Arial, sans-serif`;
      ctx.fillStyle = 'rgba(255,255,255,0.35)';
      ctx.fillText('kravn.onrender.com/posts/' + KRAVN_POST.id, left, y);
      ctx.restore();

      return canvas;
    }

    function canvasToBlob(canvas) {
      return new Promise(resolve => { canvas.toBlob(blob => resolve(blob), 'image/png'); });
    }

    const kravnToastEl = document.getElementById('kravn-toast');
    function toast(msg) {
      if (!kravnToastEl) return;
      kravnToastEl.textContent = msg;
      kravnToastEl.classList.add('show');
      clearTimeout(kravnToastEl._t);
      kravnToastEl._t = setTimeout(() => kravnToastEl.classList.remove('show'), 2400);
    }

    async function downloadPostCard() {
      const button = document.getElementById('download-card-btn');
      button.style.pointerEvents = 'none';
      button.style.opacity = '0.55';

      try {
        await (document.fonts && document.fonts.ready);
        const canvas = await createPostCard();
        const blob = await canvasToBlob(canvas);
        if (!blob) throw new Error('Could not create PNG');

        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = 'kravn-post-' + KRAVN_POST.id + '.png';
        document.body.appendChild(link);
        link.click();
        link.remove();
        URL.revokeObjectURL(url);

        toast('Postcard downloaded');
      } catch (error) {
        console.error('Postcard download failed:', error);
        toast('Could not create the postcard');
      } finally {
        button.style.pointerEvents = '';
        button.style.opacity = '';
      }
    }

    async function sharePostCard() {
      const button = document.getElementById('share-card-btn');
      button.style.pointerEvents = 'none';
      button.style.opacity = '0.55';

      const shareText = KRAVN_POST.title + ' — on Kravn';

      try {
        await (document.fonts && document.fonts.ready);
        const canvas = await createPostCard();
        const blob = await canvasToBlob(canvas);
        if (!blob) throw new Error('render failed');
        const file = new File([blob], 'kravn-' + KRAVN_POST.id + '.png', { type: 'image/png' });

        if (navigator.canShare && navigator.canShare({ files: [file] })) {
          await navigator.share({ files: [file], title: KRAVN_POST.title, text: shareText, url: KRAVN_POST_URL });
          return;
        }

        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = 'kravn-' + KRAVN_POST.id + '.png';
        link.click();
        URL.revokeObjectURL(url);
        if (navigator.clipboard) await navigator.clipboard.writeText(KRAVN_POST_URL);
        toast('Card image saved · link copied');
      } catch (error) {
        if (error && error.name === 'AbortError') return;
        console.error('Share failed:', error);
        if (navigator.share) {
          navigator.share({ title: KRAVN_POST.title, text: shareText, url: KRAVN_POST_URL }).catch(() => {});
        } else if (navigator.clipboard) {
          navigator.clipboard.writeText(KRAVN_POST_URL).then(() => toast('Link copied')).catch(() => toast(KRAVN_POST_URL));
        } else {
          toast(KRAVN_POST_URL);
        }
      } finally {
        button.style.pointerEvents = '';
        button.style.opacity = '';
      }
    }

    document.getElementById('download-card-btn').addEventListener('click', downloadPostCard);
    document.getElementById('share-card-btn').addEventListener('click', sharePostCard);

  </script>

</body>

</html>
