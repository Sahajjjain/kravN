<%- include('partials/head', { title: 'Start a discussion' }) %>
<%- include('partials/nav') %>

<style>
  /* =====================================================================
     NEW POST: compact centered head -> big search pill -> live results
     ===================================================================== */
  .page .shell--narrow.kv-new { max-width: min(680px, 100% - 32px); }

  /* ---------- header ---------- */
  .kv-new .page-head { display: grid; gap: 8px; justify-items: center; text-align: center; margin: 8px 0 20px; padding: 0; }
  .kv-new .page-head h1 {
    margin: 0; max-width: 18em; font-size: clamp(24px, 4.6vw, 36px); font-weight: 700; letter-spacing: -.03em; line-height: 1.12; text-wrap: balance;
  }
  .kv-new .page-head .muted { margin: 0; max-width: 460px; font-size: 14px; line-height: 1.55; text-wrap: balance; }

  /* ---------- search pill ---------- */
  .kv-new .search-form {
    position: relative; display: flex; align-items: center; gap: 12px; width: 100%; height: 56px; margin: 0; padding: 0 20px; border-radius: 999px;
    background: color-mix(in srgb, var(--text) 5%, var(--surface)); border: 1px solid color-mix(in srgb, var(--text) 14%, transparent);
    box-shadow: 0 14px 34px -22px rgba(0, 0, 0, .8);
    transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
  }
  .kv-new .search-form:hover { border-color: color-mix(in srgb, var(--text) 26%, transparent); }
  .kv-new .search-form:focus-within {
    border-color: color-mix(in srgb, var(--accent) 75%, transparent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 16%, transparent), 0 14px 34px -22px rgba(0, 0, 0, .8);
  }
  .kv-new .search-form > svg { flex: none; width: 19px; height: 19px; color: color-mix(in srgb, var(--text) 55%, transparent); transition: color .2s ease; }
  .kv-new .search-form:focus-within > svg { color: var(--accent); }
  .kv-new .search-form input {
    flex: 1; min-width: 0; width: 100%; height: 100%; margin: 0; padding: 0; border: 0; outline: 0; background: transparent; box-shadow: none;
    font: 500 16px/1 var(--font); letter-spacing: .005em; color: var(--text); -webkit-appearance: none; appearance: none;
  }
  .kv-new .search-form input::placeholder { color: color-mix(in srgb, var(--text) 45%, transparent); }
  .kv-new .search-form input::-webkit-search-cancel-button { -webkit-appearance: none; appearance: none; height: 16px; width: 16px; cursor: pointer; opacity: .6;
    background: no-repeat center / 16px url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='%23b4b4bd' stroke-width='2.5' stroke-linecap='round'><path d='M6 6l12 12M18 6L6 18'/></svg>"); }

  /* ---------- results + hint ---------- */
  .kv-new .live-results { margin-top: 14px; min-width: 0; }
  .kv-new .hint { margin: 16px 0 0; text-align: center; font-size: 12.5px; line-height: 1.5; color: color-mix(in srgb, var(--text) 52%, transparent); }
  .kv-new .hint b { font-weight: 600; color: color-mix(in srgb, var(--text) 80%, transparent); }

  /* ---------- phone ---------- */
  @media (max-width: 640px) {
    .kv-new .page-head { margin: 2px 0 16px; gap: 6px; }
    .kv-new .page-head .muted { font-size: 13px; }
    .kv-new .search-form { height: 50px; padding: 0 16px; gap: 10px; }
    .kv-new .search-form > svg { width: 18px; height: 18px; }
    .kv-new .live-results { margin-top: 12px; }
  }
</style>

<main class="page">
  <div class="shell shell--narrow kv-new">
    <header class="page-head page-head--center">
      <span class="eyebrow"><span class="dot"></span> New post</span>
      <h1>Which movie or series is this about?</h1>
      <p class="muted">Find the title and your discussion starts right underneath it, where everyone talking about it will see you.</p>
    </header>

    <form class="search-form search-form--page search-form--big" action="/search" method="GET" role="search" onsubmit="return false">
      <%- include('partials/icon', { n: 'search' }) %>
      <input type="search" id="movie-input" value="<%= prefill %>" placeholder="Search for a movie or series…" autocomplete="off" autofocus aria-label="Movie or series title" data-livesearch data-target="#movie-results" data-mode="compose" data-movies-only>
    </form>

    <div class="live-results live-results--page" id="movie-results"></div>
    <p class="hint">Can't find it? Try adding the year, like <b>“dune 2021”</b>.</p>
  </div>
</main>
<%- include('partials/foot') %>