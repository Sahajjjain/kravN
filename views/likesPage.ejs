<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Likes · <%= post.movie_name %> — KravN</title>

  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/theme.js" defer></script>

  <style>
    /* ================================
       KRAVN THEME VARIABLES — same purple (dark) / gold (light)
       system used on the post detail page.
       ================================ */

    :root {
      --kravn-primary: #8b5cf6;
      --kravn-primary-rgb: 139, 92, 246;
      --kravn-primary-dark: #6d28d9;
      --kravn-primary-darker: #4c1d95;
      --kravn-primary-light: #c4b5fd;
    }

    html[data-theme="light"] {
      --kravn-primary: #d4a017;
      --kravn-primary-rgb: 212, 160, 23;
      --kravn-primary-dark: #a9790a;
      --kravn-primary-darker: #7a5807;
      --kravn-primary-light: #f0cf6f;
    }

    /* ================================
       KRAVN LIKES PAGE — quiet, premium ticket-stub.
       No blinking lights, no busy texture — the cinema metaphor
       comes through in shape and material (a torn stub, a thin
       gold/purple hairline, tabular numbering) rather than motion.
       Restrained palette, generous whitespace, a single accent
       used sparingly so it reads as considered rather than loud.
       ================================ */

    .likes-page {
      min-height: calc(100vh - 70px);
      padding: var(--space-8) var(--space-4) var(--space-16);
      position: relative;
    }

    .likes-container {
      max-width: 600px;
      margin: 0 auto;
      position: relative;
    }

    /* ---- Back link -------------------------------------------------- */

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-bottom: var(--space-6);

      color: var(--text-muted);
      font-size: 0.82rem;
      font-weight: 600;
      letter-spacing: 0.01em;
      text-decoration: none;
    }

    .back-link:hover,
    .back-link:focus-visible {
      color: var(--kravn-primary-light);
    }

    .back-link:focus-visible {
      outline: 2px solid var(--kravn-primary);
      outline-offset: 3px;
      border-radius: var(--radius-sm);
    }

    .back-link svg {
      width: 15px;
      height: 15px;
      flex: none;
      transition: transform 0.2s ease;
    }

    .back-link:hover svg {
      transform: translateX(-2px);
    }

    /* ---- Ticket header ------------------------------------------------ */
    /* A quiet, flat card shaped like a torn stub. No grain, no
       chasing lights — just a hairline gold/purple border, generous
       padding and confident type doing the "premium" work. */

    .ticket {
      position: relative;
      background:
        radial-gradient(circle at 50% 0%, rgba(var(--kravn-primary-rgb), 0.09), transparent 60%),
        var(--surface-1);
      border: 1px solid var(--border);
      border-top: 2px solid var(--kravn-primary);
      border-radius: 4px;
      overflow: hidden;
      margin-bottom: var(--space-8, 2rem);
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04), 0 12px 32px rgba(0, 0, 0, 0.08);
    }

    .ticket-body {
      padding: var(--space-7, 2rem) var(--space-6) var(--space-5);
    }

    .now-showing {
      display: inline-block;
      margin-bottom: var(--space-3);

      color: var(--kravn-primary-light);
      font-family: var(--font-mono, monospace);
      font-size: 0.66rem;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
    }

    .marquee-title {
      margin: 0;
      font-family: var(--font-display);
      font-weight: 700;
      letter-spacing: -0.01em;
      font-size: clamp(1.55rem, 4.4vw, 2rem);
      line-height: 1.18;
      color: var(--text);
    }

    .ticket-sub {
      margin: var(--space-2) 0 0;
      color: var(--text-muted);
      font-size: 0.92rem;
      line-height: 1.55;
      max-width: 46ch;
    }

    /* Perforated tear, quieted to a single hairline with faint
       sprocket dashes — a material detail, not a decoration. */
    .tear {
      height: 1px;
      margin: 0 var(--space-6);
      background: repeating-linear-gradient(
        to right,
        var(--border) 0,
        var(--border) 5px,
        transparent 5px,
        transparent 11px
      );
    }

    .stub {
      display: flex;
      align-items: baseline;
      gap: var(--space-3);
      padding: var(--space-4) var(--space-6) var(--space-5);
    }

    .stub-count {
      font-family: var(--font-mono, monospace);
      font-weight: 700;
      font-size: 1.4rem;
      color: var(--text);
      font-variant-numeric: tabular-nums;
    }

    .stub-label {
      color: var(--text-muted);
      font-size: 0.86rem;
    }

    /* ---- Reel list ---------------------------------------------------- */
    /* Ordered list on purpose — a running number earns its place. */

    .reel-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
    }

    .frame {
      content-visibility: auto;
      contain-intrinsic-size: 60px;
    }

    .frame-link {
      display: flex;
      align-items: center;
      gap: var(--space-4);
      padding: var(--space-4) var(--space-2);

      border-bottom: 1px solid var(--border);
      background: transparent;
      color: inherit;
      text-decoration: none;

      transition: background 0.15s ease;
    }

    .frame:first-child .frame-link { border-top: 1px solid var(--border); }

    .frame-link:hover,
    .frame-link:focus-visible {
      background: rgba(var(--kravn-primary-rgb), 0.035);
    }

    .frame-link:focus-visible {
      outline: 2px solid var(--kravn-primary);
      outline-offset: -2px;
    }

    .frame-number {
      flex: none;
      width: 24px;
      font-family: var(--font-mono, monospace);
      font-size: 0.74rem;
      color: var(--text-muted);
      font-variant-numeric: tabular-nums;
      text-align: right;
    }

    .frame-avatar {
      flex: none;
      width: 38px;
      height: 38px;
      border-radius: 50%;

      display: flex;
      align-items: center;
      justify-content: center;

      background: var(--surface-2, var(--surface-1));
      border: 1px solid var(--border);
      color: var(--text);
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 0.88rem;
    }

    .frame-info {
      min-width: 0;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .frame-name {
      color: var(--text);
      font-weight: 600;
      font-size: 0.94rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .frame-link:hover .frame-name,
    .frame-link:focus-visible .frame-name {
      color: var(--kravn-primary-light);
    }

    /* ---- Empty state --------------------------------------------------- */

    .empty-state {
      padding: var(--space-9, 3rem) var(--space-5);
      text-align: center;
      border: 1px solid var(--border);
      border-radius: 4px;
    }

    .empty-state h2 {
      margin: 0 0 var(--space-2);
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.1rem;
      color: var(--text);
    }

    .empty-state p {
      max-width: 340px;
      margin: 0 auto;
      color: var(--text-muted);
      font-size: 0.9rem;
      line-height: 1.55;
    }

    .empty-state strong {
      color: var(--kravn-primary-light);
      font-weight: 600;
    }

    /* Mobile */
    @media (max-width: 600px) {
      .likes-page { padding: var(--space-5) var(--space-3) var(--space-12); }
      .ticket-body { padding: var(--space-5) var(--space-5) var(--space-4); }
      .tear { margin: 0 var(--space-5); }
      .stub { padding: var(--space-3) var(--space-5) var(--space-4); }
      .frame-link { padding: var(--space-3) var(--space-1); gap: var(--space-3); }
      .frame-avatar { width: 34px; height: 34px; }
    }
  </style>
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#0a0a0a">
  <link rel="apple-touch-icon" href="/icons/icon-192.png">
</head>

<body>

  <%- include('partials/navbar', { currentPage: 'likesPage' }) %>

  <main class="likes-page">
    <div class="likes-container">

      <!--
        Back navigation: if the visitor arrived from the post page
        (same-origin referrer), a click just calls history.back() so
        they land exactly where they left off — same scroll position,
        no reload. If they opened this page directly (shared link,
        new tab), the href below takes them straight to the post.
        Adjust the route/field below (post.id) to match your schema.
      -->
      <a class="back-link" id="backLink" href="/posts/<%= post.id %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 18l-6-6 6-6"/>
        </svg>
        Back to <%= post.movie_name %>
      </a>

      <!-- Ticket header -->
      <section class="ticket">

        <div class="ticket-body">
          <span class="now-showing">Now showing</span>
          <h1 class="marquee-title"><%= post.movie_name %></h1>
          <p class="ticket-sub"><%= post.title %></p>
        </div>

        <div class="tear" role="presentation"></div>

        <div class="stub">
          <span class="stub-count"><%= likers.length %></span>
          <span class="stub-label">
            <%= likers.length === 1 ? 'person liked this screening' : 'people liked this screening' %>
          </span>
        </div>
      </section>

      <!-- Reel -->
      <% if (likers.length === 0) { %>

        <section class="empty-state">
          <h2>Nobody's clapped for this one yet</h2>
          <p>Be the first to like <strong><%= post.movie_name %></strong> and your name opens the reel.</p>
        </section>

      <% } else { %>

        <ol class="reel-list" aria-label="People who liked this post">

          <% likers.forEach((user, index) => { %>

            <li class="frame">
              <a
                class="frame-link"
                href="/users/<%= encodeURIComponent(user.username) %>"
                aria-label="View <%= user.username %>'s profile"
              >
                <span class="frame-number" aria-hidden="true"><%= String(index + 1).padStart(2, '0') %></span>

                <span class="frame-avatar" aria-hidden="true">
                  <%= user.username.charAt(0).toUpperCase() %>
                </span>

                <span class="frame-info">
                  <span class="frame-name"><%= user.username %></span>
                </span>
              </a>
            </li>

          <% }); %>

        </ol>

      <% } %>

    </div>
  </main>

  <script>
    (function () {
      var backLink = document.getElementById('backLink');
      if (!backLink || !document.referrer) return;
      try {
        var ref = new URL(document.referrer);
        if (ref.origin === window.location.origin) {
          backLink.addEventListener('click', function (e) {
            e.preventDefault();
            history.back();
          });
        }
      } catch (e) { /* malformed referrer, fall back to href */ }
    })();
  </script>

</body>
</html>
