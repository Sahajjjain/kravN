<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Likes · <%= post.movie_name %> — KravN</title>

  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/theme.js" defer></script>

  <style>
    /* ================================
       KRAVN LIKES PAGE — "ticket stub" layout, cinema-pass
       A KravN post is a screening. Liking it is leaving your
       name on the stub. The page reads like a torn ticket under
       marquee lights, followed by a reel of who showed up.

       This pass leans further into the cinema metaphor on top of
       the original ticket shape: a "NOW SHOWING" stamp, marquee
       bulbs that chase around the ticket edge, subtle film-grain
       texture, and true sprocket holes on the tear line instead of
       plain notches.

       Still built entirely on the site's real tokens (--accent,
       --surface-1/2, --text/--text-muted, --space-*, --radius-*,
       --dur-*, --font-display/--font-body) so it follows the
       purple/gold data-theme toggle automatically.
       ================================ */

    .likes-page {
      min-height: calc(100vh - 70px);
      padding: var(--space-8) var(--space-4) var(--space-16);
      position: relative;
    }

    .likes-container {
      max-width: 640px;
      margin: 0 auto;
      position: relative;
    }

    /* ---- Back link -------------------------------------------------- */

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-bottom: var(--space-5);

      color: var(--text-muted);
      font-size: 0.88rem;
      font-weight: 600;
      text-decoration: none;
    }

    .back-link:hover,
    .back-link:focus-visible {
      color: var(--accent);
    }

    .back-link:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
      border-radius: var(--radius-sm);
    }

    .back-link svg {
      width: 16px;
      height: 16px;
      flex: none;
      transition: transform var(--dur-fast) var(--ease-out);
    }

    .back-link:hover svg {
      transform: translateX(-2px);
    }

    /* ---- Ticket header ------------------------------------------------ */
    /* Shaped like a torn stub, now with a marquee-bulb border chasing
       around the frame and a subtle grain overlay so it reads as a
       physical object under theatre lights, not a flat card. */

    .ticket {
      position: relative;
      background: var(--surface-1);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      overflow: hidden;
      margin-bottom: var(--space-7, 1.75rem);
      isolation: isolate;
    }

    /* Film grain texture, dialed in low so it reads as paper stock */
    .ticket::before {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 1;
      opacity: 0.05;
      mix-blend-mode: overlay;
      background-image:
        radial-gradient(circle at 20% 30%, #fff 0.5px, transparent 0.6px),
        radial-gradient(circle at 70% 60%, #fff 0.5px, transparent 0.6px),
        radial-gradient(circle at 40% 80%, #fff 0.5px, transparent 0.6px),
        radial-gradient(circle at 90% 20%, #fff 0.5px, transparent 0.6px);
      background-size: 5px 5px, 7px 7px, 6px 6px, 8px 8px;
    }

    /* Marquee bulbs chasing the top edge */
    .marquee-lights {
      display: flex;
      justify-content: space-between;
      padding: 8px 14px 0;
      position: relative;
      z-index: 2;
    }

    .marquee-lights span {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--accent);
      opacity: 0.25;
      animation: bulbChase 1.6s ease-in-out infinite;
    }

    .marquee-lights span:nth-child(odd) { animation-delay: 0s; }
    .marquee-lights span:nth-child(even) { animation-delay: 0.4s; }

    @keyframes bulbChase {
      0%, 100% { opacity: 0.2; box-shadow: none; }
      50% { opacity: 1; box-shadow: 0 0 6px var(--accent); }
    }

    .ticket-body {
      position: relative;
      z-index: 2;
      padding: var(--space-5) var(--space-6) var(--space-5);
    }

    .now-showing {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      margin-bottom: var(--space-2);
      padding: 3px 9px;
      border-radius: 999px;

      background: color-mix(in srgb, var(--accent) 16%, transparent);
      color: var(--accent);
      font-family: var(--font-display);
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .now-showing::before {
      content: "";
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--accent);
      animation: pulse 1.4s ease-in-out infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.75); }
    }

    .marquee-title {
      margin: 0;
      font-family: var(--font-display);
      font-weight: 600;
      letter-spacing: -0.02em;
      font-size: clamp(1.6rem, 5vw, 2.15rem);
      line-height: 1.15;
      color: var(--text);
    }

    .ticket-sub {
      margin: var(--space-2) 0 0;
      color: var(--text-muted);
      font-size: 0.95rem;
      line-height: 1.5;
      max-width: 46ch;
    }

    /* Perforated tear — now with actual sprocket holes rather than
       two big notches, closer to real 35mm stock. */
    .tear {
      position: relative;
      z-index: 2;
      height: 20px;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 0 16px;
      background-image: repeating-linear-gradient(
        to right,
        var(--border-mid) 0,
        var(--border-mid) 6px,
        transparent 6px,
        transparent 12px
      );
      background-position: center;
      background-size: 100% 2px;
      background-repeat: no-repeat;
    }

    .tear span {
      flex: none;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--bg);
      border: 1px solid var(--border-mid);
    }

    .tear span:first-child { margin-left: -20px; }
    .tear span:last-child { margin-right: -20px; margin-left: auto; }

    .stub {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: baseline;
      gap: var(--space-3);
      padding: var(--space-4) var(--space-6);
    }

    .stub-count {
      font-family: var(--font-mono, monospace);
      font-weight: 700;
      font-size: 1.5rem;
      color: var(--accent);
      font-variant-numeric: tabular-nums;
    }

    .stub-label {
      color: var(--text-muted);
      font-size: 0.88rem;
    }

    /* ---- Reel list ---------------------------------------------------- */
    /* Ordered list on purpose — this really is a sequence (who liked
       it, in order), so a running number earns its place here. */

    .reel-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    .frame {
      /* Renders offscreen rows cheaply on long lists. */
      content-visibility: auto;
      contain-intrinsic-size: 68px;
    }

    .frame-link {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      padding: var(--space-3) var(--space-4) var(--space-3) var(--space-3);

      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--surface-1);
      color: inherit;
      text-decoration: none;

      /* Sprocket edge — a filmstrip's left border, not a generic card. */
      border-left: 10px solid transparent;
      background-image: radial-gradient(circle, var(--bg) 2px, transparent 2.2px);
      background-size: 10px 12px;
      background-repeat: repeat-y;
      background-position: 0 4px;

      opacity: 0;
      transform: translateY(6px);
      animation: frameIn 0.32s ease forwards;
      animation-delay: var(--d, 0s);

      transition: border-color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
    }

    .frame-link:hover,
    .frame-link:focus-visible {
      border-color: var(--accent-dim);
      transform: translateX(2px);
    }

    .frame-link:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    .frame-number {
      flex: none;
      width: 26px;
      font-family: var(--font-mono, monospace);
      font-size: 0.78rem;
      color: var(--text-muted);
      text-align: right;
    }

    .frame-avatar {
      flex: none;
      width: 40px;
      height: 40px;
      border-radius: var(--radius-sm);

      display: flex;
      align-items: center;
      justify-content: center;

      background: var(--accent);
      color: #fff;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 0.95rem;
    }

    .frame-info {
      min-width: 0;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .frame-name {
      color: var(--text);
      font-weight: 700;
      font-size: 0.96rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .frame-link:hover .frame-name,
    .frame-link:focus-visible .frame-name {
      color: var(--accent);
    }

    /* First-row gets a small gold "front row" flourish since being
       first to like a screening is worth a nod. */
    .frame:first-child .frame-number::after {
      content: "★";
      margin-left: 3px;
      color: var(--accent);
    }

    /* ---- Empty state --------------------------------------------------- */

    .empty-state {
      padding: var(--space-8) var(--space-5);
      text-align: center;
      border: 1px dashed var(--border);
      border-radius: var(--radius-sm);
      background: var(--surface-1);
    }

    .empty-state h2 {
      margin: 0 0 var(--space-2);
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 1.15rem;
      color: var(--text);
    }

    .empty-state p {
      max-width: 340px;
      margin: 0 auto;
      color: var(--text-muted);
      font-size: 0.9rem;
      line-height: 1.5;
    }

    @keyframes frameIn {
      to { opacity: 1; transform: translateY(0); }
    }

    /* Mobile */
    @media (max-width: 600px) {
      .likes-page { padding: var(--space-4) var(--space-3) var(--space-12); }
      .ticket-body { padding: var(--space-4) var(--space-5) var(--space-4); }
      .stub { padding: var(--space-3) var(--space-5); }
      .frame-link { padding: var(--space-2) var(--space-3) var(--space-2) var(--space-2); gap: var(--space-2); }
      .frame-avatar { width: 36px; height: 36px; }
      .marquee-lights { padding: 6px 10px 0; }
    }

    /* Accessibility / performance */
    @media (prefers-reduced-motion: reduce) {
      .frame-link {
        animation: none;
        opacity: 1;
        transform: none;
        transition: none;
      }
      .back-link svg,
      .marquee-lights span,
      .now-showing::before {
        animation: none;
        transition: none;
      }
      .marquee-lights span { opacity: 0.6; }
    }
  </style>
</head>

<body>

  <%- include('partials/navbar', { currentPage: 'likesPage' }) %>

  <main class="likes-page">
    <div class="likes-container">

      <!--
        Back navigation: if the visitor arrived from the post page
        (same-origin referrer), a click just calls history.back() so
        they land exactly where they left off — same scroll position,
        no reload. If they opened this page directly (shared link,
        new tab), the href below takes them straight to the post.
        Adjust the route/field below (post.id) to match your schema.
      -->
      <a class="back-link" id="backLink" href="/posts/<%= post.id %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 18l-6-6 6-6"/>
        </svg>
        Back to <%= post.movie_name %>
      </a>

      <!-- Ticket header -->
      <section class="ticket">

        <div class="marquee-lights" aria-hidden="true">
          <span></span><span></span><span></span><span></span>
          <span></span><span></span><span></span><span></span>
        </div>

        <div class="ticket-body">
          <span class="now-showing">Now showing</span>
          <h1 class="marquee-title"><%= post.movie_name %></h1>
          <p class="ticket-sub"><%= post.title %></p>
        </div>

        <div class="tear" role="presentation">
          <span></span><span></span><span></span><span></span>
          <span></span><span></span><span></span><span></span>
          <span></span><span></span>
        </div>

        <div class="stub">
          <span class="stub-count"><%= likers.length %></span>
          <span class="stub-label">
            <%= likers.length === 1 ? 'person liked this screening' : 'people liked this screening' %>
          </span>
        </div>
      </section>

      <!-- Reel -->
      <% if (likers.length === 0) { %>

        <section class="empty-state">
          <h2>Nobody's clapped for this one yet</h2>
          <p>Be the first to like <strong><%= post.movie_name %></strong> and your name opens the reel.</p>
        </section>

      <% } else { %>

        <ol class="reel-list" aria-label="People who liked this post">

          <% likers.forEach((user, index) => {
               const delay = Math.min(index * 0.03, 0.24).toFixed(2);
          %>

            <li class="frame">
              <a
                class="frame-link"
                style="--d: <%= delay %>s"
                href="/users/<%= encodeURIComponent(user.username) %>"
                aria-label="View <%= user.username %>'s profile"
              >
                <span class="frame-number" aria-hidden="true"><%= String(index + 1).padStart(2, '0') %></span>

                <span class="frame-avatar" aria-hidden="true">
                  <%= user.username.charAt(0).toUpperCase() %>
                </span>

                <span class="frame-info">
                  <span class="frame-name"><%= user.username %></span>
                </span>
              </a>
            </li>

          <% }); %>

        </ol>

      <% } %>

    </div>
  </main>

  <script>
    (function () {
      var backLink = document.getElementById('backLink');
      if (!backLink || !document.referrer) return;
      try {
        var ref = new URL(document.referrer);
        if (ref.origin === window.location.origin) {
          backLink.addEventListener('click', function (e) {
            e.preventDefault();
            history.back();
          });
        }
      } catch (e) { /* malformed referrer, fall back to href */ }
    })();
  </script>

</body>
</html>