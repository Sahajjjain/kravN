<% const isLogin = mode === 'login'; %>
<%- include('partials/head', { title: isLogin ? 'Log in' : 'Join', bodyClass: 'auth' }) %>
<%- include('partials/posterwall', { posters }) %>
<div class="landing-shade"></div>
<main class="auth-wrap">
  <a class="brand brand--lg" href="/feed" data-egg="logo">Krav<span>N</span></a>

  <section class="auth-card k-card">
    <span class="eyebrow"><span class="dot"></span> <%= isLogin ? 'Member login' : 'Create your account' %></span>
    <h1 class="k-title"><%= isLogin ? 'Welcome back.' : 'Join KravN.' %></h1>
    <p class="k-sub"><%= isLogin ? 'Log in to continue the discussion.' : 'Share your theories, reviews and hot takes.' %></p>

    <% if (typeof notice !== 'undefined' && notice) { %><p class="auth-notice" role="status"><%= notice %></p><% } %>
    <% if (typeof error !== 'undefined' && error) { %><p class="auth-error" role="alert"><%= error %></p><% } %>

    <a class="k-btn k-btn--google" href="/auth/google">
      <svg width="20" height="20" viewBox="0 0 48 48" aria-hidden="true">
        <path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.4 30.3 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.9 6.1C12.4 13.6 17.7 9.5 24 9.5z"/>
        <path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.7c-.6 3-2.3 5.5-4.8 7.2l7.6 5.9c4.4-4.1 7-10.1 7-17.6z"/>
        <path fill="#FBBC05" d="M10.5 28.7A14.5 14.5 0 0 1 9.5 24c0-1.6.3-3.2.8-4.7l-7.9-6.1A24 24 0 0 0 0 24c0 3.9.9 7.5 2.6 10.8l7.9-6.1z"/>
        <path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.6-5.9c-2.1 1.4-4.9 2.3-8.3 2.3-6.3 0-11.6-4.1-13.5-9.8l-7.9 6.1C6.5 42.6 14.6 48 24 48z"/>
      </svg>
      <span>Continue with Google</span>
    </a>

    <div class="k-divider"><span>or use email</span></div>

    <form action="/<%= mode %>" method="POST" class="k-form" data-auth-form>
      <% if (!isLogin) { %>
        <label class="k-field">
          <span class="k-label">Username</span>
          <input type="text" name="username" placeholder="yourname" required autocomplete="username" minlength="3" maxlength="30" pattern="[A-Za-z0-9_]{3,30}" autocapitalize="none" spellcheck="false">
        </label>
      <% } %>

      <label class="k-field">
        <span class="k-label"><%= isLogin ? 'Email' : 'Gmail address' %></span>
        <input type="email" name="email" placeholder="you@gmail.com" required autocomplete="email" maxlength="100" inputmode="email" autocapitalize="none" spellcheck="false">
      </label>

      <label class="k-field">
        <span class="k-label k-label--row">
          <span>Password</span>
          <% if (isLogin) { %><a class="k-link" href="/forgot-password" tabindex="0">Forgot?</a><% } %>
        </span>
        <span class="k-pw">
          <input type="password" name="password" placeholder="••••••••" required autocomplete="<%= isLogin ? 'current-password' : 'new-password' %>" <% if (!isLogin) { %>minlength="8" maxlength="72"<% } %>>
          <button type="button" class="k-eye" data-toggle-pw aria-label="Show password" aria-pressed="false">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>
              <line class="k-eye-slash" x1="3" y1="3" x2="21" y2="21"/>
            </svg>
          </button>
        </span>
        <% if (!isLogin) { %><span class="k-hint">At least 8 characters, with a letter and a number.</span><% } %>
      </label>

      <button type="submit" class="k-btn k-btn--primary" data-submit>
        <span><%= isLogin ? 'Log in' : 'Send verification code' %></span>
      </button>
    </form>

    <p class="k-switch">
      <% if (isLogin) { %>New here? <a class="k-link" href="/register">Create an account</a>
      <% } else { %>Already a member? <a class="k-link" href="/login">Log in</a><% } %>
    </p>
  </section>
</main>

<script>
  document.querySelectorAll('[data-toggle-pw]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var input = btn.parentElement.querySelector('input');
      var show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      btn.setAttribute('aria-pressed', show);
      btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
      btn.classList.toggle('is-on', show);
    });
  });
  // prevent double submits (login/registration take a moment: password hashing, sending email)
  var form = document.querySelector('[data-auth-form]');
  var submit = document.querySelector('[data-submit]');
  if (form && submit) {
    form.addEventListener('submit', function () {
      submit.disabled = true;
      submit.classList.add('is-loading');
    });
    window.addEventListener('pageshow', function () {
      submit.disabled = false;
      submit.classList.remove('is-loading');
    });
  }
</script>
<%- include('partials/foot', { bare: true }) %>