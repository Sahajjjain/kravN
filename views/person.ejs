<%- include('partials/head', { title: person.name, description: (person.bio || '').slice(0, 160) }) %>
<%- include('partials/nav') %>

<%
  const films = person.films || [];
  const num = (v) => Number(v) || 0;
  const hasRated = films.some((f) => num(f.percent) > 0);
  const hasBox = films.some((f) => num(f.revenue) > 0);
  const hasYear = films.some((f) => num(f.year) > 0);
  const sorts = [['popular', 'Popular']];
  if (hasRated) sorts.push(['rated', 'Top rated']);
  if (hasYear) sorts.push(['newest', 'Newest'], ['oldest', 'Oldest']);
  if (hasBox) sorts.push(['box', 'Box office']);
  const insta = person.external && person.external.instagram;
%>

<style>
  /* ---------- hero ---------- */
  .pf-hero {
    position: relative; isolation: isolate; overflow: hidden;
    margin-top: calc(var(--nav-h) * -1); padding-top: var(--nav-h);
    background: var(--bg-2);
  }
  .pf-bg { position: absolute; inset: -30px; z-index: 0; background-size: cover; background-position: center 20%; filter: blur(38px) saturate(1.1); opacity: .38; transform: scale(1.1); }
  .pf-shade {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background:
      linear-gradient(90deg, var(--bg) 0%, color-mix(in srgb, var(--bg) 70%, transparent) 55%, color-mix(in srgb, var(--bg) 30%, transparent) 100%),
      linear-gradient(0deg, var(--bg) 0%, transparent 45%);
  }
  .pf-inner { position: relative; z-index: 2; width: min(1400px, 100% - 96px); margin: 0 auto; }
  .pf-head { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 34px; align-items: end; padding: 56px 0 34px; }

  .pf-photo {
    width: clamp(190px, 19vw, 270px); aspect-ratio: 2/3; object-fit: cover; object-position: center top; display: block;
    border-radius: 18px; border: 1px solid rgba(255, 255, 255, .12); box-shadow: 0 30px 60px -24px rgba(0, 0, 0, .85);
    cursor: zoom-in; transition: transform .3s ease;
  }
  .pf-photo:hover { transform: translateY(-3px); }
  .pf-photo--none {
    display: grid; place-items: center; cursor: default; font-size: 72px; font-weight: 700; color: #fff;
    background: linear-gradient(160deg, hsl(var(--h) 55% 38%), hsl(calc(var(--h) + 40) 55% 22%));
  }
  .pf-photo--none:hover { transform: none; }

  .pf-info { display: grid; gap: 14px; justify-items: start; min-width: 0; }
  .pf-name {
    margin: 0; font-size: clamp(32px, 5vw, 60px); font-weight: 700; letter-spacing: -.035em; line-height: 1.05; overflow-wrap: anywhere;
    background: linear-gradient(180deg, #fff 30%, color-mix(in srgb, var(--text) 62%, transparent));
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  }

  /* fact chips */
  .pf-facts { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; }
  .pf-fact {
    display: inline-flex; align-items: baseline; gap: 8px; max-width: 100%; padding: 8px 14px; border-radius: 12px;
    background: color-mix(in srgb, var(--text) 5%, transparent); border: 1px solid color-mix(in srgb, var(--text) 10%, transparent);
  }
  .pf-fact dt { margin: 0; font-size: 10.5px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--accent-2); flex: none; }
  .pf-fact dd { margin: 0; font-size: 13px; color: color-mix(in srgb, var(--text) 88%, transparent); }

  .pf-bio { max-width: 74ch; color: color-mix(in srgb, var(--text) 74%, transparent); font-size: 14.5px; line-height: 1.65; }
  .pf-bio .review-text { margin: 0 0 6px; }

  /* instagram pill */
  .pf-insta {
    display: inline-flex; align-items: center; gap: 10px; height: 42px; padding: 0 20px 0 16px; border-radius: 999px;
    font: 500 13px/1 var(--font); letter-spacing: .03em; color: #fff; text-decoration: none; white-space: nowrap;
    border: 1px solid rgba(255, 255, 255, .26); background: transparent;
    transition: transform .25s ease, background .25s ease, border-color .25s ease;
  }
  .pf-insta svg { width: 18px; height: 18px; flex: none; }
  .pf-insta:hover { transform: translateY(-2px); border-color: transparent; background: linear-gradient(45deg, #f09433, #dc2743 50%, #bc1888); }
  .pf-insta:active { transform: scale(.97); }

  /* ---------- sections ---------- */
  .pf-h { display: flex; align-items: center; gap: 10px; margin: 0; font-size: clamp(17px, 2vw, 21px); font-weight: 700; letter-spacing: -.015em; }
  .pf-h i { width: 3px; height: 1em; border-radius: 3px; background: linear-gradient(180deg, var(--accent-2), var(--accent)); flex: none; }
  .pf-h .count { font-size: 12px; font-weight: 600; padding: 3px 9px; border-radius: 999px; color: color-mix(in srgb, var(--text) 75%, transparent); background: color-mix(in srgb, var(--text) 8%, transparent); }

  .pf-sec { margin-top: 26px; }
  .pf-sechead { display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; margin-bottom: 14px; }

  .pf-photos .photo { border-radius: 12px; overflow: hidden; }
  .pf-photos .photo img { border-radius: 12px; }

  /* sort control */
  .pf-sort {
    display: flex; align-items: center; gap: 4px; padding: 4px; width: fit-content; max-width: 100%; overflow-x: auto; scrollbar-width: none;
    border-radius: 999px; background: color-mix(in srgb, var(--text) 5%, transparent); border: 1px solid color-mix(in srgb, var(--text) 10%, transparent);
  }
  .pf-sort::-webkit-scrollbar { display: none; }
  .pf-sort button {
    flex: none; height: 30px; padding: 0 14px; border: 0; border-radius: 999px; cursor: pointer; background: transparent;
    font: 500 12.5px/1 var(--font); white-space: nowrap; color: color-mix(in srgb, var(--text) 72%, transparent); transition: background .2s, color .2s;
  }
  .pf-sort button:hover { color: #fff; }
  .pf-sort button.on { color: #fff; background: var(--accent); box-shadow: 0 8px 20px -12px color-mix(in srgb, var(--accent) 90%, transparent); }

  /* films grid */
  .pf-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 18px 14px; align-items: start; padding-bottom: 28px; }
  .pf-grid > * { min-width: 0; transition: transform .25s ease; }
  .pf-grid > *:hover { transform: translateY(-4px); }
  .pf-grid img { border-radius: 12px; }

  @media (min-width: 900px) { .pf-grid { grid-template-columns: repeat(auto-fill, minmax(176px, 1fr)); gap: 22px 16px; } }
  @media (min-width: 1600px) { .pf-inner { width: min(1560px, 100% - 144px); } }
  @media (max-width: 1099px) { .pf-inner { width: calc(100% - 48px); } }

  /* ---------- phone ---------- */
  @media (max-width: 640px) {
    .pf-inner { width: calc(100% - 32px); }
    .pf-head { grid-template-columns: 1fr; justify-items: center; text-align: center; gap: 18px; padding: 28px 0 22px; }
    .pf-photo { width: 52vw; max-width: 210px; border-radius: 16px; }
    .pf-info { justify-items: center; gap: 12px; }
    .pf-facts { justify-content: center; }
    .pf-fact { flex-direction: column; align-items: center; gap: 3px; padding: 8px 12px; text-align: center; }
    .pf-bio { text-align: left; font-size: 14px; }
    .pf-sort { width: 100%; justify-content: space-between; }
    .pf-sort button { flex: 1 1 auto; padding: 0 10px; }
    .pf-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 10px; }
    .pf-grid img { border-radius: 10px; }
  }
  @media (hover: none) { .pf-grid > *:hover, .pf-photo:hover { transform: none; } }
</style>

<main class="page page--flush">

  <!-- ============ HERO ============ -->
  <section class="pf-hero">
    <% if (person.photo) { %><div class="pf-bg" style="background-image:url('<%= person.photo %>')" aria-hidden="true"></div><% } %>
    <div class="pf-shade" aria-hidden="true"></div>

    <div class="pf-inner">
      <header class="pf-head">
        <% if (person.photo) { %><img class="pf-photo" src="<%= person.photo %>" alt="<%= person.name %>" data-lightbox="<%= person.photo %>"><% } else { %><span class="pf-photo pf-photo--none" style="--h:<%= hue(person.name) %>"><%= person.name.charAt(0) %></span><% } %>

        <div class="pf-info">
          <span class="eyebrow"><span class="dot"></span> <%= person.department || 'Person' %></span>
          <h1 class="pf-name"><%= person.name %></h1>

          <dl class="pf-facts">
            <% if (person.birthday) { %><div class="pf-fact"><dt>Born</dt><dd><%= longDate(person.birthday) %><%= person.birthplace ? ' · ' + person.birthplace : '' %></dd></div><% } %>
            <% if (person.deathday) { %><div class="pf-fact"><dt>Died</dt><dd><%= longDate(person.deathday) %></dd></div><% } %>
            <% if (person.alsoKnownAs && person.alsoKnownAs.length) { %><div class="pf-fact"><dt>Also known as</dt><dd><%= person.alsoKnownAs.slice(0, 3).join(' · ') %></dd></div><% } %>
          </dl>

          <% if (person.bio) { %>
            <div data-collapse class="bio pf-bio"><p class="review-text"><%= person.bio %></p><button type="button" class="link-btn" data-collapse-btn>Read more</button></div>
          <% } %>

          <% if (insta) { %>
            <a class="pf-insta" href="<%= insta %>" target="_blank" rel="noopener noreferrer" aria-label="<%= person.name %> on Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none"/></svg>
              Instagram
            </a>
          <% } %>
        </div>
      </header>
    </div>
  </section>

  <div class="shell">

    <!-- ============ PHOTOS ============ -->
    <% if (person.photos && person.photos.length > 1) { %>
      <section class="pf-sec pf-photos" data-rail>
        <div class="pf-sechead"><h2 class="pf-h"><i></i>Photos</h2></div>
        <div class="rail-wrap">
          <button type="button" class="rail-btn prev" data-rail-btn="-1" aria-label="Scroll left"><%- include('partials/icon', { n: 'prev' }) %></button>
          <div class="rail-track"><% person.photos.forEach((p) => { %><button type="button" class="photo photo--tall" data-lightbox="<%= p.full %>"><img src="<%= p.thumb %>" alt="<%= person.name %>" loading="lazy"></button><% }) %></div>
          <button type="button" class="rail-btn next" data-rail-btn="1" aria-label="Scroll right"><%- include('partials/icon', { n: 'next' }) %></button>
        </div>
      </section>
    <% } %>

    <!-- ============ FILMS ============ -->
    <section class="pf-sec">
      <div class="pf-sechead">
        <h2 class="pf-h"><i></i>Films <span class="count"><%= films.length %></span></h2>
        <% if (films.length > 1 && sorts.length > 1) { %>
          <div class="pf-sort" role="group" aria-label="Sort films">
            <% sorts.forEach(([key, label], i) => { %><button type="button" class="<%= i === 0 ? 'on' : '' %>" data-sort="<%= key %>"><%= label %></button><% }) %>
          </div>
        <% } %>
      </div>

      <% if (films.length) { %>
        <div class="pf-grid" id="pf-films">
          <% films.forEach((f, i) => { %>
            <div data-i="<%= i %>" data-rated="<%= num(f.percent) %>" data-year="<%= num(f.year) %>" data-box="<%= num(f.revenue) %>"><%- include('partials/movieCard', { m: f, sub: f.role }) %></div>
          <% }) %>
        </div>
      <% } else { %><p class="muted">No films listed.</p><% } %>
    </section>
  </div>
</main>

<script>
  (function () {
    var grid = document.getElementById('pf-films'), bar = document.querySelector('.pf-sort');
    if (!grid || !bar) return;
    var keys = {
      popular: function (a, b) { return a.i - b.i; },
      rated:   function (a, b) { return b.rated - a.rated || a.i - b.i; },
      newest:  function (a, b) { return b.year - a.year || a.i - b.i; },
      oldest:  function (a, b) { return (a.year || 9999) - (b.year || 9999) || a.i - b.i; },
      box:     function (a, b) { return b.box - a.box || a.i - b.i; }
    };
    bar.addEventListener('click', function (e) {
      var btn = e.target.closest('button[data-sort]');
      if (!btn) return;
      bar.querySelectorAll('button').forEach(function (b) { b.classList.toggle('on', b === btn); });
      var items = Array.prototype.map.call(grid.children, function (el) {
        return { el: el, i: +el.dataset.i, rated: +el.dataset.rated, year: +el.dataset.year, box: +el.dataset.box };
      });
      items.sort(keys[btn.dataset.sort]).forEach(function (o) { grid.appendChild(o.el); });
    });
  })();
</script>

<%- include('partials/foot') %>