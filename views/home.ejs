<!DOCTYPE html>
<html data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KravN — Where theories come alive</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/theme.js"></script>
</head>
<body>
  <div class="landing-page">
    <div class="landing-poster-strip">
      <% if (typeof posters !== 'undefined' && posters.length) { %>
        <% posters.slice(0, 24).forEach(url => { %>
          <img src="<%= url %>" alt="" onerror="this.remove()">
        <% }); %>
      <% } %>
    </div>
    <div class="landing-overlay"></div>

    <div class="landing-content">
      <span class="landing-eyebrow">Movie &amp; Series Discussions</span>
      <h1 class="landing-logo">Krav<span>N</span></h1>
      <p class="landing-tagline">Where theories come alive.</p>

      <div class="hero-actions">
        <a class="btn" href="/register">Get Started</a>
        <a class="btn secondary" href="/login">Login</a>
      </div>
    </div>
  </div>
</body>
</html>