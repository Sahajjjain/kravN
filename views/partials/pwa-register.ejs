<style>
  .kravn-install-toast {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%) translateY(120%);
    z-index: 2000;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.9rem 1.1rem;
    border-radius: 14px;
    background: #0a0a0c;
    border: 1px solid rgba(var(--kravn-primary-rgb, 139,92,246), 0.4);
    box-shadow: 0 20px 50px rgba(0,0,0,0.55), 0 0 0 1px rgba(var(--kravn-primary-rgb, 139,92,246), 0.08);
    max-width: 92vw;
    width: 380px;
    transition: transform 0.35s cubic-bezier(0.22,1,0.36,1);
  }
  .kravn-install-toast.show { transform: translateX(-50%) translateY(0); }

  .kravn-install-icon {
    width: 42px; height: 42px;
    border-radius: 10px;
    flex-shrink: 0;
    background: linear-gradient(135deg, var(--kravn-primary, #8b5cf6), var(--kravn-primary-dark, #6d28d9));
    display: flex; align-items: center; justify-content: center;
    font-weight: 800;
    font-size: 1.1rem;
    color: #fff;
  }

  .kravn-install-text { flex: 1; min-width: 0; }
  .kravn-install-title {
    font-weight: 700;
    font-size: 0.88rem;
    color: #fff;
    margin-bottom: 2px;
  }
  .kravn-install-sub {
    font-size: 0.74rem;
    color: rgba(255,255,255,0.55);
  }

  .kravn-install-actions {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  .kravn-install-btn {
    padding: 0.5rem 0.9rem;
    border-radius: 8px;
    border: 1px solid rgba(var(--kravn-primary-rgb, 139,92,246), 0.5);
    background: linear-gradient(135deg, var(--kravn-primary, #8b5cf6), var(--kravn-primary-dark, #6d28d9));
    color: #fff;
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    white-space: nowrap;
  }
  .kravn-install-dismiss {
    padding: 0.5rem 0.7rem;
    border-radius: 8px;
    border: none;
    background: transparent;
    color: rgba(255,255,255,0.45);
    font-size: 0.9rem;
    cursor: pointer;
  }
  .kravn-install-dismiss:hover { color: #fff; }

  @media (max-width: 480px) {
    .kravn-install-toast { width: calc(100vw - 24px); bottom: 90px; }
  }
</style>

<div class="kravn-install-toast" id="kravn-install-toast">
  <div class="kravn-install-icon">N</div>
  <div class="kravn-install-text">
    <div class="kravn-install-title">Install KravN</div>
    <div class="kravn-install-sub">Add to your home screen for quick access</div>
  </div>
  <div class="kravn-install-actions">
    <button class="kravn-install-btn" id="kravn-install-btn">Install</button>
    <button class="kravn-install-dismiss" id="kravn-install-dismiss" title="Dismiss">✕</button>
  </div>
</div>

<script>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js')
        .catch((err) => console.error('SW registration failed:', err));
    });
  }

  let kravnDeferredPrompt = null;

  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    kravnDeferredPrompt = e;

    if (sessionStorage.getItem('kravnInstallDismissed')) return;

    const toast = document.getElementById('kravn-install-toast');
    if (toast) {
      setTimeout(() => toast.classList.add('show'), 1200);
    }
  });

  const installBtn = document.getElementById('kravn-install-btn');
  const dismissBtn = document.getElementById('kravn-install-dismiss');
  const toastEl = document.getElementById('kravn-install-toast');

  if (installBtn) {
    installBtn.addEventListener('click', async () => {
      if (!kravnDeferredPrompt) return;
      toastEl.classList.remove('show');
      kravnDeferredPrompt.prompt();
      const { outcome } = await kravnDeferredPrompt.userChoice;
      kravnDeferredPrompt = null;
      if (outcome === 'accepted') {
        fetch('/api/track-install', { method: 'POST' }).catch(() => {});
      }
    });
  }

  if (dismissBtn) {
    dismissBtn.addEventListener('click', () => {
      toastEl.classList.remove('show');
      sessionStorage.setItem('kravnInstallDismissed', '1');
    });
  }

  window.addEventListener('appinstalled', () => {
    if (toastEl) toastEl.classList.remove('show');
    fetch('/api/track-install', { method: 'POST' }).catch(() => {});
  });
</script>