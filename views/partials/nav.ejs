<%# Watchlist: one script (its styles are inside it) loads on every page that shows the nav %>
<script src="/js/watchlist.js?v=<%= locals.wlV || assetV %>" defer data-watchlist data-me="<%= me ? 1 : 0 %>"></script>
<style>
  /* =====================================================================
     NAV — one controlled breakpoint (820px) so nothing goes missing on phones.
     Desktop: refined glass top bar.  Phone: slim top bar (search · alerts · profile menu)
     + a glass bottom bar (Home · Talk · New · Watchlist · Me).
     ===================================================================== */

  /* ---------- top bar finish (all sizes) ---------- */
  #topnav {
    -webkit-backdrop-filter: blur(18px) saturate(1.25); backdrop-filter: blur(18px) saturate(1.25);
    border-bottom: 1px solid color-mix(in srgb, var(--text) 8%, transparent);
  }
  #topnav .brand { font-weight: 800; letter-spacing: -.03em; text-decoration: none; -webkit-tap-highlight-color: transparent; white-space: nowrap; }

  /* back button + brand grouped on the left */
  #topnav .topnav-left { display: flex; align-items: center; gap: 10px; flex: none; }

  /* round icon buttons */
  #topnav .icon-btn {
    display: inline-grid; place-items: center; width: 38px; height: 38px; padding: 0; border: 0; border-radius: 50%; position: relative; cursor: pointer;
    background: transparent; color: color-mix(in srgb, var(--text) 78%, transparent); -webkit-tap-highlight-color: transparent;
    transition: background .2s ease, color .2s ease, transform .2s ease;
  }
  #topnav .icon-btn svg { width: 19px; height: 19px; }
  #topnav .icon-btn:hover { background: color-mix(in srgb, var(--text) 9%, transparent); color: var(--text); }
  #topnav .icon-btn:active { transform: scale(.92); }
  #topnav .topnav-bell.on { color: var(--accent); }
  #topnav .topnav-bell .badge-dot {
    position: absolute; top: 2px; right: 0; min-width: 16px; height: 16px; padding: 0 4px; border-radius: 999px; text-align: center;
    font: 700 10px/16px var(--font); font-style: normal; color: #fff; background: var(--accent); box-shadow: 0 0 0 2px var(--bg);
  }

  /* avatar button: soft ring */
  #topnav .avatar--btn { cursor: pointer; border: 0; box-shadow: 0 0 0 2px var(--bg), 0 0 0 3px color-mix(in srgb, var(--text) 18%, transparent); transition: box-shadow .2s ease, transform .2s ease; }
  #topnav .avatar--btn:hover { box-shadow: 0 0 0 2px var(--bg), 0 0 0 3px color-mix(in srgb, var(--accent) 75%, transparent); }
  #topnav .avatar--btn:active { transform: scale(.94); }

  /* hollow pill buttons (match the rest of the site) */
  #topnav .topnav-new, #topnav .topnav-join {
    display: inline-flex; align-items: center; justify-content: center; gap: 7px; height: 36px; padding: 0 16px; margin: 0; border-radius: 999px;
    font: 500 12.5px/1 var(--font); letter-spacing: .03em; color: #fff; white-space: nowrap; text-decoration: none; background: transparent; box-shadow: none;
    border: 1px solid color-mix(in srgb, var(--accent) 85%, #fff 10%); transition: transform .2s ease, background .2s ease, border-color .2s ease;
  }
  #topnav .topnav-new svg { width: 15px; height: 15px; }
  #topnav .topnav-new:hover, #topnav .topnav-join:hover { background: var(--accent); border-color: var(--accent); transform: translateY(-1px); }
  #topnav .topnav-login {
    display: inline-flex; align-items: center; justify-content: center; height: 36px; padding: 0 14px; border-radius: 999px; text-decoration: none;
    font: 500 12.5px/1 var(--font); letter-spacing: .03em; color: color-mix(in srgb, var(--text) 82%, transparent); background: transparent; border: 1px solid transparent; box-shadow: none;
    transition: background .2s ease, color .2s ease;
  }
  #topnav .topnav-login:hover { background: color-mix(in srgb, var(--text) 8%, transparent); color: var(--text); }

  /* ---------- account menu (shared) ---------- */
  #topnav .menu-pop {
    padding: 6px; border-radius: 16px; background: color-mix(in srgb, var(--surface) 94%, transparent);
    -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px);
    border: 1px solid color-mix(in srgb, var(--text) 12%, transparent); box-shadow: 0 24px 50px -20px rgba(0, 0, 0, .75);
  }
  #topnav .menu-who { padding: 10px 12px 8px; font-size: 12.5px; font-weight: 600; letter-spacing: .01em; color: color-mix(in srgb, var(--text) 58%, transparent); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  #topnav .menu-pop a, #topnav .menu-pop button {
    display: flex; align-items: center; gap: 11px; width: 100%; padding: 10px 12px; border: 0; border-radius: 10px;
    background: none; color: inherit; font: 500 14px/1.2 var(--font); text-align: left; cursor: pointer; text-decoration: none;
    transition: background .15s ease;
  }
  #topnav .menu-pop a:hover, #topnav .menu-pop button:hover { background: color-mix(in srgb, var(--text) 8%, transparent); }
  #topnav .menu-pop svg { width: 17px; height: 17px; flex: none; opacity: .8; }
  #topnav .menu-pop .menu-sep { height: 1px; margin: 6px 4px; background: color-mix(in srgb, var(--text) 10%, transparent); }
  #topnav .menu-pop .menu-badge { margin-left: auto; min-width: 18px; height: 18px; padding: 0 5px; border-radius: 999px; display: grid; place-items: center; font-size: 10.5px; font-weight: 700; color: #fff; background: var(--accent); }
  #topnav .menu-pop .menu-theme { display: none; }

  /* ---------- full-screen search ---------- */
  #search-overlay .search-form {
    display: flex; align-items: center; gap: 12px; height: 56px; padding: 0 10px 0 20px; border-radius: 999px;
    background: color-mix(in srgb, var(--text) 6%, var(--surface)); border: 1px solid color-mix(in srgb, var(--text) 14%, transparent);
    transition: border-color .2s ease, box-shadow .2s ease;
  }
  #search-overlay .search-form:focus-within { border-color: color-mix(in srgb, var(--accent) 75%, transparent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 16%, transparent); }
  #search-overlay .search-form > svg { flex: none; width: 19px; height: 19px; color: color-mix(in srgb, var(--text) 55%, transparent); }
  #search-overlay .search-form input { flex: 1; min-width: 0; height: 100%; margin: 0; padding: 0; border: 0; outline: 0; background: transparent; box-shadow: none; font: 500 16px/1 var(--font); color: var(--text); -webkit-appearance: none; appearance: none; }
  #search-overlay .search-form input::placeholder { color: color-mix(in srgb, var(--text) 45%, transparent); }
  #search-overlay .search-form input::-webkit-search-cancel-button { -webkit-appearance: none; display: none; }
  #search-overlay .search-form .icon-btn { flex: none; width: 38px; height: 38px; border-radius: 50%; }
  #search-overlay .search-hint { margin-top: 14px; text-align: center; font-size: 12.5px; color: color-mix(in srgb, var(--text) 50%, transparent); }
  #search-overlay kbd { display: inline-block; padding: 2px 7px; border-radius: 6px; font: 600 11px/1.3 var(--font); color: color-mix(in srgb, var(--text) 80%, transparent); background: color-mix(in srgb, var(--text) 8%, transparent); border: 1px solid color-mix(in srgb, var(--text) 14%, transparent); }

  /* ---------- desktop (≥ 821px) ---------- */
  @media (min-width: 821px) {
    #topnav .topnav-links { display: flex; align-items: center; gap: 4px; }
    #topnav .topnav-links a {
      display: inline-flex; align-items: center; height: 36px; padding: 0 15px; border-radius: 999px; text-decoration: none;
      font: 500 13.5px/1 var(--font); letter-spacing: .01em; color: color-mix(in srgb, var(--text) 68%, transparent);
      transition: background .2s ease, color .2s ease;
    }
    #topnav .topnav-links a:hover { color: var(--text); background: color-mix(in srgb, var(--text) 7%, transparent); }
    #topnav .topnav-links a.on { color: var(--text); background: color-mix(in srgb, var(--text) 11%, transparent); }
    #topnav .topnav-right { display: flex; align-items: center; gap: 6px; }
    #topnav .topnav-new { margin: 0 4px; }
    .bottomnav { display: none; }
  }

  /* ---------- phone / small tablet (≤ 820px) ---------- */
  @media (max-width: 820px) {
    #topnav .topnav-left { gap: 8px; }
    #topnav .topnav-links { display: none; }
    #topnav .topnav-new { display: none; }                 /* the + in the bottom bar replaces it */
    #topnav .topnav-right { display: flex; align-items: center; gap: 2px; margin-left: auto; }
    #topnav .topnav-right > .icon-btn,
    #topnav .topnav-right .topnav-bell { display: inline-grid; width: 40px; height: 40px; place-items: center; position: relative; }
    #topnav .has-me .topnav-theme { display: none; }       /* theme moves into the account menu */
    #topnav .menu { display: block; position: relative; margin-left: 4px; }
    #topnav .menu .avatar--btn { display: grid; width: 34px; height: 34px; font-size: 14px; }
    #topnav .menu-pop { right: 0; left: auto; min-width: 224px; max-width: calc(100vw - 20px); }
    #topnav .menu-pop .menu-theme { display: flex; }
    /* logged-out: compact Log in + Sign up stay visible */
    #topnav .topnav-login, #topnav .topnav-join { display: inline-flex; height: 32px; padding: 0 12px; font-size: 13px; margin-left: 2px; }

    #search-overlay .search-form { height: 50px; padding-left: 16px; }
    #search-overlay .search-form input { font-size: 16px; }   /* stops iOS zooming on focus */

    /* ---------- bottom bar ---------- */
    .bottomnav {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 60; display: grid; grid-template-columns: repeat(5, 1fr); align-items: end;
      padding: 6px 8px calc(6px + env(safe-area-inset-bottom)); min-height: 60px; border-radius: 20px 20px 0 0;
      background: color-mix(in srgb, var(--bg) 82%, transparent);
      -webkit-backdrop-filter: blur(20px) saturate(1.3); backdrop-filter: blur(20px) saturate(1.3);
      border-top: 1px solid color-mix(in srgb, var(--text) 10%, transparent);
      box-shadow: 0 -14px 34px -22px rgba(0, 0, 0, .8);
    }
    .bottomnav a {
      position: relative; isolation: isolate; display: grid; justify-items: center; align-content: center; gap: 3px; min-width: 0; height: 46px;
      color: color-mix(in srgb, var(--text) 56%, transparent); font-size: 10.5px; font-weight: 600; letter-spacing: .02em; text-decoration: none;
      -webkit-tap-highlight-color: transparent; transition: color .2s ease, transform .15s ease;
    }
    .bottomnav a svg { width: 21px; height: 21px; transition: color .2s ease; }
    .bottomnav a span { line-height: 1; white-space: nowrap; }
    .bottomnav a.on { color: var(--text); }
    .bottomnav a.on svg { color: var(--accent); }
    /* active: soft accent pill behind the icon */
    .bottomnav a.on::before {
      content: ''; position: absolute; z-index: -1; top: 3px; left: 50%; width: 46px; height: 28px; transform: translateX(-50%);
      border-radius: 999px; background: color-mix(in srgb, var(--accent) 17%, transparent);
    }
    .bottomnav a:active { transform: scale(.93); }

    /* centre action */
    .bottomnav .bottomnav-new {
      width: 52px; height: 52px; margin: -24px auto 0; border-radius: 50%; display: grid; place-items: center; color: #fff;
      background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 88%, #fff), var(--accent));
      border: 4px solid var(--bg); box-shadow: 0 10px 22px -8px color-mix(in srgb, var(--accent) 70%, #000);
    }
    .bottomnav .bottomnav-new svg { width: 22px; height: 22px; color: #fff; }
    .bottomnav .bottomnav-new::before { display: none; }

    .bottomnav .bn-av { width: 24px; height: 24px; font-size: 11px; display: grid; place-items: center; box-shadow: 0 0 0 2px transparent; transition: box-shadow .2s ease; }
    .bottomnav a.on .bn-av { box-shadow: 0 0 0 2px var(--accent); }

    /* keep page content clear of the fixed bar */
    body { padding-bottom: calc(68px + env(safe-area-inset-bottom)); }
  }

  /* very small phones: keep the header from overflowing (Log in also lives in the bottom bar) */
  @media (max-width: 400px) {
    #topnav .topnav-left { gap: 6px; }
    #topnav .topnav-login { display: none; }
  }
</style>

<header class="topnav" id="topnav">
  <div class="topnav-left">
    <%- include('back-button') %>
    <a class="brand" href="/feed" aria-label="KravN home" data-egg="logo">Krav<span>N</span></a>
  </div>

  <nav class="topnav-links" aria-label="Main">
    <a href="/feed" class="<%= nav === 'home' ? 'on' : '' %>"<%- nav === 'home' ? ' aria-current="page"' : '' %>>Home</a>
    <a href="/discussions" class="<%= nav === 'discussions' ? 'on' : '' %>"<%- nav === 'discussions' ? ' aria-current="page"' : '' %>>Discussions</a>
    <% if (me) { %><a href="/watchlist" class="<%= nav === 'watchlist' ? 'on' : '' %>"<%- nav === 'watchlist' ? ' aria-current="page"' : '' %>>Watchlist</a><% } %>
    <% if (me) { %><a href="/dashboard" class="<%= nav === 'dashboard' ? 'on' : '' %>"<%- nav === 'dashboard' ? ' aria-current="page"' : '' %>>Dashboard</a><% } %>
    <a href="/about" class="<%= nav === 'about' ? 'on' : '' %>"<%- nav === 'about' ? ' aria-current="page"' : '' %>>About</a>
  </nav>

  <div class="topnav-right<%= me ? ' has-me' : '' %>">
    <button type="button" class="icon-btn" data-act="search" aria-label="Search movies, series, people and discussions"><%- include('icon', { n: 'search' }) %></button>
    <a class="btn btn-primary btn-sm topnav-new" href="<%= me ? '/posts/new' : '/login?next=/posts/new' %>"><%- include('icon', { n: 'plus' }) %><span>Start a discussion</span></a>
    <% if (me) { %><a class="icon-btn topnav-bell<%= nav === 'notifications' ? ' on' : '' %>" href="/notifications" aria-label="Notifications"<%- nav === 'notifications' ? ' aria-current="page"' : '' %>>
      <%- include('icon', { n: 'bell' }) %><% if (unread > 0) { %><i class="badge-dot"><%= unread > 9 ? '9+' : unread %></i><% } %>
    </a><% } %>
    <button type="button" class="icon-btn topnav-theme" data-act="theme" aria-label="Switch theme"><span class="theme-sun"><%- include('icon', { n: 'sun' }) %></span><span class="theme-moon"><%- include('icon', { n: 'moon' }) %></span></button>
    <% if (!me) { %>
      <a class="btn btn-ghost btn-sm topnav-login" href="/login?next=<%= encodeURIComponent(here) %>">Log in</a>
      <a class="btn btn-primary btn-sm topnav-join" href="/register?next=<%= encodeURIComponent(here) %>">Sign up</a>
    <% } %>
    <% if (me) { %>
      <div class="menu" data-menu>
        <button type="button" class="avatar avatar--btn" style="--h:<%= hue(me.username) %>" data-menu-btn aria-label="Account menu" aria-haspopup="true"><%= me.username.charAt(0).toUpperCase() %></button>
        <div class="menu-pop" role="menu">
          <div class="menu-who">@<%= me.username %></div>
          <a href="/users/<%= encodeURIComponent(me.username) %>" role="menuitem"><%- include('icon', { n: 'user' }) %> My profile</a>
          <a href="/watchlist" role="menuitem"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 3.5h12a1 1 0 0 1 1 1V21l-7-4.5L5 21V4.5a1 1 0 0 1 1-1z"/></svg> My watchlist</a>
          <a href="/dashboard" role="menuitem"><%- include('icon', { n: 'home' }) %> My dashboard</a>
          <a href="/notifications" role="menuitem"><%- include('icon', { n: 'bell' }) %> Notifications<% if (unread > 0) { %><span class="menu-badge"><%= unread > 9 ? '9+' : unread %></span><% } %></a>
          <a href="/posts/new" role="menuitem"><%- include('icon', { n: 'plus' }) %> Start a discussion</a>
          <div class="menu-sep"></div>
          <button type="button" class="menu-theme" role="menuitem" data-act="theme"><%- include('icon', { n: 'sun' }) %> Switch theme</button>
          <a href="/about" role="menuitem"><%- include('icon', { n: 'info' }) %> About KravN</a>
          <a href="/logout" role="menuitem"><%- include('icon', { n: 'logout' }) %> Log out</a>
        </div>
      </div>
    <% } %>
  </div>
</header>

<!-- full-screen search -->
<div class="overlay search-overlay" id="search-overlay" hidden>
  <div class="overlay-inner">
    <form class="search-form" action="/search" method="GET" role="search">
      <%- include('icon', { n: 'search' }) %>
      <input type="search" name="q" id="search-input" placeholder="Search movies, series, actors or discussions…" autocomplete="off" aria-label="Search" data-livesearch data-target="#search-results">
      <button type="button" class="icon-btn" data-act="close-overlay" aria-label="Close search"><%- include('icon', { n: 'x' }) %></button>
    </form>
    <div class="live-results" id="search-results"></div>
    <p class="search-hint">Press <kbd>Enter</kbd> to see every result · <kbd>Esc</kbd> to close</p>
  </div>
</div>

<nav class="bottomnav" aria-label="Quick navigation">
  <a href="/feed" class="<%= nav === 'home' ? 'on' : '' %>"<%- nav === 'home' ? ' aria-current="page"' : '' %>><%- include('icon', { n: 'home' }) %><span>Home</span></a>
  <a href="/discussions" class="<%= nav === 'discussions' ? 'on' : '' %>"<%- nav === 'discussions' ? ' aria-current="page"' : '' %>><%- include('icon', { n: 'chat' }) %><span>Talk</span></a>
  <a href="<%= me ? '/posts/new' : '/login?next=/posts/new' %>" class="bottomnav-new" aria-label="Start a discussion"><%- include('icon', { n: 'plus' }) %></a>
  <% if (me) { %>
  <a href="/watchlist" class="<%= nav === 'watchlist' ? 'on' : '' %>"<%- nav === 'watchlist' ? ' aria-current="page"' : '' %>><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 3.5h12a1 1 0 0 1 1 1V21l-7-4.5L5 21V4.5a1 1 0 0 1 1-1z"/></svg><span>Watchlist</span></a>
  <a href="/dashboard" class="<%= nav === 'dashboard' ? 'on' : '' %>"<%- nav === 'dashboard' ? ' aria-current="page"' : '' %>><span class="avatar bn-av" style="--h:<%= hue(me.username) %>"><%= me.username.charAt(0).toUpperCase() %></span><span>Me</span></a>
  <% } else { %>
  <a href="/about" class="<%= nav === 'about' ? 'on' : '' %>"<%- nav === 'about' ? ' aria-current="page"' : '' %>><%- include('icon', { n: 'info' }) %><span>About</span></a>
  <a href="/login?next=<%= encodeURIComponent(here) %>"><%- include('icon', { n: 'user' }) %><span>Log in</span></a>
  <% } %>
</nav>