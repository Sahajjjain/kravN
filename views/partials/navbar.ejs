<script>
  /* Top bar hides on scroll-down, reappears on scroll-up. Bottom nav
     is left alone — it's meant to stay reachable at all times.

     Fix: previously, navigating back to a page (e.g. tapping the
     browser/back-button to return to /feed after scrolling down on
     it earlier) could restore the old scroll position via the
     browser's native scroll restoration *before* this script's
     lastY baseline was set, or leave a stale 'topbar-hidden' class
     from a bfcache-restored page — making the bar appear "stuck"
     hidden right after navigating back. We now explicitly reset the
     bar to visible and re-baseline lastY on every page-show event,
     including bfcache restores (event.persisted). */
  (function initKravnTopbarAutoHide() {
    const topbar = document.querySelector('.topbar');
    if (!topbar) return;

    let lastY = window.scrollY;
    let ticking = false;
    const THRESHOLD = 6;   // ignore tiny jitters
    const REVEAL_ZONE = 40; // always show bar near the very top

    function resetTopbar() {
      topbar.classList.remove('topbar-hidden');
      lastY = window.scrollY;
    }

    function onScroll() {
      const y = window.scrollY;
      const delta = y - lastY;

      if (y < REVEAL_ZONE) {
        topbar.classList.remove('topbar-hidden');
      } else if (delta > THRESHOLD) {
        topbar.classList.add('topbar-hidden');
      } else if (delta < -THRESHOLD) {
        topbar.classList.remove('topbar-hidden');
      }

      lastY = y;
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(onScroll);
        ticking = true;
      }
    }, { passive: true });

    // Covers: fresh load, back/forward navigation, and bfcache restores.
    window.addEventListener('pageshow', resetTopbar);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') resetTopbar();
    });
  })();
</script>
