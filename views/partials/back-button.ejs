<%
  const _fallback = typeof fallback !== 'undefined' ? fallback : '/feed';
  const _label    = typeof label    !== 'undefined' ? label    : 'Go back';
  const _extra    = typeof btnClass !== 'undefined' ? ' ' + btnClass : '';
%>
<style>
  /* Netflix-style back: just an arrow, no circle, no border, no background */
  .back-btn {
    display: inline-grid; place-items: center; flex: none; width: 36px; height: 36px; margin: 0 2px 0 -6px; padding: 0;
    background: none; border: 0; border-radius: 0; cursor: pointer;
    color: var(--text); opacity: .85;
    touch-action: manipulation; -webkit-tap-highlight-color: transparent;
    transition: opacity .15s ease, transform .15s ease;
  }
  .back-btn svg { width: 24px; height: 24px; filter: drop-shadow(0 1px 3px rgba(0, 0, 0, .55)); }
  .back-btn:hover { opacity: 1; transform: translateX(-2px); }
  .back-btn:active { opacity: .6; transform: translateX(-3px); }
  .back-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 6px; }
  @media (max-width: 820px) { .back-btn { width: 40px; height: 40px; margin-left: -8px; } }
  @media (pointer: coarse) { .back-btn { width: 44px; height: 44px; } }
  @media (hover: none) { .back-btn:hover { opacity: .85; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .back-btn { transition: none; } }
</style>
<button type="button" class="back-btn<%= _extra %>" data-back data-back-fallback="<%= _fallback %>" aria-label="<%= _label %>" title="<%= _label %>">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
</button>

<script>
  /* One shared handler for every [data-back] button (binds only once).
     Goes to the previous page when it is a normal KravN page.
     Otherwise (arrived from another site, or from a login/signup screen)
     it goes to the fallback, or scrolls to top if already on the fallback. */
  (function () {
    if (window.__backBound) return;
    window.__backBound = true;
    var AUTH = /^\/(login|register|verify|logout|forgot-password|reset-password|auth)(\/|$)/;
    document.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-back]');
      if (!btn) return;
      e.preventDefault();
      var fallback = btn.getAttribute('data-back-fallback') || '/feed';
      var canGoBack = false;
      try {
        var ref = document.referrer ? new URL(document.referrer) : null;
        canGoBack = !!ref && ref.origin === location.origin && !AUTH.test(ref.pathname) && history.length > 1;
      } catch (_) {}
      if (canGoBack) { history.back(); return; }
      if (location.pathname === fallback) window.scrollTo({ top: 0, behavior: 'smooth' });
      else location.assign(fallback);
    });
  })();
</script>