<%
  const u = profileUser;
  const yearOf = (d) => (String(d || '').match(/(?:19|20)\d{2}/) || [''])[0];
  const mapPost = (p) => {
    const rating = Number(p.rating) || 0;
    return {
      id: p.id,
      href: '/posts/' + p.id,
      title: p.title || p.movie_name || 'Discussion',
      movie: p.movie_name || '',
      year: yearOf(p.release_date),
      poster: posterOf(p) || '',
      genres: (genreList(p) || []).filter(Boolean),
      likes: Number(p.likes ?? p.like_count) || 0,
      liked: !!(p.liked ?? p.liked_by_me ?? p.user_liked),
      rating,
      badge: rating ? '★ ' + (Math.round(rating * 10) / 10) : '',
      ts: new Date(p.created_at || 0).getTime() || 0
    };
  };
  const items = posts.map(mapPost);
  // Likes tab: pass `likedPosts` (same row shape as `posts`) from your route. If it is missing, the tab is hidden.
  const hasLikes = typeof likedPosts !== 'undefined' && Array.isArray(likedPosts);
  const likedItems = hasLikes ? likedPosts.map(mapPost) : [];
  const commentList = (typeof recentComments !== 'undefined' && Array.isArray(recentComments)) ? recentComments : [];
  const allGenres = [...new Set(items.flatMap((i) => i.genres))].sort((a, b) => String(a).localeCompare(String(b)));

  // Filter + sort dropdowns share one component (markup, styles and script).
  const ic = (d) => '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + d + '</svg>';
  const CHEV = '<svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>';
  const CHECK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';
  const menus = [
    { key: 'genre', def: '', label: 'All genres', name: 'Filter by genre',
      icon: ic('<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>'),
      options: [{ v: '', t: 'All genres' }, ...allGenres.map((g) => ({ v: g, t: g }))] },
    { key: 'sort', def: 'latest', label: 'Latest', name: 'Sort discussions',
      icon: ic('<path d="M7 4v16M7 20l-3-3M7 20l3-3M17 20V4M17 4l-3 3M17 4l3 3"/>'),
      options: [{ v: 'latest', t: 'Latest' }, { v: 'oldest', t: 'Oldest' }, { v: 'rating', t: 'Top rated' }, { v: 'likes', t: 'Most liked' }, { v: 'random', t: 'Random' }] }
  ].filter((m) => m.options.length > 1);
%>
<%- include('partials/head', { title: isOwn ? 'Your dashboard' : '@' + u.username }) %>
<%- include('partials/nav') %>

<style>
  /* PROFILE: header -> stats -> favourite genres -> tabs (discussions / comments / likes)
     (cards come from partials/movieCard + movie-card.css) */

  /* ---------- header ---------- */
  .page .profile-head {
    display: flex; align-items: center; gap: 18px; flex-wrap: wrap; padding: 20px 22px; margin: 0 0 12px; border-radius: 20px;
    background:
      radial-gradient(90% 160% at 0% 0%, hsl(var(--h, 260) 70% 50% / .24), transparent 62%),
      linear-gradient(180deg, color-mix(in srgb, var(--text) 5%, var(--surface)), var(--surface));
    border: 1px solid color-mix(in srgb, var(--text) 9%, transparent);
  }
  .page .profile-head .avatar--xl {
    width: 64px; height: 64px; font-size: 27px; font-weight: 700; flex: none;
    box-shadow: 0 0 0 3px var(--bg), 0 0 0 5px hsl(var(--h, 260) 70% 58% / .6);
  }
  .profile-id { flex: 1 1 220px; display: grid; gap: 3px; justify-items: start; min-width: 0; }
  .profile-id .eyebrow { display: none; }
  .profile-id h1 { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; margin: 0; font-size: clamp(21px, 2.6vw, 30px); font-weight: 700; letter-spacing: -.025em; line-height: 1.15; overflow-wrap: anywhere; }
  .profile-id h1 .pill { font-size: 10.5px; padding: 2px 8px; }
  .profile-id .muted { margin: 0; font-size: 12.5px; }

  .profile-actions { display: flex; gap: 8px; flex: none; }
  .profile-actions .btn {
    display: inline-flex !important; visibility: visible !important; opacity: 1 !important; align-items: center; justify-content: center; gap: 8px;
    height: 40px; padding: 0 18px; margin: 0; border-radius: 999px; font: 600 12.5px/1 var(--font); letter-spacing: .03em; white-space: nowrap; text-decoration: none; cursor: pointer;
    transition: transform .2s ease, background .2s ease, border-color .2s ease, filter .2s ease;
  }
  .profile-actions .btn svg { width: 15px; height: 15px; flex: none; }
  .profile-actions .btn svg.kv-ic { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .profile-actions .btn:hover { transform: translateY(-1px); }
  .profile-actions .btn:active { transform: scale(.97); }
  .profile-actions .btn-primary { color: #fff; background: var(--accent); border: 1px solid var(--accent); box-shadow: 0 10px 24px -12px color-mix(in srgb, var(--accent) 75%, transparent); }
  .profile-actions .btn-primary:hover { filter: brightness(1.08); }
  .profile-actions .btn-glass { color: var(--text); background: transparent; box-shadow: none; border: 1px solid color-mix(in srgb, var(--text) 32%, transparent); }
  .profile-actions .btn-glass:hover { background: color-mix(in srgb, var(--text) 8%, transparent); border-color: color-mix(in srgb, var(--text) 55%, transparent); }

  /* ---------- stats ---------- */
  .page .stats { display: grid; grid-template-columns: repeat(4, 1fr); margin: 0 0 4px; padding: 0; overflow: hidden; border-radius: 16px; border: 1px solid color-mix(in srgb, var(--text) 9%, transparent); background: color-mix(in srgb, var(--text) 3%, var(--surface)); }
  .page .stats .stat { display: flex; align-items: baseline; justify-content: center; gap: 8px; padding: 15px 8px; margin: 0; border: 0; border-radius: 0; background: none; box-shadow: none; min-width: 0; }
  .page .stats .stat + .stat { border-left: 1px solid color-mix(in srgb, var(--text) 8%, transparent); }
  .page .stats .stat strong { font-size: 21px; font-weight: 700; letter-spacing: -.02em; line-height: 1; font-variant-numeric: tabular-nums; color: var(--text); }
  .page .stats .stat span { font-size: 11px; font-weight: 500; letter-spacing: .05em; text-transform: uppercase; color: color-mix(in srgb, var(--text) 55%, transparent); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .page .sprocket { margin: 14px 0 0; opacity: .5; }

  /* ---------- section headings ---------- */
  .pf-h { display: flex; align-items: center; gap: 10px; margin: 0; font-size: clamp(16px, 1.8vw, 19px); font-weight: 700; letter-spacing: -.015em; }
  .pf-h i { width: 3px; height: 1em; border-radius: 3px; background: linear-gradient(180deg, var(--accent-2, var(--accent)), var(--accent)); flex: none; }
  .pf-count { display: inline-flex; align-items: center; height: 22px; padding: 0 9px; border-radius: 999px; font: 600 11.5px/1 var(--font); font-variant-numeric: tabular-nums; color: color-mix(in srgb, var(--text) 75%, transparent); background: color-mix(in srgb, var(--text) 7%, transparent); border: 1px solid color-mix(in srgb, var(--text) 10%, transparent); }
  .pf-sec { display: flex; align-items: center; gap: 10px; margin: 20px 0 0; }

  /* ---------- toolbar: genre + sort dropdown pills ---------- */
  .page .toolbar { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 12px 0 20px; min-width: 0; }

  .dd { position: relative; z-index: 40; min-width: 0; }
  .dd--sort { margin-left: auto; }
  .dd-pill {
    list-style: none; display: inline-flex; align-items: center; gap: 9px; height: 40px; padding: 0 14px 0 16px; border-radius: 999px; max-width: 100%;
    cursor: pointer; user-select: none; -webkit-user-select: none; -webkit-tap-highlight-color: transparent;
    font: 600 13px/1 var(--font); color: var(--text);
    background: color-mix(in srgb, var(--text) 6%, transparent); border: 1px solid color-mix(in srgb, var(--text) 14%, transparent);
    transition: background .2s, border-color .2s, box-shadow .2s;
  }
  .dd-pill::-webkit-details-marker { display: none; }
  .dd-pill:hover { border-color: color-mix(in srgb, var(--accent) 55%, transparent); background: color-mix(in srgb, var(--accent) 10%, transparent); }
  .dd-pill > svg { width: 15px; height: 15px; flex: none; opacity: .75; }
  .dd-pill .chev { width: 14px; height: 14px; opacity: .7; transition: transform .25s ease; }
  .dd-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
  .dd[open] .dd-pill { border-color: var(--accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 18%, transparent); }
  .dd[open] .chev { transform: rotate(180deg); }
  .dd.has-value .dd-pill { background: color-mix(in srgb, var(--accent) 20%, transparent); border-color: color-mix(in srgb, var(--accent) 70%, transparent); }

  .dd-panel {
    position: absolute; top: calc(100% + 10px); left: 0; width: min(440px, calc(100vw - 32px)); padding: 10px; border-radius: 20px;
    background: color-mix(in srgb, var(--text) 5%, var(--surface)); border: 1px solid color-mix(in srgb, var(--text) 13%, transparent);
    box-shadow: 0 28px 60px -20px rgba(0, 0, 0, .85);
    -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px);
    transform-origin: top left; animation: dd-pop .18s ease-out;
  }
  .dd--sort .dd-panel { left: auto; right: 0; width: 210px; transform-origin: top right; }
  @keyframes dd-pop { from { opacity: 0; transform: translateY(-6px) scale(.97); } to { opacity: 1; transform: none; } }

  .dd-list {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(124px, 1fr)); gap: 4px; max-height: min(56vh, 340px);
    overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; scrollbar-color: color-mix(in srgb, var(--text) 25%, transparent) transparent;
  }
  .dd--sort .dd-list { grid-template-columns: 1fr; }
  .dd-opt {
    display: flex; align-items: center; justify-content: space-between; gap: 8px; min-width: 0; height: 40px; padding: 0 12px; margin: 0; border: 0; border-radius: 12px;
    cursor: pointer; text-align: left; white-space: nowrap; font: 500 13px/1 var(--font); background: none;
    color: color-mix(in srgb, var(--text) 82%, transparent); transition: background .15s, color .15s;
  }
  .dd-opt span { overflow: hidden; text-overflow: ellipsis; }
  .dd-opt svg { width: 14px; height: 14px; flex: none; opacity: 0; }
  .dd-opt:hover, .dd-opt:focus-visible { background: color-mix(in srgb, var(--accent) 16%, transparent); color: #fff; }
  .dd-opt.on { background: var(--accent); color: #fff; font-weight: 600; }
  .dd-opt.on svg { opacity: 1; }
  .dd-opt--all { grid-column: 1 / -1; margin-bottom: 4px; }
  .dd :is(.dd-pill, .dd-opt):focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* ---------- poster grid ---------- */
  .pf-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 18px 14px; align-items: start; }
  .pf-item { min-width: 0; }
  .pf-item[hidden] { display: none; }
  .pf-empty { text-align: center; padding: 36px 0; }

  /* ---------- Kravn Cards: a vertical, one-card-at-a-time feed of the same poster cards ---------- */
  .kc { --kc-h: 100vh; --kc-w: min(78vw, 340px, calc((var(--kc-h) - 220px) * .667)); position: fixed; inset: 0; z-index: 300; display: flex; flex-direction: column; color: #fff; background: rgba(8, 8, 12, .95); -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px); }
  @supports (height: 100dvh) { .kc { --kc-h: 100dvh; } }
  .kc[hidden] { display: none !important; }
  .kc-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: calc(12px + env(safe-area-inset-top)) 16px 6px; }
  .kc-count { font: 600 13px/1 var(--font); letter-spacing: .08em; color: rgba(255, 255, 255, .75); font-variant-numeric: tabular-nums; }
  .kc-hint { flex: 1; text-align: center; font-size: 12px; color: rgba(255, 255, 255, .45); }
  .kc-close { width: 40px; height: 40px; display: grid; place-items: center; padding: 0; border-radius: 50%; cursor: pointer; color: #fff; background: rgba(255, 255, 255, .06); border: 1px solid rgba(255, 255, 255, .25); transition: background .2s; }
  .kc-close:hover { background: rgba(255, 255, 255, .16); }
  .kc-close svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }

  .kc-feed { flex: 1; min-height: 0; overflow-y: auto; scroll-snap-type: y mandatory; overscroll-behavior: contain; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
  .kc-feed::-webkit-scrollbar { display: none; }
  .kc-slide { height: 100%; scroll-snap-align: center; scroll-snap-stop: always; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; }
  .kc-slide .mcard { width: var(--kc-w); flex: none; -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; touch-action: manipulation; }
  .kc-slide .mcard-poster { position: relative; }
  .kc-empty { margin: auto; padding: 0 24px; text-align: center; font-size: 14px; color: rgba(255, 255, 255, .7); }

  .kc-heart { position: absolute; inset: 0; z-index: 3; display: grid; place-items: center; pointer-events: none; opacity: 0; color: #fff; }
  .kc-heart svg { width: 96px; height: 96px; fill: currentColor; stroke: none; filter: drop-shadow(0 6px 24px rgba(0, 0, 0, .55)); }
  .kc-heart.pop { animation: kc-pop .75s ease-out; }
  @keyframes kc-pop { 0% { opacity: 0; transform: scale(.4); } 22% { opacity: 1; transform: scale(1.15); } 60% { opacity: 1; transform: scale(1); } 100% { opacity: 0; transform: scale(1.1); } }

  .kc-like {
    display: inline-flex; align-items: center; gap: 8px; height: 40px; padding: 0 18px; margin: 0; border-radius: 999px; cursor: pointer; color: #fff;
    font: 600 13px/1 var(--font); font-variant-numeric: tabular-nums; background: rgba(255, 255, 255, .07); border: 1px solid rgba(255, 255, 255, .28);
    transition: background .2s, border-color .2s, transform .2s;
  }
  .kc-like svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: transform .2s; }
  .kc-like:active svg { transform: scale(.8); }
  .kc-like.on { background: color-mix(in srgb, var(--accent) 28%, transparent); border-color: var(--accent); }
  .kc-like.on svg { fill: currentColor; }

  /* ---------- laptop / large screens ---------- */
  @media (min-width: 900px) {
    .page .profile-head { gap: 24px; padding: 26px 30px; border-radius: 22px; margin-bottom: 14px; }
    .page .profile-head .avatar--xl { width: 80px; height: 80px; font-size: 34px; }
    .page .stats { border-radius: 18px; }
    .page .stats .stat { padding: 18px 8px; gap: 10px; }
    .page .stats .stat strong { font-size: 25px; }
    .page .stats .stat span { font-size: 11.5px; }
    .pf-grid { grid-template-columns: repeat(auto-fill, minmax(176px, 1fr)); gap: 22px 18px; }
    .page .toolbar { margin: 14px 0 24px; }
  }
  @media (min-width: 1400px) { .pf-grid { grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 26px 20px; } }

  /* ---------- phone ---------- */
  @media (max-width: 640px) {
    .page .profile-head { display: grid; grid-template-columns: auto 1fr; gap: 12px 14px; padding: 14px; border-radius: 16px; margin-bottom: 10px; }
    .page .profile-head .avatar--xl { width: 54px; height: 54px; font-size: 23px; }
    .profile-id { flex: none; }
    .profile-id h1 { font-size: 20px; }
    .profile-actions { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr; gap: 8px; }
    .profile-actions:has(.btn + .btn) { grid-template-columns: 1fr 1fr; }
    .profile-actions .btn { width: 100%; padding: 0 10px; }
    .page .stats { border-radius: 14px; }
    .page .stats .stat { flex-direction: column; align-items: center; gap: 4px; padding: 12px 2px; }
    .page .stats .stat strong { font-size: 18px; }
    .page .stats .stat span { font-size: 9.5px; letter-spacing: .04em; max-width: 100%; }
    .pf-sec { margin-top: 16px; }
    .page .toolbar { margin: 10px 0 16px; }
    .dd-pill { height: 38px; padding: 0 12px 0 14px; }
    .dd--genre { max-width: calc(100% - 140px); }
    .dd-list { grid-template-columns: repeat(2, minmax(0, 1fr)); max-height: 52vh; }
    .dd--sort .dd-list { grid-template-columns: 1fr; }
    .dd-panel { border-radius: 18px; }
    .pf-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 10px; }
    .kc-hint { font-size: 11px; }
  }
  @media (max-width: 360px) { .profile-actions:has(.btn + .btn) { grid-template-columns: 1fr; } .kc-hint { display: none; } }
  @media (prefers-reduced-motion: reduce) {
    .dd-panel { animation: none; }
    .dd-pill, .dd-pill .chev, .dd-opt, .kc-like, .kc-like svg { transition: none; }
    .kc-heart.pop { animation-duration: .01s; }
  }
</style>

<style>
  /* favourite genres + tabs + comments + likes */

  /* favourite genres: a soft panel; chips filter the grid below when the genre exists in this user's posts */
  .pf-genres {
    margin: 12px 0 0; padding: 14px 16px; border-radius: 16px; display: grid; gap: 10px; min-width: 0;
    background:
      radial-gradient(80% 140% at 100% 0%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 60%),
      color-mix(in srgb, var(--text) 3%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--text) 9%, transparent);
  }
  .pf-genres-head { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; min-width: 0; }
  .pf-genres-title { margin: 0; font: 700 12px/1.2 var(--font); letter-spacing: .09em; text-transform: uppercase; color: color-mix(in srgb, var(--text) 70%, transparent); }
  .pf-genres-hint { font-size: 11.5px; color: color-mix(in srgb, var(--text) 45%, transparent); white-space: nowrap; }
  .pf-genres-row { display: flex; flex-wrap: wrap; gap: 8px; min-width: 0; }
  .pf-genre {
    display: inline-flex; align-items: center; gap: 7px; height: 34px; padding: 0 14px; margin: 0; border-radius: 999px; flex: none;
    font: 500 13px/1 var(--font); letter-spacing: .005em; white-space: nowrap; text-decoration: none;
    color: color-mix(in srgb, var(--text) 90%, transparent);
    background: color-mix(in srgb, var(--accent) 13%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 34%, transparent);
    transition: color .2s, background .2s, border-color .2s, transform .2s;
  }
  .pf-genre::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); flex: none; opacity: .85; }
  button.pf-genre { cursor: pointer; -webkit-tap-highlight-color: transparent; }
  button.pf-genre:hover, button.pf-genre:focus-visible { color: #fff; background: color-mix(in srgb, var(--accent) 28%, transparent); border-color: color-mix(in srgb, var(--accent) 75%, transparent); }
  button.pf-genre:active { transform: scale(.96); }
  button.pf-genre:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .pf-genre.on { color: #fff; background: var(--accent); border-color: var(--accent); }
  .pf-genre.on::before { background: #fff; }

  /* ---------- tabs ---------- */
  .pf-tabs {
    display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 4px; margin: 18px 0 0; padding: 4px; border-radius: 999px; max-width: 520px;
    background: color-mix(in srgb, var(--text) 5%, var(--surface)); border: 1px solid color-mix(in srgb, var(--text) 10%, transparent);
  }
  .pf-tab {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-width: 0; height: 42px; padding: 0 14px; margin: 0; border: 0; border-radius: 999px;
    cursor: pointer; white-space: nowrap; font: 600 13px/1 var(--font); letter-spacing: .01em; background: none; -webkit-tap-highlight-color: transparent;
    color: color-mix(in srgb, var(--text) 62%, transparent); transition: background .2s, color .2s, box-shadow .2s, transform .2s;
  }
  .pf-tab svg { width: 15px; height: 15px; flex: none; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .pf-tab:hover { color: var(--text); background: color-mix(in srgb, var(--text) 7%, transparent); }
  .pf-tab:active { transform: scale(.97); }
  .pf-tab:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .pf-tab.on { color: #fff; background: var(--accent); box-shadow: 0 10px 24px -12px color-mix(in srgb, var(--accent) 80%, transparent); }
  .pf-tab em {
    font: 600 11px/1 var(--font); font-style: normal; font-variant-numeric: tabular-nums; padding: 3px 7px; border-radius: 999px;
    background: color-mix(in srgb, var(--text) 10%, transparent);
  }
  .pf-tab.on em { background: rgba(255, 255, 255, .22); }

  .pf-panel { margin-top: 4px; animation: pf-in .25s ease-out; }
  .pf-panel[hidden] { display: none; }
  @keyframes pf-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

  /* ---------- comments ---------- */
  .pf-comments-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 12px; margin: 20px 0 0; }
  .pf-comment {
    position: relative; display: grid; gap: 10px; align-content: space-between; min-width: 0; padding: 16px 18px 14px; border-radius: 16px; text-decoration: none; color: inherit; overflow: hidden;
    background:
      radial-gradient(90% 120% at 100% 0%, color-mix(in srgb, var(--accent) 9%, transparent), transparent 60%),
      color-mix(in srgb, var(--text) 3%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--text) 9%, transparent);
    transition: border-color .2s ease, transform .2s ease, box-shadow .2s ease;
  }
  .pf-comment::before { content: '“'; position: absolute; top: -6px; right: 14px; font: 700 64px/1 Georgia, serif; color: color-mix(in srgb, var(--accent) 28%, transparent); pointer-events: none; }
  .pf-comment:hover { border-color: color-mix(in srgb, var(--accent) 50%, transparent); transform: translateY(-2px); box-shadow: 0 18px 36px -22px rgba(0, 0, 0, .8); }
  .pf-comment:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .pf-comment p { margin: 0; padding-right: 18px; font-size: 14px; line-height: 1.55; overflow-wrap: anywhere; }
  .pf-comment-meta { display: flex; align-items: center; gap: 8px; min-width: 0; padding-top: 10px; border-top: 1px solid color-mix(in srgb, var(--text) 8%, transparent); font-size: 12px; color: color-mix(in srgb, var(--text) 55%, transparent); }
  .pf-comment-meta span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
  .pf-comment-meta b { font-weight: 600; color: color-mix(in srgb, var(--text) 85%, transparent); }
  .pf-comment-meta time { flex: none; margin-left: auto; font-variant-numeric: tabular-nums; }
  .pf-liked-grid { margin-top: 20px; }

  @media (min-width: 900px) {
    .pf-tabs { margin-top: 22px; }
    .pf-comments-list { gap: 14px; margin-top: 24px; }
    .pf-liked-grid { margin-top: 24px; }
  }
  @media (max-width: 640px) {
    .profile-actions .btn:last-child:nth-child(odd) { grid-column: 1 / -1; }
    /* genres become one swipeable row so the panel stays compact */
    .pf-genres { padding: 12px 14px; border-radius: 14px; gap: 8px; }
    .pf-genres-row {
      flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; overscroll-behavior-x: contain; padding: 2px 14px 4px; margin-inline: -14px;
      -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 14px, #000 calc(100% - 22px), transparent 100%);
              mask-image: linear-gradient(90deg, transparent 0, #000 14px, #000 calc(100% - 22px), transparent 100%);
    }
    .pf-genres-row::-webkit-scrollbar { display: none; }
    .pf-genre { height: 32px; padding: 0 12px; font-size: 12.5px; }
    .pf-tabs { max-width: none; margin-top: 14px; }
    .pf-tab { height: 40px; padding: 0 6px; gap: 6px; font-size: 12.5px; }
    .pf-tab svg { display: none; }
    .pf-comments-list { grid-template-columns: 1fr; gap: 10px; margin-top: 14px; }
    .pf-comment { padding: 14px 15px 12px; }
    .pf-liked-grid { margin-top: 14px; }
  }
  @media (hover: none) { .pf-comment:hover { transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .pf-genre, .pf-tab, .pf-comment { transition: none; }
    .pf-panel { animation: none; }
    .pf-comment:hover, button.pf-genre:active, .pf-tab:active { transform: none; }
  }
</style>

<style>
  /* Share -> KravN QR card */
  .qr {
    position: fixed; inset: 0; z-index: 400; display: grid; place-items: center; padding: 16px;
    background: rgba(6, 6, 10, .72); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    animation: qr-fade .2s ease-out;
  }
  .qr[hidden] { display: none !important; }
  .qr-card {
    position: relative; width: min(360px, 100%); max-height: calc(100vh - 32px); overflow-y: auto; overscroll-behavior: contain;
    display: grid; gap: 14px; justify-items: center; padding: 22px 22px 20px; border-radius: 24px; text-align: center;
    background:
      radial-gradient(120% 70% at 50% 0%, color-mix(in srgb, var(--accent) 26%, transparent), transparent 65%),
      color-mix(in srgb, var(--text) 4%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--text) 14%, transparent);
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, .9);
    animation: qr-pop .22s ease-out;
  }
  @supports (height: 100dvh) { .qr-card { max-height: calc(100dvh - 32px); } }
  .qr-x {
    position: absolute; top: 12px; right: 12px; width: 36px; height: 36px; display: grid; place-items: center; padding: 0; margin: 0; border-radius: 50%; cursor: pointer;
    color: var(--text); background: color-mix(in srgb, var(--text) 7%, transparent); border: 1px solid color-mix(in srgb, var(--text) 18%, transparent); transition: background .2s;
  }
  .qr-x:hover { background: color-mix(in srgb, var(--text) 15%, transparent); }
  .qr-x svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  .qr-brand { display: inline-flex; align-items: center; gap: 9px; font: 700 18px/1 var(--font); letter-spacing: -.02em; color: var(--text); }
  .qr-mark {
    width: 30px; height: 30px; display: grid; place-items: center; border-radius: 10px; color: #fff; font: 800 16px/1 var(--font);
    background: linear-gradient(135deg, var(--accent-2, var(--accent)), var(--accent)); box-shadow: 0 8px 20px -10px var(--accent);
  }
  .qr-name { margin: 0; max-width: 100%; font: 700 20px/1.2 var(--font); letter-spacing: -.02em; overflow-wrap: anywhere; color: var(--text); }
  .qr-sub { margin: -6px 0 0; font-size: 12.5px; color: color-mix(in srgb, var(--text) 60%, transparent); }
  .qr-frame {
    line-height: 0; padding: 10px; border-radius: 22px; background: #fff;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, .08), 0 22px 44px -22px color-mix(in srgb, var(--accent) 70%, transparent);
  }
  .qr-frame[hidden] { display: none; }
  .qr-canvas { display: block; width: min(248px, 62vw); height: min(248px, 62vw); border-radius: 12px; }
  .qr-fail { margin: 0; padding: 14px 6px; font-size: 13px; line-height: 1.5; color: color-mix(in srgb, var(--text) 70%, transparent); }
  .qr-fail[hidden] { display: none; }
  .qr-url {
    max-width: 100%; box-sizing: border-box; padding: 8px 14px; border-radius: 999px; font-size: 12px; line-height: 1.2; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    color: color-mix(in srgb, var(--text) 70%, transparent); background: color-mix(in srgb, var(--text) 6%, transparent); border: 1px solid color-mix(in srgb, var(--text) 10%, transparent);
  }
  .qr-actions { width: 100%; display: grid; grid-template-columns: repeat(auto-fit, minmax(104px, 1fr)); gap: 8px; }
  .qr-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 7px; height: 42px; padding: 0 12px; margin: 0; border-radius: 999px; cursor: pointer; white-space: nowrap;
    font: 600 12.5px/1 var(--font); color: var(--text); background: transparent; border: 1px solid color-mix(in srgb, var(--text) 30%, transparent);
    transition: background .2s, border-color .2s, transform .2s, filter .2s;
  }
  .qr-btn svg { width: 15px; height: 15px; flex: none; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .qr-btn:hover { background: color-mix(in srgb, var(--text) 8%, transparent); border-color: color-mix(in srgb, var(--text) 55%, transparent); }
  .qr-btn:active { transform: scale(.97); }
  .qr-btn--primary { color: #fff; background: var(--accent); border-color: var(--accent); }
  .qr-btn--primary:hover { background: var(--accent); border-color: var(--accent); filter: brightness(1.08); }
  .qr-btn[hidden] { display: none; }
  .qr :is(.qr-btn, .qr-x):focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  @keyframes qr-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes qr-pop { from { opacity: 0; transform: translateY(10px) scale(.97); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .qr, .qr-card { animation: none; } .qr-btn, .qr-x { transition: none; } }
</style>

<main class="page">
  <div class="shell">

    <header class="profile-head" style="--h:<%= hue(u.username) %>">
      <span class="avatar avatar--xl" style="--h:<%= hue(u.username) %>"><%= u.username.charAt(0).toUpperCase() %></span>
      <div class="profile-id">
        <span class="eyebrow"><span class="dot"></span> <%= isOwn ? 'Your dashboard' : 'Profile' %></span>
        <h1><%= u.username %><% if (isOwn) { %><span class="pill pill--accent">You</span><% } %></h1>
        <p class="muted">Member since <%= fmtDate(u.created_at) %></p>
      </div>
      <div class="profile-actions">
        <% if (items.length) { %><button type="button" class="btn btn-primary" data-cards-open="#feed"><svg class="kv-ic" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="7" width="13" height="14" rx="2"/><path d="M8 3.5h11a2 2 0 0 1 2 2V17"/></svg> Kravn Cards</button><% } %>
        <% if (isOwn) { %><a class="btn btn-glass" href="/posts/new"><%- include('partials/icon', { n: 'plus' }) %> New discussion</a><% } %>
        <button type="button" class="btn btn-glass" aria-haspopup="dialog" data-share-profile data-name="<%= u.username %>" data-title="<%= u.username %> on KravN" data-url="/users/<%= encodeURIComponent(u.username) %>"><%- include('partials/icon', { n: 'share' }) %> <span>Share</span></button>
      </div>
    </header>

    <div class="stats">
      <div class="stat" title="Discussions"><strong data-count="<%= stats.discussions %>"><%= stats.discussions %></strong><span>Posts</span></div>
      <div class="stat" title="Likes received"><strong data-count="<%= stats.likes %>"><%= stats.likes %></strong><span>Likes</span></div>
      <div class="stat" title="Comments received"><strong data-count="<%= stats.comments %>"><%= stats.comments %></strong><span>Comments</span></div>
      <div class="stat" title="Movies discussed"><strong data-count="<%= stats.movies %>"><%= stats.movies %></strong><span>Movies</span></div>
    </div>

    <% if (typeof topGenres !== 'undefined' && topGenres.length) { %>
      <section class="pf-genres" aria-label="Favourite genres">
        <div class="pf-genres-head">
          <h2 class="pf-genres-title">Favourite genres</h2>
          <% if (items.length && allGenres.some((g) => topGenres.includes(g))) { %><span class="pf-genres-hint">Tap one to filter</span><% } %>
        </div>
        <div class="pf-genres-row">
          <% topGenres.forEach((g) => { %>
            <% if (items.length && allGenres.includes(g)) { %><button type="button" class="pf-genre" data-genre-pick="<%= g %>" aria-pressed="false"><%= g %></button><% } else { %><span class="pf-genre"><%= g %></span><% } %>
          <% }) %>
        </div>
      </section>
    <% } %>

    <div class="sprocket" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>

    <div class="pf-tabs" role="tablist" aria-label="Profile sections">
      <button type="button" class="pf-tab on" role="tab" id="tab-discussions" aria-controls="panel-discussions" aria-selected="true" data-tab="discussions">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
        Discussions <em><%= items.length %></em>
      </button>
      <button type="button" class="pf-tab" role="tab" id="tab-comments" aria-controls="panel-comments" aria-selected="false" tabindex="-1" data-tab="comments">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H8l-5 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        Comments <em><%= commentList.length %></em>
      </button>
      <% if (hasLikes) { %>
      <button type="button" class="pf-tab" role="tab" id="tab-likes" aria-controls="panel-likes" aria-selected="false" tabindex="-1" data-tab="likes">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
        Likes <em><%= likedItems.length %></em>
      </button>
      <% } %>
    </div>

    <!-- ===== Discussions ===== -->
    <section class="pf-panel" id="panel-discussions" role="tabpanel" aria-labelledby="tab-discussions" data-panel="discussions">
    <% if (!items.length) { %>
      <div class="empty">
        <p><%= isOwn ? "You haven't posted anything yet." : u.username + " hasn't posted anything yet." %></p>
        <% if (isOwn) { %><a class="btn btn-primary" href="/posts/new">Start your first discussion</a><% } %>
      </div>
    <% } else { %>
      <div class="pf-sec">
        <h2 class="pf-h"><i></i>Discussions</h2>
        <span class="pf-count"><%= items.length %></span>
      </div>

      <div class="toolbar">
        <% menus.forEach((m) => { %>
          <details class="dd dd--<%= m.key %>" data-dd="<%= m.key %>" data-default="<%= m.def %>">
            <summary class="dd-pill" aria-label="<%= m.name %>"><%- m.icon %><span class="dd-label"><%= m.label %></span><%- CHEV %></summary>
            <div class="dd-panel">
              <div class="dd-list">
                <% m.options.forEach((o, i) => { %><button type="button" class="dd-opt<%= m.key === 'genre' && i === 0 ? ' dd-opt--all' : '' %><%= o.v === m.def ? ' on' : '' %>" data-value="<%= o.v %>" data-label="<%= o.t %>"><span><%= o.t %></span><%- CHECK %></button><% }) %>
              </div>
            </div>
          </details>
        <% }) %>
      </div>

      <div class="pf-grid" id="feed">
        <% items.forEach((it) => { %>
          <div class="pf-item" data-id="<%= it.id %>" data-genres="<%= it.genres.join('|') %>" data-ts="<%= it.ts %>" data-rating="<%= it.rating %>" data-likes="<%= it.likes %>" data-liked="<%= it.liked ? 1 : 0 %>">
            <%- include('partials/movieCard', {
              m: { id: it.id, title: it.title, year: it.year, poster: it.poster, percent: null, url: it.href, type: '' },
              href: it.href,
              badge: it.badge,
              sub: it.movie && it.movie !== it.title ? it.movie : ''
            }) %>
          </div>
        <% }) %>
      </div>
      <p class="muted pf-empty" id="pf-empty" hidden>No discussions in that genre yet.</p>
    <% } %>
    </section>

    <!-- ===== Comments ===== -->
    <section class="pf-panel" id="panel-comments" role="tabpanel" aria-labelledby="tab-comments" data-panel="comments" hidden>
      <% if (commentList.length) { %>
        <div class="pf-comments-list">
          <% commentList.forEach((c) => { const txt = String(c.content || ''); %>
            <a class="pf-comment" href="/posts/<%= c.post_id %>#c-<%= c.id %>">
              <p><%= txt.length > 220 ? txt.slice(0, 220) + '…' : txt %></p>
              <div class="pf-comment-meta">
                <span>on <b><%= c.post_title || c.movie_name || 'a discussion' %></b></span>
                <time><%= timeAgo(c.created_at) %></time>
              </div>
            </a>
          <% }) %>
        </div>
      <% } else { %>
        <p class="muted pf-empty"><%= isOwn ? "You haven't commented yet." : u.username + " hasn't commented yet." %></p>
      <% } %>
    </section>

    <!-- ===== Likes ===== -->
    <% if (hasLikes) { %>
    <section class="pf-panel" id="panel-likes" role="tabpanel" aria-labelledby="tab-likes" data-panel="likes" hidden>
      <% if (likedItems.length) { %>
        <div class="pf-grid pf-liked-grid">
          <% likedItems.forEach((it) => { %>
            <div class="pf-item">
              <%- include('partials/movieCard', {
                m: { id: it.id, title: it.title, year: it.year, poster: it.poster, percent: null, url: it.href, type: '' },
                href: it.href,
                badge: it.badge,
                sub: it.movie && it.movie !== it.title ? it.movie : ''
              }) %>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p class="muted pf-empty"><%= isOwn ? "You haven't liked anything yet." : u.username + " hasn't liked anything yet." %></p>
      <% } %>
    </section>
    <% } %>
  </div>
</main>

<script>
  /* dropdown filters + sort + Kravn Cards feed (everything reads the .pf-item data attributes) */
  (function () {
    var grid = document.getElementById('feed');
    if (!grid) return;
    var LIKE_URL = function (id) { return '/posts/' + id + '/like'; }; // POST, toggles the like — change if your route differs
    var items = Array.prototype.slice.call(grid.querySelectorAll('.pf-item'));
    var emptyMsg = document.getElementById('pf-empty');
    var state = { genre: '', sort: 'latest' };
    var picks = Array.prototype.slice.call(document.querySelectorAll('[data-genre-pick]'));
    var HEART = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>';
    function num(el, k) { return parseFloat(el.getAttribute('data-' + k)) || 0; }
    function el(tag, cls, html) { var e = document.createElement(tag); if (cls) e.className = cls; if (html) e.innerHTML = html; return e; }

    /* ----- filter + sort ----- */
    var by = {
      latest: function (a, b) { return num(b, 'ts') - num(a, 'ts'); },
      oldest: function (a, b) { return num(a, 'ts') - num(b, 'ts'); },
      rating: function (a, b) { return num(b, 'rating') - num(a, 'rating'); },
      likes:  function (a, b) { return num(b, 'likes') - num(a, 'likes'); },
      random: function () { return Math.random() - .5; }
    };
    function syncPicks() {
      picks.forEach(function (p) {
        var on = p.getAttribute('data-genre-pick') === state.genre;
        p.classList.toggle('on', on); p.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
    }
    function apply() {
      var shown = items.filter(function (it) {
        var ok = !state.genre || (it.getAttribute('data-genres') || '').split('|').indexOf(state.genre) > -1;
        it.hidden = !ok; return ok;
      });
      shown.sort(by[state.sort] || by.latest).forEach(function (it) { grid.appendChild(it); });
      if (emptyMsg) emptyMsg.hidden = shown.length > 0;
      syncPicks();
    }

    /* ----- dropdown pills ----- */
    var menus = Array.prototype.slice.call(document.querySelectorAll('[data-dd]'));
    menus.forEach(function (m) {
      m.addEventListener('toggle', function () {
        if (!m.open) return;
        menus.forEach(function (o) { if (o !== m) o.open = false; });
        var on = m.querySelector('.dd-opt.on'); if (on) on.scrollIntoView({ block: 'nearest' });
      });
      m.addEventListener('click', function (e) {
        var o = e.target.closest('.dd-opt'); if (!o) return;
        var v = o.getAttribute('data-value');
        m.querySelectorAll('.dd-opt').forEach(function (x) { x.classList.toggle('on', x === o); });
        m.querySelector('.dd-label').textContent = o.getAttribute('data-label');
        m.classList.toggle('has-value', v !== m.getAttribute('data-default'));
        state[m.getAttribute('data-dd')] = v;
        m.open = false; apply();
      });
    });
    document.addEventListener('click', function (e) { menus.forEach(function (m) { if (m.open && !m.contains(e.target)) m.open = false; }); });
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      menus.forEach(function (m) { if (m.open) { m.open = false; m.querySelector('summary').focus(); } });
    });

    /* ----- favourite-genre chips: drive the genre dropdown (tap again to clear) ----- */
    picks.forEach(function (p) {
      p.addEventListener('click', function () {
        var g = p.getAttribute('data-genre-pick'), target = state.genre === g ? '' : g;
        var gm = document.querySelector('[data-dd="genre"]'); if (!gm) return;
        var opts = gm.querySelectorAll('.dd-opt'), hit = null, i;
        for (i = 0; i < opts.length; i++) { if (opts[i].getAttribute('data-value') === target) { hit = opts[i]; break; } }
        if (!hit) return;
        hit.click();
        var tb = document.querySelector('.pf-sec') || document.querySelector('.toolbar');
        if (tb && tb.scrollIntoView) tb.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    /* ----- likes (shared by the double-tap and the heart button) ----- */
    function itemOf(slide) { return grid.querySelector('.pf-item[data-id="' + slide.getAttribute('data-id') + '"]'); }
    function paint(slide) {
      var it = itemOf(slide), on = it.getAttribute('data-liked') === '1', b = slide.querySelector('.kc-like');
      b.classList.toggle('on', on); b.setAttribute('aria-pressed', on); b.querySelector('span').textContent = num(it, 'likes');
    }
    function setLike(slide, want) {
      var it = itemOf(slide), was = it.getAttribute('data-liked') === '1', n = num(it, 'likes');
      if (want === was) return;
      function write(liked, count) { it.setAttribute('data-liked', liked ? 1 : 0); it.setAttribute('data-likes', Math.max(0, count)); paint(slide); }
      write(want, n + (want ? 1 : -1));
      fetch(LIKE_URL(it.getAttribute('data-id')), { method: 'POST', credentials: 'same-origin', headers: { 'X-Requested-With': 'fetch', 'Accept': 'application/json' } })
        .then(function (r) {
          if (r.status === 401) { location.href = '/login?next=' + encodeURIComponent(location.pathname); throw 0; }
          if (!r.ok) throw r;
          return r.json().catch(function () { return null; });
        })
        .then(function (j) { if (j && typeof j.liked === 'boolean') write(j.liked, typeof j.likes === 'number' ? j.likes : num(it, 'likes')); })
        .catch(function () { write(was, n); });
    }
    function burst(slide) {
      var h = slide.querySelector('.kc-heart'); if (!h) return;
      h.classList.remove('pop'); void h.offsetWidth; h.classList.add('pop');
    }

    /* ----- Kravn Cards: vertical feed, tap opens, double-tap likes ----- */
    var ov, feed, counter, slides = [], idx = 0, lastFocus, ticking = false, tapTimer = null;
    function sync() { idx = Math.max(0, Math.min(slides.length - 1, Math.round(feed.scrollTop / feed.clientHeight))); counter.textContent = slides.length ? (idx + 1) + ' / ' + slides.length : ''; }
    function go(i) { feed.scrollTo({ top: Math.max(0, Math.min(slides.length - 1, i)) * feed.clientHeight, behavior: 'smooth' }); }
    function hide() { ov.hidden = true; document.documentElement.style.overflow = ''; if (lastFocus && lastFocus.focus) lastFocus.focus(); }

    function build() {
      ov = el('div', 'kc'); ov.hidden = true; ov.setAttribute('role', 'dialog'); ov.setAttribute('aria-modal', 'true'); ov.setAttribute('aria-label', 'Kravn Cards');
      var top = el('div', 'kc-top'); counter = el('span', 'kc-count');
      var close = el('button', 'kc-close', '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>');
      close.type = 'button'; close.setAttribute('aria-label', 'Close cards'); close.addEventListener('click', hide);
