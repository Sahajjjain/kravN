      var sub = mk('p', 'qr-sub', 'Scan with your camera to open this profile');
      frame = mk('div', 'qr-frame'); canvas = mk('canvas', 'qr-canvas'); canvas.setAttribute('role', 'img'); frame.appendChild(canvas);
      fail = mk('p', 'qr-fail', 'This link is too long to turn into a QR code. Use Copy link instead.'); fail.hidden = true;
      urlEl = mk('div', 'qr-url');
      var actions = mk('div', 'qr-actions');
      var copyBtn = btn('qr-btn--primary', ICON.copy, 'Copy link'); copyLbl = copyBtn.querySelector('span');
      shareBtn = btn('', ICON.share, 'Share'); shareBtn.hidden = !navigator.share;
      saveBtn = btn('', ICON.save, 'Save image');
      copyBtn.addEventListener('click', copyLink); shareBtn.addEventListener('click', nativeShare); saveBtn.addEventListener('click', saveImage);
      actions.appendChild(copyBtn); actions.appendChild(shareBtn); actions.appendChild(saveBtn);
      [x, brand, nameEl, sub, frame, fail, urlEl, actions].forEach(function (n) { card.appendChild(n); });
      box.appendChild(card); document.body.appendChild(box);
      box.addEventListener('click', function (e) { if (e.target === box) close(); });
      box.addEventListener('keydown', function (e) {
        if (e.key !== 'Tab') return;
        var f = Array.prototype.filter.call(box.querySelectorAll('button'), function (b) { return !b.hidden && b.offsetParent !== null; });
        if (!f.length) return;
        var first = f[0], last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      });
    }

    function open(b) {
      if (!box) build();
      var url = location.origin + b.getAttribute('data-url');
      var name = b.getAttribute('data-name') || (b.getAttribute('data-title') || '').replace(/ on KravN$/, '');
      var qr = null;
      try { qr = KravQR.encode(url, 'H'); } catch (err) { qr = null; }
      cur = { url: url, name: name, title: b.getAttribute('data-title') || name + ' on KravN', qr: qr };
      nameEl.textContent = '@' + name; urlEl.textContent = url.replace(/^https?:\/\//, ''); copyLbl.textContent = 'Copy link';
      shareBtn.hidden = !navigator.share;
      frame.hidden = !qr; fail.hidden = !!qr; saveBtn.hidden = !qr;
      if (qr) {
        var css = 248, dpr = Math.min(window.devicePixelRatio || 1, 3);
        paintQR(canvas, qr, Math.round(css * dpr), palette());
        canvas.setAttribute('aria-label', 'QR code that opens the KravN profile of ' + name);
      }
      lastFocus = document.activeElement; document.documentElement.style.overflow = 'hidden';
      box.hidden = false;
      box.querySelector('.qr-btn--primary').focus();
    }
    function close() {
      if (!box || box.hidden) return;
      box.hidden = true; document.documentElement.style.overflow = '';
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }

    function copyLink() {
      var url = cur.url;
      function done() { copyLbl.textContent = 'Link copied'; setTimeout(function () { copyLbl.textContent = 'Copy link'; }, 1800); }
      if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(url).then(done, function () { window.prompt('Copy this link', url); });
      else window.prompt('Copy this link', url);
    }
    function nativeShare() {
      if (navigator.share) navigator.share({ title: cur.title, url: cur.url }).catch(function () {});
    }
    function saveImage() {
      if (!cur.qr) return;
      var c = poster(cur.qr, cur.name, cur.url, palette());
      var file = 'kravn-' + (cur.name.toLowerCase().replace(/[^a-z0-9_-]+/g, '') || 'profile') + '-qr.png';
      function dl(href, revoke) {
        var a = document.createElement('a'); a.href = href; a.download = file; document.body.appendChild(a); a.click(); a.remove();
        if (revoke) setTimeout(function () { URL.revokeObjectURL(href); }, 2000);
      }
      if (c.toBlob) c.toBlob(function (blob) { if (blob) dl(URL.createObjectURL(blob), true); }, 'image/png');
      else dl(c.toDataURL('image/png'), false);
    }

    document.addEventListener('click', function (e) {
      var b = e.target.closest && e.target.closest('[data-share-profile]');
      if (!b) return;
      e.preventDefault(); open(b);
    });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
  })();
</script>
