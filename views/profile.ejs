    transition: background .2s, border-color .2s, transform .2s, filter .2s;
  }
  .qr-btn svg { width: 15px; height: 15px; flex: none; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .qr-btn:hover { background: color-mix(in srgb, var(--text) 8%, transparent); border-color: color-mix(in srgb, var(--text) 55%, transparent); }
  .qr-btn:active { transform: scale(.97); }
  .qr-btn--primary { color: #fff; background: var(--accent); border-color: var(--accent); }
  .qr-btn--primary:hover { background: var(--accent); border-color: var(--accent); filter: brightness(1.08); }
  .qr-btn[hidden] { display: none; }
  .qr :is(.qr-btn, .qr-x):focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  @keyframes qr-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes qr-pop { from { opacity: 0; transform: translateY(10px) scale(.97); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .qr, .qr-card { animation: none; } .qr-btn, .qr-x { transition: none; } }
</style>

<style>
  /* Kravn Cards reel: the real card (same as post.ejs) at its natural size, scaled as a whole to fit the screen.
     Tap = open post, double-tap = like. The Like/Share row under the card is kept in the markup but hidden. */
  .kc {
    position: fixed; inset: 0; z-index: 300; display: flex; flex-direction: column; color: #fff; overflow: hidden;
    height: 100vh; background: #08080c; opacity: 0; visibility: hidden; pointer-events: none;
    overscroll-behavior: contain;
    transition: opacity .2s ease, visibility 0s .2s;
  }
  @supports (height: 100dvh) { .kc { height: 100dvh; } }
  .kc.open { opacity: 1; visibility: visible; pointer-events: auto; transition: opacity .2s ease; }
  .kc-bg { position: absolute; inset: -40px; z-index: 0; background: center / cover no-repeat; filter: blur(50px) saturate(1.2); opacity: .35; transition: background-image .3s; pointer-events: none; }
  .kc::after { content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none; background: linear-gradient(180deg, rgba(8,8,12,.55), rgba(8,8,12,.88)); }
  .kc-progress { position: absolute; top: 0; left: 0; right: 0; z-index: 3; height: 3px; background: rgba(255,255,255,.1); }
  .kc-progress i { display: block; height: 100%; transform-origin: left; transform: scaleX(0); background: linear-gradient(90deg, var(--accent-2, var(--accent)), var(--accent)); transition: transform .25s ease; }

  .kc-top {
    position: relative; z-index: 2; flex: none; display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: calc(10px + env(safe-area-inset-top)) calc(14px + env(safe-area-inset-right)) 6px calc(14px + env(safe-area-inset-left));
  }
  .kc-count { flex: none; min-width: 56px; font: 600 13px/1 var(--font); letter-spacing: .06em; font-variant-numeric: tabular-nums; color: rgba(255,255,255,.85); }
  .kc-hint { flex: 1; min-width: 0; text-align: center; font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: rgba(255,255,255,.5); }
  .kc-close {
    flex: none; width: 44px; height: 44px; display: grid; place-items: center; padding: 0; margin: 0; border-radius: 50%; cursor: pointer; color: #fff;
    background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.25); -webkit-tap-highlight-color: transparent; transition: background .2s, transform .2s;
  }
  .kc-close:hover { background: rgba(255,255,255,.18); }
  .kc-close:active { transform: scale(.94); }
  .kc-close svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  .kc-close:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .kc-feed { position: relative; z-index: 1; flex: 1; min-height: 0; overflow-y: auto; overflow-x: hidden; scroll-snap-type: y mandatory; overscroll-behavior: contain; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
  .kc-feed::-webkit-scrollbar { display: none; }
  .kc-slide {
    height: 100%; box-sizing: border-box; padding: 4px 12px calc(12px + env(safe-area-inset-bottom)); scroll-snap-align: center; scroll-snap-stop: always;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0;
  }
  .kc-slide[hidden] { display: none; }

  /* .kc-fit takes the scaled size in layout; .kc-stage keeps the card's natural size and is scaled with transform */
  .kc-fit { position: relative; flex: none; width: 380px; height: 480px; }
  .kc-stage {
    position: absolute; top: 0; left: 0; width: 380px; transform-origin: 0 0; cursor: pointer;
    -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; touch-action: manipulation; -webkit-tap-highlight-color: transparent;
  }
  .kc-stage .kcard-mount { width: 100%; }
  .kc-heart { position: absolute; inset: 0; z-index: 5; display: grid; place-items: center; pointer-events: none; opacity: 0; color: #fff; }
  .kc-heart svg { width: 96px; height: 96px; fill: currentColor; stroke: none; filter: drop-shadow(0 6px 24px rgba(0,0,0,.55)); }
  .kc-heart.pop { animation: kc-pop .75s ease-out; }
  @keyframes kc-pop { 0% { opacity: 0; transform: scale(.4); } 22% { opacity: 1; transform: scale(1.15); } 60% { opacity: 1; transform: scale(1); } 100% { opacity: 0; transform: scale(1.1); } }

  .kc-bar { display: none; }
  .kc-empty { position: absolute; inset: 0; z-index: 2; display: grid; place-items: center; padding: 24px; text-align: center; font-size: 14px; color: rgba(255,255,255,.7); pointer-events: none; }
  .kc-empty[hidden] { display: none; }

  @media (max-width: 420px) { .kc-hint { display: none; } }
  @media (max-height: 520px) {
    .kc-top { padding-top: calc(6px + env(safe-area-inset-top)); padding-bottom: 2px; }
    .kc-close { width: 38px; height: 38px; }
    .kc-slide { padding-bottom: calc(8px + env(safe-area-inset-bottom)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .kc, .kc-bg, .kc-progress i, .kc-close { transition: none; }
    .kc-heart.pop { animation: none; opacity: 1; }
  }
</style>

<main class="page">
  <div class="shell">

    <header class="profile-head" style="--h:<%= hue(u.username) %>">
      <span class="avatar avatar--xl" style="--h:<%= hue(u.username) %>"><%= u.username.charAt(0).toUpperCase() %></span>
      <div class="profile-id">
        <span class="eyebrow"><span class="dot"></span> <%= isOwn ? 'Your dashboard' : 'Profile' %></span>
        <h1><%= u.username %><% if (tick) { %><span class="vtick vtick--<%= tick.k %>" role="img" aria-label="<%= tick.t %>" title="<%= tick.t %>"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 1.5l2.4 1.7 2.9-.3 1.2 2.7 2.6 1.4-.3 2.9L22.5 12l-1.7 2.4.3 2.9-2.6 1.4-1.2 2.7-2.9-.3L12 22.5l-2.4-1.7-2.9.3-1.2-2.7-2.6-1.4.3-2.9L1.5 12l1.7-2.4-.3-2.9 2.6-1.4 1.2-2.7 2.9.3z"/><path d="M7.8 12.4l2.9 2.9 5.5-5.8" fill="none" stroke="#fff" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"/></svg></span><% } %><% if (isFounder) { %><span class="fbadge" role="img" aria-label="Founder of KravN" title="Founder of KravN"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3.5 17.5L2.6 8.4l5 4.1L12 5l4.4 7.5 5-4.1-.9 9.1z" fill="rgba(214,170,70,.28)" stroke="#d6aa46" stroke-width="1.5" stroke-linejoin="round"/><path d="M5 21h14" stroke="#d6aa46" stroke-width="1.6" stroke-linecap="round" fill="none"/><circle cx="12" cy="3.6" r="1.1" fill="#f0cd78"/></svg><span class="fbadge-t">Founder</span></span><% } %><% if (isOwn) { %><span class="pill pill--accent">You</span><% } %></h1>
        <p class="muted">Member since <%= fmtDate(u.created_at) %></p>
        <% if (isOwn || bioText) { %>
        <div class="pf-bio" id="pf-bio" data-max="<%= BIO_MAX %>">
          <div class="pf-bio-view" id="pf-bio-view">
            <p class="pf-bio-text" id="pf-bio-text"<%- bioText ? '' : ' hidden' %>><%= bioText %></p>
            <% if (isOwn) { %><button type="button" class="pf-bio-btn<%= bioText ? ' is-set' : '' %>" id="pf-bio-open" aria-label="<%= bioText ? 'Edit bio' : 'Add a bio' %>"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg><span>Add a bio</span></button><% } %>
          </div>
          <% if (isOwn) { %>
          <div class="pf-bio-edit" id="pf-bio-edit" hidden>
            <input type="text" id="pf-bio-input" maxlength="<%= BIO_MAX %>" placeholder="Your vibe in a few words" autocomplete="off" aria-label="Your bio">
            <span class="pf-bio-count" id="pf-bio-count" aria-live="polite">0 / <%= BIO_MAX %></span>
            <button type="button" class="pf-sbtn" id="pf-bio-cancel">Cancel</button>
            <button type="button" class="pf-sbtn pf-sbtn--primary" id="pf-bio-save">Save</button>
          </div>
          <% } %>
        </div>
        <% } %>
      </div>
      <div class="profile-actions">
        <% if (items.length) { %><button type="button" class="btn btn-primary" data-cards-open="#feed"><svg class="kv-ic" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="7" width="13" height="14" rx="2"/><path d="M8 3.5h11a2 2 0 0 1 2 2V17"/></svg> Kravn Cards</button><% } %>
        <% if (hasCurate) { %><a class="btn btn-curate" href="<%= curateHref %>"><span class="btn-curate-star" aria-hidden="true">★</span> KravN Curate</a><% } %>
        <% if (isOwn) { %><a class="btn btn-glass" href="/wrapped">✨ KravN Wrapped</a><% } %>
        <button type="button" class="btn btn-glass" aria-haspopup="dialog" data-share-profile data-name="<%= u.username %>" data-title="<%= u.username %> on KravN" data-url="/users/<%= encodeURIComponent(u.username) %>"><%- include('partials/icon', { n: 'share' }) %> <span>Share</span></button>
      </div>
    </header>

    <div class="pf-meta<%= showVibes ? ' pf-meta--vibes' : '' %>">
    <div class="stats">
      <div class="stat" title="Discussions"><strong data-count="<%= stats.discussions %>"><%= stats.discussions %></strong><span>Posts</span></div>
      <div class="stat" title="Likes received"><strong data-count="<%= stats.likes %>"><%= stats.likes %></strong><span>Likes</span></div>
      <div class="stat" title="Comments received"><strong data-count="<%= stats.comments %>"><%= stats.comments %></strong><span>Comments</span></div>
      <div class="stat" title="Movies discussed"><strong data-count="<%= stats.movies %>"><%= stats.movies %></strong><span>Movies</span></div>
    </div>

    <% if (showVibes) { %>
      <% const vibeTitle = isOwn ? 'Movies you vibe with' : 'Movies ' + u.username + ' vibes with'; %>
      <section class="pf-vibe" id="pf-vibe" aria-label="<%= vibeTitle %>" data-max="<%= VIBE_MAX %>">
        <div class="pf-vibe-head">
          <h2 class="pf-vibe-title"><%= isOwn ? 'Your' : u.username + '’s' %> Vibes:</h2>
          <% if (isOwn) { %><button type="button" class="pf-vibe-edit" id="pf-vibe-open" aria-haspopup="dialog" aria-label="Edit movies you vibe with"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg></button><% } %>
        </div>
        <div class="pf-vibe-row" id="pf-vibe-row">
          <% vibes.forEach((v) => { %>
            <figure class="pf-vibe-item" title="<%= v.title %><%= v.year ? ' (' + v.year + ')' : '' %>">
              <span class="pf-vibe-poster"><b class="pf-vibe-ph"><%= v.title %></b><% if (v.poster) { %><img src="<%= v.poster %>" alt="<%= v.title %>" loading="lazy" decoding="async" onerror="this.remove()"><% } %></span>
            </figure>
          <% }) %>
          <% if (isOwn) { for (let i = vibes.length; i < VIBE_MAX; i++) { %><button type="button" class="pf-vibe-slot" aria-label="Add a movie"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button><% } } %>
        </div>
        <% if (isOwn) { %>
          <p class="pf-vibe-hint" id="pf-vibe-hint"<%- vibes.length ? ' hidden' : '' %>>Pick up to 3 movies that sum you up</p>
          <script type="application/json" id="pf-vibe-data"><%- JSON.stringify(vibes).replace(/</g, '\\u003c') %></script>
        <% } %>
      </section>
    <% } %>
    </div>

    <div class="sprocket" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>

    <div class="pf-tabs<%= tabN >= 4 ? ' has-4' : '' %>" role="tablist" aria-label="Profile sections">
      <button type="button" class="pf-tab on" role="tab" id="tab-discussions" aria-controls="panel-discussions" aria-selected="true" data-tab="discussions">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
        Discussions <em><%= items.length %></em>
      </button>
      <button type="button" class="pf-tab" role="tab" id="tab-comments" aria-controls="panel-comments" aria-selected="false" tabindex="-1" data-tab="comments">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H8l-5 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        Comments <em><%= commentList.length %></em>
      </button>
      <% if (hasLikes) { %>
      <button type="button" class="pf-tab" role="tab" id="tab-likes" aria-controls="panel-likes" aria-selected="false" tabindex="-1" data-tab="likes">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
        Likes <em><%= likedItems.length %></em>
      </button>
      <% } %>
      <% if (hasLists) { %>
      <button type="button" class="pf-tab" role="tab" id="tab-lists" aria-controls="panel-lists" aria-selected="false" tabindex="-1" data-tab="lists">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3.5h12a1 1 0 0 1 1 1V21l-7-4.5L5 21V4.5a1 1 0 0 1 1-1z"/></svg>
        Lists <em><%= wlLists.length %></em>
      </button>
      <% } %>
    </div>

    <!-- ===== Discussions ===== -->
    <section class="pf-panel" id="panel-discussions" role="tabpanel" aria-labelledby="tab-discussions" data-panel="discussions">
    <% if (!items.length) { %>
      <div class="empty">
        <p><%= isOwn ? "You haven't posted anything yet." : u.username + " hasn't posted anything yet." %></p>
        <% if (isOwn) { %><a class="btn btn-primary" href="/posts/new">Start your first discussion</a><% } %>
      </div>
    <% } else { %>
      <div class="pf-sec">
        <h2 class="pf-h"><i></i>Discussions</h2>
        <span class="pf-count"><%= items.length %></span>
      </div>

      <div class="toolbar">
        <% menus.forEach((m) => { %>
          <details class="dd dd--<%= m.key %>" data-dd="<%= m.key %>" data-default="<%= m.def %>">
            <summary class="dd-pill" aria-label="<%= m.name %>"><%- m.icon %><span class="dd-label"><%= m.label %></span><%- CHEV %></summary>
            <div class="dd-panel">
              <div class="dd-list">
                <% m.options.forEach((o, i) => { %><button type="button" class="dd-opt<%= m.key === 'genre' && i === 0 ? ' dd-opt--all' : '' %><%= o.v === m.def ? ' on' : '' %>" data-value="<%= o.v %>" data-label="<%= o.t %>"><span><%= o.t %></span><%- CHECK %></button><% }) %>
              </div>
            </div>
          </details>
        <% }) %>
      </div>

      <div class="pf-grid" id="feed">
        <% items.forEach((it) => { %>
          <div class="pf-item" data-id="<%= it.id %>" data-genres="<%= it.genres.join('|') %>" data-ts="<%= it.ts %>" data-rating="<%= it.rating %>" data-likes="<%= it.likes %>" data-liked="<%= it.liked ? 1 : 0 %>">
            <%- include('partials/movieCard', {
              m: { id: it.id, title: it.title, year: it.year, poster: it.poster, percent: null, url: it.href, type: '' },
              href: it.href,
              badge: it.badge,
              sub: it.movie && it.movie !== it.title ? it.movie : ''
            }) %>
          </div>
        <% }) %>
      </div>
      <p class="muted pf-empty" id="pf-empty" hidden>No discussions in that genre yet.</p>
    <% } %>
    </section>

    <!-- ===== Comments ===== -->
    <section class="pf-panel" id="panel-comments" role="tabpanel" aria-labelledby="tab-comments" data-panel="comments" hidden>
      <% if (commentList.length) { %>
        <div class="pf-comments-list">
          <% commentList.forEach((c) => { const txt = String(c.content || ''); %>
            <a class="pf-comment" href="/posts/<%= c.post_id %>#c-<%= c.id %>">
              <p><%= txt.length > 220 ? txt.slice(0, 220) + '…' : txt %></p>
              <div class="pf-comment-meta">
                <span>on <b><%= c.post_title || c.movie_name || 'a discussion' %></b></span>
                <time><%= timeAgo(c.created_at) %></time>
              </div>
            </a>
          <% }) %>
        </div>
      <% } else { %>
        <p class="muted pf-empty"><%= isOwn ? "You haven't commented yet." : u.username + " hasn't commented yet." %></p>
      <% } %>
    </section>

    <!-- ===== Likes ===== -->
    <% if (hasLikes) { %>
    <section class="pf-panel" id="panel-likes" role="tabpanel" aria-labelledby="tab-likes" data-panel="likes" hidden>
      <% if (likedItems.length) { %>
        <div class="pf-grid pf-liked-grid">
          <% likedItems.forEach((it) => { %>
            <div class="pf-item">
              <%- include('partials/movieCard', {
                m: { id: it.id, title: it.title, year: it.year, poster: it.poster, percent: null, url: it.href, type: '' },
                href: it.href,
                badge: it.badge,
                sub: it.movie && it.movie !== it.title ? it.movie : ''
              }) %>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p class="muted pf-empty"><%= isOwn ? "You haven't liked anything yet." : u.username + " hasn't liked anything yet." %></p>
      <% } %>
    </section>
    <% } %>

    <!-- ===== Lists (public watchlist collections) ===== -->
    <% if (hasLists) { %>
    <section class="pf-panel" id="panel-lists" role="tabpanel" aria-labelledby="tab-lists" data-panel="lists" hidden>
      <% if (wlLists.length) { %>
        <div class="pf-lists-head">
          <p><%= wlLists.length %> public <%= wlLists.length === 1 ? 'list' : 'lists' %> · <%= wlTotal %> <%= wlTotal === 1 ? 'title' : 'titles' %></p>
          <a class="pf-lists-all" href="<%= wlBase %>">Open all</a>
        </div>
        <div class="pf-lists">
          <% wlLists.forEach((l) => { const ps = (l.posters || []).slice(0, 4); %>
            <a class="pf-list" href="<%= wlBase %>?list=<%= l.id %>" aria-label="<%= l.name %>, <%= l.count %> <%= Number(l.count) === 1 ? 'title' : 'titles' %>">
              <div class="pf-list-strip" aria-hidden="true">
                <% for (let i = 0; i < 4; i++) { %><span><% if (ps[i]) { %><img src="<%= ps[i] %>" alt="" width="120" height="180" loading="lazy" decoding="async" onerror="this.remove()"><% } %></span><% } %>
              </div>
              <div class="pf-list-meta">
                <div class="pf-list-text">
                  <span class="pf-list-name"><%= l.name %></span>
                  <span class="pf-list-n"><%= l.count %> <%= Number(l.count) === 1 ? 'title' : 'titles' %></span>
                </div>
                <span class="pf-list-go" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg></span>
              </div>
            </a>
          <% }) %>
        </div>
      <% } else { %>
        <div class="pf-lists-empty">
          <p>No public lists yet. Make one of your watchlists public and it will show up here for everyone.</p>
          <a class="btn btn-primary" href="/watchlist">Open my watchlist</a>
        </div>
      <% } %>
    </section>
    <% } %>
  </div>
</main>

<% if (items.length) { %>
<div class="kc" id="kc" role="dialog" aria-modal="true" aria-label="Kravn Cards" aria-hidden="true">
  <div class="kc-bg" aria-hidden="true"></div>
  <div class="kc-progress" aria-hidden="true"><i></i></div>
  <div class="kc-top">
    <span class="kc-count" id="kc-count" aria-live="polite"></span>
    <span class="kc-hint">Tap to open · double-tap to like</span>
    <button type="button" class="kc-close" id="kc-close" aria-label="Close cards"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
  </div>
  <div class="kc-feed" id="kc-feed">
    <% items.forEach((it) => { const c = it.card; %>
      <article class="kc-slide" data-id="<%= it.id %>" data-href="<%= it.href %>" data-poster="<%= c.posterUrl || '' %>">
        <div class="kc-fit">
          <div class="kc-stage">
            <div class="kcard-mount" data-kcard-mount data-post="<%= json(c) %>"></div>
            <span class="kc-heart" aria-hidden="true"><%- include('partials/icon', { n: 'heart' }) %></span>
          </div>
        </div>
        <div class="kc-bar">
          <button type="button" class="kc-btn kc-like<%= c.liked ? ' on' : '' %>" data-like="<%= it.id %>" aria-pressed="<%= !!c.liked %>"><%- include('partials/icon', { n: 'heart' }) %><span data-like-label><%= c.liked ? 'Liked' : 'Like' %></span><b data-like-count="<%= it.id %>"><%= c.likes %></b></button>
          <button type="button" class="kc-btn" data-kc-share data-url="<%= it.href %>" data-title="<%= it.title %>"><%- include('partials/icon', { n: 'share' }) %><span>Share</span></button>
        </div>
      </article>
    <% }) %>
  </div>
  <p class="kc-empty" id="kc-empty" hidden>No discussions to show as cards yet.</p>
</div>
<% } %>

<script>
  /* dropdown filters + sort */
  (function () {
    var grid = document.getElementById('feed');
    if (!grid) return;
    var items = Array.prototype.slice.call(grid.querySelectorAll('.pf-item'));
    var emptyMsg = document.getElementById('pf-empty');
    var state = { genre: '', sort: 'latest' };
    function num(el, k) { return parseFloat(el.getAttribute('data-' + k)) || 0; }

    /* ----- filter + sort ----- */
    var by = {
      latest: function (a, b) { return num(b, 'ts') - num(a, 'ts'); },
      oldest: function (a, b) { return num(a, 'ts') - num(b, 'ts'); },
      rating: function (a, b) { return num(b, 'rating') - num(a, 'rating'); },
      likes:  function (a, b) { return num(b, 'likes') - num(a, 'likes'); },
      random: function () { return Math.random() - .5; }
    };
    function apply() {
      var shown = items.filter(function (it) {
        var ok = !state.genre || (it.getAttribute('data-genres') || '').split('|').indexOf(state.genre) > -1;
        it.hidden = !ok; return ok;
      });
      shown.sort(by[state.sort] || by.latest).forEach(function (it) { grid.appendChild(it); });
      if (emptyMsg) emptyMsg.hidden = shown.length > 0;
    }

    /* ----- dropdown pills ----- */
    var menus = Array.prototype.slice.call(document.querySelectorAll('[data-dd]'));
    menus.forEach(function (m) {
      m.addEventListener('toggle', function () {
        if (!m.open) return;
        menus.forEach(function (o) { if (o !== m) o.open = false; });
        var on = m.querySelector('.dd-opt.on'); if (on) on.scrollIntoView({ block: 'nearest' });
      });
      m.addEventListener('click', function (e) {
        var o = e.target.closest('.dd-opt'); if (!o) return;
        var v = o.getAttribute('data-value');
        m.querySelectorAll('.dd-opt').forEach(function (x) { x.classList.toggle('on', x === o); });
        m.querySelector('.dd-label').textContent = o.getAttribute('data-label');
        m.classList.toggle('has-value', v !== m.getAttribute('data-default'));
        state[m.getAttribute('data-dd')] = v;
        m.open = false; apply();
      });
    });
    document.addEventListener('click', function (e) { menus.forEach(function (m) { if (m.open && !m.contains(e.target)) m.open = false; }); });
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      menus.forEach(function (m) { if (m.open) { m.open = false; m.querySelector('summary').focus(); } });
    });
    apply();
  })();
</script>

<script>
  /* Profile tabs: Discussions / Comments / Likes / Lists (keyboard + #hash aware) */
  (function () {
    var tabs = Array.prototype.slice.call(document.querySelectorAll('[data-tab]'));
    var panels = Array.prototype.slice.call(document.querySelectorAll('[data-panel]'));
    if (!tabs.length) return;
    function show(name, focus) {
      if (!tabs.some(function (t) { return t.getAttribute('data-tab') === name; })) name = 'discussions';
      tabs.forEach(function (t) {
        var on = t.getAttribute('data-tab') === name;
        t.classList.toggle('on', on); t.setAttribute('aria-selected', on ? 'true' : 'false'); t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      });
      panels.forEach(function (p) { p.hidden = p.getAttribute('data-panel') !== name; });
      try { history.replaceState(null, '', name === 'discussions' ? location.pathname + location.search : '#' + name); } catch (e) {}
    }
    function fromHash() { var h = (location.hash || '').replace('#', ''); if (h === 'comments' || h === 'likes' || h === 'lists') show(h); }
    tabs.forEach(function (t, i) {
      t.addEventListener('click', function () { show(t.getAttribute('data-tab')); });
      t.addEventListener('keydown', function (e) {
        var n = e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowLeft' ? i - 1 : e.key === 'Home' ? 0 : e.key === 'End' ? tabs.length - 1 : -1;
        if (n < 0) return;
        e.preventDefault(); show(tabs[(n + tabs.length) % tabs.length].getAttribute('data-tab'), true);
      });
    });
    fromHash();
    window.addEventListener('hashchange', fromHash);
  })();
</script>

<script>
  /* Kravn Cards reel: the real KravN Card (same as the post page) scaled to fit any screen.
     Tap = open post, double-tap = like, swipe = next card, back button = close. */
  (function () {
    var ov = document.getElementById('kc'), feed = document.getElementById('kc-feed'), grid = document.getElementById('feed');
    if (!ov || !feed || !grid) return;
    var bg = ov.querySelector('.kc-bg'), bar = ov.querySelector('.kc-progress i'), count = document.getElementById('kc-count'), empty = document.getElementById('kc-empty');
    var slides = Array.prototype.slice.call(feed.querySelectorAll('.kc-slide')), byId = {};
    var INTERACTIVE = 'button, a, input, textarea, select, label, [role="button"]';
    var MAX_SCALE = 1.5;
    slides.forEach(function (s) { byId[s.getAttribute('data-id')] = s; });
    var cur = 0, lastFocus = null, ticking = false, tapTimer = null, pushed = false, fitQueued = false;

    function live() { return Array.prototype.filter.call(feed.querySelectorAll('.kc-slide'), function (s) { return !s.hidden; }); }

    /* follow whatever genre filter + sort the grid is showing right now */
    function arrange() {
      var order = Array.prototype.filter.call(grid.querySelectorAll('.pf-item'), function (it) { return !it.hidden; })
        .map(function (it) { return byId[it.getAttribute('data-id')]; }).filter(Boolean);
      slides.forEach(function (s) { s.hidden = order.indexOf(s) < 0; });
      var dom = live(), same = dom.length === order.length && order.every(function (s, i) { return dom[i] === s; });
      if (!same) order.forEach(function (s) { feed.appendChild(s); });
      empty.hidden = order.length > 0;
    }

    /* scale the whole card (never reshape it) so it fits the screen; grows a little on big screens */
    function fit(slide) {
      if (!slide || slide.hidden) return;
      var box = slide.querySelector('.kc-fit'), st = slide.querySelector('.kc-stage');
      var w = st.offsetWidth, h = st.offsetHeight;
      if (!w || !h || !slide.clientHeight) return;
      var cs = getComputedStyle(slide);
      var availW = slide.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
      var availH = slide.clientHeight - parseFloat(cs.paddingTop) - parseFloat(cs.paddingBottom);
      var s = Math.max(0.3, Math.min(availW / w, availH / h, MAX_SCALE));
      st.style.transform = 'scale(' + s + ')';
      box.style.width = Math.floor(w * s) + 'px'; box.style.height = Math.floor(h * s) + 'px';
    }
    function fitAll() {
      if (fitQueued) return; fitQueued = true;
      requestAnimationFrame(function () { fitQueued = false; live().forEach(fit); });
    }
    if (window.ResizeObserver) {
      var ro = new ResizeObserver(fitAll);
      slides.forEach(function (s) { ro.observe(s.querySelector('.kc-stage')); });
      ro.observe(feed);
    }

    function sync() {
      var v = live(), h = feed.clientHeight || 1;
      cur = Math.max(0, Math.min(v.length - 1, Math.round(feed.scrollTop / h)));
      count.textContent = v.length ? (cur + 1) + ' / ' + v.length : '';
      bar.style.transform = 'scaleX(' + (v.length ? (cur + 1) / v.length : 0) + ')';
      var p = v[cur] && v[cur].getAttribute('data-poster');
      bg.style.backgroundImage = p ? 'url("' + p.replace(/"/g, '%22') + '")' : 'none';
    }
    function go(i) { var n = live().length; feed.scrollTo({ top: Math.max(0, Math.min(n - 1, i)) * feed.clientHeight, behavior: 'smooth' }); }

    function open() {
      arrange(); lastFocus = document.activeElement;
      ov.classList.add('open'); ov.setAttribute('aria-hidden', 'false');
      document.documentElement.style.overflow = 'hidden'; document.body.style.overflow = 'hidden';
      try { history.pushState({ kc: 1 }, ''); pushed = true; } catch (e) { pushed = false; }
      feed.scrollTop = 0; sync(); fitAll();
      setTimeout(fitAll, 120); setTimeout(fitAll, 500);
      document.getElementById('kc-close').focus({ preventScroll: true });
    }
    function hide() {
      if (!ov.classList.contains('open')) return;
      clearTimeout(tapTimer); tapTimer = null;
      ov.classList.remove('open'); ov.setAttribute('aria-hidden', 'true');
      document.documentElement.style.overflow = ''; document.body.style.overflow = '';
      if (lastFocus && lastFocus.focus) lastFocus.focus({ preventScroll: true });
    }
    function close() {
      if (!ov.classList.contains('open')) return;
      if (pushed) { pushed = false; try { history.back(); } catch (e) {} }
      hide();
    }
    window.addEventListener('popstate', function () { pushed = false; hide(); });

    function like(slide) {
      var b = slide.querySelector('.kc-like'), h = slide.querySelector('.kc-heart');
      if (b && !b.classList.contains('on')) b.click();
      if (h) { h.classList.remove('pop'); void h.offsetWidth; h.classList.add('pop'); }
      if (navigator.vibrate) { try { navigator.vibrate(12); } catch (e) {} }
    }

    feed.addEventListener('scroll', function () { if (ticking) return; ticking = true; requestAnimationFrame(function () { ticking = false; sync(); }); }, { passive: true });
    feed.addEventListener('click', function (e) {
      if (e.target === feed || e.target.classList.contains('kc-slide')) { close(); return; }

      /* tap on the card: second tap within 260ms likes, otherwise open the post */
      var stage = e.target.closest('.kc-stage');
      if (!stage || e.target.closest(INTERACTIVE)) return;
      var slide = stage.closest('.kc-slide');
      if (tapTimer) { clearTimeout(tapTimer); tapTimer = null; like(slide); return; }
      tapTimer = setTimeout(function () { tapTimer = null; location.href = slide.getAttribute('data-href'); }, 260);
    });
    document.getElementById('kc-close').addEventListener('click', close);
    document.addEventListener('click', function (e) {
      var b = e.target.closest && e.target.closest('[data-cards-open]');
      if (b) { e.preventDefault(); e.stopImmediatePropagation(); open(); }
    }, true);
    document.addEventListener('keydown', function (e) {
      if (!ov.classList.contains('open')) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowDown' || e.key === 'PageDown') { e.preventDefault(); go(cur + 1); }
      else if (e.key === 'ArrowUp' || e.key === 'PageUp') { e.preventDefault(); go(cur - 1); }
    });

    /* rotation / address-bar resize: stay on the same card and refit */
    window.addEventListener('resize', function () {
      if (!ov.classList.contains('open')) return;
      feed.scrollTop = cur * feed.clientHeight; sync(); fitAll();
    });
    window.addEventListener('orientationchange', function () { setTimeout(function () { window.dispatchEvent(new Event('resize')); }, 250); });
  })();
</script>

<script>
  /* Bio (max 20 characters) + "Movies you vibe with" (max 3): owner-only editors */
  (function () {
    var BIO_URL = '/profile/bio';                 // POST { bio }                                  -> { bio }
    var VIBES_URL = '/profile/vibes';             // POST { movies: [{ id, title, year, poster }] } -> { movies }
    var SEARCH_URL = function (q) { return '/api/vibes/search?q=' + encodeURIComponent(q); }; // GET -> { results: [...] }
    var HEAD = { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-Requested-With': 'fetch' };
    var PLUS = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>';
    var CLOSE = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>';

    function mk(tag, cls, html) { var e = document.createElement(tag); if (cls) e.className = cls; if (html) e.innerHTML = html; return e; }
    function chars(s) { return Array.from(s).length; }
    function tidy(s) { return String(s || '').replace(/\s+/g, ' ').trim(); }
    function postJSON(url, body) {
      return fetch(url, { method: 'POST', credentials: 'same-origin', headers: HEAD, body: JSON.stringify(body) }).then(function (r) {
        if (r.status === 401) { location.href = '/login?next=' + encodeURIComponent(location.pathname); throw new Error('auth'); }
        if (!r.ok) return failFrom(r);
        return r.json();
      });
    }
    function failFrom(r) {
      return r.json().catch(function () { return {}; }).then(function (j) {
        var e = new Error('bad'); e.status = r.status; e.detail = (j && j.error) || ''; throw e;
      });
    }
    function describe(e, what) {
      if (e && e.status === 404) return 'Server not updated: restart node';
      if (e && e.detail) return e.detail;
      return what + ' (' + ((e && e.status) || 'network error') + ')';
    }
    function norm(r) {
      return { id: String(r.id || ''), title: String(r.title || ''), year: String(r.year || ''), poster: String(r.poster || '') };
    }
    function posterImg(src, alt) {
      var i = new Image(); i.alt = alt || ''; i.loading = 'lazy'; i.decoding = 'async';
      i.onerror = function () { this.remove(); }; i.src = src; return i;
    }

    /* ===== bio ===== */
    (function () {
      var root = document.getElementById('pf-bio'), edit = document.getElementById('pf-bio-edit');
      if (!root || !edit) return;
      var max = parseInt(root.getAttribute('data-max'), 10) || 20;
      var view = document.getElementById('pf-bio-view'), text = document.getElementById('pf-bio-text'), open = document.getElementById('pf-bio-open');
      var input = document.getElementById('pf-bio-input'), count = document.getElementById('pf-bio-count');
      var save = document.getElementById('pf-bio-save'), cancel = document.getElementById('pf-bio-cancel');
      var current = tidy(text.textContent), busy = false;

      function refresh() {
        var n = chars(tidy(input.value));
        count.textContent = n + ' / ' + max;
        count.classList.toggle('over', n > max);
        save.disabled = busy || n > max;
      }
      function paint() {
        text.textContent = current; text.hidden = !current;
        open.classList.toggle('is-set', !!current);
        open.setAttribute('aria-label', current ? 'Edit bio' : 'Add a bio');
      }
      function openEdit() {
        input.value = current; view.hidden = true; edit.hidden = false; refresh();
        input.focus(); input.setSelectionRange(input.value.length, input.value.length);
      }
      function closeEdit() { edit.hidden = true; view.hidden = false; open.focus(); }

      paint();
      open.addEventListener('click', openEdit);
      cancel.addEventListener('click', closeEdit);
      input.addEventListener('input', refresh);
      input.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') { e.preventDefault(); closeEdit(); }
        else if (e.key === 'Enter') { e.preventDefault(); if (!save.disabled) save.click(); }
      });
      save.addEventListener('click', function () {
        var v = tidy(input.value), failed = false;
        if (busy || chars(v) > max) return;
        busy = true; save.textContent = 'Saving…'; refresh();
        postJSON(BIO_URL, { bio: v }).then(function (j) {
          current = tidy(j && typeof j.bio === 'string' ? j.bio : v);
          paint(); closeEdit();
        }).catch(function (e) {
          failed = (e && e.message === 'auth') ? '' : describe(e, 'Couldn’t save');
        }).then(function () {
          busy = false; save.textContent = 'Save'; refresh();
          if (failed) { count.textContent = failed; count.classList.add('over'); }
        });
      });
    })();

    /* ===== movies you vibe with ===== */
    (function () {
      var section = document.getElementById('pf-vibe'), openBtn = document.getElementById('pf-vibe-open');
      if (!section || !openBtn) return;
      var MAXV = parseInt(section.getAttribute('data-max'), 10) || 3;
      var row = document.getElementById('pf-vibe-row'), hint = document.getElementById('pf-vibe-hint');
      var saved = [], draft = [], found = [], busy = false, seq = 0, timer = null, lastFocus = null;
      var box, input, picked, results, countEl, saveBtn;
      try { saved = (JSON.parse(document.getElementById('pf-vibe-data').textContent) || []).map(norm); } catch (e) { saved = []; }

      function renderRow() {
        var i;
        row.textContent = '';
        saved.forEach(function (m) {
          var fig = mk('figure', 'pf-vibe-item'), p = mk('span', 'pf-vibe-poster'), ph = mk('b', 'pf-vibe-ph');
          fig.title = m.title + (m.year ? ' (' + m.year + ')' : '');
          ph.textContent = m.title; p.appendChild(ph);
          if (m.poster) p.appendChild(posterImg(m.poster, m.title));
          fig.appendChild(p); row.appendChild(fig);
        });
        for (i = saved.length; i < MAXV; i++) {
          var s = mk('button', 'pf-vibe-slot', PLUS); s.type = 'button'; s.setAttribute('aria-label', 'Add a movie'); row.appendChild(s);
        }
        if (hint) hint.hidden = saved.length > 0;
      }

      function setMsg(t) { results.textContent = ''; var p = mk('p', 'vb-msg'); p.textContent = t; results.appendChild(p); }
      function inDraft(m) { return draft.some(function (d) { return d.id === m.id; }); }
      function updateFoot() { countEl.classList.remove('over'); countEl.textContent = draft.length + ' / ' + MAXV + ' picked'; }
      function markRes() {
        Array.prototype.forEach.call(results.querySelectorAll('.vb-res'), function (b) {
          var m = found[+b.getAttribute('data-i')], on = inDraft(m);
          b.disabled = on || draft.length >= MAXV;
          b.classList.toggle('on', on);
          b.querySelector('.vb-res-tag').textContent = on ? 'Added' : 'Add';
        });
      }
      function drawPicked() {
        var i;
        picked.textContent = '';
        for (i = 0; i < MAXV; i++) {
          var m = draft[i], s = mk('div', 'vb-pick' + (m ? ' filled' : ''));
          if (m) {
            s.title = m.title;
            var ph = mk('span', 'vb-pick-ph'); ph.textContent = m.title; s.appendChild(ph);
            if (m.poster) s.appendChild(posterImg(m.poster, m.title));
            var x = mk('button', 'vb-pick-x', CLOSE); x.type = 'button'; x.setAttribute('data-i', i); x.setAttribute('aria-label', 'Remove ' + m.title); s.appendChild(x);
          } else { s.textContent = String(i + 1); }
          picked.appendChild(s);
        }
      }
      function drawFound() {
        results.textContent = '';
        found.forEach(function (m, i) {
          var b = mk('button', 'vb-res'), th = mk('span', 'vb-res-th'), tx = mk('span', 'vb-res-text'), nm = mk('span', 'vb-res-name'), yr = mk('span', 'vb-res-yr'), tag = mk('span', 'vb-res-tag');
          b.type = 'button'; b.setAttribute('data-i', i);
          if (m.poster) th.appendChild(posterImg(m.poster, ''));
          nm.textContent = m.title; yr.textContent = m.year; tag.textContent = 'Add';
          tx.appendChild(nm); if (m.year) tx.appendChild(yr);
          b.appendChild(th); b.appendChild(tx); b.appendChild(tag); results.appendChild(b);
        });
        markRes();
      }

      function run(q) {
        var my = ++seq;
        setMsg('Searching…');
        fetch(SEARCH_URL(q), { credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
          .then(function (r) {
            if (r.status === 401) { location.href = '/login?next=' + encodeURIComponent(location.pathname); throw new Error('auth'); }
            if (!r.ok) return failFrom(r);
            return r.json();
          })
          .then(function (j) {
            if (my !== seq) return;
            found = ((j && j.results) || []).map(norm).filter(function (m) { return m.id && m.title; });
            if (found.length) drawFound(); else setMsg('No movies found for “' + q + '”.');
          })
          .catch(function (e) { if (my === seq && !(e && e.message === 'auth')) setMsg(describe(e, 'Search failed')); });
      }

      function build() {
        box = mk('div', 'vb'); box.hidden = true; box.setAttribute('role', 'dialog'); box.setAttribute('aria-modal', 'true'); box.setAttribute('aria-labelledby', 'vb-title');
        var card = mk('div', 'vb-card');
        var x = mk('button', 'vb-x', CLOSE); x.type = 'button'; x.setAttribute('aria-label', 'Close');
        var head = mk('div', 'vb-head', '<h3 id="vb-title">Movies you vibe with</h3><p>Pick up to 3 that say something about you. You can change them any time.</p>');
        picked = mk('div', 'vb-picked');
        var sw = mk('div', 'vb-search'); input = mk('input'); input.type = 'search'; input.placeholder = 'Search for a movie…'; input.autocomplete = 'off'; input.setAttribute('aria-label', 'Search for a movie'); sw.appendChild(input);
        results = mk('div', 'vb-results'); results.setAttribute('aria-live', 'polite');
        var foot = mk('div', 'vb-foot'), actions = mk('div', 'vb-actions');
        countEl = mk('span', 'vb-count');
        var cancel = mk('button', 'pf-sbtn', 'Cancel'); cancel.type = 'button';
        saveBtn = mk('button', 'pf-sbtn pf-sbtn--primary', 'Save'); saveBtn.type = 'button';
        actions.appendChild(cancel); actions.appendChild(saveBtn); foot.appendChild(countEl); foot.appendChild(actions);
        [x, head, picked, sw, results, foot].forEach(function (n) { card.appendChild(n); });
        box.appendChild(card); document.body.appendChild(box);

        x.addEventListener('click', hide); cancel.addEventListener('click', hide);
        box.addEventListener('click', function (e) { if (e.target === box) hide(); });
        picked.addEventListener('click', function (e) {
          var b = e.target.closest('.vb-pick-x'); if (!b) return;
          draft.splice(+b.getAttribute('data-i'), 1); drawPicked(); markRes(); updateFoot();
        });
        results.addEventListener('click', function (e) {
          var b = e.target.closest('.vb-res'); if (!b || b.disabled) return;
          var m = found[+b.getAttribute('data-i')];
          if (!m || draft.length >= MAXV || inDraft(m)) return;
          draft.push(m); drawPicked(); markRes(); updateFoot();
        });
        input.addEventListener('input', function () {
          clearTimeout(timer);
          var q = input.value.trim();
          if (q.length < 2) { seq++; found = []; setMsg(q ? 'Keep typing…' : 'Search for a movie to add it.'); return; }
          timer = setTimeout(function () { run(q); }, 300);
        });
        saveBtn.addEventListener('click', function () {
          if (busy) return;
          busy = true; saveBtn.disabled = true; saveBtn.textContent = 'Saving…';
          var failed = false;
          postJSON(VIBES_URL, { movies: draft }).then(function (j) {
            saved = (j && Array.isArray(j.movies) ? j.movies : draft).map(norm).slice(0, MAXV);
            renderRow(); hide();
          }).catch(function (e) {
            failed = (e && e.message === 'auth') ? '' : describe(e, 'Couldn’t save');
          }).then(function () {
            busy = false; saveBtn.disabled = false; saveBtn.textContent = 'Save';
            if (failed) { countEl.textContent = failed; countEl.classList.add('over'); }
          });
        });
        box.addEventListener('keydown', function (e) {
          if (e.key !== 'Tab') return;
          var f = Array.prototype.filter.call(box.querySelectorAll('button, input'), function (b) { return !b.disabled && b.offsetParent !== null; });
          if (!f.length) return;
          var first = f[0], last = f[f.length - 1];
          if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
          else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        });
      }

      function show() {
        if (!box) build();
        draft = saved.slice(); found = []; seq++; input.value = '';
        drawPicked(); updateFoot(); setMsg('Search for a movie to add it.');
        lastFocus = document.activeElement; document.documentElement.style.overflow = 'hidden';
        box.hidden = false; input.focus();
      }
      function hide() {
        if (!box || box.hidden) return;
        box.hidden = true; document.documentElement.style.overflow = '';
        if (lastFocus && lastFocus.focus) lastFocus.focus();
      }

      openBtn.addEventListener('click', show);
      row.addEventListener('click', function (e) { if (e.target.closest('.pf-vibe-slot')) show(); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') hide(); });
    })();
  })();
</script>

<script>
  /* Share profile: opens a KravN-branded QR card (scan it to open the profile) with Copy link / Share / Save image.
     The QR code is generated right here in the browser: no library, no external request. */
  (function () {

    /* ===== tiny QR encoder (byte mode, error-correction Q/H, versions 1-15) ===== */
    var KravQR = (function () {
