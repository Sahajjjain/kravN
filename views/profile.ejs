<%
  const u = profileUser;
  const allGenres = topGenres.length ? [...new Set(posts.flatMap((p) => genreList(p)))].sort() : [];
%>
<%- include('partials/head', { title: isOwn ? 'Your dashboard' : '@' + u.username }) %>
<%- include('partials/nav') %>

<main class="page">
  <div class="shell">

    <header class="profile-head">
      <span class="avatar avatar--xl" style="--h:<%= hue(u.username) %>"><%= u.username.charAt(0).toUpperCase() %></span>
      <div class="profile-id">
        <span class="eyebrow"><span class="dot"></span> <%= isOwn ? 'Your dashboard' : 'Profile' %></span>
        <h1><%= u.username %><% if (isOwn) { %><span class="pill pill--accent">You</span><% } %></h1>
        <p class="muted">Member since <%= fmtDate(u.created_at) %></p>
        <% if (topGenres.length) { %><div class="chips"><% topGenres.forEach((g) => { %><span class="chip chip--static"><%= g %></span><% }) %></div><% } %>
      </div>
      <div class="profile-actions">
        <% if (posts.length) { %><button type="button" class="btn btn-primary" data-cards-open="#feed"><%- include('partials/icon', { n: 'cards' }) %> Kravn Cards</button><% } %>
        <% if (isOwn) { %><a class="btn btn-glass" href="/posts/new"><%- include('partials/icon', { n: 'plus' }) %> New discussion</a><% } %>
      </div>
    </header>

    <div class="stats">
      <div class="stat"><strong data-count="<%= stats.discussions %>"><%= stats.discussions %></strong><span>Discussion<%= stats.discussions === 1 ? '' : 's' %></span></div>
      <div class="stat"><strong data-count="<%= stats.likes %>"><%= stats.likes %></strong><span>Like<%= stats.likes === 1 ? '' : 's' %> received</span></div>
      <div class="stat"><strong data-count="<%= stats.comments %>"><%= stats.comments %></strong><span>Comment<%= stats.comments === 1 ? '' : 's' %> received</span></div>
      <div class="stat"><strong data-count="<%= stats.movies %>"><%= stats.movies %></strong><span>Movie<%= stats.movies === 1 ? '' : 's' %> discussed</span></div>
    </div>

    <div class="sprocket" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>

    <% if (!posts.length) { %>
      <div class="empty">
        <p><%= isOwn ? "You haven't posted anything yet." : u.username + " hasn't posted anything yet." %></p>
        <% if (isOwn) { %><a class="btn btn-primary" href="/posts/new">Start your first discussion</a><% } %>
      </div>
    <% } else { %>
      <div class="toolbar">
        <div class="chips chips--scroll" data-filter-genres>
          <button type="button" class="chip on" data-genre="">All</button>
          <% allGenres.forEach((g) => { %><button type="button" class="chip" data-genre="<%= g %>"><%= g %></button><% }) %>
        </div>
        <div class="toolbar-right">
          <select class="select" data-sort-select aria-label="Sort discussions">
            <option value="latest">Latest</option>
            <option value="oldest">Oldest</option>
            <option value="rating">Highest rated</option>
            <option value="likes">Most liked</option>
            <option value="random">Random</option>
          </select>
          <div class="seg seg--icons" data-view-toggle>
            <button type="button" data-view="list" class="on" aria-label="List view"><%- include('partials/icon', { n: 'list' }) %></button>
            <button type="button" data-view="grid" aria-label="Poster grid"><%- include('partials/icon', { n: 'grid' }) %></button>
          </div>
        </div>
      </div>

      <div class="stack" id="feed" data-post-list data-filterable><%- include('partials/postCards', { posts }) %></div>
      <p class="empty-line muted" id="feed-empty" hidden>No discussions in that genre yet.</p>
    <% } %>
  </div>
</main>
<%- include('partials/foot') %>
