<!DOCTYPE html>
<html data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register - KravN</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/theme.js"></script>
</head>
<body>
  <div class="auth-page">
    <div class="auth-visual">
      <div class="auth-poster-strip">
        <% if (typeof posters !== 'undefined' && posters.length) { %>
          <% posters.slice(0, 10).forEach(url => { %>
            <img src="<%= url %>" alt="" onerror="this.remove()">
          <% }); %>
        <% } %>
      </div>
      <div class="auth-visual-overlay"></div>
      <div class="auth-visual-content">
        <div class="auth-logo">Krav<span>N</span></div>
        <p class="auth-tagline">Your theory is one post away.</p>
      </div>
    </div>

    <div class="auth-form-side">
      <div class="auth-card">
        <span class="auth-eyebrow">Create Account</span>
        <h1>Join KravN.</h1>
        <p class="auth-subtitle">Start posting your theories.</p>

        <% if (error) { %>
          <p class="auth-error"><%= error %></p>
        <% } %>

        <form action="/register" method="POST">
          <label class="auth-label">Username</label>
          <input type="text" name="username" placeholder="yourname" required>

          <label class="auth-label">Email</label>
          <input type="email" name="email" placeholder="you@example.com" required>

          <label class="auth-label">Password</label>
          <input type="password" name="password" placeholder="••••••••" required>

          <button type="submit">Create account</button>
        </form>

        <p class="auth-switch">Already have an account? <a href="/login">Login</a></p>
      </div>
    </div>
  </div>
</body>
</html>