<!DOCTYPE html>
<html data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Feed - KravN</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
/* ============================================================
   KRAVN CARDS — shared engine styles
   Used by feed.ejs, dashboard.ejs, and userProfile.ejs.
   Colors are theme-aware: purple in dark mode, gold in light
   mode, driven by html[data-theme].
   ============================================================ */

:root {
  --kravn-primary: #8b5cf6;
  --kravn-primary-rgb: 139, 92, 246;
  --kravn-primary-dark: #6d28d9;
  --kravn-primary-light: #c4b5fd;
  --kravn-heart-red: #ef4444;
}

html[data-theme="light"] {
  --kravn-primary: #d4a017;
  --kravn-primary-rgb: 212, 160, 23;
  --kravn-primary-dark: #a9790a;
  --kravn-primary-light: #f0cf6f;
  --kravn-heart-red: #e0703a;
}

.kravn-wordmark-n {
  background: linear-gradient(115deg, var(--kravn-primary-light) 0%, #fff 18%, var(--kravn-primary) 45%, var(--kravn-primary-light) 70%, var(--kravn-primary) 100%);
  background-size: 250% auto;
  -webkit-background-clip: text;
  background-clip: text;
  color: var(--kravn-primary-light);
  -webkit-text-fill-color: transparent;
  animation: kravn-n-shimmer 3.2s linear infinite;
  filter: drop-shadow(0 0 10px rgba(var(--kravn-primary-rgb), 0.45));
  display: inline-block;
}
@keyframes kravn-n-shimmer {
  0%   { background-position: 0% center; }
  100% { background-position: 250% center; }
}

/* ---- Cards entry button — rectangular, minimalist, premium shine ---- */
.kravn-cards-row {
  display: flex;
  justify-content: center;
  margin: var(--space-5, 1.5rem) 0 var(--space-6, 2rem);
}

.kravn-cards-btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.75rem 1.8rem;
  border-radius: 8px;
  border: 1px solid rgba(var(--kravn-primary-rgb), 0.4);
  background:
    linear-gradient(#0a0a0c, #0a0a0c) padding-box,
    linear-gradient(120deg, rgba(var(--kravn-primary-rgb), 0.9), var(--kravn-primary-light), rgba(var(--kravn-primary-rgb), 0.9)) border-box;
  color: var(--kravn-primary-light);
  font-family: var(--font-mono, monospace);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  cursor: pointer;
  overflow: hidden;
  isolation: isolate;
  box-shadow: 0 10px 26px rgba(var(--kravn-primary-rgb), 0.16);
  transition: box-shadow 0.2s ease, color 0.2s ease, border-color 0.2s ease;
}
.kravn-cards-btn::before {
  content: '';
  position: absolute;
  top: 0; left: -60%;
  width: 45%; height: 100%;
  background: linear-gradient(115deg, transparent, rgba(255,255,255,0.5), transparent);
  transform: skewX(-20deg);
  animation: kravn-btn-shine 4.5s ease-in-out infinite;
}
.kravn-cards-btn:hover {
  color: #fff;
  border-color: rgba(var(--kravn-primary-rgb), 0.7);
  box-shadow: 0 14px 34px rgba(var(--kravn-primary-rgb), 0.28);
}
.kravn-cards-btn:active { transform: translateY(1px); }

@keyframes kravn-btn-shine {
  0%   { left: -60%; }
  35%  { left: 130%; }
  100% { left: 130%; }
}

.kravn-cards-btn-icon {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--kravn-primary-light);
  box-shadow: 0 0 8px var(--kravn-primary);
  flex-shrink: 0;
}

@media (max-width: 480px) {
  .kravn-cards-btn { padding: 0.6rem 1.3rem; font-size: 0.7rem; letter-spacing: 0.13em; }
}

/* ---- Overlay shell ---- */
.kravn-overlay {
  position: fixed; inset: 0; z-index: 999;
  background: #050505;
  display: none;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
}
.kravn-overlay.active { display: flex; animation: kravn-fade-in 0.3s ease; }
@keyframes kravn-fade-in { from { opacity: 0; } to { opacity: 1; } }

.kravn-overlay-top {
  width: 100%; max-width: 420px;
  padding: env(safe-area-inset-top, 14px) 16px 0;
  box-sizing: border-box;
  z-index: 100;
}
.kravn-pips { display: flex; gap: 4px; margin-bottom: 14px; }
.kravn-pip {
  flex: 1; height: 2.5px; border-radius: 2px;
  background: rgba(255,255,255,0.14);
  overflow: hidden; position: relative;
}
.kravn-pip.done { background: var(--kravn-primary); }
.kravn-pip.active::after {
  content: ''; position: absolute; inset: 0;
  background: var(--kravn-primary);
  animation: kravn-pip-fill 0.3s ease forwards;
}
@keyframes kravn-pip-fill { from { width: 0; } to { width: 100%; } }

.kravn-overlay-header { display: flex; align-items: center; justify-content: space-between; }
.kravn-brand {
  font-family: var(--font-mono, monospace);
  font-size: 0.95rem; font-weight: 700; color: #fff; letter-spacing: -0.3px;
}

.kravn-header-actions { display: flex; gap: 0.55rem; align-items: center; }

.kravn-mode-toggle {
  position: relative;
  display: flex;
  align-items: center;
  width: 128px;
  height: 32px;
  border-radius: 20px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(var(--kravn-primary-rgb), 0.3);
  cursor: pointer;
  overflow: hidden;
  user-select: none;
  flex-shrink: 0;
}
.kravn-mode-thumb {
  position: absolute;
  top: 2px; left: 2px;
  width: calc(50% - 2px);
  height: calc(100% - 4px);
  border-radius: 18px;
  background: linear-gradient(135deg, var(--kravn-primary), var(--kravn-primary-dark));
  box-shadow: 0 2px 10px rgba(var(--kravn-primary-rgb), 0.5);
  transition: transform 0.28s cubic-bezier(0.22,1,0.36,1);
}
.kravn-mode-toggle.shuffle .kravn-mode-thumb { transform: translateX(100%); }
.kravn-mode-option {
  position: relative; z-index: 1;
  flex: 1; text-align: center;
  font-family: var(--font-mono, monospace);
  font-size: 0.6rem; letter-spacing: 0.05em; text-transform: uppercase;
  color: rgba(255,255,255,0.45);
  transition: color 0.25s ease;
}
.kravn-mode-toggle:not(.shuffle) .kravn-mode-option[data-mode="latest"],
.kravn-mode-toggle.shuffle .kravn-mode-option[data-mode="shuffle"] {
  color: #fff; font-weight: 700;
}

.kravn-icon-btn {
  width: 34px; height: 34px;
  border-radius: 50%;
  border: 1px solid rgba(var(--kravn-primary-rgb), 0.3);
  background: rgba(var(--kravn-primary-rgb), 0.06);
  color: #ddd;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer;
  font-size: 0.95rem;
  transition: all 0.18s ease;
  flex-shrink: 0;
}
.kravn-icon-btn:hover {
  border-color: var(--kravn-primary);
  color: var(--kravn-primary-light);
  background: rgba(var(--kravn-primary-rgb), 0.12);
}

@media (max-width: 420px) {
  .kravn-icon-btn { width: 30px; height: 30px; font-size: 0.85rem; }
  .kravn-mode-toggle { width: 108px; height: 30px; }
  .kravn-header-actions { gap: 0.4rem; }
  .kravn-brand { font-size: 0.85rem; }
}

.kravn-stage {
  position: relative;
  flex: 1; width: 100%; max-width: 420px;
  display: flex; align-items: center; justify-content: center;
  touch-action: pan-y;
  padding: 10px 16px 20px;
  box-sizing: border-box;
}
.kravn-empty {
  color: var(--text-muted, #888);
  font-family: var(--font-mono, monospace);
  font-size: 0.85rem; text-align: center;
}

.kravn-side-arrow {
  display: none;
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 46px; height: 46px;
  border-radius: 50%;
  border: 1px solid rgba(var(--kravn-primary-rgb), 0.35);
  background: rgba(10,10,12,0.7);
  color: var(--kravn-primary-light);
  align-items: center;
  justify-content: center;
  font-size: 1.3rem;
  cursor: pointer;
  z-index: 6;
  transition: all 0.18s ease;
  backdrop-filter: blur(6px);
}
.kravn-side-arrow:hover { border-color: var(--kravn-primary); background: rgba(var(--kravn-primary-rgb), 0.16); color: #fff; }
.kravn-side-arrow.disabled { opacity: 0.3; cursor: default; pointer-events: none; }
.kravn-side-arrow.prev { left: max(2vw, 24px); }
.kravn-side-arrow.next { right: max(2vw, 24px); }
@media (min-width: 900px) { .kravn-side-arrow { display: flex; } }

.kravn-card {
  position: absolute;
  width: min(88vw, 340px);
  aspect-ratio: 9 / 16;
  border-radius: 22px;
  background: #050507;
  border: 1px solid rgba(var(--kravn-primary-rgb), 0.15);
  box-shadow: 0 25px 60px rgba(0,0,0,0.6);
  cursor: grab;
  will-change: transform;
  user-select: none;
  touch-action: none;
  padding: 8px;
  box-sizing: border-box;
  transition: box-shadow 0.2s ease;
}
.kravn-card.dragging { cursor: grabbing; }

.post-card {
  border: 1px solid rgba(var(--kravn-primary-rgb), 0.32);
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}
.post-card:hover {
  border-color: rgba(var(--kravn-primary-rgb), 0.55);
  box-shadow: 0 0 0 1px rgba(var(--kravn-primary-rgb), 0.12);
}

.kravn-card-frame {
  position: relative;
  width: 100%; height: 100%;
  border-radius: 16px;
  overflow: hidden;
  border: 3px solid rgba(var(--kravn-primary-rgb), 0.55);
  box-shadow: 0 0 0 1px rgba(var(--kravn-primary-rgb), 0.12) inset;
}

.kravn-card-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 22%; pointer-events: none; }
.kravn-card-fallback {
  position: absolute; inset: 0;
  background: radial-gradient(circle at 70% 20%, rgba(var(--kravn-primary-rgb), 0.25), transparent 50%), linear-gradient(150deg, #1a1425, #060606 60%);
  display: flex; align-items: center; justify-content: center; font-size: 2.5rem;
}
.kravn-card-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to bottom, rgba(3,2,8,0.6) 0%, rgba(3,2,8,0.04) 24%, rgba(3,2,8,0.08) 42%, rgba(3,2,8,0.5) 68%, rgba(0,0,0,0.95) 100%);
  pointer-events: none;
}
.kravn-card-content {
  position: absolute; inset: 0;
  padding: 16px; box-sizing: border-box;
  display: flex; flex-direction: column; justify-content: space-between;
}
.kravn-card-header { display: flex; align-items: flex-start; justify-content: space-between; pointer-events: auto; }
.kravn-card-logo {
  font-size: 15px; font-weight: 800; letter-spacing: -0.5px; color: #fff;
  text-shadow: 0 3px 10px rgba(0,0,0,0.7);
}
.kravn-card-logo .kravn-wordmark-n { filter: drop-shadow(0 0 6px rgba(var(--kravn-primary-rgb), 0.55)); }
.kravn-card-badge {
  font-family: var(--font-mono, monospace);
  font-size: 0.58rem; letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--kravn-primary-light);
  background: rgba(5,5,9,0.5);
  border: 1px solid rgba(var(--kravn-primary-rgb), 0.5);
  padding: 3px 8px; border-radius: 20px;
}
.kravn-card-movie {
  font-family: var(--font-mono, monospace);
  font-size: 0.62rem; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase;
  color: var(--kravn-primary-light); margin-bottom: 5px;
}
.kravn-card-title {
  color: #fff;
  font-size: clamp(1rem, 4.2vw, 1.3rem);
  font-weight: 800; line-height: 1.2; letter-spacing: -0.3px;
  margin: 0 0 8px;
  text-shadow: 0 2px 10px rgba(0,0,0,0.6);
  display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
}
.kravn-card-footer { display: flex; align-items: center; justify-content: space-between; pointer-events: auto; }
.kravn-card-author { font-size: 0.72rem; color: rgba(255,255,255,0.7); }

.kravn-card-tools { display: flex; gap: 6px; }
.kravn-card-tool-btn {
  width: 30px; height: 30px; border-radius: 50%;
  background: rgba(var(--kravn-primary-rgb), 0.1);
  border: 1px solid rgba(var(--kravn-primary-rgb), 0.35);
  backdrop-filter: blur(6px);
  color: var(--kravn-primary-light);
  display: flex; align-items: center; justify-content: center;
  font-size: 0.78rem; cursor: pointer;
  transition: all 0.18s ease;
}
.kravn-card-tool-btn:hover {
  border-color: var(--kravn-primary);
  background: rgba(var(--kravn-primary-rgb), 0.22);
  color: #fff;
  transform: translateY(-1px);
}

.kravn-heart-burst {
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%, -50%) scale(0.4);
  opacity: 0; pointer-events: none; z-index: 3;
  filter: drop-shadow(0 0 18px rgba(var(--kravn-primary-rgb), 0.45));
}
.kravn-heart-burst svg { width: 76px; height: 76px; display: block; }
.kravn-heart-burst.pop { animation: kravn-heart-pop 0.7s cubic-bezier(0.22,1,0.36,1) forwards; }
@keyframes kravn-heart-pop {
  0%   { transform: translate(-50%, -50%) scale(0.3); opacity: 0; }
  35%  { transform: translate(-50%, -50%) scale(1.08); opacity: 1; }
  55%  { transform: translate(-50%, -50%) scale(0.95); opacity: 1; }
  100% { transform: translate(-50%, -50%) scale(1); opacity: 0; }
}

.kravn-liked-pill {
  position: absolute; top: 14px; right: 14px;
  font-size: 0.62rem; font-family: var(--font-mono, monospace);
  color: var(--kravn-primary-light);
  background: rgba(5,5,9,0.6);
  border: 1px solid rgba(var(--kravn-primary-rgb), 0.5);
  padding: 3px 8px; border-radius: 20px;
  opacity: 0; transition: opacity 0.25s ease; pointer-events: none; z-index: 2;
}
.kravn-liked-pill.show { opacity: 1; }

.kravn-hint-toast {
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  z-index: 10;
  background: rgba(10,10,12,0.85);
  border: 1px solid rgba(var(--kravn-primary-rgb), 0.4);
  color: #f0f0f0;
  font-family: var(--font-mono, monospace);
  font-size: 0.72rem; letter-spacing: 0.03em; text-align: center;
  padding: 0.85rem 1.3rem; border-radius: 12px;
  opacity: 0; pointer-events: none;
  transition: opacity 0.4s ease;
  max-width: 80%;
}
.kravn-hint-toast.show { opacity: 1; }

.kravn-toast {
  position: fixed; bottom: 28px; left: 50%;
  transform: translateX(-50%) translateY(20px);
  background: #151515;
  border: 1px solid rgba(var(--kravn-primary-rgb), 0.35);
  color: #eee;
  font-family: var(--font-mono, monospace);
  font-size: 0.75rem; padding: 0.6rem 1rem; border-radius: 6px;
  opacity: 0; z-index: 1001; transition: all 0.25s ease; pointer-events: none;
  max-width: 88vw; text-align: center;
}
.kravn-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

.kravn-profile-hint {
  position: fixed;
  top: calc(env(safe-area-inset-top, 0px) + 12px);
  left: 50%;
  transform: translateX(-50%) translateY(-10px);
  z-index: 900;
  background: rgba(10,10,12,0.88);
  backdrop-filter: blur(6px);
  border: 1px solid rgba(var(--kravn-primary-rgb), 0.4);
  color: var(--kravn-primary-light);
  font-family: var(--font-mono, monospace);
  font-size: 0.7rem;
  letter-spacing: 0.02em;
  padding: 0.55rem 1rem;
  border-radius: 20px;
  box-shadow: 0 10px 26px rgba(0,0,0,0.35);
  opacity: 0;
  pointer-events: none;
  max-width: 90vw;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  transition: opacity 0.4s ease, transform 0.4s ease;
}
.kravn-profile-hint.show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}
@media (max-width: 480px) {
  .kravn-profile-hint { font-size: 0.64rem; padding: 0.5rem 0.85rem; white-space: normal; }
}

.kravn-page {
  transform-origin: center top;
  will-change: transform, opacity, border-radius;
  transition: transform 0.36s cubic-bezier(0.22, 1, 0.36, 1),
              opacity 0.3s ease,
              border-radius 0.3s ease;
  border-radius: 0px;
  min-height: 100vh;
  background: var(--bg, #0a0a0a);
}
.kravn-page.kravn-page-enter {
  transform: translateY(28px) scale(0.97);
  opacity: 0;
}
.kravn-page.kravn-page-enter-active {
  transform: translateY(0) scale(1);
  opacity: 1;
}

/* ============================================================
   KRAVN 2.0 — TOP PICKS
   ============================================================ */

.kravn2-section {
  margin: 0 0 var(--space-5, 1.4rem);
}
.kravn2-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 0.75rem;
}
.kravn2-section-title {
  font-size: 0.98rem;
  font-weight: 800;
  letter-spacing: -0.1px;
  display: flex;
  align-items: center;
  gap: 0.4rem;
}
.kravn2-section-sub {
  font-family: var(--font-mono, monospace);
  font-size: 0.62rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--text-muted, #888);
}

.kravn2-scroll-row {
  display: flex;
  gap: 0.85rem;
  overflow-x: auto;
  padding: 0.2rem 0.1rem 0.6rem;
  scroll-snap-type: x proximity;
  -webkit-overflow-scrolling: touch;
}
.kravn2-scroll-row::-webkit-scrollbar { height: 5px; }
.kravn2-scroll-row::-webkit-scrollbar-thumb { background: rgba(var(--kravn-primary-rgb), 0.35); border-radius: 4px; }

.kravn2-poster-card {
  position: relative;
  flex: 0 0 auto;
  width: 138px;
  aspect-ratio: 2 / 3;
  border-radius: 12px;
  overflow: hidden;
  scroll-snap-align: start;
  cursor: pointer;
  border: 1px solid rgba(var(--kravn-primary-rgb), 0.25);
  background: #0a0a0c;
  transition: transform 0.18s ease, border-color 0.18s ease;
}
.kravn2-poster-card:hover { transform: translateY(-3px); border-color: rgba(var(--kravn-primary-rgb), 0.55); }
.kravn2-poster-card img { width: 100%; height: 100%; object-fit: cover; display: block; }
.kravn2-poster-fallback {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  font-size: 1.8rem;
  background: linear-gradient(150deg, #1a1425, #060606 60%);
}
.kravn2-poster-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to bottom, transparent 40%, rgba(0,0,0,0.92) 100%);
  display: flex; flex-direction: column; justify-content: flex-end;
  padding: 8px;
}
.kravn2-poster-movie {
  font-size: 0.68rem; font-weight: 800; color: #fff; line-height: 1.2;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.kravn2-poster-meta {
  font-family: var(--font-mono, monospace);
  font-size: 0.58rem; color: var(--kravn-primary-light);
  margin-top: 3px;
}
.kravn2-rank-badge {
  position: absolute; top: 6px; left: 6px;
  width: 22px; height: 22px; border-radius: 50%;
  background: rgba(5,5,9,0.75);
  border: 1px solid rgba(var(--kravn-primary-rgb), 0.5);
  color: var(--kravn-primary-light);
  font-family: var(--font-mono, monospace);
  font-size: 0.62rem; font-weight: 800;
  display: flex; align-items: center; justify-content: center;
}

.kravn2-viewall-card {
  flex: 0 0 auto;
  width: 138px;
  aspect-ratio: 2 / 3;
  border-radius: 12px;
  border: 1px dashed rgba(var(--kravn-primary-rgb), 0.45);
  background: rgba(var(--kravn-primary-rgb), 0.05);
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  color: var(--kravn-primary-light);
  transition: all 0.18s ease;
  scroll-snap-align: start;
}
.kravn2-viewall-card:hover {
  background: rgba(var(--kravn-primary-rgb), 0.12);
  border-color: rgba(var(--kravn-primary-rgb), 0.75);
  transform: translateY(-3px);
}
.kravn2-viewall-icon {
  width: 40px; height: 40px; border-radius: 50%;
  border: 1px solid rgba(var(--kravn-primary-rgb), 0.5);
  display: flex; align-items: center; justify-content: center;
  font-size: 1.1rem;
}
.kravn2-viewall-label {
  font-family: var(--font-mono, monospace);
  font-size: 0.62rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;
  text-align: center; padding: 0 0.4rem;
}

@media (max-width: 480px) {
  .kravn2-poster-card, .kravn2-viewall-card { width: 116px; }
}

/* ============================================================
   KRAVN TOP PICKS — full ranked list overlay
   ============================================================ */
.kravn2-overlay {
  position: fixed; inset: 0; z-index: 998;
  background: #050505;
  display: none;
  flex-direction: column;
