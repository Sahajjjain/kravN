      gap: 0.35rem;
      font-family: var(--font-mono, monospace);
      font-size: 0.66rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--kravn-primary-light);
      transition: gap 0.2s ease, color 0.2s ease;
    }
    .post-card:hover .post-card-cta {
      gap: 0.55rem;
      color: #fff;
    }
  </style>
</head>
