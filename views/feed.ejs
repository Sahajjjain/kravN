  <script>
  function setView(view) {
    const container = document.getElementById('feed-container');
    const btnList   = document.getElementById('btn-list');
    const btnGrid   = document.getElementById('btn-grid');
    if (view === 'grid') {
      container.classList.add('poster-grid-view');
      btnGrid.classList.add('active');
      btnList.classList.remove('active');
    } else {
      container.classList.remove('poster-grid-view');
      btnList.classList.add('active');
      btnGrid.classList.remove('active');
    }
    localStorage.setItem('kravn-view', view);
  }
  document.addEventListener('DOMContentLoaded', () => {
    const savedView = localStorage.getItem('kravn-view');
    if (savedView === 'grid') setView('grid');
  });

  (function initSortDropdown() {
    const container = document.getElementById('feed-container');
    const dropdown  = document.getElementById('kravn-sort-dropdown');
    const trigger   = document.getElementById('kravn-sort-trigger');
    const menu      = document.getElementById('kravn-sort-menu');
    const label     = document.getElementById('kravn-sort-label');
    const options   = menu ? menu.querySelectorAll('.kravn-sort-option') : [];
    if (!container || !trigger || !menu) return;

    function openMenu() {
      menu.classList.add('open');
      trigger.classList.add('open');
      trigger.setAttribute('aria-expanded', 'true');
    }
    function closeMenu() {
      menu.classList.remove('open');
      trigger.classList.remove('open');
      trigger.setAttribute('aria-expanded', 'false');
    }
    function toggleMenu() {
      if (menu.classList.contains('open')) closeMenu(); else openMenu();
    }

    function applySort(mode) {
      const cards = Array.from(container.children);
      if (mode === 'latest') {
        cards.sort((a, b) => new Date(b.dataset.created) - new Date(a.dataset.created));
      } else if (mode === 'oldest') {
        cards.sort((a, b) => new Date(a.dataset.created) - new Date(b.dataset.created));
      } else {
        for (let i = cards.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [cards[i], cards[j]] = [cards[j], cards[i]];
        }
      }
      cards.forEach(c => container.appendChild(c));
    }

    trigger.addEventListener('click', (e) => { e.stopPropagation(); toggleMenu(); });

    options.forEach(opt => {
      opt.addEventListener('click', () => {
        options.forEach(o => { o.classList.remove('active'); o.setAttribute('aria-selected', 'false'); });
        opt.classList.add('active');
        opt.setAttribute('aria-selected', 'true');
        label.textContent = opt.dataset.sort.charAt(0).toUpperCase() + opt.dataset.sort.slice(1);
        applySort(opt.dataset.sort);
        closeMenu();
      });
    });

    document.addEventListener('click', (e) => {
      if (!dropdown.contains(e.target)) closeMenu();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu();
    });
  })();
  </script>

  <script>
function initKravnCards(config) {
  config = config || {};
  const posts = config.posts || [];
  if (!posts.length) {
    console.warn('[KravnCards] initKravnCards() called with zero posts — nothing to show, button will do nothing.');
    return;
  }

  const openBtn    = document.getElementById(config.openBtnId || 'kravn-open-btn');
  const overlay    = document.getElementById(config.overlayId || 'kravn-overlay');
  const stage      = document.getElementById(config.stageId || 'kravn-stage');
  const pipsEl     = document.getElementById(config.pipsId || 'kravn-pips');
  const closeBtn   = document.getElementById(config.closeBtnId || 'kravn-close-btn');
  const modeToggle = document.getElementById(config.modeToggleId || 'kravn-mode-toggle');
  const toastEl    = document.getElementById(config.toastId || 'kravn-toast');
  const canvas     = document.getElementById(config.canvasId || 'kravn-render-canvas');
  const hintEl     = document.getElementById(config.hintId || 'kravn-hint-toast');
  const prevArrow  = document.getElementById(config.prevArrowId || 'kravn-arrow-prev');
  const nextArrow  = document.getElementById(config.nextArrowId || 'kravn-arrow-next');
  const hintKey    = config.hintKey || 'kravnHintSeen';
  const circular   = config.circular !== undefined ? config.circular : true;

  if (!openBtn || !overlay || !stage) {
    console.warn('[KravnCards] Could not find required elements — check the ids on this page.', {
      openBtnFound: !!openBtn, overlayFound: !!overlay, stageFound: !!stage
    });
    return;
  }

  let deck = posts.slice().sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
  let current = 0;
  let history = [];
  let mode = 'latest';
  const likedSet = new Set();
  let isAnimating = false;

  const VISIBLE_STACK = Math.min(3, deck.length);
  const gradId = 'kravnHeartGrad' + Math.random().toString(36).slice(2);

  const easeOutCubic = t => 1 - Math.pow(1 - t, 3);
  const easeOutBack = t => {
    const c1 = 1.4, c3 = c1 + 1;
    return 1 + c3 * Math.pow(t - 1, 3) + c1 * Math.pow(t - 1, 2);
  };

  function animateProgress(from, to, { duration = 300, easing = easeOutCubic, onUpdate, onDone }) {
    const start = performance.now();
    const span = to - from;
    function frame(now) {
      const t = Math.min((now - start) / duration, 1);
      onUpdate(from + span * easing(t));
      if (t < 1) requestAnimationFrame(frame);
      else { onUpdate(to); if (onDone) onDone(); }
    }
    requestAnimationFrame(frame);
  }

  function toast(msg) {
    if (!toastEl) return;
    toastEl.textContent = msg;
    toastEl.classList.add('show');
    clearTimeout(toastEl._t);
    toastEl._t = setTimeout(() => toastEl.classList.remove('show'), 2000);
  }

  function escapeHtml(str) {
    return String(str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function themeColor(name, fallback) {
    const v = getComputedStyle(document.documentElement).getPropertyValue(name);
    return v && v.trim() ? v.trim() : fallback;
  }

  function renderPips() {
    if (!pipsEl) return;
    pipsEl.innerHTML = '';
    deck.forEach((_, i) => {
      const pip = document.createElement('div');
      pip.className = 'kravn-pip';
      if (i === current) pip.classList.add('active');
      else if (i < current) pip.classList.add('done');
      pipsEl.appendChild(pip);
    });
  }

  function updateArrows() {
    if (!prevArrow || !nextArrow) return;
    if (circular) {
      prevArrow.classList.remove('disabled');
      nextArrow.classList.remove('disabled');
    } else {
      prevArrow.classList.toggle('disabled', history.length === 0);
      nextArrow.classList.remove('disabled');
    }
  }

  async function likePost(post, pillEl) {
    if (likedSet.has(post.id)) return;
    likedSet.add(post.id);
    if (pillEl) pillEl.classList.add('show');
    try { await fetch(`/posts/${post.id}/like`, { method: 'POST' }); } catch (err) {}
  }

  function loadImage(src) {
    return new Promise((resolve, reject) => {
      const img = new Image();
      img.crossOrigin = 'anonymous';
      img.onload = () => resolve(img);
      img.onerror = reject;
      img.src = src;
    });
  }

  function roundedRectPath(ctx, x, y, w, h, r) {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.arcTo(x + w, y, x + w, y + h, r);
    ctx.arcTo(x + w, y + h, x, y + h, r);
    ctx.arcTo(x, y + h, x, y, r);
    ctx.arcTo(x, y, x + w, y, r);
    ctx.closePath();
  }

  function wrapText(ctx, text, maxWidth, maxLines) {
    const words = text.split(' ');
    const lines = [];
    let line = '';
    for (const w of words) {
      const test = line ? line + ' ' + w : w;
      if (ctx.measureText(test).width > maxWidth && line) {
        lines.push(line);
        line = w;
        if (lines.length === maxLines - 1) break;
      } else {
        line = test;
      }
    }
    if (line) lines.push(line);
    if (lines.length > maxLines) lines.length = maxLines;
    return lines;
  }

  function drawFallbackBg(ctx, W, H, accentRgb) {
    const grad = ctx.createRadialGradient(W * 0.7, H * 0.15, 0, W * 0.7, H * 0.15, W * 0.8);
    grad.addColorStop(0, `rgba(${accentRgb},0.2)`);
    grad.addColorStop(1, 'rgba(5,5,7,1)');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, W, H);
  }

  async function renderCardToBlob(post) {
    if (!canvas) return null;
    const accent = themeColor('--kravn-primary-light', '#c4b5fd');
    const accentRgb = themeColor('--kravn-primary-rgb', '139,92,246');
    const W = 900, H = 1500;
    canvas.width = W; canvas.height = H;
    const ctx = canvas.getContext('2d');

    ctx.fillStyle = '#050507';
    ctx.fillRect(0, 0, W, H);

    if (post.posterUrl) {
      try {
        const img = await loadImage(post.posterUrl);
        const ir = img.width / img.height, cr = W / H;
        let dw, dh, dx, dy;
        if (ir > cr) { dh = H; dw = H * ir; dx = (W - dw) / 2; dy = 0; }
        else { dw = W; dh = W / ir; dx = 0; dy = (H - dh) / 2; }
        ctx.drawImage(img, dx, dy, dw, dh);
        ctx.getImageData(0, 0, 1, 1);
      } catch (err) {
        drawFallbackBg(ctx, W, H, accentRgb);
      }
    } else {
      drawFallbackBg(ctx, W, H, accentRgb);
    }

    const grad = ctx.createLinearGradient(0, 0, 0, H);
    grad.addColorStop(0, 'rgba(0,0,0,0.55)');
    grad.addColorStop(0.26, 'rgba(0,0,0,0.02)');
    grad.addColorStop(0.42, 'rgba(0,0,0,0.05)');
    grad.addColorStop(0.68, 'rgba(0,0,0,0.6)');
    grad.addColorStop(1, 'rgba(0,0,0,0.97)');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, W, H);

    ctx.save();
    ctx.strokeStyle = `rgba(${accentRgb},0.55)`;
    ctx.lineWidth = 8;
    roundedRectPath(ctx, 8, 8, W - 16, H - 16, 28);
    ctx.stroke();
    ctx.restore();

    ctx.font = '700 34px "JetBrains Mono", monospace';
    ctx.fillStyle = '#ffffff';
    ctx.fillText('Krav', 40, 70);
    const wordmarkWidth = ctx.measureText('Krav').width;
    ctx.fillStyle = accent;
    ctx.fillText('N', 40 + wordmarkWidth, 70);

    if (post.imdbRating) {
      const label = 'IMDb ' + post.imdbRating;
      ctx.font = '700 20px "IBM Plex Mono", monospace';
      const tw = ctx.measureText(label).width;
      const bx = W - 40 - (tw + 40), by = 38, bw = tw + 40, bh = 44;
      roundedRectPath(ctx, bx, by, bw, bh, 22);
      ctx.fillStyle = `rgba(${accentRgb},0.12)`;
      ctx.fill();
      ctx.strokeStyle = `rgba(${accentRgb},0.5)`;
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.fillStyle = accent;
      ctx.fillText(label, bx + 20, by + 29);
    }

    ctx.font = '700 24px "IBM Plex Mono", monospace';
    ctx.fillStyle = accent;
    ctx.fillText((post.movieName || '').toUpperCase(), 40, H - 230);

    ctx.font = '800 54px Inter, sans-serif';
    ctx.fillStyle = '#ffffff';
    const lines = wrapText(ctx, post.title || '', W - 80, 3);
    let ty = H - 175;
    lines.forEach((ln, i) => { ctx.fillText(ln, 40, ty + i * 60); });

    ctx.font = '400 26px Inter, sans-serif';
    ctx.fillStyle = 'rgba(255,255,255,0.75)';
    ctx.fillText('@' + (post.username || ''), 40, H - 50);

    ctx.textAlign = 'right';
    ctx.font = '600 22px "JetBrains Mono", monospace';
    ctx.fillStyle = `rgba(${accentRgb},0.9)`;
    ctx.fillText('kravn', W - 40, H - 50);
    ctx.textAlign = 'left';

    return new Promise((resolve) => canvas.toBlob(resolve, 'image/png', 0.95));
  }

  async function downloadCard(post) {
    try {
      await (document.fonts && document.fonts.ready);
      const blob = await renderCardToBlob(post);
      if (!blob) throw new Error('render failed');
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `kravn-${post.id}.png`;
      a.click();
      toast('Postcard downloaded');
    } catch (err) {
      toast('Could not create the postcard');
    }
  }

  async function shareCard(post) {
    const url = `${window.location.origin}/posts/${post.id}`;
    const shareText = `${post.title} — on Kravn`;
    try {
      await (document.fonts && document.fonts.ready);
      const blob = await renderCardToBlob(post);
      if (!blob) throw new Error('render failed');
      const file = new File([blob], `kravn-${post.id}.png`, { type: 'image/png' });
      if (navigator.canShare && navigator.canShare({ files: [file] })) {
        await navigator.share({ files: [file], title: post.title, text: shareText, url });
        return;
      }
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `kravn-${post.id}.png`;
      a.click();
      if (navigator.clipboard) await navigator.clipboard.writeText(url);
      toast('Card image saved · link copied');
    } catch (err) {
      if (navigator.share) {
        navigator.share({ title: post.title, text: shareText, url }).catch(() => {});
      } else if (navigator.clipboard) {
        navigator.clipboard.writeText(url).then(() => toast('Link copied')).catch(() => toast(url));
      } else {
        toast(url);
      }
    }
  }

  function cardMarkup(post) {
    const posterBlock = post.posterUrl
      ? `<img class="kravn-card-bg" src="${post.posterUrl}" alt="" onerror="this.style.display='none'">`
      : `<div class="kravn-card-fallback">🎬</div>`;
    return `
      <div class="kravn-card-frame">
        ${posterBlock}
        <div class="kravn-card-overlay"></div>
        <div class="kravn-heart-burst">
          <svg viewBox="0 0 24 24">
            <defs>
              <linearGradient id="${gradId}" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="var(--kravn-heart-red)"/>
                <stop offset="100%" stop-color="var(--kravn-primary)"/>
              </linearGradient>
            </defs>
            <path d="M12 21s-6.5-4.35-9.5-8.5C.5 9 2 5 5.5 5c2 0 3.5 1.2 4.5 2.7C11 6.2 12.5 5 14.5 5 18 5 19.5 9 17.5 12.5 14.5 16.65 12 21 12 21z" fill="url(#${gradId})" stroke="rgba(255,255,255,0.55)" stroke-width="0.5"/>
          </svg>
        </div>
        <div class="kravn-liked-pill">♥ liked</div>
        <div class="kravn-card-content">
          <div class="kravn-card-header">
            <span class="kravn-card-logo">Krav<span class="kravn-wordmark-n">N</span></span>
            <span class="kravn-card-badge">${post.imdbRating ? 'IMDb ' + post.imdbRating : 'Kravn'}</span>
          </div>
          <div>
            <div class="kravn-card-movie">${escapeHtml(post.movieName)}</div>
            <div class="kravn-card-title">${escapeHtml(post.title)}</div>
            <div class="kravn-card-footer">
              <span class="kravn-card-author">@${escapeHtml(post.username)}</span>
              <div class="kravn-card-tools">
                <div class="kravn-card-tool-btn kravn-card-download" title="Download postcard">⬇</div>
                <div class="kravn-card-tool-btn kravn-card-share" title="Share">↗</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    `;
  }

  function makeCardEl(post) {
    const card = document.createElement('div');
    card.className = 'kravn-card';
    card.innerHTML = cardMarkup(post);
    card.dataset.postId = post.id;
    if (likedSet.has(post.id)) card.querySelector('.kravn-liked-pill').classList.add('show');
    return card;
  }

  function restSlot(i) {
    const scale = 1 - i * 0.05;
    const y = i * 14;
    return { x: 0, y, scale, rotate: 0, opacity: i === VISIBLE_STACK - 1 && VISIBLE_STACK > 1 ? 0.55 : 1 };
  }

  function hiddenPrevSlot(stageWidth) {
    return { x: -stageWidth * 0.55, y: 14, scale: 0.92, rotate: 0, opacity: 0.5 };
  }

  function lerp(a, b, t) { return a + (b - a) * t; }
  function lerpTransform(from, to, t) {
    return {
      x: lerp(from.x, to.x, t),
      y: lerp(from.y, to.y, t),
      scale: lerp(from.scale, to.scale, t),
      rotate: lerp(from.rotate, to.rotate, t),
      opacity: lerp(from.opacity, to.opacity, t)
    };
  }

  function applyTransform(el, t) {
    el.style.transform = `translate(${t.x}px, ${t.y}px) rotate(${t.rotate}deg) scale(${t.scale})`;
    el.style.opacity = String(t.opacity);
  }

  function activeCardTransform(progress, dragX, dragY) {
    const absP = Math.min(Math.abs(progress), 1);
    return {
      x: dragX,
      y: dragY * 0.15,
      scale: 1 - absP * 0.03,
      rotate: progress * 10,
      opacity: 1 - absP * 0.45
    };
  }

  let cardEls = [];
  let prevEl = null;

  function removePrevEl() {
    if (prevEl && prevEl.parentNode) prevEl.parentNode.removeChild(prevEl);
    prevEl = null;
  }

  function ensurePrevEl(stageWidth) {
    if (prevEl) return prevEl;
    if (!canGoPrev()) return null;
    const prevIdx = circular ? (current - 1 + deck.length) % deck.length : history[history.length - 1];
    const prevPost = deck[prevIdx];
    if (!prevPost) return null;
    prevEl = makeCardEl(prevPost);
    prevEl.style.zIndex = String(VISIBLE_STACK + 1);
    applyTransform(prevEl, { ...hiddenPrevSlot(stageWidth), opacity: 0 });
    stage.insertBefore(prevEl, stage.firstChild);
    return prevEl;
  }

  function layoutStack(progress, dragX, dragY, stageWidth) {
    if (!cardEls[0]) return;
    applyTransform(cardEls[0], activeCardTransform(progress, dragX, dragY));
    const advance = Math.min(Math.abs(progress), 1);

    if (progress <= 0) {
      if (cardEls[1]) applyTransform(cardEls[1], lerpTransform(restSlot(1), restSlot(0), advance));
      if (prevEl) applyTransform(prevEl, { ...hiddenPrevSlot(stageWidth), opacity: 0 });
    } else {
      const el = ensurePrevEl(stageWidth);
      if (el) applyTransform(el, lerpTransform(hiddenPrevSlot(stageWidth), { x: 0, y: 0, scale: 1, rotate: 0, opacity: 1 }, advance));
      if (cardEls[1]) {
        const base = restSlot(1);
        applyTransform(cardEls[1], { ...base, opacity: base.opacity * (1 - advance) });
      }
    }
  }

  function dismissHint() {
    if (hintEl) hintEl.classList.remove('show');
  }
  function showHintOnce() {
    if (!hintEl) return;
    if (sessionStorage.getItem(hintKey)) return;
    hintEl.textContent = circular
      ? 'Swipe to browse · Swipe down to close · Double-tap to like'
      : 'Swipe to browse · Double-tap to like';
    hintEl.classList.add('show');
    sessionStorage.setItem(hintKey, '1');
    setTimeout(dismissHint, 2800);
  }

  function render() {
    stage.querySelectorAll('.kravn-card').forEach(el => el.remove());
    cardEls = [];
    prevEl = null;
    for (let i = VISIBLE_STACK - 1; i >= 0; i--) {
      const idx = circular ? (current + i) % deck.length : current + i;
      if (idx >= deck.length) continue;
      const post = deck[idx];
      const card = makeCardEl(post);
      applyTransform(card, restSlot(i));
      card.style.zIndex = i === 0 ? String(VISIBLE_STACK + 2) : String(VISIBLE_STACK - i);
      if (i === 0) attachInteractions(card, post);
      stage.appendChild(card);
      cardEls[i] = card;
    }
    renderPips();
    updateArrows();
  }

  function canGoNext() {
    return circular || current + 1 < deck.length;
  }
  function canGoPrev() {
    return circular || history.length > 0;
  }

  function commitAdvance(direction) {
    if (direction > 0) {
      if (!canGoNext()) return;
      if (!circular) history.push(current);
      current = circular ? (current + 1) % deck.length : current + 1;
    } else {
      if (!canGoPrev()) return;
      current = circular ? (current - 1 + deck.length) % deck.length : history.pop();
    }
    render();
  }

  function attachInteractions(card, post) {
    const shareEl    = card.querySelector('.kravn-card-share');
    const downloadEl = card.querySelector('.kravn-card-download');
    const burstEl    = card.querySelector('.kravn-heart-burst');
    const pillEl     = card.querySelector('.kravn-liked-pill');

    shareEl.addEventListener('click', (e) => { e.stopPropagation(); dismissHint(); shareCard(post); });
    downloadEl.addEventListener('click', (e) => { e.stopPropagation(); dismissHint(); downloadCard(post); });

    let dragging = false, moved = false;
    let startX = 0, startY = 0, dragX = 0, dragY = 0;
    let lastX = 0, lastY = 0, lastT = 0, vx = 0, vy = 0;
    let clickTimer = null, clickCount = 0;

    const SIDE_COMMIT_DIST = 100;
    const SIDE_COMMIT_VEL  = 0.5;
    const DOWN_COMMIT_DIST = 120;
    const DOWN_COMMIT_VEL  = 0.6;
    const EDGE_DAMPEN      = 0.32;

    function stageWidth() { return stage.clientWidth || 340; }

    card.addEventListener('pointerdown', (e) => {
      if (isAnimating || e.target === shareEl || e.target === downloadEl) return;
      dragging = true; moved = false;
      startX = e.clientX; startY = e.clientY;
      lastX = e.clientX; lastY = e.clientY; lastT = performance.now();
      dragX = 0; dragY = 0; vx = 0; vy = 0;
      card.classList.add('dragging');
      card.setPointerCapture(e.pointerId);
    });

    card.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      let rawDX = e.clientX - startX;
      const rawDY = e.clientY - startY;
      const now = performance.now();
      const dt = Math.max(now - lastT, 1);
      vx = (e.clientX - lastX) / dt;
      vy = (e.clientY - lastY) / dt;
      lastX = e.clientX; lastY = e.clientY; lastT = now;

      if (Math.abs(rawDX) > 6 || Math.abs(rawDY) > 6) { moved = true; dismissHint(); }

      const downwardBias = rawDY > 0 && Math.abs(rawDY) > Math.abs(rawDX);
      if (downwardBias) {
        dragY = rawDY; dragX = rawDX;
        applyTransform(card, {
          x: dragX * 0.3,
          y: dragY * 0.7,
          scale: 1 - Math.min(dragY / 900, 0.12),
          rotate: dragX * 0.02,
          opacity: Math.max(1 - dragY / 420, 0.3)
        });
        return;
      }

      if (rawDX < 0 && !canGoNext()) rawDX *= EDGE_DAMPEN;
      if (rawDX > 0 && !canGoPrev()) rawDX *= EDGE_DAMPEN;

      dragX = rawDX; dragY = rawDY;
      const progress = Math.max(-1, Math.min(1, dragX / (stageWidth() * 0.55)));
      layoutStack(progress, dragX, dragY, stageWidth());
    });

    function finishToRest() {
      isAnimating = true;
      const w = stageWidth();
      const startProgress = Math.max(-1, Math.min(1, dragX / (w * 0.55)));
      const startDX = dragX, startDY = dragY;
      const downwardBias = startDY > 0 && Math.abs(startDY) > Math.abs(startDX);
      animateProgress(1, 0, {
        duration: 260,
        easing: easeOutBack,
        onUpdate: (t) => {
          if (downwardBias) {
            applyTransform(card, {
              x: startDX * t,
              y: startDY * t,
              scale: lerp(1, 1 - Math.min(startDY / 900, 0.12), t),
              rotate: startDX * 0.02 * t,
              opacity: lerp(1, Math.max(1 - startDY / 420, 0.3), t)
            });
          } else {
            layoutStack(startProgress * t, startDX * t, startDY * t, w);
          }
        },
        onDone: () => { isAnimating = false; removePrevEl(); }
      });
    }

    function finishCommit(direction) {
      isAnimating = true;
      const w = stageWidth();
      const startProgress = Math.max(-1, Math.min(1, dragX / (w * 0.55)));
      const targetX = direction > 0 ? -w * 1.3 : w * 1.3;
      const speed = Math.max(Math.abs(vx), 0.35);
      const duration = Math.max(140, Math.min(260, 220 / speed));
      animateProgress(0, 1, {
        duration,
        easing: easeOutCubic,
        onUpdate: (t) => {
          const p = lerp(startProgress, direction > 0 ? -1 : 1, t);
          const x = lerp(dragX, targetX, t);
          layoutStack(p, x, dragY * (1 - t * 0.6), w);
        },
        onDone: () => {
          isAnimating = false;
          commitAdvance(direction);
        }
      });
    }

    function finishDownClose() {
      isAnimating = true;
      const startDX = dragX, startDY = dragY;
      animateProgress(0, 1, {
        duration: 200,
        easing: easeOutCubic,
        onUpdate: (t) => {
          applyTransform(card, {
            x: startDX * (1 - t * 0.2),
            y: lerp(startDY, 640, t),
            scale: lerp(1 - Math.min(startDY / 900, 0.12), 0.82, t),
            rotate: startDX * 0.02,
            opacity: lerp(Math.max(1 - startDY / 420, 0.3), 0, t)
          });
        },
        onDone: () => { isAnimating = false; closeOverlay(); }
      });
    }

    card.addEventListener('pointerup', () => {
      if (!dragging) return;
      dragging = false;
      card.classList.remove('dragging');

      const downwardBias = dragY > 0 && Math.abs(dragY) > Math.abs(dragX);

      if (downwardBias && circular) {
        if (dragY > DOWN_COMMIT_DIST || vy > DOWN_COMMIT_VEL) {
          dismissHint();
          finishDownClose();
        } else {
          finishToRest();
        }
        return;
      }

      const wantsCommit = Math.abs(dragX) > SIDE_COMMIT_DIST || Math.abs(vx) > SIDE_COMMIT_VEL;
      const direction = dragX < 0 ? 1 : -1;
      const allowed = direction > 0 ? canGoNext() : canGoPrev();

      if (!moved) {
        clickCount++;
        if (clickCount === 1) {
          clickTimer = setTimeout(() => { clickCount = 0; window.location.href = `/posts/${post.id}`; }, 260);
        } else if (clickCount === 2) {
          clearTimeout(clickTimer);
          clickCount = 0;
          dismissHint();
          burstEl.classList.remove('pop');
          void burstEl.offsetWidth;
          burstEl.classList.add('pop');
          likePost(post, pillEl);
        }
        return;
      }

      if (wantsCommit && allowed) {
        dismissHint();
        finishCommit(direction);
      } else {
        finishToRest();
      }
    });

    card.addEventListener('pointercancel', () => {
      if (!dragging) return;
      dragging = false;
      card.classList.remove('dragging');
      finishToRest();
    });
  }

  function openOverlay() {
    overlay.classList.add('active');
    document.body.style.overflow = 'hidden';
    current = 0;
    history = [];
    render();
    showHintOnce();
    if (window.kravnPushOverlayState) window.kravnPushOverlayState();
  }
  function closeOverlay() {
    overlay.classList.remove('active');
    document.body.style.overflow = '';
    dismissHint();
  }

  openBtn.addEventListener('click', openOverlay);
  openBtn.addEventListener('keypress', (e) => { if (e.key === 'Enter' || e.key === ' ') openOverlay(); });
  if (closeBtn) closeBtn.addEventListener('click', closeOverlay);

  function setMode(next) {
    if (next === mode) return;
    if (next === 'shuffle') {
      for (let i = deck.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [deck[i], deck[j]] = [deck[j], deck[i]];
      }
      toast('Shuffled');
    } else {
      deck = deck.slice().sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
      toast('Sorted: Latest');
    }
    mode = next;
    if (modeToggle) modeToggle.classList.toggle('shuffle', mode === 'shuffle');
    current = 0; history = [];
    render();
  }

  if (modeToggle) {
    modeToggle.addEventListener('click', () => setMode(mode === 'latest' ? 'shuffle' : 'latest'));
    modeToggle.addEventListener('keypress', (e) => {
      if (e.key === 'Enter' || e.key === ' ') setMode(mode === 'latest' ? 'shuffle' : 'latest');
    });
  }

  function arrowNav(direction) {
    if (isAnimating) return;
    const allowed = direction > 0 ? canGoNext() : canGoPrev();
    if (!allowed) return;
    dismissHint();
    isAnimating = true;
    const w = stage.clientWidth || 340;
    if (direction < 0) ensurePrevEl(w);
    animateProgress(0, 1, {
      duration: 280,
      easing: easeOutCubic,
      onUpdate: (t) => {
        const p = direction > 0 ? -t : t;
        const x = direction > 0 ? -w * 1.1 * t : w * 1.1 * t;
        layoutStack(p, x, 0, w);
      },
      onDone: () => { isAnimating = false; commitAdvance(direction); }
    });
  }

  if (prevArrow) prevArrow.addEventListener('click', () => arrowNav(-1));
  if (nextArrow) nextArrow.addEventListener('click', () => arrowNav(1));

  document.addEventListener('keydown', (e) => {
    if (!overlay.classList.contains('active')) return;
    if (e.key === 'Escape') closeOverlay();
    if (e.key === 'ArrowRight') arrowNav(1);
    if (e.key === 'ArrowLeft') arrowNav(-1);
    if (e.key === 'ArrowDown' && circular) closeOverlay();
  });

  if (window.kravnRegisterOverlay) window.kravnRegisterOverlay(overlay, closeOverlay);
}

function initKravnPageArrival(config) {
  config = config || {};
  const page = document.getElementById(config.pageId || 'kravn-page');
  const flagKey = 'kravnPageTransitionOut';
  if (!page) return;

  if (sessionStorage.getItem(flagKey)) {
    sessionStorage.removeItem(flagKey);
    page.classList.add('kravn-page-enter');
    void page.offsetWidth;
    requestAnimationFrame(() => {
      page.classList.add('kravn-page-enter-active');
      setTimeout(() => {
        page.classList.remove('kravn-page-enter', 'kravn-page-enter-active');
      }, 380);
    });
  }
}

/* ============================================================
   KRAVN BACK-BUTTON GUARD
   Any time a Kravn overlay (Cards, Top Picks list, or a Top
   Pick's movie discussions) is open, pressing the browser/mobile
   back button should just take the person back to the Feed
   (home) instead of leaving the app or landing somewhere
   unexpected. We push one history entry per "layer" of overlay
   that opens, and unwind them on popstate — closing overlays
   first, and only actually navigating to /feed once every
   overlay is closed (a no-op here since Feed IS home).
   ============================================================ */
(function initKravnBackGuard() {
  const registered = [];
  let depth = 0;

  window.kravnRegisterOverlay = function (overlayEl, closeFn) {
    registered.push({ overlayEl, closeFn });
  };
  window.kravnPushOverlayState = function () {
    depth++;
    history.pushState({ kravnOverlayDepth: depth }, '');
  };

  function closeTopMostOpenOverlay() {
    for (let i = registered.length - 1; i >= 0; i--) {
      const { overlayEl, closeFn } = registered[i];
      if (overlayEl && overlayEl.classList.contains('active')) {
        closeFn();
        return true;
      }
    }
    return false;
  }

  window.addEventListener('popstate', () => {
    if (depth > 0) {
      depth--;
      closeTopMostOpenOverlay();
      if (!location.pathname.startsWith('/feed')) {
        window.location.href = '/feed';
      }
    }
  });
})();

/* ============================================================
   HERO BANNER — poster carousel
   Built from the top 30 posts ranked by IMDb rating (deduped by
   movie), shuffled into a random order each page load/login,
   auto-drifting, and fully drag/swipe-able.
   ============================================================ */
function initHeroCarousel(posts) {
  const strip = document.getElementById('hero-poster-strip');
  const track = document.getElementById('hero-poster-track');
  if (!strip || !track || !posts || !posts.length) return;

  const rated = posts.filter(p => p.posterUrl && p.imdbRating && !isNaN(parseFloat(p.imdbRating)));
  const source = rated.length ? rated : posts.filter(p => p.posterUrl);
  if (!source.length) { strip.remove(); return; }

  const byMovie = new Map();
  source.forEach(p => {
    const key = (p.movieName || p.title || '').trim().toLowerCase();
    if (!key) return;
    const rating = parseFloat(p.imdbRating) || 0;
    const existing = byMovie.get(key);
    if (!existing || rating > existing.rating) {
      byMovie.set(key, { movieName: p.movieName || p.title, posterUrl: p.posterUrl, rating });
    }
  });

  let top30 = Array.from(byMovie.values())
    .sort((a, b) => b.rating - a.rating)
    .slice(0, 30);

  // Shuffle into random order — reshuffles on every refresh/login.
  for (let i = top30.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [top30[i], top30[j]] = [top30[j], top30[i]];
  }

  if (!top30.length) { strip.remove(); return; }

  function escapeHtml(str) {
    return String(str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function tileEl(item) {
    const el = document.createElement('div');
    el.className = 'hero-poster-tile';
    el.innerHTML = `
      <img src="${item.posterUrl}" alt="" draggable="false" onerror="this.closest('.hero-poster-tile').remove()">
      <div class="hero-poster-tile-label">${escapeHtml(item.movieName)}</div>`;
    return el;
  }

  // Duplicate the shuffled set so the strip can loop seamlessly.
  const renderSet = [...top30, ...top30];
  renderSet.forEach(item => track.appendChild(tileEl(item)));

  let offset = 0;
  let singleSetWidth = 0;
  let dragging = false;
  let dragStartX = 0;
  let dragStartOffset = 0;
  let resumeTimer = null;
  let paused = false;
  let lastFrameT = null;
  const DRIFT_SPEED = 22; // px/sec

  function measure() {
    const tiles = track.children;
    if (!tiles.length) return;
    const half = tiles.length / 2;
    let w = 0;
    for (let i = 0; i < half; i++) {
      w += tiles[i].offsetWidth + 10; // + margin-right
    }
    singleSetWidth = w;
  }

  function applyOffset() {
    if (singleSetWidth > 0) {
      if (offset <= -singleSetWidth) offset += singleSetWidth;
      if (offset > 0) offset -= singleSetWidth;
    }
    track.style.transform = `translateX(${offset}px)`;
  }

  function pauseDrift() {
    paused = true;
    clearTimeout(resumeTimer);
    resumeTimer = setTimeout(() => { paused = false; lastFrameT = null; }, 2200);
  }

  function frame(t) {
    if (!dragging && !paused && singleSetWidth > 0) {
      if (lastFrameT !== null) {
        const dt = (t - lastFrameT) / 1000;
        offset -= DRIFT_SPEED * dt;
        applyOffset();
      }
      lastFrameT = t;
    } else {
      lastFrameT = null;
    }
    requestAnimationFrame(frame);
  }

  strip.addEventListener('pointerdown', (e) => {
    dragging = true;
    dragStartX = e.clientX;
    dragStartOffset = offset;
    strip.classList.add('dragging');
    pauseDrift();
    try { strip.setPointerCapture(e.pointerId); } catch (err) {}
  });
  strip.addEventListener('pointermove', (e) => {
    if (!dragging) return;
    offset = dragStartOffset + (e.clientX - dragStartX);
    applyOffset();
  });
  function endDrag() {
    if (!dragging) return;
    dragging = false;
    strip.classList.remove('dragging');
    pauseDrift();
  }
  strip.addEventListener('pointerup', endDrag);
  strip.addEventListener('pointercancel', endDrag);
  strip.addEventListener('pointerleave', () => { if (dragging) endDrag(); });
  strip.addEventListener('wheel', () => pauseDrift(), { passive: true });

  window.addEventListener('resize', measure);
  requestAnimationFrame(() => {
    measure();
    requestAnimationFrame(frame);
  });
}

/* ============================================================
   KRAVN TOP PICKS
   ============================================================ */
function initKravnTopPicks(posts) {
  if (!posts || !posts.length) return;

  const rated = posts.filter(p => p.imdbRating && !isNaN(parseFloat(p.imdbRating)));

  const picksSection = document.getElementById('kravn2-picks-section');
  const picksRow = document.getElementById('kravn2-picks-row');
  if (!picksRow) return;

  if (!rated.length) {
    if (picksSection) picksSection.style.display = 'none';
    return;
  }

  const groupsMap = new Map();
  rated.forEach(p => {
    const key = (p.movieName || p.title || '').trim().toLowerCase();
    if (!key) return;
    if (!groupsMap.has(key)) {
      groupsMap.set(key, {
        movieName: p.movieName || p.title,
        posterUrl: p.posterUrl,
        bestRating: parseFloat(p.imdbRating),
        posts: []
      });
    }
    const g = groupsMap.get(key);
    g.posts.push(p);
    const r = parseFloat(p.imdbRating);
    if (r > g.bestRating) g.bestRating = r;
    if (!g.posterUrl && p.posterUrl) g.posterUrl = p.posterUrl;
  });
  const groups = Array.from(groupsMap.values()).sort((a, b) => b.bestRating - a.bestRating);

  function posterInner(group) {
    return group.posterUrl
      ? `<img src="${group.posterUrl}" alt="" onerror="this.parentElement.innerHTML='<div class=\\'kravn2-poster-fallback\\'>\uD83C\uDFAC</div>'">`
      : `<div class="kravn2-poster-fallback">\uD83C\uDFAC</div>`;
  }

  function posterCard(group, rank) {
    const el = document.createElement('div');
    el.className = 'kravn2-poster-card';
    el.addEventListener('click', () => openMovieOverlay(group, false));
    el.innerHTML = `
      ${posterInner(group)}
      <div class="kravn2-rank-badge">#${rank}</div>
      <div class="kravn2-poster-overlay">
        <div class="kravn2-poster-movie">${group.movieName}</div>
        <div class="kravn2-poster-meta">IMDb ${group.bestRating}${group.posts.length > 1 ? ' · ' + group.posts.length + ' posts' : ''}</div>
      </div>`;
    return el;
  }

  const SHELF_SIZE = 10;
  groups.slice(0, SHELF_SIZE).forEach((g, i) => picksRow.appendChild(posterCard(g, i + 1)));

  if (groups.length > 3) {
    const viewAll = document.createElement('div');
    viewAll.className = 'kravn2-viewall-card';
    viewAll.innerHTML = `
      <div class="kravn2-viewall-icon">→</div>
      <div class="kravn2-viewall-label">View All<br>(${groups.length})</div>`;
    viewAll.addEventListener('click', () => openRankOverlay());
    picksRow.appendChild(viewAll);
  }

  const rankOverlay = document.getElementById('kravn2-rank-overlay');
  const rankGrid = document.getElementById('kravn2-rank-grid');
  const rankBack = document.getElementById('kravn2-rank-back');
  const rankCount = document.getElementById('kravn2-rank-count');

  function openRankOverlay() {
    if (!rankOverlay || !rankGrid) return;
    rankGrid.innerHTML = '';
    groups.forEach((g, i) => {
      const item = document.createElement('div');
      item.className = 'kravn2-rank-item';
      item.addEventListener('click', () => openMovieOverlay(g, true));
      item.innerHTML = `
        <div class="kravn2-rank-poster-wrap">
          ${posterInner(g)}
          <div class="kravn2-rank-num">#${i + 1}</div>
          <div class="kravn2-rank-rating">★ ${g.bestRating}</div>
        </div>
        <div class="kravn2-rank-info">
          <div class="kravn2-rank-movie">${g.movieName}</div>
          <div class="kravn2-rank-post">${g.posts.length} discussion${g.posts.length > 1 ? 's' : ''}</div>
        </div>`;
      rankGrid.appendChild(item);
    });
    if (rankCount) rankCount.textContent = `${groups.length} movies · ranked by IMDb rating`;
    rankOverlay.classList.add('active');
    document.body.style.overflow = 'hidden';
    if (window.kravnPushOverlayState) window.kravnPushOverlayState();
  }
  function closeRankOverlay() {
    rankOverlay.classList.remove('active');
    document.body.style.overflow = '';
  }
  if (rankBack) rankBack.addEventListener('click', closeRankOverlay);
  if (window.kravnRegisterOverlay) window.kravnRegisterOverlay(rankOverlay, closeRankOverlay);

  const movieOverlay = document.getElementById('kravn2-movie-overlay');
  const movieList = document.getElementById('kravn2-movie-list');
  const movieBack = document.getElementById('kravn2-movie-back');
  const movieTitleEl = document.getElementById('kravn2-movie-title');
  const movieCountEl = document.getElementById('kravn2-movie-count');
  const movieHero = document.getElementById('kravn2-movie-hero');
  const movieHeroBackdrop = document.getElementById('kravn2-movie-hero-backdrop');
  const movieHeroImg = document.getElementById('kravn2-movie-hero-img');
  const movieHeroBadge = document.getElementById('kravn2-movie-hero-badge');
  let cameFromRank = false;

  function openMovieOverlay(group, fromRank) {
    if (!movieOverlay || !movieList) return;
    cameFromRank = !!fromRank;
    movieTitleEl.textContent = group.movieName;
    movieCountEl.textContent = `${group.posts.length} discussion${group.posts.length > 1 ? 's' : ''}`;

    if (movieHero && movieHeroImg) {
      if (group.posterUrl) {
        movieHeroImg.src = group.posterUrl;
        if (movieHeroBackdrop) movieHeroBackdrop.style.backgroundImage = `url("${group.posterUrl}")`;
        movieHero.style.display = 'block';
        if (movieHeroBadge) movieHeroBadge.textContent = '★ IMDb ' + group.bestRating;
      } else {
        movieHero.style.display = 'none';
      }
    }

    movieList.innerHTML = '';
    const sorted = group.posts.slice().sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
    sorted.forEach(p => {
      const row = document.createElement('div');
      row.className = 'kravn2-movie-row';
      row.addEventListener('click', () => { window.location.href = `/posts/${p.id}`; });
      const dateStr = new Date(p.createdAt).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Kolkata' });
      row.innerHTML = `
        <div class="kravn2-movie-row-body">
          <div class="kravn2-movie-row-title">${p.title}</div>
          <div class="kravn2-movie-row-meta">Posted by <span>${p.username}</span> · ${dateStr}${p.imdbRating ? ' · IMDb ' + p.imdbRating : ''}</div>
        </div>
        <div class="kravn2-movie-row-arrow">→</div>`;
      movieList.appendChild(row);
    });
    movieOverlay.classList.add('active');
    document.body.style.overflow = 'hidden';
    if (window.kravnPushOverlayState) window.kravnPushOverlayState();
  }
  function closeMovieOverlay() {
    movieOverlay.classList.remove('active');
    if (!cameFromRank) document.body.style.overflow = '';
  }
  if (movieBack) movieBack.addEventListener('click', closeMovieOverlay);
  if (window.kravnRegisterOverlay) window.kravnRegisterOverlay(movieOverlay, closeMovieOverlay);

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (movieOverlay && movieOverlay.classList.contains('active')) { closeMovieOverlay(); return; }
    if (rankOverlay && rankOverlay.classList.contains('active')) closeRankOverlay();
  });
}
</script>
  <script>
    const KRAVN_FEED_POSTS = <%- JSON.stringify(posts.map(p => ({
      id: p.id,
      movieName: p.movie_name || '',
      title: p.title || '',
      username: p.username || '',
      imdbRating: (p.imdb_rating && p.imdb_rating !== 'N/A') ? p.imdb_rating : null,
      posterUrl: (p.poster_url && p.poster_url !== 'N/A') ? p.poster_url : null,
      createdAt: p.created_at
    }))) %>;

    document.addEventListener('DOMContentLoaded', () => {
      initKravnCards({ posts: KRAVN_FEED_POSTS, hintKey: 'kravnHintSeen_feed', circular: true });
      initHeroCarousel(KRAVN_FEED_POSTS);
      initKravnTopPicks(KRAVN_FEED_POSTS);
      initKravnPageArrival();
    });
  </script>
</body>
</html>
