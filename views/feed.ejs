<%- include('partials/head', { title: 'Home' }) %>
<%- include('partials/nav') %>
<style>
  /* =====================================================================
     HOME: "Browse by genre" row + trending discussion poster tiles
     ===================================================================== */

  /* ---------- genre pills ---------- */
  .kv-genres {
    display: flex; flex-wrap: nowrap; gap: 8px; overflow-x: auto; scrollbar-width: none; overscroll-behavior-x: contain;
    scroll-snap-type: x proximity; padding: 2px 0 6px;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 16px, #000 calc(100% - 28px), transparent 100%);
            mask-image: linear-gradient(90deg, transparent 0, #000 16px, #000 calc(100% - 28px), transparent 100%);
  }
  .kv-genres::-webkit-scrollbar { display: none; }
  .kv-genre {
    flex: none; scroll-snap-align: start; display: inline-flex; align-items: center; height: 32px; padding: 0 14px; margin: 0;
    border-radius: 999px; font: 500 12.5px/1 var(--font); letter-spacing: .01em; color: color-mix(in srgb, var(--text) 82%, transparent);
    white-space: nowrap; background: color-mix(in srgb, var(--text) 5%, transparent);
    border: 1px solid color-mix(in srgb, var(--text) 10%, transparent); box-shadow: none;
    transition: color .2s, background .2s, border-color .2s, transform .2s;
  }
  .kv-genre:hover, .kv-genre:focus-visible { color: #fff; border-color: color-mix(in srgb, var(--accent) 60%, transparent); background: color-mix(in srgb, var(--accent) 18%, transparent); }
  .kv-genre:active { transform: scale(.96); }

  /* ---------- trending rail: sizing ---------- */
  .rail-track--posts { gap: 14px; align-items: flex-start; padding-block: 4px 10px; }
  .rail-track--posts .pcard { flex: 0 0 auto; width: clamp(150px, 14vw, 184px); max-width: 184px; scroll-snap-align: start; }

  /* ---------- the tile ---------- */
  .rail-track--posts .pcard {
    position: relative; display: flex; flex-direction: column; min-width: 0; height: auto; margin: 0; padding: 0; overflow: hidden;
    border-radius: 16px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--text) 7%, var(--surface)), var(--surface));
    border: 1px solid color-mix(in srgb, var(--text) 9%, transparent);
    transition: transform .25s ease, border-color .25s, box-shadow .25s;
  }
  .rail-track--posts .pcard:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--accent) 45%, transparent); box-shadow: 0 18px 38px -18px rgba(0, 0, 0, .75); }

  /* poster: 2:3 frame; the watchlist bookmark sits on it, top-right (plain dark circle, no blur) */
  .rail-track--posts .pcard .pcard-poster {
    position: relative; display: block; width: 100%; height: auto; aspect-ratio: 2/3; flex: none; margin: 0; border-radius: 0;
    background: color-mix(in srgb, var(--surface-2) 90%, #000); overflow: hidden;
  }
  .rail-track--posts .pcard .pcard-poster img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; transition: transform .5s ease; }
  .rail-track--posts .pcard:hover .pcard-poster img { transform: scale(1.04); }
  .rail-track--posts .pcard .pcard-poster::after { content: ''; position: absolute; inset: auto 0 0 0; height: 38%; background: linear-gradient(0deg, rgba(0, 0, 0, .55), transparent); pointer-events: none; }
  .rail-track--posts .pcard .pcard-poster-fallback { display: grid; place-items: center; width: 100%; height: 100%; color: var(--muted); }
  .rail-track--posts .pcard .wl-btn--poster { -webkit-backdrop-filter: none; backdrop-filter: none; }

  /* text block: one column pinned to the card width, so long names get an ellipsis instead of widening the card */
  .rail-track--posts .pcard .pcard-body { padding: 11px 12px 12px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 5px; min-width: 0; }
  .rail-track--posts .pcard .pcard-eyebrow { margin: 0; display: block; min-width: 0; }
  .rail-track--posts .pcard .pcard-eyebrow :is(.rate, .muted) { display: none; }
  .rail-track--posts .pcard .pcard-movie {
    display: block; font-size: 10.5px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase;
    color: var(--accent-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; position: relative; z-index: 2;
  }
  .rail-track--posts .pcard .pcard-title { margin: 0; font-size: 13.5px; font-weight: 650; line-height: 1.32; letter-spacing: -.005em; min-width: 0; }
  .rail-track--posts .pcard .pcard-title a { display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; color: inherit; }
  .rail-track--posts .pcard .pcard-text,
  .rail-track--posts .pcard time { display: none; }

  /* footer: row 1 = clickable username, row 2 = like · comment (left) and share (right) */
  .rail-track--posts .pcard .pcard-foot { display: grid; grid-template-columns: minmax(0, 1fr); gap: 4px; min-width: 0; margin: 3px 0 0; padding: 8px 0 0; border-top: 1px solid color-mix(in srgb, var(--text) 8%, transparent); }
  .rail-track--posts .pcard .pcard-author { position: relative; z-index: 2; display: inline-flex; align-items: center; gap: 6px; justify-self: start; min-width: 0; max-width: 100%; font-size: 11.5px; color: color-mix(in srgb, var(--text) 70%, transparent); transition: color .2s; }
  .rail-track--posts .pcard .pcard-author:hover { color: var(--text); }
  .rail-track--posts .pcard .pcard-author span:last-child { min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rail-track--posts .pcard .avatar--sm { width: 20px; height: 20px; font-size: 10px; flex: none; }

  .rail-track--posts .pcard .pcard-actions { position: relative; z-index: 2; display: flex; align-items: center; gap: 2px; margin: 0 -8px; }
  .rail-track--posts .pcard .act {
    display: inline-flex; align-items: center; gap: 5px; height: 30px; min-height: 0; padding: 0 8px; border: 0; border-radius: 999px; background: none;
    font-size: 12px; font-weight: 600; font-variant-numeric: tabular-nums; color: color-mix(in srgb, var(--text) 62%, transparent);
    transition: background .2s, color .2s, transform .15s;
  }
  .rail-track--posts .pcard .act svg { width: 15px; height: 15px; flex: none; }
  .rail-track--posts .pcard .act:hover { color: var(--text); background: color-mix(in srgb, var(--text) 9%, transparent); }
  .rail-track--posts .pcard .act:active { transform: scale(.94); }
  .rail-track--posts .pcard .act.like:hover, .rail-track--posts .pcard .act.like.on { color: var(--accent); background: color-mix(in srgb, var(--accent) 14%, transparent); }
  .rail-track--posts .pcard .act.like.on svg { fill: currentColor; }
  .rail-track--posts .pcard [data-share-post] { margin-left: auto; }

  /* ---------- phones ---------- */
  @media (max-width: 640px) {
    .kv-genres { margin-inline: -16px; padding-inline: 16px; scroll-padding-inline: 16px; gap: 7px; }
    .kv-genre { height: 30px; padding: 0 12px; font-size: 12px; }
    .rail-track--posts { gap: 10px; }
    .rail-track--posts .pcard { width: 132px; max-width: 132px; }
    .rail-track--posts .pcard { border-radius: 14px; }
    .rail-track--posts .pcard .pcard-body { padding: 9px 10px 10px; gap: 4px; }
    .rail-track--posts .pcard .pcard-title { font-size: 12.5px; }
    .rail-track--posts .pcard .pcard-movie { font-size: 9.5px; }
    .rail-track--posts .pcard .pcard-actions { margin: 0 -6px; }
    .rail-track--posts .pcard .act { gap: 4px; padding: 0 6px; font-size: 11.5px; }
    .rail-track--posts .pcard .act svg { width: 14px; height: 14px; }
  }
  @media (hover: none) { .rail-track--posts .pcard:hover { transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .rail-track--posts .pcard, .rail-track--posts .pcard .pcard-poster img, .rail-track--posts .pcard .pcard-author, .rail-track--posts .pcard .act, .kv-genre { transition: none; }
    .rail-track--posts .pcard:hover, .rail-track--posts .pcard:hover .pcard-poster img { transform: none; }
  }
</style>

<main class="page page--flush">

  <%
    /* Backdrop: the most famous titles first (popular + top rated of all time), then trending */
    const pick = (re) => rows.filter((r) => re.test(r.title)).reduce((a, r) => a.concat(r.movies || []), []);
    const seen = new Set();
    let pool = []
      .concat(pick(/popular/i), pick(/top rated/i), pick(/trending/i), rows.reduce((a, r) => a.concat(r.movies || []), []))
      .filter((m) => m && m.poster && !seen.has(m.poster) && seen.add(m.poster))
      .map((m) => m.poster);
    if (pool.length < 8) pool = top.map((p) => posterOf(p)).filter(Boolean);
    pool = pool.slice(0, 32);
    const colCount = pool.length >= 16 ? 8 : 4;
    const cols = Array.from({ length: colCount }, (_, c) => pool.filter((_, i) => i % colCount === c)).filter((c) => c.length);
    const loopCol = (col) => { let base = col.slice(); while (base.length < 6) base = base.concat(col); return base.concat(base); };
  %>

  <style>
    /* ---------- hero: clean cinematic poster wall in 3D perspective, no glow ---------- */
    .kv-hero {
      position: relative; isolation: isolate; overflow: hidden;
      margin-top: calc(var(--nav-h) * -1); padding-top: var(--nav-h);
      min-height: clamp(380px, 58vh, 580px); display: flex; align-items: center;
      background: linear-gradient(180deg, color-mix(in srgb, var(--bg-2) 88%, #000), var(--bg-2));
    }
    .kv-stage { position: absolute; inset: 0; z-index: 0; overflow: hidden; perspective: 1400px; perspective-origin: 72% 35%; pointer-events: none; }
    .kv-wall {
      position: absolute; inset: -38% -12%; display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 14px;
      transform: rotateX(24deg) rotateY(-18deg) rotateZ(-7deg) scale(1.2); transform-style: preserve-3d;
      opacity: .4; filter: saturate(.85) contrast(1.05); user-select: none; -webkit-user-select: none;
    }
    .kv-col { display: grid; gap: 14px; align-content: start; animation: kvDrift var(--d, 110s) linear infinite var(--dir, normal); will-change: transform; }
    .kv-col:nth-child(odd) { opacity: .78; }
    .kv-col img {
      width: 100%; aspect-ratio: 2/3; object-fit: cover; border-radius: 10px; background: var(--surface-2);
      pointer-events: none; -webkit-user-drag: none;
      border: 1px solid rgba(255, 255, 255, .08); box-shadow: 0 14px 34px -14px rgba(0, 0, 0, .8);
    }
    @keyframes kvDrift { to { transform: translateY(-50%); } }

    /* readability shade + fine film grain */
    .kv-shade {
      position: absolute; inset: 0; z-index: 1; pointer-events: none;
      background:
        linear-gradient(90deg, var(--bg) 0%, color-mix(in srgb, var(--bg) 86%, transparent) 38%, color-mix(in srgb, var(--bg) 22%, transparent) 92%),
        linear-gradient(0deg, var(--bg) 0%, color-mix(in srgb, var(--bg) 40%, transparent) 22%, transparent 48%),
        linear-gradient(180deg, color-mix(in srgb, var(--bg) 78%, transparent) 0%, transparent 32%);
    }
    .kv-shade::after {
      content: ''; position: absolute; inset: 0; opacity: .08; mix-blend-mode: overlay;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='140' height='140'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    }

    /* film-reel edges with scrolling sprocket holes (laptop only) */
    .kv-film { position: absolute; z-index: 2; top: 0; bottom: 0; width: 30px; pointer-events: none; background: linear-gradient(90deg, rgba(0, 0, 0, .55), rgba(0, 0, 0, .15)); }
    .kv-film--l { left: 0; border-right: 1px solid rgba(255, 255, 255, .06); }
    .kv-film--r { right: 0; transform: scaleX(-1); border-right: 1px solid rgba(255, 255, 255, .06); }
    .kv-film::before {
      content: ''; position: absolute; inset: 0 0 0 9px; width: 12px;
      background: repeating-linear-gradient(180deg, rgba(255, 255, 255, .16) 0 12px, transparent 12px 28px);
      -webkit-mask-image: linear-gradient(180deg, transparent, #000 18%, #000 82%, transparent);
              mask-image: linear-gradient(180deg, transparent, #000 18%, #000 82%, transparent);
      border-radius: 3px; animation: kvReel 2.4s linear infinite;
    }
    @keyframes kvReel { to { background-position: 0 28px; } }

    /* content */
    .kv-inner { position: relative; z-index: 3; width: min(1400px, 100% - 96px); margin: 0 auto; }
    .kv-body { padding: 48px 0 64px; display: grid; gap: 14px; justify-items: start; min-width: 0; }
    .kv-title { display: grid; gap: 6px; max-width: 760px; overflow-wrap: anywhere; line-height: 1.04; margin: 0; }
    .kv-title .hi { font-size: clamp(15px, 2vw, 20px); font-weight: 500; letter-spacing: .01em; color: var(--accent-2); }
    .kv-title .to {
      font-size: clamp(34px, 5.8vw, 68px); font-weight: 700; letter-spacing: -.035em;
      background: linear-gradient(180deg, #fff 30%, color-mix(in srgb, var(--text) 60%, transparent));
      -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
    }
    .kv-title .logo { white-space: nowrap; }
    .kv-title .logo span { -webkit-text-fill-color: var(--accent); color: var(--accent); }
    .kv-sub { color: color-mix(in srgb, var(--text) 68%, transparent); max-width: 460px; font-size: 15.5px; line-height: 1.55; margin: 0; }
    .kv-body .hero-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px; }

    /* CTAs: minimal pills, solid primary + quiet glass secondary */
    .kv-body .kv-cta {
      position: relative; display: inline-flex; align-items: center; justify-content: center; gap: 10px;
      height: 46px; padding: 0 24px; margin: 0; border-radius: 999px;
      font: 500 13.5px/1 var(--font); letter-spacing: .04em; color: #fff; white-space: nowrap; text-decoration: none;
      transition: transform .25s ease, background .25s ease, border-color .25s ease, box-shadow .25s ease;
    }
    .kv-body .kv-cta:hover { transform: translateY(-2px); }
    .kv-body .kv-cta:active { transform: scale(.97); }
    .kv-body .kv-cta-ic { display: grid; place-items: center; flex: none; width: auto; border: 0; margin: 0; }
    .kv-body .kv-cta-ic svg { width: 17px; height: 17px; transition: transform .25s ease; }
    .kv-body .kv-cta:hover .kv-cta-ic svg { transform: scale(1.12); }

    /* hollow variants: thin outline, fill in on hover */
    .kv-body .kv-cta--main {
      background: transparent; border: 1px solid color-mix(in srgb, var(--accent) 85%, #fff 10%); color: #fff;
      box-shadow: none;
    }
    .kv-body .kv-cta--main:hover {
      background: var(--accent); border-color: var(--accent);
      box-shadow: 0 12px 28px -14px color-mix(in srgb, var(--accent) 80%, transparent);
    }

    .kv-body .kv-cta--ghost {
      background: transparent; border: 1px solid rgba(255, 255, 255, .28); color: rgba(255, 255, 255, .92);
      -webkit-backdrop-filter: none; backdrop-filter: none; box-shadow: none;
    }
    .kv-body .kv-cta--ghost:hover { background: rgba(255, 255, 255, .08); border-color: rgba(255, 255, 255, .6); color: #fff; }

    /* section headings */
    .kv-h { display: flex; align-items: center; gap: 10px; font-size: clamp(17px, 2vw, 21px); font-weight: 700; letter-spacing: -.015em; margin: 0; }
    .kv-h i { width: 3px; height: 1em; border-radius: 3px; background: linear-gradient(180deg, var(--accent-2), var(--accent)); flex: none; }
    .kv-first .section-head { margin-top: 22px; margin-bottom: 10px; }

    @media (min-width: 1600px) { .kv-inner { width: min(1560px, 100% - 144px); } }
    @media (max-width: 1099px) {
      .kv-col:nth-child(n+7) { display: none; }
      .kv-inner { width: calc(100% - 48px); }
      .kv-film { display: none; }
    }
    @media (max-width: 640px) {
  .kv-hero { min-height: 27vh; min-height: 27svh; align-items: flex-end; }
      .kv-col:nth-child(n+7) { display: none; }
      .kv-wall { gap: 6px; opacity: .4; inset: -24% -34%; transform: rotateX(16deg) rotateY(-10deg) rotateZ(-7deg) scale(1); }
      .kv-col { gap: 6px; } .kv-col img { border-radius: 6px; }
      .kv-shade {
        background:
          linear-gradient(0deg, var(--bg) 0%, color-mix(in srgb, var(--bg) 88%, transparent) 40%, color-mix(in srgb, var(--bg) 20%, transparent) 100%),
          linear-gradient(180deg, color-mix(in srgb, var(--bg) 70%, transparent) 0%, transparent 25%);
      }
      .kv-inner { width: calc(100% - 32px); }
      .kv-body { padding: 22px 0 24px; gap: 9px; }
      .kv-title .to { font-size: clamp(32px, 10vw, 40px); }
      .kv-sub { font-size: 14px; max-width: 34ch; }
      .kv-body .hero-actions { width: 100%; display: grid; grid-template-columns: 1.55fr 1fr; gap: 8px; }
      .kv-body .kv-cta { height: 44px; padding: 0 14px; gap: 8px; font-size: 13px; width: 100%; }
      .kv-body .kv-cta-ic svg { width: 16px; height: 16px; }
      .kv-first .section-head { margin-top: 18px; }
    }
    @media (max-width: 400px) { .kv-long { display: none; } }
    @media (prefers-reduced-motion: reduce) { .kv-col, .kv-film::before { animation: none !important; } }
  </style>

  <!-- ============ WELCOME HERO ============ -->
  <section class="kv-hero">
    <% if (cols.length) { %>
      <div class="kv-stage" aria-hidden="true">
        <div class="kv-wall">
          <% cols.forEach((col, c) => { %>
            <div class="kv-col" style="--d:<%= 100 + c * 14 %>s;--dir:<%= c % 2 ? 'reverse' : 'normal' %>"><% loopCol(col).forEach((src) => { %><img src="<%= src %>" alt="" loading="lazy" decoding="async" draggable="false"><% }) %></div>
          <% }) %>
        </div>
      </div>
    <% } %>
    <div class="kv-shade" aria-hidden="true"></div>
    <span class="kv-film kv-film--l" aria-hidden="true"></span>
    <span class="kv-film kv-film--r" aria-hidden="true"></span>

    <div class="kv-inner">
      <div class="kv-body">
        <h1 class="kv-title">
          <span class="hi"><%= me ? 'Hey ' + me.username + ',' : 'Hey there,' %></span>
          <span class="to">Welcome to <span class="logo">Krav<span>N</span></span></span>
        </h1>
        <p class="kv-sub">Where theories come alive.</p>
        <div class="hero-actions">
          <a class="btn btn-primary kv-cta kv-cta--main" href="<%= me ? '/posts/new' : '/register' %>"><span class="kv-cta-ic"><%- include('partials/icon', { n: me ? 'plus' : 'user' }) %></span><span class="kv-cta-tx"><%= me ? 'Start a discussion' : 'Join KravN' %></span></a>
          <a class="btn btn-glass kv-cta kv-cta--ghost" href="/discussions"><span class="kv-cta-ic"><%- include('partials/icon', { n: 'chat' }) %></span><span class="kv-cta-tx">Browse<span class="kv-long"> discussions</span></span></a>
        </div>
      </div>
    </div>
  </section>

  <div class="shell">

    <% if (Object.keys(genreNames).length) { %>
      <section class="kv-first" aria-label="Browse by genre">
        <div class="section-head"><h2 class="kv-h"><i></i>Browse by genre</h2></div>
        <div class="kv-genres">
          <% Object.entries(genreNames).forEach(([id, name]) => { %><a class="kv-genre" href="/genre/<%= id %>"><%= name %></a><% }) %>
        </div>
      </section>
    <% } %>

    <section class="rail" data-rail>
      <div class="section-head">
        <h2 class="kv-h"><i></i>Trending discussions</h2>
        <a class="more" href="/discussions">See all <%- include('partials/icon', { n: 'next' }) %></a>
      </div>
      <% if (latest.length) { %>
        <div class="rail-wrap">
          <button type="button" class="rail-btn prev" data-rail-btn="-1" aria-label="Scroll left"><%- include('partials/icon', { n: 'prev' }) %></button>
          <div class="rail-track rail-track--posts" id="latest"><% latest.forEach((post) => { %><%- include('partials/postCard', { post, compact: true }) %><% }) %></div>
          <button type="button" class="rail-btn next" data-rail-btn="1" aria-label="Scroll right"><%- include('partials/icon', { n: 'next' }) %></button>
        </div>
      <% } else { %>
        <div class="empty"><p>No discussions yet. Be the first to start one.</p><a class="btn btn-primary" href="<%= me ? '/posts/new' : '/register' %>">Start a discussion</a></div>
      <% } %>
    </section>

    <% if (top.length) { %>
      <section class="rail" data-rail>
        <div class="section-head"><h2 class="kv-h"><i></i>Most discussed movies</h2></div>
        <div class="rail-wrap">
          <button type="button" class="rail-btn prev" data-rail-btn="-1" aria-label="Scroll left"><%- include('partials/icon', { n: 'prev' }) %></button>
          <div class="rail-track">
            <% top.forEach((p) => { %><%- include('partials/movieCard', {
              m: { title: p.movie_name, year: (String(p.release_date || '').match(/(?:19|20)\d{2}/) || [''])[0], poster: posterOf(p), percent: null },
              href: movieLink(p),
              badge: p.discussions + (p.discussions === 1 ? ' discussion' : ' discussions')
            }) %><% }) %>
          </div>
          <button type="button" class="rail-btn next" data-rail-btn="1" aria-label="Scroll right"><%- include('partials/icon', { n: 'next' }) %></button>
        </div>
      </section>
    <% } %>

    <% rows.forEach((row) => { %><%- include('partials/row', { row }) %><% }) %>

    <div id="more-rows"></div>
    <% if (nextRow < totalRows) { %>
      <div class="loader" data-infinite="/api/home/rows?count=3" data-param="from" data-next="<%= nextRow %>" data-target="#more-rows"><span class="spinner"></span></div>
    <% } %>
  </div>
</main>

<%- include('partials/foot') %>