    c.fillStyle = '#111'; c.font = '800 40px ' + FAM; c.textAlign = 'center'; c.fillText('K', x0 + 32, 1811);
    c.fillStyle = 'rgba(255,255,255,.8)'; c.font = '700 36px ' + FAM; c.textAlign = 'left'; c.fillText(label, x0 + 82, 1810);
    return cv;
  }
  function toBlob(cv) { return new Promise(function (ok, no) { cv.toBlob(function (b) { b ? ok(b) : no(new Error('export failed')); }, 'image/png'); }); }
  function saveBlob(blob, name) { var a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = name; document.body.appendChild(a); a.click(); a.remove(); setTimeout(function () { URL.revokeObjectURL(a.href); }, 3000); }
  function fname(i) { return 'kravn-wrapped-' + W.year + '-' + (i + 1) + '.png'; }
  /* images are rendered in the background as slides appear, so Save and Share are instant */
  var blobCache = {}, pending = {};
  function getBlob(i) {
    if (blobCache[i]) return Promise.resolve(blobCache[i]);
    if (!pending[i]) pending[i] = renderCanvas(S[i]).then(toBlob).then(function (b) { blobCache[i] = b; delete pending[i]; return b; }, function (e) { delete pending[i]; throw e; });
    return pending[i];
  }

  /* ================= share text ================= */
  var SITE = location.origin + '/wrapped';
  var CAP = W.personality.emoji + ' I’m ' + W.personality.name + ' on KravN Wrapped ' + W.year + '. ' + W.sentence + ' Top pick: ' + t1.name + '.';
  function enc(s) { return encodeURIComponent(s); }

  /* ================= story viewer ================= */
  var ov, frame, stage, row, segs = [], slides = [], idx = 0, lastFocus, busy = false, warmT;
  var saveBtn, shareBtn, moreBtn, prevBtn, nextBtn, sheet, prevImg, tabs, toastEl, toastT, shareIdx = 0, openIdx = 0, holdPaused = false, sheetOpen = false, prevUrl = '';

  function updatePause() { ov.classList.toggle('paused', holdPaused || sheetOpen); }
  function toast(msg) { toastEl.textContent = msg; toastEl.hidden = false; clearTimeout(toastT); toastT = setTimeout(function () { toastEl.hidden = true; }, 2400); }
  function guard(fn) { return async function () { if (busy) return; busy = true; try { await fn(); } catch (e) { toast('Something went wrong. Please try again.'); } finally { busy = false; } }; }

  function layout() {
    var bh = (row.offsetHeight || 50) + 14, aw = innerWidth - 16, ah = innerHeight - bh - 28;
    var fh = Math.min(ah, 1100), fw = fh * 9 / 16;
    if (fw > aw) { fw = aw; fh = fw * 16 / 9; }
    frame.style.width = fw + 'px'; frame.style.height = fh + 'px'; stage.style.transform = 'scale(' + (fw / SW) + ')'; row.style.width = fw + 'px';
  }
  function countUp(slide) {
    Array.prototype.forEach.call(slide.querySelectorAll('.wr-num b'), function (n) {
      var v = Number(n.getAttribute('data-v')) || 0, t0 = performance.now(), d = 1300;
      (function tick(t) { var p = Math.min(1, (t - t0) / d); n.textContent = Math.round(v * (1 - Math.pow(1 - p, 3))); if (p < 1) requestAnimationFrame(tick); })(t0);
    });
  }
  function show(i) {
    idx = Math.max(0, Math.min(LAST, i));
    slides.forEach(function (s, k) { s.classList.toggle('on', k === idx); });
    segs.forEach(function (sg, k) {
      sg.className = 'wr-seg' + (k < idx ? ' done' : '') + (k === idx ? ' on' + (k === LAST ? ' last' : '') : '');
      if (k === idx) { var f = sg.firstChild; f.style.animation = 'none'; void f.offsetWidth; f.style.animation = ''; }
    });
    countUp(slides[idx]);
    var last = idx === LAST;
    saveBtn.querySelector('span').textContent = last ? 'Save poster' : 'Save slide';
    shareBtn.querySelector('span').textContent = last ? 'Share poster' : 'Share';
    shareBtn.classList.toggle('wr-btn--p', last);
    prevBtn.style.visibility = idx === 0 ? 'hidden' : 'visible';
    nextBtn.style.visibility = last ? 'hidden' : 'visible';
    clearTimeout(warmT); warmT = setTimeout(function () { getBlob(idx).catch(noop); }, 450);
  }

  /* ---------- share sheet ---------- */
  function setShareIdx(i) {
    shareIdx = i;
    Array.prototype.forEach.call(tabs.children, function (t, k) { t.classList.toggle('on', (k === 0 ? openIdx : LAST) === i); });
    prevImg.classList.add('load');
    getBlob(i).then(function (b) {
      if (shareIdx !== i) return;
      if (prevUrl) URL.revokeObjectURL(prevUrl);
      prevUrl = URL.createObjectURL(b); prevImg.src = prevUrl; prevImg.classList.remove('load');
    }).catch(function () { prevImg.classList.remove('load'); });
  }
  function openSheet() {
    openIdx = idx; sheetOpen = true; updatePause(); sheet.hidden = false;
    tabs.hidden = openIdx === LAST;
    setShareIdx(openIdx);
    sheet.querySelector('.wr-share-main').focus();
  }
  function closeSheet() { sheetOpen = false; sheet.hidden = true; updatePause(); shareBtn.focus(); }

  async function nativeShare(i) {
    var blob = await getBlob(i), f = new File([blob], fname(i), { type: 'image/png' });
    var data = { files: [f], title: 'My KravN Wrapped ' + W.year, text: CAP + ' ' + SITE };
    if (canFiles) {
      try { await navigator.share(data); } catch (e) { if (!e || e.name !== 'AbortError') throw e; }
    } else { saveBlob(blob, fname(i)); toast('Image saved. Attach it to your post!'); }
  }
  async function copyCaption() {
    var text = CAP + ' ' + SITE;
    try { await navigator.clipboard.writeText(text); }
    catch (e) { var ta = el('textarea'); ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0'; document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove(); }
    toast('Caption copied');
  }

  function build() {
    ov = el('div', 'wr-ov'); ov.hidden = true; ov.setAttribute('role', 'dialog'); ov.setAttribute('aria-modal', 'true'); ov.setAttribute('aria-label', 'KravN Wrapped');
    ov.style.setProperty('--noise', 'url(' + noise().toDataURL('image/png') + ')');
    var wrapEl = el('div', 'wr-stagewrap');
    frame = el('div', 'wr-frame'); stage = el('div', 'wr-stage');
    S.forEach(function (sp) { var s = domSlide(sp); slides.push(s); stage.appendChild(s); });
    var sg = el('div', 'wr-segs'); sg.style.setProperty('--dur', DUR + 'ms');
    S.forEach(function (_, k) { var s = el('div', 'wr-seg'); s.appendChild(el('i')); sg.appendChild(s); segs.push(s); if (k < LAST) s.firstChild.addEventListener('animationend', function () { if (s.classList.contains('on')) show(idx + 1); }); });
    var x = el('button', 'wr-x'); x.type = 'button'; x.innerHTML = ICON.x; x.setAttribute('aria-label', 'Close'); x.addEventListener('click', close);
    frame.appendChild(stage); frame.appendChild(sg); frame.appendChild(x);
    var downT = 0;
    ['l', 'r'].forEach(function (d) {
      var z = el('div', 'wr-zone ' + d);
      z.addEventListener('pointerdown', function () { downT = Date.now(); holdPaused = true; updatePause(); });
      z.addEventListener('pointerup', function () { holdPaused = false; updatePause(); if (Date.now() - downT < 260) show(idx + (d === 'l' ? -1 : 1)); });
      z.addEventListener('pointerleave', function () { holdPaused = false; updatePause(); });
      z.addEventListener('pointercancel', function () { holdPaused = false; updatePause(); });
      z.addEventListener('contextmenu', function (e) { e.preventDefault(); });
      frame.appendChild(z);
    });
    prevBtn = el('button', 'wr-arrow'); prevBtn.type = 'button'; prevBtn.innerHTML = ICON.l; prevBtn.setAttribute('aria-label', 'Previous slide'); prevBtn.addEventListener('click', function () { show(idx - 1); });
    nextBtn = el('button', 'wr-arrow'); nextBtn.type = 'button'; nextBtn.innerHTML = ICON.r; nextBtn.setAttribute('aria-label', 'Next slide'); nextBtn.addEventListener('click', function () { show(idx + 1); });
    wrapEl.appendChild(prevBtn); wrapEl.appendChild(frame); wrapEl.appendChild(nextBtn);

    /* action bar: Save | Share (one tap to the system share sheet when supported) | More */
    row = el('div', 'wr-actions');
    saveBtn = el('button', 'wr-btn'); saveBtn.type = 'button'; saveBtn.innerHTML = ICON.dl + '<span>Save slide</span>';
    shareBtn = el('button', 'wr-btn'); shareBtn.type = 'button'; shareBtn.innerHTML = ICON.sh + '<span>Share</span>';
    moreBtn = el('button', 'wr-btn wr-btn--icon'); moreBtn.type = 'button'; moreBtn.innerHTML = ICON.mr; moreBtn.setAttribute('aria-label', 'More share options'); moreBtn.hidden = !canFiles;
    saveBtn.addEventListener('click', guard(async function () { saveBlob(await getBlob(idx), fname(idx)); toast('Saved to your device'); }));
    shareBtn.addEventListener('click', guard(async function () {
      if (canFiles && blobCache[idx]) {
        holdPaused = true; updatePause();
        try { await nativeShare(idx); } finally { holdPaused = false; updatePause(); }
      } else openSheet();
    }));
    moreBtn.addEventListener('click', openSheet);
    row.appendChild(saveBtn); row.appendChild(shareBtn); row.appendChild(moreBtn);

    /* share sheet */
    sheet = el('div', 'wr-sheet'); sheet.hidden = true;
    var card = el('div', 'wr-card'); card.setAttribute('role', 'dialog'); card.setAttribute('aria-label', 'Share your Wrapped');
    var h = el('div', 'wr-card-h'); h.appendChild(el('span', null, 'Share your Wrapped'));
    var sx = el('button', 'wr-x'); sx.type = 'button'; sx.innerHTML = ICON.x; sx.setAttribute('aria-label', 'Close share options'); sx.addEventListener('click', closeSheet); h.appendChild(sx);
    tabs = el('div', 'wr-tabs');
    var tA = el('button', 'wr-tab', 'This slide'), tB = el('button', 'wr-tab', 'My poster'); tA.type = tB.type = 'button';
    tA.addEventListener('click', function () { setShareIdx(openIdx); }); tB.addEventListener('click', function () { setShareIdx(LAST); });
    tabs.appendChild(tA); tabs.appendChild(tB);
    prevImg = el('img', 'wr-prev'); prevImg.alt = 'Preview of the image you are sharing';
    var main = el('button', 'wr-btn wr-btn--p wr-share-main'); main.type = 'button'; main.innerHTML = ICON.sh + '<span>Share image</span>';
    main.addEventListener('click', guard(function () { return nativeShare(shareIdx); }));
    var grid = el('div', 'wr-opts');
    function opt(icon, label, fn) { var b = el('button', 'wr-opt'); b.type = 'button'; b.innerHTML = icon + '<span>' + label + '</span>'; b.addEventListener('click', fn); grid.appendChild(b); }
    function link(icon, label, href) { var a = el('a', 'wr-opt'); a.href = href; if (/^https?:/.test(href)) { a.target = '_blank'; a.rel = 'noopener'; } a.innerHTML = icon + '<span>' + label + '</span>'; grid.appendChild(a); }
    opt(ICON.dl, 'Save image', guard(async function () { saveBlob(await getBlob(shareIdx), fname(shareIdx)); toast('Saved to your device'); }));
    opt(ICON.all, 'Save all', guard(async function () {
      for (var k = 0; k < S.length; k++) { saveBlob(await getBlob(k), fname(k)); await new Promise(function (r) { setTimeout(r, 350); }); }
      toast('All ' + S.length + ' slides saved');
    }));
    opt(ICON.cp, 'Copy caption', guard(copyCaption));
    opt(ICON.ig, 'Instagram', guard(async function () { saveBlob(await getBlob(shareIdx), fname(shareIdx)); toast('Saved. Add it to your Instagram story.'); }));
    link(ICON.wa, 'WhatsApp', 'https://wa.me/?text=' + enc(CAP + ' ' + SITE));
    link(ICON.tg, 'Telegram', 'https://t.me/share/url?url=' + enc(SITE) + '&text=' + enc(CAP));
    link(ICON.xx, 'X', 'https://twitter.com/intent/tweet?text=' + enc(CAP) + '&url=' + enc(SITE));
    link(ICON.ml, 'Email', 'mailto:?subject=' + enc('My KravN Wrapped ' + W.year) + '&body=' + enc(CAP + ' ' + SITE));
    var hint = el('p', 'wr-hint', 'WhatsApp, Telegram, X and Email share the caption. Save the image first to attach it.');
    [h, tabs, prevImg, main, grid, hint].forEach(function (n) { card.appendChild(n); });
    sheet.appendChild(card);
    sheet.addEventListener('click', function (e) { if (e.target === sheet) closeSheet(); });
    toastEl = el('div', 'wr-toast'); toastEl.hidden = true; toastEl.setAttribute('role', 'status');

    ov.appendChild(wrapEl); ov.appendChild(row); ov.appendChild(sheet); ov.appendChild(toastEl); document.body.appendChild(ov);
    addEventListener('resize', function () { if (!ov.hidden) layout(); });
    document.addEventListener('keydown', function (e) {
      if (ov.hidden) return;
      if (e.key === 'Escape') { sheetOpen ? closeSheet() : close(); }
      else if (!sheetOpen && e.key === 'ArrowRight') show(idx + 1);
      else if (!sheetOpen && e.key === 'ArrowLeft') show(idx - 1);
    });
  }
  function open(start, share) {
    if (!ov) build(); lastFocus = document.activeElement; document.documentElement.style.overflow = 'hidden'; ov.hidden = false; layout(); show(start || 0);
    setTimeout(function () { getBlob(LAST).catch(noop); }, 2500);
    if (share) openSheet();
  }
  function close() {
    if (sheetOpen) { sheetOpen = false; sheet.hidden = true; updatePause(); }
    ov.hidden = true; document.documentElement.style.overflow = ''; if (lastFocus && lastFocus.focus) lastFocus.focus();
  }
  document.getElementById('wr-open').addEventListener('click', function () { open(0); });
  document.getElementById('wr-poster').addEventListener('click', function () { open(LAST, true); });
  if (location.hash === '#play') open(0);
  else if (location.hash === '#poster') open(LAST, true);
})();
</script>
<% } %>
