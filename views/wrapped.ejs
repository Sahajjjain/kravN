<%- include('partials/head', { title: 'KravN Wrapped' }) %>
<%- include('partials/nav') %>

<style>
  /* ---------- shared brand tokens (independent of the site theme) ---------- */
  .wr-hero, .wr-ov { --wr-grad: linear-gradient(135deg, #8b5cf6, #ec4899); --wr-font: var(--font, system-ui), system-ui, -apple-system, 'Segoe UI', sans-serif; --wr-serif: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif; }

  /* ---------- landing ---------- */
  .wr-hero { position: relative; overflow: hidden; isolation: isolate; display: grid; gap: 40px; align-items: center; margin: 8px 0 24px; padding: clamp(32px, 6vw, 72px) clamp(22px, 5vw, 68px);
    border-radius: 32px; color: #fff; font-family: var(--wr-font); background: #0b0a14;
    box-shadow: 0 40px 90px -50px rgba(124, 58, 237, .6), inset 0 0 0 1px rgba(255, 255, 255, .07); }
  @media (min-width: 860px) { .wr-hero { grid-template-columns: 1.05fr .95fr; min-height: 560px; } }
  .wr-hero::before { content: ""; position: absolute; z-index: -2; inset: -25%;
    background: radial-gradient(40% 36% at 15% 20%, rgba(139, 92, 246, .45), transparent), radial-gradient(36% 32% at 85% 85%, rgba(236, 72, 153, .3), transparent), radial-gradient(30% 28% at 72% 8%, rgba(59, 130, 246, .2), transparent);
    animation: wr-drift 14s ease-in-out infinite alternate; }
  .wr-hero::after { content: ""; position: absolute; z-index: -1; inset: 0; opacity: .08; mix-blend-mode: overlay; pointer-events: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>"); }
  .wr-copy { display: grid; gap: 20px; justify-items: start; }
  .wr-eyebrow { display: inline-flex; align-items: center; gap: 12px; font: 600 12px/1 var(--wr-font); letter-spacing: .22em; text-transform: uppercase; color: rgba(255, 255, 255, .62); }
  .wr-eyebrow::before { content: ""; width: 34px; height: 1px; background: rgba(255, 255, 255, .4); }
  .wr-hero h1 { margin: 0; font-family: var(--wr-serif); font-weight: 500; font-size: clamp(42px, 6.4vw, 78px); line-height: 1.02; letter-spacing: -.02em; }
  .wr-hero h1 em { font-style: italic; background: linear-gradient(100deg, #c4b5fd, #f9a8d4); -webkit-background-clip: text; background-clip: text; color: transparent; padding-right: .08em; }
  .wr-by { margin: -6px 0 0; font: 600 15px/1 var(--wr-font); color: rgba(255, 255, 255, .55); }
  .wr-hero p.wr-lead { margin: 0; max-width: 44ch; font-size: clamp(15px, 2.2vw, 17px); line-height: 1.6; color: rgba(255, 255, 255, .7); }
  .wr-facts { display: flex; flex-wrap: wrap; row-gap: 14px; }
  .wr-fact { padding: 0 24px; border-left: 1px solid rgba(255, 255, 255, .16); }
  .wr-fact:first-child { padding-left: 0; border-left: 0; }
  .wr-fact b { display: block; font: 500 30px/1.1 var(--wr-serif); font-variant-numeric: tabular-nums; }
  .wr-fact span { display: block; margin-top: 6px; font: 600 11px/1 var(--wr-font); letter-spacing: .16em; text-transform: uppercase; color: rgba(255, 255, 255, .5); }
  .wr-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }
  .wr-go { display: inline-flex; align-items: center; justify-content: center; gap: 10px; height: 54px; padding: 0 30px; border-radius: 999px; border: 0; cursor: pointer; text-decoration: none;
    font: 700 15px/1 var(--wr-font); color: #14141c; background: #fff; box-shadow: 0 18px 44px -16px rgba(196, 181, 253, .7); transition: transform .2s, box-shadow .2s; }
  .wr-go:hover { transform: translateY(-2px); box-shadow: 0 22px 50px -14px rgba(244, 168, 212, .75); }
  .wr-go svg { width: 16px; height: 16px; fill: currentColor; }
  .wr-ghost { display: inline-flex; align-items: center; justify-content: center; gap: 10px; height: 54px; padding: 0 26px; border-radius: 999px; cursor: pointer; text-decoration: none;
    font: 600 15px/1 var(--wr-font); color: #fff; background: rgba(255, 255, 255, .06); border: 1px solid rgba(255, 255, 255, .22); transition: background .2s, transform .2s; }
  .wr-ghost:hover { background: rgba(255, 255, 255, .14); transform: translateY(-2px); }
  .wr-go:focus-visible, .wr-ghost:focus-visible, .wr-btn:focus-visible, .wr-opt:focus-visible, .wr-x:focus-visible, .wr-arrow:focus-visible, .wr-tab:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }

  /* poster fan: the person's own top picks */
  .wr-fan { position: relative; height: clamp(300px, 42vw, 420px); }
  @media (max-width: 859px) { .wr-fan { order: -1; } }
  .wr-fp { position: absolute; left: 50%; bottom: 0; margin: 0; width: clamp(130px, 19vw, 200px); aspect-ratio: 2 / 3; border-radius: 14px; overflow: hidden; display: grid; place-items: center; padding: 10px; text-align: center;
    font: 700 13px/1.25 var(--wr-font); color: rgba(255, 255, 255, .85); background: linear-gradient(160deg, #3b2a6b, #1a1233); transform-origin: 50% 100%;
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, .85), 0 0 0 1px rgba(255, 255, 255, .14);
    transform: translateX(calc(-50% + var(--x))) translateY(var(--y)) rotate(var(--r));
    animation: wr-rise .9s cubic-bezier(.2, .8, .2, 1) both; animation-delay: calc(var(--d) * .12s + .1s); }
  .wr-fp img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .wr-fp-l { --x: -82%; --r: -9deg; --y: 14px; z-index: 1; }
  .wr-fp-c { --x: 0%; --r: 0deg; --y: -18px; z-index: 3; width: clamp(150px, 22vw, 230px); }
  .wr-fp-r { --x: 82%; --r: 9deg; --y: 14px; z-index: 2; }
  @keyframes wr-rise { from { opacity: 0; transform: translateX(-50%) translateY(60px) rotate(0deg); } to { opacity: 1; transform: translateX(calc(-50% + var(--x))) translateY(var(--y)) rotate(var(--r)); } }
  @keyframes wr-drift { from { transform: translate(0, 0) scale(1); } to { transform: translate(-90px, 70px) scale(1.12); } }

  /* ---------- fullscreen story ---------- */
  .wr-ov { position: fixed; inset: 0; z-index: 500; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px;
    padding: env(safe-area-inset-top) 0 env(safe-area-inset-bottom); color: #fff; font-family: var(--wr-font);
    background: radial-gradient(60% 50% at 50% 0%, rgba(139, 92, 246, .22), transparent), rgba(6, 5, 12, .97); -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px); }
  .wr-ov[hidden] { display: none !important; }
  .wr-stagewrap { display: flex; align-items: center; gap: 22px; }
  .wr-frame { position: relative; overflow: hidden; border-radius: 28px; background: #000; touch-action: manipulation; -webkit-user-select: none; user-select: none; -webkit-touch-callout: none;
    box-shadow: 0 40px 90px -30px rgba(0, 0, 0, .95), 0 0 0 1px rgba(255, 255, 255, .12); }
  .wr-stage { position: absolute; left: 0; top: 0; width: 1080px; height: 1920px; transform-origin: 0 0; }
  .wr-segs { position: absolute; z-index: 6; top: 14px; left: 14px; right: 14px; display: flex; gap: 4px; pointer-events: none; }
  .wr-seg { flex: 1; height: 4px; border-radius: 3px; background: rgba(255, 255, 255, .28); overflow: hidden; }
  .wr-seg i { display: block; height: 100%; width: 0; background: #fff; }
  .wr-seg.done i { width: 100%; }
  .wr-seg.on i { animation: wr-fill var(--dur, 6.5s) linear forwards; }
  .wr-seg.on.last i { animation: none; width: 100%; }
  .wr-ov.paused .wr-seg.on i { animation-play-state: paused; }
  @keyframes wr-fill { from { width: 0; } to { width: 100%; } }
  .wr-x { position: absolute; z-index: 7; top: 26px; right: 14px; width: 38px; height: 38px; display: grid; place-items: center; padding: 0; border-radius: 50%; cursor: pointer; color: #fff;
    background: rgba(0, 0, 0, .4); border: 1px solid rgba(255, 255, 255, .35); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
  .wr-zone { position: absolute; z-index: 5; top: 70px; bottom: 0; }
  .wr-zone.l { left: 0; width: 30%; } .wr-zone.r { right: 0; width: 70%; }
  .wr-ic { width: 18px; height: 18px; flex: none; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .wr-arrow { width: 48px; height: 48px; display: grid; place-items: center; padding: 0; border-radius: 50%; cursor: pointer; color: #fff; background: rgba(255, 255, 255, .08); border: 1px solid rgba(255, 255, 255, .22); transition: background .2s, transform .2s; }
  .wr-arrow:hover { background: rgba(255, 255, 255, .2); transform: scale(1.06); }
  @media (max-width: 760px) { .wr-arrow { display: none; } .wr-stagewrap { gap: 0; } }

  .wr-actions { display: flex; gap: 10px; }
  .wr-btn { flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 9px; height: 50px; padding: 0 20px; border-radius: 999px; cursor: pointer; white-space: nowrap;
    font: 700 14px/1 var(--wr-font); color: #fff; background: rgba(255, 255, 255, .1); border: 1px solid rgba(255, 255, 255, .26); transition: background .2s, transform .2s, filter .2s; }
  .wr-btn:hover { background: rgba(255, 255, 255, .2); } .wr-btn:active { transform: scale(.97); }
  .wr-btn--p { background: var(--wr-grad); border-color: transparent; box-shadow: 0 14px 34px -12px rgba(236, 72, 153, .8); }
  .wr-btn--p:hover { background: var(--wr-grad); filter: brightness(1.1); }
  .wr-btn--icon { flex: none; width: 50px; padding: 0; }
  .wr-btn[hidden] { display: none; }

  /* ---------- share sheet ---------- */
  .wr-sheet { position: absolute; inset: 0; z-index: 600; display: flex; align-items: flex-end; justify-content: center; background: rgba(0, 0, 0, .6); }
  .wr-sheet[hidden] { display: none; }
  .wr-card { width: min(480px, 100%); max-height: 94%; overflow-y: auto; padding: 18px 18px calc(18px + env(safe-area-inset-bottom)); border-radius: 28px 28px 0 0;
    background: #16131f; border: 1px solid rgba(255, 255, 255, .1); box-shadow: 0 -24px 70px rgba(0, 0, 0, .6); animation: wr-sheetup .3s cubic-bezier(.2, .8, .2, 1) both; }
  @keyframes wr-sheetup { from { transform: translateY(40px); opacity: 0; } to { transform: none; opacity: 1; } }
  @media (min-width: 760px) { .wr-sheet { align-items: center; } .wr-card { border-radius: 28px; } }
  .wr-card-h { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; font-size: 18px; font-weight: 800; }
  .wr-card-h .wr-x { position: static; }
  .wr-tabs { display: flex; gap: 6px; padding: 4px; margin-bottom: 14px; border-radius: 999px; background: rgba(255, 255, 255, .08); }
  .wr-tabs[hidden] { display: none; }
  .wr-tab { flex: 1; height: 38px; border: 0; border-radius: 999px; cursor: pointer; font: 700 13px/1 var(--wr-font); color: rgba(255, 255, 255, .7); background: transparent; }
  .wr-tab.on { color: #fff; background: rgba(255, 255, 255, .18); }
  .wr-prev { display: block; margin: 0 auto 16px; height: min(36vh, 340px); aspect-ratio: 9 / 16; object-fit: cover; border-radius: 16px; background: rgba(255, 255, 255, .08); box-shadow: 0 20px 40px -18px rgba(0, 0, 0, .8); transition: opacity .2s; }
  .wr-prev.load { opacity: .35; }
  .wr-share-main { width: 100%; margin-bottom: 12px; }
  .wr-opts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
  .wr-opt { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; min-height: 72px; padding: 10px 4px; border-radius: 16px; cursor: pointer; text-decoration: none;
    font: 600 11.5px/1.2 var(--wr-font); color: #fff; background: rgba(255, 255, 255, .08); border: 1px solid rgba(255, 255, 255, .14); transition: background .2s, transform .2s; }
  .wr-opt:hover { background: rgba(255, 255, 255, .17); } .wr-opt:active { transform: scale(.96); }
  .wr-opt .wr-ic { width: 22px; height: 22px; }
  .wr-hint { margin: 14px 4px 0; font-size: 12.5px; line-height: 1.5; text-align: center; color: rgba(255, 255, 255, .55); }
  .wr-toast { position: absolute; z-index: 700; left: 50%; bottom: calc(24px + env(safe-area-inset-bottom)); transform: translateX(-50%); max-width: 90%; padding: 12px 20px; border-radius: 999px;
    font: 600 14px/1.2 var(--wr-font); color: #14141c; background: #fff; box-shadow: 0 14px 40px rgba(0, 0, 0, .5); animation: wr-sheetup .25s both; }
  .wr-toast[hidden] { display: none; }

  /* ---------- slide (design units = 1080 x 1920 px) ---------- */
  .wr-s { position: absolute; inset: 0; display: none; overflow: hidden; color: #fff; font-family: var(--wr-font);
    background: linear-gradient(165deg, hsl(var(--h) 80% 38%), hsl(calc(var(--h) + 30) 72% 20%) 50%, hsl(calc(var(--h) + 55) 70% 8%)); }
  .wr-s.on { display: block; animation: wr-fade .45s ease both; }
  @keyframes wr-fade { from { opacity: 0; } to { opacity: 1; } }
  .wr-bg { position: absolute; inset: 0; overflow: hidden; }
  .wr-bg i { position: absolute; border-radius: 50%; }
  .wr-bg i:nth-child(1) { left: 400px; top: -330px; width: 1400px; height: 1400px; background: radial-gradient(closest-side, hsl(calc(var(--h) + 40) 100% 65% / .45), transparent); animation: wr-drift 9s ease-in-out infinite alternate; }
  .wr-bg i:nth-child(2) { left: -700px; top: 960px; width: 1600px; height: 1600px; background: radial-gradient(closest-side, hsl(calc(var(--h) - 30) 100% 55% / .35), transparent); animation: wr-drift 11s ease-in-out infinite alternate-reverse; }
  .wr-bg i:nth-child(3) { left: 180px; top: -480px; width: 1480px; height: 1480px; background: repeating-radial-gradient(closest-side, transparent 0 218px, rgba(255, 255, 255, .07) 218px 220px); }
  .wr-bg i:nth-child(4) { inset: 0; border-radius: 0; background-image: var(--noise); background-size: 160px 160px; opacity: .14; mix-blend-mode: overlay; }
  .wr-bg i:nth-child(5) { inset: 0; border-radius: 0; background: radial-gradient(circle at 50% 50%, transparent 60%, rgba(0, 0, 0, .4) 100%); }
  .wr-tag { position: absolute; left: 0; width: 1080px; top: 160px; height: 60px; line-height: 60px; padding: 0 160px; box-sizing: border-box; text-align: center; font-weight: 700; font-size: 36px;
    text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: rgba(255, 255, 255, .8); }
  .wr-body { position: absolute; left: 90px; top: 280px; width: 900px; height: 1420px; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 38px; text-align: center; }
  .wr-body > * { animation: wr-up .75s cubic-bezier(.2, .8, .2, 1) both; animation-delay: calc(var(--i) * .16s + .1s); }
  @keyframes wr-up { from { opacity: 0; transform: translateY(70px) scale(.95); } to { opacity: 1; transform: none; } }
  .wr-brand { position: absolute; left: 0; width: 1080px; top: 1778px; height: 64px; display: flex; align-items: center; justify-content: center; gap: 18px; font-weight: 700; font-size: 36px; color: rgba(255, 255, 255, .8); }
  .wr-mark { width: 64px; height: 64px; border-radius: 20px; display: grid; place-items: center; background: #fff; color: #111; font-weight: 800; font-size: 40px; line-height: 1; }

  .wr-big { width: 900px; font-weight: 800; line-height: 1.12; overflow-wrap: anywhere; text-shadow: 0 4px 24px rgba(0, 0, 0, .25); }
  .wr-sub { width: 880px; font-weight: 500; font-size: 44px; line-height: 1.35; color: rgba(255, 255, 255, .82); overflow-wrap: anywhere; }
  .wr-emoji { font-size: 170px; line-height: 190px; height: 190px; animation: wr-up .75s both, wr-bob 2.4s 1s ease-in-out infinite; animation-delay: calc(var(--i) * .16s + .1s), 1s; }
  @keyframes wr-bob { 0%, 100% { transform: translateY(0) rotate(-4deg); } 50% { transform: translateY(-22px) rotate(4deg); } }
  .wr-num b { display: block; font-weight: 800; letter-spacing: -.02em; font-variant-numeric: tabular-nums; text-shadow: 0 6px 30px rgba(0, 0, 0, .25); }
  .wr-num span { display: block; height: 56px; line-height: 56px; font-weight: 600; font-size: 42px; color: rgba(255, 255, 255, .85); }
  .wr-pbox { position: relative; overflow: hidden; background: rgba(255, 255, 255, .12); box-shadow: 0 30px 60px -20px rgba(0, 0, 0, .6), 0 0 0 3px rgba(255, 255, 255, .3); display: grid; place-items: center; }
  .wr-pbox img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .wr-pfall { padding: 0 20px; font-weight: 700; color: rgba(255, 255, 255, .85); overflow-wrap: anywhere; }
  .wr-posters { display: flex; gap: 24px; justify-content: center; }
  .wr-mini { position: relative; }
  .wr-badge { position: absolute; z-index: 2; left: 12px; top: 12px; width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; font-style: normal; font-weight: 800; font-size: 24px; background: #fff; color: #111; }
  .wr-cap { margin-top: 12px; height: 64px; font-weight: 600; font-size: 24px; line-height: 32px; color: rgba(255, 255, 255, .9); overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow-wrap: anywhere; }
  .wr-bars { width: 900px; height: 470px; display: flex; justify-content: space-between; align-items: flex-end; }
  .wr-col { width: 52px; height: 470px; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; }
  .wr-col span { height: 50px; line-height: 50px; font-weight: 700; font-size: 28px; color: rgba(255, 255, 255, .8); }
  .wr-pole { width: 52px; border-radius: 14px; background: rgba(255, 255, 255, .35); transform-origin: bottom; animation: wr-grow .9s cubic-bezier(.2, .8, .2, 1) both; }
  .wr-pole.hi { background: #fff; }
  @keyframes wr-grow { from { transform: scaleY(0); } to { transform: none; } }
  .wr-meter { width: 900px; }
  .wr-row { display: flex; align-items: center; gap: 20px; height: 74px; margin-bottom: 10px; }
  .wr-row:last-child { margin-bottom: 0; }
  .wr-row em { width: 280px; flex: none; text-align: left; font-style: normal; font-weight: 600; font-size: 32px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .wr-track { flex: 1; height: 28px; border-radius: 14px; background: rgba(255, 255, 255, .2); overflow: hidden; }
  .wr-track i { display: block; height: 100%; border-radius: 14px; background: #fff; transform-origin: left; animation: wr-growx 1s cubic-bezier(.2, .8, .2, 1) both; animation-delay: .5s; }
  @keyframes wr-growx { from { transform: scaleX(0); } to { transform: none; } }
  .wr-row b { width: 90px; flex: none; text-align: right; font-weight: 700; font-size: 30px; }
  .wr-stats { width: 900px; display: flex; gap: 20px; }
  .wr-st { flex: 1; height: 170px; border-radius: 28px; background: rgba(255, 255, 255, .14); display: flex; flex-direction: column; justify-content: center; align-items: center; }
  .wr-st b { font-weight: 800; font-size: 70px; line-height: 80px; } .wr-st span { font-weight: 600; font-size: 24px; line-height: 32px; text-transform: uppercase; color: rgba(255, 255, 255, .8); }
  .wr-pill { height: 84px; padding: 0 40px; border-radius: 42px; display: inline-flex; align-items: center; background: #fff; color: #14141c; font-weight: 700; font-size: 40px; white-space: nowrap; }

  @media (prefers-reduced-motion: reduce) {
    .wr-body > *, .wr-pole, .wr-track i, .wr-bg i, .wr-emoji, .wr-hero::before, .wr-fp, .wr-go, .wr-s.on, .wr-card, .wr-toast { animation: none !important; }
  }
</style>

<main class="page"><div class="shell">
<% if (W.empty) { %>
  <section class="wr-hero" style="grid-template-columns: 1fr; min-height: 0; justify-items: center; text-align: center;">
    <div class="wr-copy" style="justify-items: center;">
      <span class="wr-eyebrow">KravN Wrapped · <%= W.year %></span>
      <h1>Nothing to <em>unwrap</em> yet</h1>
      <p class="wr-lead">Start a discussion or leave a few comments, then come back. Your <%= W.year %> in movies will be waiting.</p>
      <div class="wr-cta"><a class="wr-go" href="/posts/new">Start a discussion</a></div>
    </div>
  </section>
<% } else { %>
  <% var fan = W.top5.slice(0, 3);
     var slots = fan.length >= 3 ? [[fan[1], 'l'], [fan[0], 'c'], [fan[2], 'r']] : fan.length === 2 ? [[fan[1], 'r'], [fan[0], 'c']] : [[fan[0], 'c']]; %>
  <section class="wr-hero">
    <div class="wr-copy">
      <span class="wr-eyebrow">KravN Wrapped · <%= W.year %></span>
      <h1>Your <%= W.year %><br><em>in movies</em></h1>
      <p class="wr-by">@<%= W.username %></p>
      <p class="wr-lead">Your top films, your biggest obsession, your movie personality and a poster made to share.</p>
      <div class="wr-facts">
        <div class="wr-fact"><b><%= W.cinematic.titles %></b><span>Titles</span></div>
        <div class="wr-fact"><b><%= W.cinematic.discussions %></b><span>Discussions</span></div>
        <div class="wr-fact"><b><%= W.cinematic.comments %></b><span>Comments</span></div>
      </div>
      <div class="wr-cta">
        <button type="button" class="wr-go" id="wr-open"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l13-7.5z"/></svg> Play my Wrapped</button>
        <button type="button" class="wr-ghost" id="wr-poster">Share my poster</button>
      </div>
    </div>
    <div class="wr-fan" aria-hidden="true">
      <% slots.forEach(function (s, i) { %>
        <figure class="wr-fp wr-fp-<%= s[1] %>" style="--d:<%= i %>">
          <span><%= s[0].name %></span>
          <% if (s[0].poster) { %><img src="/api/wrapped/img?u=<%= encodeURIComponent(s[0].poster) %>" alt="" onerror="this.remove()"><% } %>
        </figure>
      <% }) %>
    </div>
  </section>
<% } %>
</div></main>

<% if (!W.empty) { %>
<script>
(function () {
